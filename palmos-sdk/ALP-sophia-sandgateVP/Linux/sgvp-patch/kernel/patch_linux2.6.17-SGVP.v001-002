+
+config PXA27x_E81
+	bool "Intel PXA27x Errata 81"
+	help
+	  CLOCKS MANAGER: Possible DMA errors when exiting 13M mode to
+	  a frequncy where the memory controller clock (CLK_MEM) frequncy
+	  does not equal the system bus frequency.
+	default y
+
+endmenu
+
 endmenu
 
 config MACH_POODLE
