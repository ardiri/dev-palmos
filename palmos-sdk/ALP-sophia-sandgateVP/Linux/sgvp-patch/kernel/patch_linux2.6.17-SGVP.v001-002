diff -uNr linux-2.6.17.org/arch/arm/mach-pxa/pm.c linux-2.6.17/arch/arm/mach-pxa/pm.c
--- linux-2.6.17.org/arch/arm/mach-pxa/pm.c	2006-10-28 14:34:30.000000000 +0900
+++ linux-2.6.17/arch/arm/mach-pxa/pm.c	2006-10-28 14:42:38.000000000 +0900
@@ -9,22 +9,58 @@
  *
  * This program is free software; you can redistribute it and/or
  * modify it under the terms of the GNU General Public License.
+ *
+ * Copyright (C) 2005-2006 WILLCOM, Inc. All rights Reserved.
  */
 #include <linux/config.h>
+#include <linux/dpm.h>
 #include <linux/init.h>
 #include <linux/module.h>
 #include <linux/suspend.h>
 #include <linux/errno.h>
 #include <linux/time.h>
-
 #include <asm/hardware.h>
 #include <asm/memory.h>
 #include <asm/system.h>
 #include <asm/arch/pm.h>
 #include <asm/arch/pxa-regs.h>
-#include <asm/arch/lubbock.h>
 #include <asm/mach/time.h>
+#include <asm/dpm.h>
+
+#ifdef CONFIG_DVFM
+/* How long we will in sleep mode if duty cycle. */
+unsigned int  pm_sleeptime=58;  /* In seconds. */
+
+/* How long we will in run mode if duty cycle. */
+unsigned int  pm_waketime = 2;  /* In seconds. */
+
+/* After pm_uitimeout long without input from keypad/touch, we will sleep. */
+unsigned int  pm_uitimeout= 30; /* In seconds. */
+
+/*
+ * The default sleep level, if we want to use Standy to replace sleep.
+ * set this to PM_SUSPEND_STANDBY.
+ */
+unsigned int ipm_sleep_level = PM_SUSPEND_MEM; /* Default is to Sleep mode. */
 
+/*
+ * Flag is used to say whether it was called from UI update or from
+ * sleep call. In UI device call it with flag = 0, in sleep return
+ * call it with flag = 1.
+ */
+int pm_updatetimer(int flag)
+{
+#if 0
+	if (flag)
+		mod_timer(&pm_timer, jiffies + pm_waketime*HZ );
+	else
+		mod_timer(&pm_timer, jiffies + pm_uitimeout*HZ );
+#endif
+	return 0;
+}
+EXPORT_SYMBOL_GPL(pm_updatetimer);
+
+#endif /* CONFIG_DVFM */
 
 /*
  * Debug macros
@@ -66,13 +102,30 @@
  	SLEEP_SAVE_MDREFR,
  	SLEEP_SAVE_PWER, SLEEP_SAVE_PCFR, SLEEP_SAVE_PRER,
  	SLEEP_SAVE_PFER, SLEEP_SAVE_PKWR,
+	SLEEP_SAVE_PSLR,
 #endif
-
 	SLEEP_SAVE_CKSUM,
 
 	SLEEP_SAVE_SIZE
 };
 
+#if defined(CONFIG_MACH_SANDGATE2P)
+#define	BOARD_BCR	SG2P_BCR
+#define	BOARD_ISR	SG2P_ISR
+#define	BOARD_IMR	SG2P_IMR
+#elif defined(CONFIG_MACH_BLACKRIVER)
+#define	BOARD_BCR	BR_BCR
+#define	BOARD_ISR	BR_ISR
+#define	BOARD_IMR	BR_IMR
+#else
+#undef	BOARD_BCR
+#undef	BOARD_ISR
+#undef	BOARD_IMR
+#endif
+
+unsigned long saved_cpld_bcr, saved_cpld_imr;
+unsigned long saved_msc0, saved_msc1, saved_msc2;
+unsigned long saved_cccr;
 
 int pxa_pm_enter(suspend_state_t state)
 {
@@ -92,6 +145,63 @@
 	rtc.tv_nsec = 0;
 	save_time_delta(&delta, &rtc);
 
+	if (state == PM_SUSPEND_MEM) {
+		/* Sleep Mode */
+#if defined(BOARD_BCR)
+		saved_cpld_bcr = BOARD_BCR;
+		saved_cpld_imr = BOARD_IMR;
+#endif
+		saved_msc0 = MSC0;
+		saved_msc1 = MSC1;
+		saved_msc2 = MSC2;
+		saved_cccr = CCCR;
+
+		SAVE(GPLR0); SAVE(GPLR1); SAVE(GPLR2);
+		SAVE(GPDR0); SAVE(GPDR1); SAVE(GPDR2);
+		SAVE(GRER0); SAVE(GRER1); SAVE(GRER2);
+		SAVE(GFER0); SAVE(GFER1); SAVE(GFER2);
+		SAVE(PGSR0); SAVE(PGSR1); SAVE(PGSR2);
+
+		SAVE(GAFR0_L); SAVE(GAFR0_U);
+		SAVE(GAFR1_L); SAVE(GAFR1_U);
+		SAVE(GAFR2_L); SAVE(GAFR2_U);
+
+#ifdef CONFIG_PXA27x
+		SAVE(MDREFR);
+		SAVE(GPLR3); SAVE(GPDR3); SAVE(GRER3); SAVE(GFER3); SAVE(PGSR3);
+		SAVE(GAFR3_L); SAVE(GAFR3_U);
+		SAVE(PWER); SAVE(PCFR); SAVE(PRER);
+		SAVE(PFER); SAVE(PKWR);
+#endif
+
+		SAVE(ICMR);
+		ICMR = 0;
+
+		SAVE(CKEN);
+		SAVE(PSLR);
+
+		/* Note: wake up source are set up in each machine specific files */
+		/* clear GPIO transition detect bits */
+		GEDR0 = GEDR0; GEDR1 = GEDR1; GEDR2 = GEDR2;
+#ifdef CONFIG_PXA27x
+		GEDR3 = GEDR3;
+#endif
+		/* Clear sleep reset status */
+		RCSR = RCSR_SMR;
+
+		/* Set Registers */
+		PSLR |= (1 << 3);	/* PSLR[SL_PI] = b10 Set */
+		PSLR |= (1 << 23);	/* PSLR[PSSD] Set */
+		PSLR &= ~(1 << 22);	/* PSLR[IVF] Clear */
+
+		PMCR |= 0x2A;		/* Status Clear */
+		PMCR |= (1 << 2);	/* PMCR[VIDAE] Set */
+
+		PSSR |= PSSR_RDH;
+		PSSR |= PSSR_PH;
+		PSSR |= PSSR_SSS;
+	} else {
+	/* Standby Mode */
 	SAVE(GPLR0); SAVE(GPLR1); SAVE(GPLR2);
 	SAVE(GPDR0); SAVE(GPDR1); SAVE(GPDR2);
 	SAVE(GRER0); SAVE(GRER1); SAVE(GRER2);
@@ -127,6 +237,8 @@
 	/* Clear sleep reset status */
 	RCSR = RCSR_SMR;
 
+	}
+
 	/* before sleeping, calculate and save a checksum */
 	for (i = 0; i < SLEEP_SAVE_SIZE - 1; i++)
 		checksum += sleep_save[i];
@@ -181,7 +293,10 @@
 	ICCR = 1;
 	RESTORE(ICMR);
 
-	RESTORE(PSTR);
+	if (state == PM_SUSPEND_MEM) 	/* Sleep Mode Start */
+		RESTORE(PSLR);
+	else
+		RESTORE(PSTR);
 
 	/* restore current time */
 	rtc.tv_sec = RCNR;
@@ -190,6 +305,21 @@
 #ifdef DEBUG
 	printk(KERN_DEBUG "*** made it back from resume\n");
 #endif
+	if (state == PM_SUSPEND_MEM) {
+		/* Sleep Mode Start */
+		vm_setvoltage(0x8C);
+#if defined(BOARD_BCR)
+		BOARD_BCR = saved_cpld_bcr;
+		BOARD_IMR = saved_cpld_imr;
+#endif
+		MSC0 = saved_msc0;
+		MSC1 = saved_msc1;
+		MSC2 = saved_msc2;
+		CCCR = saved_cccr;
+#ifdef CONFIG_DPM
+		dpm_unlock();
+#endif /* CONFIG_DPM */
+	}
 
 	return 0;
 }
diff -uNr linux-2.6.17.org/arch/arm/mach-pxa/pmu-bvd.S linux-2.6.17/arch/arm/mach-pxa/pmu-bvd.S
--- linux-2.6.17.org/arch/arm/mach-pxa/pmu-bvd.S	1970-01-01 09:00:00.000000000 +0900
+++ linux-2.6.17/arch/arm/mach-pxa/pmu-bvd.S	2006-10-28 14:42:38.000000000 +0900
@@ -0,0 +1,183 @@
+/* 
+ * Copyright 2000-2003 Intel Corporation All Rights Reserved.
+ * This file is for xsc2 PMU Access Assembly function
+ *
+ * Copyright (C) 2005-2006 WILLCOM, Inc. All rights Reserved.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 as
+ * published by the Free Software Foundation.
+ */
+
+.text
+
+/*
+@
+@ pmu_reg_read - Read the PMU Register
+@
+@ Description:
+@ 	This routine reads the designated PMU register via CoProcesser 14.
+@
+@ Input Parameters:
+@       r0 - arg1, PMU register number to read.  Number between 0 to 8
+@	if r0 contains:
+@		0 -> PMNC,  PMU Control Register
+@		1 -> CCNT,  PMU Clock Counter
+@		2 -> PMN0,  PMU Count Register 0
+@		3 -> PMN1,  PMU Count Register 1
+@		4 -> PMN2,	PMU Count Register 2
+@		5 -> PMN3,  PMU Count Register 3
+@		6 -> INTEN, PMU Interupt Enable Register
+@		7 -> FLAG,  PMU Overflow Flag Status Register
+@		8 -> EVTSEL	PMU Event Select Register			
+@
+@ Returns:
+@	r0 - 32-bit value read from CoProcessor
+@    
+@ Registers Modified:
+@	CoProcessor Register Modified: None
+@	General Purpose Registers Modified: r0	
+@
+@ NOTE:  
+@	Error checking not included
+@
+*/
+.global pmu_reg_read;
+.align 0;
+pmu_reg_read:
+    cmp     	r0, #8
+    addls	pc, pc, r0, lsl #2
+    b		RRet
+    b		RdPMNC
+    b		RdCCNT
+    b		RdPMN0
+    b		RdPMN1
+    b		RdPMN2
+    b		RdPMN3
+    b		RdINTEN
+    b		RdFLAG
+    b		RdEVTSEL
+
+RdPMNC:  
+    mrc     	p14, 0, r0, c0, c1, 0		@ Read PMNC
+    b       	RRet
+RdCCNT: 
+    mrc     	p14, 0, r0, c1, c1, 0		@ Read CCNT
+    b		RRet
+RdPMN0:
+    mrc     	p14, 0, r0, c0, c2, 0		@ Read PMN0
+    b		RRet
+RdPMN1:
+    mrc     	p14, 0, r0, c1, c2, 0		@ Read PMN1
+    b		RRet
+RdPMN2:
+    mrc     	p14, 0, r0, c2, c2, 0		@ Read PMN2
+    b		RRet
+RdPMN3:
+    mrc     	p14, 0, r0, c3, c2, 0		@ Read PMN3
+    b		RRet
+RdINTEN:  
+    mrc     	p14, 0, r0, c4, c1, 0		@ Read INTEN
+    b		RRet
+RdFLAG:
+    mrc     	p14, 0, r0, c5, c1, 0		@ Read FLAG
+    b		RRet
+RdEVTSEL:  
+    mrc     	p14, 0, r0, c8, c1, 0		@ Read EVTSEL
+
+RRet:
+    mov  	pc, lr          @ return
+
+/*
+@
+@ pmu_reg_write - Writes to the PMU Register
+@
+@ Description:
+@ 	This routine writes to the designated PMU register via CoProcesser 14.
+@
+@ Input Parameters:   
+@       r0 - arg1 - PMU register number to write
+@       r1 - arg2 - Value to write to PMU register
+@
+@	if r0 contains:
+@		0 -> PMNC,  PMU Control Register
+@		1 -> CCNT,  PMU Clock Counter
+@		2 -> PMN0,  PMU Count Register 0
+@		3 -> PMN1,  PMU Count Register 1
+@		4 -> PMN2,	PMU Count Register 2
+@		5 -> PMN3,  PMU Count Register 3
+@		6 -> INTEN, PMU Interupt Enable Register
+@		7 -> FLAG,  PMU Overflow Flag Status Register
+@		8 -> EVTSEL	PMU Event Select Register
+@
+@ Returns:
+@	None
+@
+@ Registers Modified:
+@	CoProcessor Register Modified: PMU Register
+@	General Purpose Registers Modified: None
+@
+@ NOTE   
+@	Error checking not included
+@
+*/
+.global pmu_reg_write;
+.align 0;
+pmu_reg_write:
+    cmp     	r0, #8
+    addls	pc, pc, r0, lsl #2
+    b		WRet
+    b		WrPMNC
+    b		WrCCNT
+    b		WrPMN0
+    b		WrPMN1
+    b		WrPMN2
+    b		WrPMN3
+    b		WrINTEN
+    b		WrFLAG
+    b		WrEVTSEL
+
+WrPMNC:  
+    mcr     	p14, 0, r1, c0, c1, 0		@ Write PMNC
+    b		WRet
+WrCCNT: 
+    mcr     	p14, 0, r1, c1, c1, 0		@ Write CCNT
+    b		WRet
+WrPMN0: 
+    mcr     	p14, 0, r1, c0, c2, 0		@ Write PMN0
+    b		WRet
+WrPMN1: 
+    mcr     	p14, 0, r1, c1, c2, 0		@ Write PMN1
+    b		WRet
+WrPMN2:  
+    mcr     	p14, 0, r1, c2, c2, 0		@ Write PMN2
+    b		WRet
+WrPMN3:  
+    mcr     	p14, 0, r1, c3, c2, 0		@ Write PMN3
+    b		WRet
+WrINTEN:  
+    mcr     	p14, 0, r1, c4, c1, 0		@ Write INTEN
+    b		WRet
+WrFLAG:
+    mcr     	p14, 0, r1, c5, c1, 0		@ Write FLAG
+    b		WRet
+WrEVTSEL:  
+    mcr     	p14, 0, r1, c8, c1, 0		@ Write EVTSEL
+	
+WRet:
+    mov  	pc, lr          @ return
+    
+/*
+; XSC1GetCPUId - Get the CPU ID from CP15 R0 Register
+;
+; This routine reads R0 from CoProcesser 15 to get the CPU ID
+;
+;       Uses r0 - return value of CPU ID
+*/
+.global XSC1GetCPUId;
+.align 0;
+XSC1GetCPUId:
+    mrc     p15, 0, r0, c0, c0, 0
+    mov  pc, lr
+	 
+.end 
diff -uNr linux-2.6.17.org/arch/arm/mach-pxa/pmu.c linux-2.6.17/arch/arm/mach-pxa/pmu.c
--- linux-2.6.17.org/arch/arm/mach-pxa/pmu.c	1970-01-01 09:00:00.000000000 +0900
+++ linux-2.6.17/arch/arm/mach-pxa/pmu.c	2006-10-28 14:42:38.000000000 +0900
@@ -0,0 +1,179 @@
+/*
+ * This function provides the implementation of the access functions to 
+ * the Performance Monitoring Unit on all CPUs based on the XScale core.
+ *
+ * This program is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU General Public License.
+ *
+ * Copyright (c) 2003 Intel Corporation.
+ *
+ * Copyright (C) 2005-2006 WILLCOM, Inc. All rights Reserved.
+ */
+
+#include <linux/config.h>
+#include <linux/module.h>
+#include <linux/types.h>
+#include <linux/errno.h>
+#include <linux/sched.h>
+#include <linux/interrupt.h>
+#include <asm/atomic.h>
+#include <asm/arch/xscale-pmu.h>
+#include <asm/arch/irqs.h>
+
+static atomic_t usage = ATOMIC_INIT(0);
+static unsigned long id = 0;
+struct pmu_results results;
+
+static u32 pmnc;
+static u32 evtsel;
+
+#define PMNC 0    /*	PMU Control Register	*/
+#define CCNT 1    /*	PMU Clock Counter (CCNT)	*/
+#define PMN0 2    /*	PMU Count Register 0 (PMN0)	*/
+#define PMN1 3    /*	PMU Count Register 1 (PMN1)	*/
+#define PMN2 4
+#define PMN3 5
+#define INTEN	6
+#define FLAG	7
+#define EVTSEL	8
+
+extern void pmu_reg_write(unsigned long regno, unsigned long value);
+extern unsigned long pmu_reg_read(unsigned long regno);
+
+#define	PMU_ENABLE	0x001	/* Enable counters */
+#define PMN_RESET	0x002	/* Reset event counters */
+#define	CCNT_RESET	0x004	/* Reset clock counter */
+#define	PMU_RESET	CCNT_RESET | PMN_RESET
+#define	CLK_DIV		0x008	/* Clock divide enbable */
+
+#define	PMN3_OVERFLOW	0x10	/* Perfromance counter 0 overflow */
+#define PMN2_OVERFLOW	0x08	/* Performance counter 1 overflow */
+#define PMN1_OVERFLOW	0x04	/* Performance counter 1 overflow */
+#define PMN0_OVERFLOW	0x02	/* Performance counter 1 overflow */
+#define CCNT_OVERFLOW	0x01	/* Clock counter overflow */
+
+static irqreturn_t pmu_irq_handler(int, void *, struct pt_regs *);
+
+int pmu_claim(void)
+{
+	int err = 0;
+
+	if(atomic_read(&usage))
+		return -EBUSY;
+
+	err = request_irq(IRQ_PMU, pmu_irq_handler, SA_INTERRUPT,
+			  NULL, (void *) &results);
+	if(err < 0)
+	{
+		printk(KERN_ERR "unable to request IRQ %d for 80200 PMU: %d\n",
+		       IRQ_PMU, err);
+		return err;
+	}
+	
+	atomic_inc(&usage);
+	pmnc = 0;
+	pmu_reg_write(PMNC, pmnc);
+	return ++id;
+}
+
+int pmu_release(int claim_id)
+{
+	if(!atomic_read(&usage))
+		return 0;
+
+	if(claim_id != id)
+		return -EPERM;
+
+	free_irq(IRQ_PMU, (void *)&results);
+	atomic_dec(&usage);
+
+	return 0;
+}
+
+int pmu_start(u32 pmn0, u32 pmn1, u32 pmn2, u32 pmn3)
+{
+	memset(&results, 0, sizeof(results));
+
+	evtsel = (pmn3 <<24) | (pmn2 <<16) | (pmn1 <<8) | pmn0;
+
+	pmnc |= PMU_ENABLE | PMU_RESET;
+
+	pmu_reg_write(EVTSEL, evtsel);
+	/*	All interrupt are turned on.	*/
+	pmu_reg_write(INTEN, 0x1F);
+	pmu_reg_write(PMNC, pmnc);
+
+	return 0;
+}
+
+int pmu_stop(struct pmu_results *results)
+{
+	u32 ccnt;
+	u32 pmn0;
+	u32 pmn1;
+	u32 pmn2;
+	u32 pmn3;
+
+	if(!pmnc)
+		return -ENOSYS;
+
+	ccnt = pmu_reg_read(CCNT);
+	pmn0 = pmu_reg_read(PMN0);
+	pmn1 = pmu_reg_read(PMN1);
+	pmn2 = pmu_reg_read(PMN2);
+	pmn3 = pmu_reg_read(PMN3);
+
+	pmnc = 0;
+
+	pmu_reg_write(PMNC, pmnc);
+
+	results->ccnt = ccnt;
+	results->pmn0 = pmn0;
+	results->pmn1 = pmn1;
+	results->pmn2 = pmn2;
+	results->pmn3 = pmn3;
+
+	return 0;
+}
+
+static irqreturn_t pmu_irq_handler(int irq, void *dev_id, struct pt_regs *regs)
+{
+	struct pmu_results *results = (struct pmu_results *)dev_id;
+	unsigned int flag;
+
+	/* read the status */
+	flag = pmu_reg_read(FLAG);
+	pmnc = pmu_reg_read(PMNC);
+
+	if(pmnc & PMN0_OVERFLOW) {
+		results->pmn0_of++;
+	}
+
+	if(pmnc & PMN1_OVERFLOW) {
+		results->pmn1_of++;
+	}
+
+	if(pmnc & PMN2_OVERFLOW) {
+		results->pmn2_of++;
+	}
+
+	if(pmnc & PMN3_OVERFLOW) {
+		results->pmn3_of++;
+	}
+
+	if(pmnc & CCNT_OVERFLOW) {
+		results->ccnt_of++;
+	}
+
+	pmu_reg_write(FLAG, flag);
+	pmu_reg_write(PMNC, pmnc);
+
+	return IRQ_HANDLED;
+}
+
+EXPORT_SYMBOL(pmu_claim);
+EXPORT_SYMBOL(pmu_release);
+EXPORT_SYMBOL(pmu_start);
+EXPORT_SYMBOL(pmu_stop);
+
+
diff -uNr linux-2.6.17.org/arch/arm/mach-pxa/pxa27x.c linux-2.6.17/arch/arm/mach-pxa/pxa27x.c
--- linux-2.6.17.org/arch/arm/mach-pxa/pxa27x.c	2006-10-28 14:34:30.000000000 +0900
+++ linux-2.6.17/arch/arm/mach-pxa/pxa27x.c	2006-10-28 14:42:38.000000000 +0900
@@ -10,6 +10,8 @@
  * This program is free software; you can redistribute it and/or modify
  * it under the terms of the GNU General Public License version 2 as
  * published by the Free Software Foundation.
+ *
+ * Copyright (C) 2005-2006 WILLCOM, Inc. All rights Reserved.
  */
 #include <linux/config.h>
 #include <linux/module.h>
@@ -32,6 +34,7 @@
  * Get the clock frequency as reflected by CCSR and the turbo flag.
  * We assume these values have been applied via a fcs.
  * If info is not 0 we also display the current settings.
+ * special situation about 13M
  */
 unsigned int get_clk_frequency_khz( int info)
 {
@@ -41,6 +44,8 @@
 
 	ccsr = CCSR;
 	cccr_a = CCCR & (1 << 25);
+	if (ccsr & (1 << 31))
+		return 13000;
 
 	/* Read clkcfg register: it has turbo, b, half-turbo (and f) */
 	asm( "mrc\tp14, 0, %0, c6, c0, 0" : "=r" (clkcfg) );
@@ -75,6 +80,7 @@
 /*
  * Return the current mem clock frequency in units of 10kHz as
  * reflected by CCCR[A], B, and L
+ * in 13M, mem clock frequency is 13M
  */
 unsigned int get_memclk_frequency_10khz(void)
 {
@@ -84,6 +90,8 @@
 
 	ccsr = CCSR;
 	cccr_a = CCCR & (1 << 25);
+	if (ccsr & (1 << 31))
+		return 1300;
 
 	/* Read clkcfg register: it has turbo, b, half-turbo (and f) */
 	asm( "mrc\tp14, 0, %0, c6, c0, 0" : "=r" (clkcfg) );
@@ -100,6 +108,7 @@
 
 /*
  * Return the current LCD clock frequency in units of 10kHz as
+ * in 13M, LCD clock frequency is 13M or 26 M
  */
 unsigned int get_lcdclk_frequency_10khz(void)
 {
@@ -107,6 +116,8 @@
 	unsigned int l, L, k, K;
 
 	ccsr = CCSR;
+	if (ccsr & (1 << 31))
+		return (CCCR & (1 << 27))? 2600:1300;
 
 	l = ccsr & 0x1f;
 	k = (l <= 7) ? 1 : (l <= 16) ? 2 : 4;
@@ -141,11 +152,107 @@
 	extern void pxa_cpu_resume(void);
 
 	if (state == PM_SUSPEND_STANDBY)
-		CKEN = CKEN22_MEMC | CKEN9_OSTIMER | CKEN16_LCD |CKEN0_PWM0;
+#if defined(CONFIG_MACH_BLACKRIVER)
+	{
+		CKEN = CKEN22_MEMC
+		     | CKEN9_OSTIMER
+		     | CKEN16_LCD
+		     | CKEN0_PWM0
+		     | CKEN6_FFUART;
+		/* 
+		 *  PWER_GPIO   : PWR_SW
+		 *  PWER_RTC    : RTC
+		 *  PWER_GPIO35 : FFCTS
+		 *  PWER_GPIO53 : IRQ_OTHER
+		 *  PWER_GPIO38 : FFRI
+		 *  PWER_GPIO36 : FFDCD
+		 */
+		PWER = PWER_GPIO0
+		     | PWER_RTC
+#if 0
+		     | ((BR_STATUS & BR_STATUS_COMM_DETECT) ? PWER_GPIO53 : PWER_GPIO36)
+#else
+		     | PWER_GPIO53
+#endif
+		     | ((BR_BCR & BR_BCR_COMM_PWR_ON) ? PWER_GPIO35 : 0);
+		PFER = PFER_GPIO0
+		     | (GPLR(35) & GPIO_bit(35) ? PFER_GPIO35 : 0);
+		PRER = GPLR(35) & GPIO_bit(35) ? 0 : PFER_GPIO35;
+
+		/* Keypad Interrupt wake-up enable */
+		PKWR = PKWR_GPIO97 | PKWR_GPIO100 | PKWR_GPIO101| PKWR_GPIO102;
+	}
+	/* 20060804 Add Start */
+	else  if (state == PM_SUSPEND_MEM) {
+
+		/* PCFR & OSCC Set */
+		PCFR &= ~PCFR_L1_EN;	/* PCFR[L1_EN] Clear */
+		PCFR |= PCFR_DC_EN;	/* PCFR[DC_EN] Set */
+		PCFR |= PCFR_RO;
+		PCFR |= PCFR_PO;
+		PCFR |= PCFR_PI2CEN;
+		PCFR &= ~PCFR_FS;
+
+		/* PWER Bit Set */
+		PWER = PWER_RTC		/* PWER[RTC] Set */
+		     | PWER_GPIO53	/* PWER[GPIO53] Set */
+		     | PWER_GPIO0;	/* PWER[GPIO0] Set */
+
+		/* PKWR Bit Set */
+		PKWR = PKWR_GPIO97 | PKWR_GPIO100 | PKWR_GPIO101| PKWR_GPIO102;
+		/* PRER Bit Set */
+		PRER = GPLR(35) & GPIO_bit(35) ? 0 : PFER_GPIO35;
+
+		/* PRER Bit Set */
+		PFER = PFER_GPIO0
+		     | (GPLR(35) & GPIO_bit(35) ? PFER_GPIO35 : 0);
+
+		/* PGSRx Bit Set */
+		PGSR0 &= ~0x00408000;	/* PGSR0 Set nCS3 nCS1 */
+		PGSR0 |= 0x80000006;	/* PGSR0 Set RESET_DISABLE SYS_EN */
+		PGSR1 &= ~0x00000002;	/* PGSR1 Set nCS5 */
+		PGSR1 |= 0x00020000;	/* PGSR1 Set PWR- */
+		PGSR2 &= ~0x00014000;	/* PGSR2 Set nCS4 nCS2*/
+		PGSR3 |= 0x00001F81;	/* PGSR3 Set KeyMatrix */
+
+		PCFR &= ~(PCFR_FVC|PCFR_GPR_EN);
+		PCFR |= PCFR_GPROD;
+		PCFR |= PCFR_OPDE;	/* PCFR[OPDE] Set */
+		while ((OSCC & OSCC_OOK) == 0)
+			;
+		RCSR = RCSR & 0x0F;	/* Reset Status Clear */
+		CKEN = CKEN22_MEMC | CKEN9_OSTIMER | CKEN16_LCD | CKEN0_PWM0 | CKEN6_FFUART | CKEN19_KEYPAD;
+	/* 20060804 Add End */
+	}
+#elif defined(CONFIG_MACH_SANDGATEVP)
+	{
+		CKEN = CKEN22_MEMC
+		     | CKEN9_OSTIMER
+		     | CKEN16_LCD
+		     | CKEN0_PWM0;
+		/* 
+		 *  PWER_GPIO   : PWR_SW
+		 *  PWER_RTC    : RTC
+		 *  PWER_GPIO9  : Pointer
+		 */
+		PWER = PWER_GPIO0
+		     | PWER_GPIO9
+		     | PWER_RTC;
+		PFER = PFER_GPIO0
+		     | (GPLR(9)  & GPIO_bit(9)  ? PFER_GPIO(9)  : 0);
+		PRER = GPLR(9)  & GPIO_bit(9)  ? 0 : PFER_GPIO(9);
+
+		/* Keypad Interrupt wake-up enable */
+		PKWR = PKWR_GPIO97 | PKWR_GPIO100 | PKWR_GPIO101| PKWR_GPIO102;
+	}
+#else
+		CKEN = CKEN22_MEMC | CKEN9_OSTIMER | CKEN16_LCD | CKEN0_PWM0;
+#endif /* CONFIG_MACH_BLACKRIVER, CONFIG_MACH_SANDGATEVP */
 	else
 		CKEN = CKEN22_MEMC | CKEN9_OSTIMER;
 
 	/* ensure voltage-change sequencer not initiated, which hangs */
+	if(state == PM_SUSPEND_STANDBY)
 	PCFR &= ~PCFR_FVC;
 
 	/* Clear edge-detect status register. */
@@ -159,6 +266,7 @@
 		/* set resume return address */
 		PSPR = virt_to_phys(pxa_cpu_resume);
 		pxa_cpu_suspend(PWRMODE_SLEEP);
+		PSPR = 0;
 		break;
 	}
 }
diff -uNr linux-2.6.17.org/arch/arm/mach-pxa/sandgate2.c linux-2.6.17/arch/arm/mach-pxa/sandgate2.c
--- linux-2.6.17.org/arch/arm/mach-pxa/sandgate2.c	1970-01-01 09:00:00.000000000 +0900
+++ linux-2.6.17/arch/arm/mach-pxa/sandgate2.c	2006-10-28 14:42:38.000000000 +0900
@@ -0,0 +1,168 @@
+/*
+ *  linux/arch/arm/mach-pxa/sandgate2.c
+ *
+ *  Support for Sophia Systems Sandgate2 board.
+ *
+ *  Author:	Nicolas Pitre
+ *  Created:	Nov 05, 2002
+ *  Copyright:	MontaVista Software Inc.
+ *
+ *  Modified from linux/arch/arm/mach-pxa/mainstone.c
+ *  by Adam Ward (adam.ward@intel.com) in 2005
+ *
+ *  This program is free software; you can redistribute it and/or modify
+ *  it under the terms of the GNU General Public License version 2 as
+ *  published by the Free Software Foundation.
+ *
+ * Copyright (C) 2005-2006 WILLCOM, Inc. All rights Reserved.
+ */
+
+#include <linux/init.h>
+#include <linux/platform_device.h>
+#include <linux/interrupt.h>
+#include <linux/sched.h>
+#include <linux/bitops.h>
+#include <linux/fb.h>
+
+#include <asm/types.h>
+#include <asm/setup.h>
+#include <asm/memory.h>
+#include <asm/mach-types.h>
+#include <asm/hardware.h>
+#include <asm/irq.h>
+
+#include <asm/mach/arch.h>
+#include <asm/mach/map.h>
+#include <asm/mach/irq.h>
+
+#include <asm/arch/pxa-regs.h>
+#include <asm/arch/sandgate2.h>
+#include <asm/arch/pxafb.h>
+
+#include "generic.h"
+
+unsigned long sandgate2_bcr = 0x000003c0;
+
+static void __init sandgate2_init_irq(void)
+{
+	pxa_init_irq();
+
+	pxa_gpio_mode(10 | GPIO_IN);
+	set_irq_type(SANDGATE2_ETH_IRQ, IRQT_RISING);
+
+	pxa_gpio_mode(12 | GPIO_IN);
+	set_irq_type(SANDGATE2_CF_DETECT_IRQ, IRQT_BOTHEDGE);
+
+	pxa_gpio_mode(13 | GPIO_IN);
+	set_irq_type(SANDGATE2_AC97_IRQ, IRQT_RISING);
+
+	pxa_gpio_mode(22 | GPIO_IN);
+	set_irq_type(SANDGATE2_CF_IRQ, IRQT_RISING);
+}
+
+
+static struct resource smc91x_resources[] = {
+	[0] = {
+		.start	= (SG2_ETH_PHYS + 0x300),
+		.end	= (SG2_ETH_PHYS + 0xfffff),
+		.flags	= IORESOURCE_MEM,
+	},
+	[1] = {
+		.start	= SANDGATE2_ETH_IRQ,
+		.end	= SANDGATE2_ETH_IRQ,
+		.flags	= IORESOURCE_IRQ,
+	}
+};
+
+static struct platform_device smc91x_device = {
+	.name		= "smc91x",
+	.id		= 0,
+	.num_resources	= ARRAY_SIZE(smc91x_resources),
+	.resource	= smc91x_resources,
+};
+
+
+static void sandgate2_backlight_power(int on)
+{
+	if (on) {
+		sandgate2_bcr |= SG2_BCR_LCD_PWR_ON;
+		SG2_BCR = sandgate2_bcr;
+		
+		pxa_gpio_mode(GPIO16_PWM0_MD);
+		pxa_set_cken(CKEN0_PWM0, 1);
+		PWM_CTRL0 = 0;
+		PWM_PWDUTY0 = 0x3ff;
+		PWM_PERVAL0 = 0x3ff;
+	} else {
+		PWM_CTRL0 = 0;
+		PWM_PWDUTY0 = 0x0;
+		PWM_PERVAL0 = 0x3FF;
+		pxa_set_cken(CKEN0_PWM0, 0);
+
+		sandgate2_bcr &= ~SG2_BCR_LCD_PWR_ON;
+		SG2_BCR = sandgate2_bcr;		
+	}
+}
+
+static struct pxafb_mach_info toshiba_ltm04c380k __initdata = {
+	.pixclock		= 50000,
+	.xres			= 640,
+	.yres			= 480,
+	.bpp			= 16,
+	.hsync_len		= 1,
+	.left_margin		= 0x9f,
+	.right_margin		= 1,
+	.vsync_len		= 44,
+	.upper_margin		= 0,
+	.lower_margin		= 0,
+	.sync			= FB_SYNC_HOR_HIGH_ACT|FB_SYNC_VERT_HIGH_ACT,
+	.lccr0			= LCCR0_Act,
+	.lccr3			= LCCR3_PCP,
+	.pxafb_backlight_power	= sandgate2_backlight_power,
+};
+
+static void __init sandgate2_init(void)
+{
+	/* set up value expected from bootloader */
+	sandgate2_bcr = SG2_BCR_RS232ON; 
+  	/* system bus arbiter setting
+	 * - Core_Park
+	 * - LCD_wt:DMA_wt:CORE_Wt = 2:3:4
+	 */
+	ARB_CNTRL = ARB_CORE_PARK | 0x234;
+
+	platform_device_register(&smc91x_device);
+
+#ifdef CONFIG_FB_PXA_LCD_VGA
+		set_pxa_fb_info(&toshiba_ltm04c380k);
+#endif
+}
+
+
+static struct map_desc sandgate2_io_desc[] __initdata = {
+	{	/* CPLD */
+		.virtual	= SG2_FPGA_VIRT,
+		.pfn		= __phys_to_pfn(SG2_FPGA_PHYS),
+		.length		= 0x00100000,
+		.type		= MT_DEVICE
+	},
+};
+
+static void __init sandgate2_map_io(void)
+{
+	pxa_map_io();
+	iotable_init(sandgate2_io_desc, ARRAY_SIZE(sandgate2_io_desc));
+}
+
+MACHINE_START(SANDGATE2, "Sophia Systems Sandgate2 Development Platform")
+	/* Maintainer: Adam Ward */
+	.phys_ram	= 0xa0000000,
+	.phys_io	= 0x40000000,
+	.io_pg_offst	= (io_p2v(0x40000000) >> 18) & 0xfffc,
+	/* FIXME: BLOB boot parameter setting */
+	.boot_params	= 0xa0000100,
+	.map_io		= sandgate2_map_io,
+	.init_irq	= sandgate2_init_irq,
+	.timer		= &pxa_timer,
+	.init_machine	= sandgate2_init,
+MACHINE_END
diff -uNr linux-2.6.17.org/arch/arm/mach-pxa/sandgate2g.c linux-2.6.17/arch/arm/mach-pxa/sandgate2g.c
--- linux-2.6.17.org/arch/arm/mach-pxa/sandgate2g.c	1970-01-01 09:00:00.000000000 +0900
+++ linux-2.6.17/arch/arm/mach-pxa/sandgate2g.c	2006-10-28 14:42:38.000000000 +0900
@@ -0,0 +1,226 @@
+/*
+ *  linux/arch/arm/mach-pxa/sandgate2g.c
+ *
+ *  Support for Sophia Systems Sandgate2G board
+ *
+ *  Author:	Nicolas Pitre
+ *  Created:	Nov 05, 2002
+ *  Copyright:	MontaVista Software Inc.
+ *
+ *  modified from linux/arch/arm/mach-pxa/mainstone.c
+ *  by Adam Ward (adam.ward@intel.com) in 2005
+ *
+ *  This program is free software; you can redistribute it and/or modify
+ *  it under the terms of the GNU General Public License version 2 as
+ *  published by the Free Software Foundation.
+ *
+ * Copyright (C) 2005-2006 WILLCOM, Inc. All rights Reserved.
+ */
+
+#include <linux/init.h>
+#include <linux/platform_device.h>
+#include <linux/interrupt.h>
+#include <linux/sched.h>
+#include <linux/bitops.h>
+#include <linux/fb.h>
+
+#include <asm/types.h>
+#include <asm/setup.h>
+#include <asm/memory.h>
+#include <asm/mach-types.h>
+#include <asm/hardware.h>
+#include <asm/irq.h>
+
+#include <asm/mach/arch.h>
+#include <asm/mach/map.h>
+#include <asm/mach/irq.h>
+
+#include <asm/arch/pxa-regs.h>
+#include <asm/arch/sandgate2g.h>
+#include <asm/arch/pxafb.h>
+
+#include "generic.h"
+
+static unsigned long sandgate2g_irq_enabled;
+
+
+static void sandgate2g_mask_irq(unsigned int irq)
+{
+	int sandgate2g_irq = (irq - SANDGATE2G_IRQ(0));
+	sandgate2g_irq_enabled &= ~(1 << sandgate2g_irq);
+}
+
+
+static void sandgate2g_unmask_irq(unsigned int irq)
+{
+	int sandgate2g_irq = (irq - SANDGATE2G_IRQ(0));
+	/* the irq can be acknowledged only if deasserted, so it's done here */
+	SG2G_INTERRUPTS &= ~(1 << sandgate2g_irq);
+	sandgate2g_irq_enabled |= (1 << sandgate2g_irq);
+}
+
+
+static struct irqchip sandgate2g_irq_chip = {
+	.ack		= sandgate2g_mask_irq,
+	.mask		= sandgate2g_mask_irq,
+	.unmask		= sandgate2g_unmask_irq,
+};
+
+
+static void sandgate2g_irq_handler(unsigned int irq, struct irqdesc *desc,
+				  struct pt_regs *regs)
+{
+	unsigned long pending = SG2G_INTERRUPTS & sandgate2g_irq_enabled;
+
+        SG2G_INTERRUPTS = pending; //to clear unwanted ints masked out
+
+        do {
+	    GEDR(1) = GPIO_bit(1);  /* clear useless edge notification */
+	    if (likely(pending)) {
+		irq = SANDGATE2G_IRQ(0) + __ffs(pending);
+		desc = irq_desc + irq;
+		desc->handle(irq, desc, regs);
+	    }
+	    pending = SG2G_INTERRUPTS & sandgate2g_irq_enabled;
+	} while (pending);
+}
+
+
+static void __init sandgate2g_init_irq(void)
+{
+	int irq;
+
+	pxa_init_irq();
+
+	/* setup extra irqs */
+	for(irq = SANDGATE2G_IRQ(0); irq <= SANDGATE2G_IRQ(13); irq++) {
+		set_irq_chip(irq, &sandgate2g_irq_chip);
+		set_irq_handler(irq, do_level_IRQ);
+		set_irq_flags(irq, IRQF_VALID | IRQF_PROBE);
+	}
+
+	sandgate2g_irq_enabled = 0;
+        SG2G_INTERRUPTS = 0;
+
+	set_irq_chained_handler(IRQ_GPIO(1), sandgate2g_irq_handler);
+	set_irq_type(IRQ_GPIO(1), IRQT_FALLING);
+
+	pxa_gpio_mode(22 | GPIO_IN);
+	set_irq_type(SANDGATE2G_CF_IRQ, IRQT_FALLING);
+	
+	pxa_gpio_mode(10 | GPIO_IN);
+	set_irq_type(SANDGATE2G_ETH_IRQ, IRQT_RISING);
+	
+	pxa_gpio_mode(13 | GPIO_IN);
+	set_irq_type(SANDGATE2G_AC97_IRQ, IRQT_RISING);
+	
+	pxa_gpio_mode(12 | GPIO_IN);
+	set_irq_type(SANDGATE2G_2700G_IRQ, IRQT_FALLING);
+}
+
+
+static struct resource smc91x_resources[] = {
+	[0] = {
+		.start	= (SG2G_ETH_PHYS + 0x300),
+		.end	= (SG2G_ETH_PHYS + 0xfffff),
+		.flags	= IORESOURCE_MEM,
+	},
+	[1] = {
+		.start	= SANDGATE2G_ETH_IRQ,
+		.end	= SANDGATE2G_ETH_IRQ,
+		.flags	= IORESOURCE_IRQ,
+	}
+};
+
+static struct platform_device smc91x_device = {
+	.name		= "smc91x",
+	.id		= 0,
+	.num_resources	= ARRAY_SIZE(smc91x_resources),
+	.resource	= smc91x_resources,
+};
+
+
+static void sandgate2g_backlight_power(int on)
+{
+	if (on) {
+		/* LCD board LED on */
+		SG2G_2700G_REG(0x06C) = 1; /* 2700G GPIO0 - output, 3mA */
+		SG2G_2700G_REG(0x074) = 1; /* 2700G GPIO0 - drive low   */
+		/* 2700G backlight PWM */
+		SG2G_2700G_REG(0x0214) = 0x03ff; /* 2700G PWM0 duty    */
+		SG2G_2700G_REG(0x0218) = 0x03ff; /* 2700G PWM0 period  */
+	} else {
+		/* LCD board LED off   */
+		SG2G_2700G_REG(0x06C)  = 0; /* 2700G GPIO0 - input */
+		/* 2700G backlight PWM off */
+		SG2G_2700G_REG(0x0214) = 0; /* 2700G PWM0 duty    */
+	}
+}
+
+static struct pxafb_mach_info toshiba_ltm04c380k __initdata = {
+	.pixclock		= 50000,
+	.xres			= 640,
+	.yres			= 480,
+	.bpp			= 16,
+	.hsync_len		= 1,
+	.left_margin		= 0x9f,
+	.right_margin		= 1,
+	.vsync_len		= 44,
+	.upper_margin		= 0,
+	.lower_margin		= 0,
+	.sync			= FB_SYNC_HOR_HIGH_ACT|FB_SYNC_VERT_HIGH_ACT,
+	.lccr0			= LCCR0_Act,
+	.lccr3			= LCCR3_PCP,
+	.pxafb_backlight_power	= sandgate2g_backlight_power,
+};
+
+static void __init sandgate2g_init(void)
+{
+  	/* system bus arbiter setting
+	 * - Core_Park
+	 * - LCD_wt:DMA_wt:CORE_Wt = 2:3:4
+	 */
+	ARB_CNTRL = ARB_CORE_PARK | 0x234;
+
+	platform_device_register(&smc91x_device);
+
+#ifdef CONFIG_FB_PXA_LCD_VGA
+		set_pxa_fb_info(&toshiba_ltm04c380k);
+#endif
+}
+
+
+static struct map_desc sandgate2g_io_desc[] __initdata = {
+	{	/* CPLD */
+		.virtual	= SG2G_FPGA_VIRT,
+		.pfn		= __phys_to_pfn(SG2G_FPGA_PHYS),
+		.length		= 0x00100000,
+		.type		= MT_DEVICE
+	},
+	{	/* 2700G */
+		.virtual	= SG2G_2700G_VIRT,
+		.pfn		= __phys_to_pfn(SG2G_2700G_PHYS),
+		.length		= 0x04000000,
+		.type		= MT_DEVICE
+	}
+};
+
+static void __init sandgate2g_map_io(void)
+{
+	pxa_map_io();
+	iotable_init(sandgate2g_io_desc, ARRAY_SIZE(sandgate2g_io_desc));
+}
+
+MACHINE_START(SANDGATE2G, "Sophia Systems Sandgate2g Development Platform")
+	/* Maintainer: Adam Ward */
+	.phys_ram	= 0xa0000000,
+	.phys_io	= 0x40000000,
+	.io_pg_offst	= (io_p2v(0x40000000) >> 18) & 0xfffc,
+	/* FIXME: BLOB boot parameter setting */
+	.boot_params	= 0xa0000100,
+	.map_io		= sandgate2g_map_io,
+	.init_irq	= sandgate2g_init_irq,
+	.timer		= &pxa_timer,
+	.init_machine	= sandgate2g_init,
+MACHINE_END
+
diff -uNr linux-2.6.17.org/arch/arm/mach-pxa/sandgate2p.c linux-2.6.17/arch/arm/mach-pxa/sandgate2p.c
--- linux-2.6.17.org/arch/arm/mach-pxa/sandgate2p.c	1970-01-01 09:00:00.000000000 +0900
+++ linux-2.6.17/arch/arm/mach-pxa/sandgate2p.c	2006-10-28 14:42:38.000000000 +0900
@@ -0,0 +1,330 @@
+/*
+ *  linux/arch/arm/mach-pxa/sandgate2p.c
+ *
+ *  Support for Sophia Systems Sandgate2-p board.
+ *
+ *  Author:	Nicolas Pitre
+ *  Created:	Nov 05, 2002
+ *  Copyright:	MontaVista Software Inc.
+ *
+ *  Modified from linux/arch/arm/mach-pxa/mainstone.c
+ *  by Adam Ward (adam.ward@intel.com) in 2005
+ *
+ *  This program is free software; you can redistribute it and/or modify
+ *  it under the terms of the GNU General Public License version 2 as
+ *  published by the Free Software Foundation.
+ *
+ * Copyright (C) 2005-2006 WILLCOM, Inc. All rights Reserved.
+ */
+
+#include <linux/init.h>
+#include <linux/platform_device.h>
+#include <linux/interrupt.h>
+#include <linux/sched.h>
+#include <linux/bitops.h>
+#include <linux/fb.h>
+
+#include <asm/types.h>
+#include <asm/setup.h>
+#include <asm/memory.h>
+#include <asm/mach-types.h>
+#include <asm/hardware.h>
+#include <asm/irq.h>
+
+#include <asm/mach/arch.h>
+#include <asm/mach/map.h>
+#include <asm/mach/irq.h>
+
+#include <asm/arch/pxa-regs.h>
+#include <asm/arch/sandgate2p.h>
+#include <asm/arch/pxafb.h>
+
+#if defined(CONFIG_MMC_PXA) || defined(CONFIG_MMC_PXA_MODULE)
+#include <asm/arch/mmc.h>
+#endif
+
+#include "generic.h"
+#include <asm/arch/gpio-sandgate2p.h>
+#include <linux/delay.h>
+
+unsigned long sandgate2p_bcr = 0x00000000;
+EXPORT_SYMBOL(sandgate2p_bcr);
+
+const static u16 LS022XXXXXX_idata[][3] = {
+	/*  5 */ { 0x0007, 0x0101,  1 },
+	/*  6 */ { 0x0004, 0x0100,  0 },
+	/*  7 */
+	/*  8 */ { 0x0029, 0x0100,  0 },
+	/*  9 */ { 0x0026, 0x0106, 20 },
+	/* 10 */ { 0x0005, 0x0102,  0 },
+	/* 11 */ { 0x0006, 0x0130,  0 },
+	/* 12 */
+	/* 13 */ { 0x0020, 0x0101, 20 },
+	/* 14 */ { 0x0021, 0x0120, 20 },
+	/* 15 */ { 0x0021, 0x0130, 20 },
+	/* 16 */ { 0x0021, 0x0132, 20 },
+	/* 17 */ { 0x0021, 0x0133, 20 },
+	/* 18 */ { 0x0002, 0x0100, 20 },
+	/* 19 */ { 0x0001, 0x0131, 20 },
+	/* 20 */
+	/* 21 */ { 0x0001, 0x0130,  1 }
+};
+
+const static u16 LS022XXXXXX_edata[][3] = {
+	/*  2 */ { 0x0001, 0x0131,  0 },
+	/*  3 */ { 0x0003, 0x0100, 40 },
+	/*  4 */ { 0x0001, 0x0135, 20 },
+	/*  5 */ { 0x0021, 0x0122, 20 },
+	/*  6 */ { 0x0002, 0x0101, 20 },
+	/*  7 */ { 0x0021, 0x0100, 20 },
+	/*  8 */ { 0x0020, 0x0100, 20 }
+};
+
+static void __lcd_sdi(u16 data)
+{
+	int i;
+	u16 bits;
+
+	for (i = 16; i > 0; i--) {
+		bits = (data >> (i - 1)) & 1;
+		SG2P_BCR &= ~SG2P_BCR_LCD_SCLK;
+		if (bits)
+			SG2P_BCR |= SG2P_BCR_LCD_SDI;
+		else
+			SG2P_BCR &= ~SG2P_BCR_LCD_SDI;
+		SG2P_BCR |= SG2P_BCR_LCD_SCLK;
+	}
+	SG2P_BCR &= ~(SG2P_BCR_LCD_SCLK | SG2P_BCR_LCD_SDI);
+}
+
+static void lcd_sdi(u16 comm, u16 data, u16 mdelay)
+{
+	__lcd_sdi(comm);
+	__lcd_sdi(data);
+	if (mdelay > 0)
+		mdelay(mdelay);
+}
+
+static void __init sandgate2p_init_irq(void)
+{
+	pxa_init_irq();
+
+	pxa_gpio_mode(GPIO_52_LAN_IRQ | GPIO_IN);
+	set_irq_type(SANDGATE2P_ETH_IRQ, IRQT_RISING);
+
+	/* 
+	 * setup detect gpio irq
+	 */
+	pxa_gpio_mode(GPIO_53_IRQ_OTHER | GPIO_IN);
+	set_irq_type(SANDGATE2P_DETECT_IRQ, IRQT_FALLING);
+	enable_irq(SANDGATE2P_DETECT_IRQ);
+}
+
+static struct resource smc91x_resources[] = {
+	[0] = {
+		.start	= (SG2P_ETH_PHYS + 0x300),
+		.end	= (SG2P_ETH_PHYS + 0xfffff),
+		.flags	= IORESOURCE_MEM,
+	},
+	[1] = {
+		.start	= SANDGATE2P_ETH_IRQ,
+		.end	= SANDGATE2P_ETH_IRQ,
+		.flags	= IORESOURCE_IRQ,
+	}
+};
+
+static struct platform_device smc91x_device = {
+	.name		= "smc91x",
+	.id		= 0,
+	.num_resources	= ARRAY_SIZE(smc91x_resources),
+	.resource	= smc91x_resources,
+};
+
+static void sandgate2p_backlight_power(int on)
+{
+	int i;
+	int sz = sizeof(LS022XXXXXX_idata) / (3 * sizeof(u16));
+
+	if (on) {
+		sandgate2p_bcr |= SG2P_BCR_LCD1_RESETn;
+		SG2P_BCR = sandgate2p_bcr;
+
+		pxa_gpio_mode(GPIO16_PWM0_MD);
+		pxa_set_cken(CKEN0_PWM0, 1);
+		PWM_CTRL0 = 0;
+		PWM_PWDUTY0 = 0x3ff;
+		PWM_PERVAL0 = 0x3ff;
+
+		sz = sizeof(LS022XXXXXX_idata) / (3 * sizeof(u16));
+		// Enable chip select
+		SG2P_BCR |= SG2P_BCR_LCD_SCS;
+		/* No. 4 */
+		//mdelay(1);
+		/* No. 5-21 */
+		for (i = 0; i < sz; i++) {
+			lcd_sdi(LS022XXXXXX_idata[i][0],
+			   LS022XXXXXX_idata[i][1],
+			   LS022XXXXXX_idata[i][2]);
+		}
+		// Disable chip select
+		SG2P_BCR &= ~SG2P_BCR_LCD_SCS;
+
+		sandgate2p_bcr |= SG2P_BCR_LCD1_PWR_ON;
+		SG2P_BCR = sandgate2p_bcr;
+	} else {
+		sandgate2p_bcr &= ~SG2P_BCR_LCD1_PWR_ON;
+		SG2P_BCR = sandgate2p_bcr;		
+
+		sz = sizeof(LS022XXXXXX_edata) / (3 * sizeof(u16));
+		// Enable chip select
+		SG2P_BCR |= SG2P_BCR_LCD_SCS;
+		/* No. 2-8 */
+		for (i = 0; i < sz; i++) {
+			lcd_sdi(LS022XXXXXX_edata[i][0],
+			   LS022XXXXXX_edata[i][1],
+			   LS022XXXXXX_edata[i][2]);
+		}
+		// Disable chip select
+		SG2P_BCR &= ~SG2P_BCR_LCD_SCS;
+
+		PWM_CTRL0 = 0;
+		PWM_PWDUTY0 = 0x0;
+		PWM_PERVAL0 = 0x3FF;
+		pxa_set_cken(CKEN0_PWM0, 0);
+
+		sandgate2p_bcr &= ~SG2P_BCR_LCD1_RESETn;
+		SG2P_BCR = sandgate2p_bcr;
+	}
+}
+
+static struct pxafb_mach_info sharp_ls022xxxxx __initdata = {
+	.pixclock		= 50000,
+	.bpp			= 16,
+	.xres			= 240,
+	.hsync_len		= 4,
+	.left_margin		= 0x2c,
+	.right_margin		= 1,
+	.yres			= 320,
+	.vsync_len		= 2,
+	.upper_margin		= 0,
+	.lower_margin		= 0,
+	.lccr0			= LCCR0_Act,
+	.pxafb_backlight_power	= sandgate2p_backlight_power,
+};
+
+#if defined(CONFIG_MMC_PXA) || defined(CONFIG_MMC_PXA_MODULE)
+static int sandgate2p_mci_init(struct device *dev, irqreturn_t (*sandgate2p_detect_int)(int, void *, struct pt_regs *), void *data)
+{
+	int err;
+
+	/*
+	 * setup GPIO for PXA27x MMC controller
+	 */
+	pxa_gpio_mode(GPIO32_MMCCLK_MD);
+	pxa_gpio_mode(GPIO112_MMCCMD_MD);
+	pxa_gpio_mode(GPIO92_MMCDAT0_MD);
+	pxa_gpio_mode(GPIO109_MMCDAT1_MD);
+	pxa_gpio_mode(GPIO110_MMCDAT2_MD);
+	pxa_gpio_mode(GPIO111_MMCDAT3_MD);
+
+	/* 
+	 * setup mmc detect interrupt
+	 */
+	err = request_irq(SANDGATE2P_SD_IN_IRQ,
+			  sandgate2p_detect_int,
+			  SA_INTERRUPT,
+			  "MMC card detect in",
+			  data);
+	if (err) {
+		printk(KERN_ERR "%s: MMC/SD: can't request MMC card detect in IRQ(%d)\n", __FUNCTION__, SANDGATE2P_SD_IN_IRQ);
+		return -1;
+	}
+	err = request_irq(SANDGATE2P_SD_OUT_IRQ,
+			  sandgate2p_detect_int,
+			  SA_INTERRUPT,
+			  "MMC card detect out",
+			  data);
+	if (err) {
+		printk(KERN_ERR "%s: MMC/SD: can't request MMC card detect out IRQ(%d)\n", __FUNCTION__, SANDGATE2P_SD_OUT_IRQ);
+		return -1;
+	}
+
+	return 0;
+}
+
+static void sandgate2p_mci_setpower(struct device *dev, unsigned int vdd)
+{
+	struct pxamci_platform_data* p_d = dev->platform_data;
+
+	if (( 1 << vdd) & p_d->ocr_mask) {
+		sandgate2p_bcr |= SG2P_BCR_SD_PWR_ON;
+		SG2P_BCR = sandgate2p_bcr;
+	} else {
+		sandgate2p_bcr &= ~SG2P_BCR_SD_PWR_ON;
+		SG2P_BCR = sandgate2p_bcr;
+	}
+}
+
+static void sandgate2p_mci_exit(struct device *dev, void *data)
+{
+	/*
+	 * MMC Detect Interrupt is free.
+	 */
+	free_irq(SANDGATE2P_SD_IN_IRQ, data);
+	free_irq(SANDGATE2P_SD_OUT_IRQ, data);
+}
+
+static struct pxamci_platform_data sandgate2p_mci_platform_data = {
+	.ocr_mask	= MMC_VDD_32_33|MMC_VDD_33_34,
+	.init 		= sandgate2p_mci_init,
+	.setpower 	= sandgate2p_mci_setpower,
+	.exit		= sandgate2p_mci_exit,
+};
+#endif
+
+static void __init sandgate2p_init(void)
+{
+  	/* system bus arbiter setting
+	 * - Core_Park
+	 * - LCD_wt:DMA_wt:CORE_Wt = 2:3:4
+	 */
+	ARB_CNTRL = ARB_CORE_PARK | 0x234;
+
+	platform_device_register(&smc91x_device);
+
+#ifdef CONFIG_FB_PXA_LCD_QVGA
+	set_pxa_fb_info(&sharp_ls022xxxxx);
+#endif
+
+#if defined(CONFIG_MMC_PXA) || defined(CONFIG_MMC_PXA_MODULE)
+	pxa_set_mci_info(&sandgate2p_mci_platform_data);
+#endif
+}
+
+static struct map_desc sandgate2p_io_desc[] __initdata = {
+	{	/* CPLD */
+		.virtual	= SG2P_FPGA_VIRT,
+		.pfn		= __phys_to_pfn(SG2P_FPGA_PHYS),
+		.length		= 0x00100000,
+		.type		= MT_DEVICE
+	}
+};
+
+static void __init sandgate2p_map_io(void)
+{
+	pxa_map_io();
+	iotable_init(sandgate2p_io_desc, ARRAY_SIZE(sandgate2p_io_desc));
+}
+
+MACHINE_START(SANDGATE2P, "Sophia Systems Sandgate2-P Development Platform")
+	/* Maintainer: Adam Ward */
+	.phys_ram	= 0xa0000000,
+	.phys_io	= 0x40000000,
+	.io_pg_offst	= (io_p2v(0x40000000) >> 18) & 0xfffc,
+	/* FIXME: BLOB boot parameter setting */
+	.boot_params	= 0xa0000100,
+	.map_io		= sandgate2p_map_io,
+	.init_irq	= sandgate2p_init_irq,
+	.timer		= &pxa_timer,
+	.init_machine	= sandgate2p_init,
+MACHINE_END
diff -uNr linux-2.6.17.org/arch/arm/mach-pxa/sandgate-vp.c linux-2.6.17/arch/arm/mach-pxa/sandgate-vp.c
--- linux-2.6.17.org/arch/arm/mach-pxa/sandgate-vp.c	1970-01-01 09:00:00.000000000 +0900
+++ linux-2.6.17/arch/arm/mach-pxa/sandgate-vp.c	2006-10-28 14:42:38.000000000 +0900
@@ -0,0 +1,1446 @@
+/*
+ *  linux/arch/arm/mach-pxa/sandgate-vp.c
+ *
+ *  Support for Sophia Systems Sandgate-VP board.
+ *
+ *  Author:	Nicolas Pitre
+ *  Created:	Nov 05, 2002
+ *  Copyright:	MontaVista Software Inc.
+ *
+ *  Modified from linux/arch/arm/mach-pxa/mainstone.c
+ *  by Adam Ward (adam.ward@intel.com) in 2005
+ *
+ *  This program is free software; you can redistribute it and/or modify
+ *  it under the terms of the GNU General Public License version 2 as
+ *  published by the Free Software Foundation.
+ *
+ * Copyright (c) 2006 Sophia Systems Co.,Ltd.
+ */
+
+#include <linux/init.h>
+#include <linux/platform_device.h>
+#include <linux/interrupt.h>
+#include <linux/sched.h>
+#include <linux/bitops.h>
+#include <linux/fb.h>
+#include <linux/input.h>
+
+#include <asm/types.h>
+#include <asm/setup.h>
+#include <asm/memory.h>
+#include <asm/mach-types.h>
+#include <asm/hardware.h>
+#include <asm/irq.h>
+
+#include <asm/mach/arch.h>
+#include <asm/mach/map.h>
+#include <asm/mach/irq.h>
+
+#include <asm/arch/bitfield.h>
+#include <asm/arch/pxa-regs.h>
+#include <asm/arch/sandgate-vp.h>
+#include <asm/arch/pxafb.h>
+
+#if defined(CONFIG_MMC_PXA) || defined(CONFIG_MMC_PXA_MODULE)
+#include <asm/arch/mmc.h>
+#endif /* CONFIG_MMC_PXA || CONFIG_MMC_PXA_MODULE */
+
+#include <asm/arch/irda.h>
+
+#include "generic.h"
+#include <asm/arch/gpio-sandgate-vp.h>
+#include <asm/arch/i2c-pxa.h>
+#include <linux/delay.h>
+
+/*
+ * CPU depend
+ */
+static void __enter_deep_sleep(void)
+{
+	/* for deep-sleep */
+	PSLR |= (1 << 22);	/* Ignore nVDD_FAULT */
+	RCSR = RCSR & (RCSR_GPR | RCSR_SMR | RCSR_WDR | RCSR_HWR);
+
+	asm volatile (
+		"	mcr	p14, 0, %0, c7, c0, 0\n"
+		"	nop\n"
+		"	nop\n"
+		"	nop\n"
+		"	nop\n"
+		"	nop\n"
+		"	nop\n"
+		"	nop\n"
+		"	nop\n"
+		"	nop\n"
+		"	nop\n"
+		"	b	.\n"
+		: : "r" (PWRMODE_DEEPSLEEP));
+}
+
+static inline void sandgate_vp_mdelay(int ndelay)
+{
+	mdelay(ndelay + 0);
+}
+
+/*
+ * LCD
+ */
+const static u16 LS022XXXXXX_idata[][3] = {
+	/*  5 */ { 0x0007, 0x0101,  1 },
+	/*  6 */ { 0x0004, 0x0100,  0 },
+	/*  7 */
+	/*  8 */ { 0x0029, 0x0100,  0 },
+	/*  9 */ { 0x0026, 0x0106, 20 },
+	/* 10 */ { 0x0005, 0x0102,  0 },
+	/* 11 */ { 0x0006, 0x0130,  0 },
+	/* 12 */
+	/* 13 */ { 0x0020, 0x0101, 20 },
+	/* 14 */ { 0x0021, 0x0120, 20 },
+	/* 15 */ { 0x0021, 0x0130, 20 },
+	/* 16 */ { 0x0021, 0x0132, 20 },
+	/* 17 */ { 0x0021, 0x0133, 20 },
+	/* 18 */ { 0x0002, 0x0100, 20 },
+	/* 19 */ { 0x0001, 0x0131, 20 },
+	/* 20 */
+	/* 21 */ { 0x0001, 0x0130,  1 }
+};
+
+const static u16 LS022XXXXXX_edata[][3] = {
+	/*  2 */ { 0x0001, 0x0131,  0 },
+	/*  3 */ { 0x0003, 0x0100, 40 },
+	/*  4 */ { 0x0001, 0x0135, 20 },
+	/*  5 */ { 0x0021, 0x0122, 20 },
+	/*  6 */ { 0x0002, 0x0101, 20 },
+	/*  7 */ { 0x0021, 0x0100, 20 },
+	/*  8 */ { 0x0020, 0x0100, 20 }
+};
+
+static void __lcd_sdi(u16 data)
+{
+	int i;
+	u16 bits;
+
+	// ### SGVP use GPIO ###
+
+	// GPIO_95_LCD_CS <- BR_BCR_LCD_SCS
+	// GPIO_99_SCLK <- BR_BCR_LCD_SCLK
+	// GPIO_36_SDI <- BR_BCR_LCD_SDI
+
+	GPSR(GPIO_95_LCD_CS) |= GPIO_bit(GPIO_95_LCD_CS);	// data output to Pin-Output Set Registers
+
+	for (i = 16; i > 0; i--) {
+		bits = (data >> (i - 1)) & 1;
+		GPCR(GPIO_99_SCLK) |= GPIO_bit(GPIO_99_SCLK);		// OFF
+		if (bits){
+			GPSR(GPIO_36_SDI) |= GPIO_bit(GPIO_36_SDI);		// ON
+		}
+		else{
+			GPCR(GPIO_36_SDI) |= GPIO_bit(GPIO_36_SDI);		// OFF
+		}
+		GPSR(GPIO_99_SCLK) |= GPIO_bit(GPIO_99_SCLK);
+	}
+	GPCR(GPIO_36_SDI) |= GPIO_bit(GPIO_36_SDI);
+	GPCR(GPIO_99_SCLK) |= GPIO_bit(GPIO_99_SCLK);
+	GPCR(GPIO_95_LCD_CS) |= GPIO_bit(GPIO_95_LCD_CS);
+
+}
+
+static void lcd_sdi(u16 comm, u16 data, u16 mdelay)
+{
+	unsigned long	flags;
+
+	local_irq_save(flags);
+	__lcd_sdi(comm);
+	__lcd_sdi(data);
+	local_irq_restore(flags);
+	if (mdelay > 0)
+		sandgate_vp_mdelay(mdelay);
+}
+
+static u16 __lcd_sdo(u16 data)
+{
+	int	i;
+	u16	bits;
+	u16	ret;
+
+	// ### SGVP use GPIO ###
+
+	// GPIO_95_LCD_CS <- BR_BCR_LCD_SCS
+	// GPIO_99_SCLK <- BR_BCR_LCD_SCLK
+	// GPIO_36_SDI <- BR_BCR_LCD_SDI
+	// GPIO_77_SDO <- BR_BCR_LCD_SDO
+
+	GPSR(GPIO_95_LCD_CS) |= GPIO_bit(GPIO_95_LCD_CS);	// data output to Pin-Output Set Registers
+
+	for (i = 16; i > 0; i--) {
+		bits = (data >> (i - 1)) & 1;
+		GPCR(GPIO_99_SCLK) |= GPIO_bit(GPIO_99_SCLK);		// OFF
+		if (bits){
+			GPSR(GPIO_36_SDI) |= GPIO_bit(GPIO_36_SDI);		// ON
+		}
+		else{
+			GPCR(GPIO_36_SDI) |= GPIO_bit(GPIO_36_SDI);		// OFF
+		}
+		GPSR(GPIO_99_SCLK) |= GPIO_bit(GPIO_99_SCLK);		// ON
+	}
+	GRER(GPIO_77_SDO) |= GPIO_bit(GPIO_77_SDO);				// as level
+	for (ret = 0; i > 0; i--) {
+		ret <<= 1;
+		GPCR(GPIO_99_SCLK) |= GPIO_bit(GPIO_99_SCLK);		// OFF
+		ret |= (GPLR(GPIO_77_SDO) & GPIO_bit(GPIO_77_SDO)) ? 1 : 0;
+		GPSR(GPIO_99_SCLK) |= GPIO_bit(GPIO_99_SCLK);		// ON
+	}
+
+	GPCR(GPIO_36_SDI) |= GPIO_bit(GPIO_36_SDI);
+	GPCR(GPIO_99_SCLK) |= GPIO_bit(GPIO_99_SCLK);
+	GPCR(GPIO_95_LCD_CS) |= GPIO_bit(GPIO_95_LCD_CS);
+
+	return ret;
+}
+
+static u16 lcd_sdo(u16 comm, u16 data)
+{
+	u16	ret;
+	unsigned long	flags;
+
+	local_irq_save(flags);
+	__lcd_sdi(comm);
+	ret = __lcd_sdo(data);
+	local_irq_restore(flags);
+
+	return ret;
+}
+
+#ifdef CONFIG_PRINTK
+#define	LCD_DEBUG
+#endif /* CONFIG_PRINTK */
+
+static int	sandgate_vp_backlight_power_on_req;
+static int	sandgate_vp_backlight_power_on_ng;
+static int	sandgate_vp_backlight_power_off_req;
+
+#ifdef LCD_DEBUG
+const static u16 LS022XXXXXX_regs[][2] = {
+	{ 0x0000, 0x2000 },
+	{ 0x0001, 0x2000 },
+	{ 0x0002, 0x2000 },
+	{ 0x0003, 0x2000 },
+	{ 0x0004, 0x2000 },
+	{ 0x0005, 0x2000 },
+	{ 0x0006, 0x2000 },
+	{ 0x0007, 0x2000 },
+	{ 0x0008, 0x2000 },
+	{ 0x0009, 0x2000 },
+	{ 0x000a, 0x2000 },
+	{ 0x000b, 0x2000 },
+	{ 0x000c, 0x2000 },
+	{ 0x000d, 0x2000 },
+	{ 0x000e, 0x2000 },
+	{ 0x000f, 0x2000 },
+	{ 0x001e, 0x2000 },
+	{ 0x0020, 0x2000 },
+	{ 0x0021, 0x2000 },
+	{ 0x0022, 0x2000 },
+	{ 0x0026, 0x2000 },
+	{ 0x0029, 0x2000 },
+};
+
+static void sandgate_vp_backlight_power_dump(void)
+{
+	u16	reg;
+	int	i;
+	int	sz;
+
+	sz = sizeof(LS022XXXXXX_regs) / (2 * sizeof(u16));
+	for (i = 0; i < sz; i++) {
+		reg = lcd_sdo(LS022XXXXXX_regs[i][0],
+		   LS022XXXXXX_regs[i][1]);
+		printk("[%s:%d] %04x %04x %04x\n",
+		    __FUNCTION__,
+		    __LINE__,
+		    LS022XXXXXX_regs[i][0],
+		    LS022XXXXXX_regs[i][1],
+		    reg);
+	}
+
+	printk("[%s:%d] %d/%d/%d\n",
+	    __FUNCTION__, __LINE__,
+	    sandgate_vp_backlight_power_on_ng,
+	    sandgate_vp_backlight_power_on_req,
+	    sandgate_vp_backlight_power_off_req);
+}
+#else
+static inline void sandgate_vp_backlight_power_dump(void) {}
+#endif /* LCD_DEBUG */
+
+static unsigned long	pwm_pwduty0 = 0x3ff;
+
+static void sandgate_vp_backlight_power_off(void)
+{
+	int	i;
+	int	sz;
+
+	/* No. 1: back light off */
+	PWM_CTRL0 = 0;
+	PWM_PWDUTY0 = 0x0;
+	PWM_PERVAL0 = 0x3FF;
+	pxa_set_cken(CKEN0_PWM0, 0);
+
+	sz = sizeof(LS022XXXXXX_edata) / (3 * sizeof(u16));
+	/* No. 2-8 */
+	for (i = 0; i < sz; i++) {
+		lcd_sdi(LS022XXXXXX_edata[i][0],
+		   LS022XXXXXX_edata[i][1],
+		   LS022XXXXXX_edata[i][2]);
+	}
+
+	// ### SGVP use GPIO ###
+	/* No. 9: logic initial */
+	GPCR(GPIO_95_LCD_CS) |= GPIO_bit(GPIO_95_LCD_CS);		// data output to Pin-Output Clear Registers
+	GPCR(GPIO_99_SCLK) |= GPIO_bit(GPIO_99_SCLK);			// data output to Pin-Output Clear Registers
+	GPCR(GPIO_36_SDI) |= GPIO_bit(GPIO_36_SDI);				// data output to Pin-Output Clear Registers
+
+	/* No. 10: Reset H -> L */
+	GPCR(GPIO_98_LCD_RESET) |= GPIO_bit(GPIO_98_LCD_RESET);	// data output to Pin-Output Clear Registers
+
+	/* No. 11: VCC off */
+	GPCR(GPIO_16_PWM0) |= GPIO_bit(GPIO_16_PWM0);			// data output to Pin-Output Clear Registers
+
+}
+
+static void sandgate_vp_backlight_power_on(void)
+{
+	int	i;
+	int	sz;
+	u16	reg, val;
+
+	sandgate_vp_backlight_power_on_req++;
+	// ### SGVP use GPIO ###
+	/* No. 1: Reset H -> L */
+	GPCR(GPIO_98_LCD_RESET) |= GPIO_bit(GPIO_98_LCD_RESET);	// data output to Pin-Output Clear Registers
+	/* No. 2: logic initial */
+	GPCR(GPIO_95_LCD_CS) |= GPIO_bit(GPIO_95_LCD_CS);		// data output to Pin-Output Clear Registers
+	GPCR(GPIO_99_SCLK) |= GPIO_bit(GPIO_99_SCLK);			// data output to Pin-Output Clear Registers
+	GPCR(GPIO_36_SDI) |= GPIO_bit(GPIO_36_SDI);				// data output to Pin-Output Clear Registers
+	/* No. 3: VCC on */
+	GPSR(GPIO_16_PWM0) |= GPIO_bit(GPIO_16_PWM0);			// data output to Pin-Output Set Registers
+	sandgate_vp_mdelay(10);
+	/* No. 4: Reset L -> H */
+	GPSR(GPIO_98_LCD_RESET) |= GPIO_bit(GPIO_98_LCD_RESET);	// data output to Pin-Output Set Registers
+	sandgate_vp_mdelay(1);
+
+	/* No. 5-21 */
+	sz = sizeof(LS022XXXXXX_idata) / (3 * sizeof(u16));
+	for (i = 0; i < sz; i++) {
+		reg = LS022XXXXXX_idata[i][0];
+		lcd_sdi(reg,
+		   LS022XXXXXX_idata[i][1],
+		   LS022XXXXXX_idata[i][2]);
+		if (reg == 0x0026) {
+			val = lcd_sdo(reg, 0x2000);
+			if (val != 0) {
+				printk(KERN_ALERT "[%s:%d] %04x %04x\n",
+				     __FUNCTION__, __LINE__, reg, val);
+
+				sandgate_vp_backlight_power_on_ng++;
+				sandgate_vp_backlight_power_dump();
+				return;
+			}
+		}
+	}
+
+	sandgate_vp_mdelay(1);
+
+	/* No. 22: back light on */
+	pxa_gpio_mode(GPIO16_PWM0_MD);
+	pxa_set_cken(CKEN0_PWM0, 1);
+	PWM_CTRL0 = 0;
+	PWM_PWDUTY0 = pwm_pwduty0;
+	PWM_PERVAL0 = 0x3ff;
+}
+
+static void sandgate_vp_backlight_power(int on)
+{
+	if (on) {
+		sandgate_vp_backlight_power_on();
+	} else {
+		sandgate_vp_backlight_power_off();
+	}
+}
+
+
+static int sandgate_vp_set_dury(int val)
+{
+	if (val < 0 || val > 0x400)
+		return -EINVAL;
+
+	pwm_pwduty0 = val;
+	PWM_PWDUTY0 = pwm_pwduty0;
+
+	return 0;
+}
+
+static int sandgate_vp_get_dury(void)
+{
+	return pwm_pwduty0;
+}
