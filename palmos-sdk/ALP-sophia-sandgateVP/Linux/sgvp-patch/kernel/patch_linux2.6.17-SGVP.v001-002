+# it under the terms of the GNU General Public License version 2 as
+# published by the Free Software Foundation.
+#
 # Prompt user for primary drivers.
 
 config SOUND_BT878
@@ -841,3 +847,22 @@
 	int "    DAC channel"
 	default "1"
 	depends on SOUND_SH_DAC_AUDIO
