+
+#define	_SDCS_OFFSET		(64 * 1024 * 1024)
+#define	SDCS0			PHYS_OFFSET
+#define	SDCS1			(SDCS0 + _SDCS_OFFSET)
+#define	SDCS2			(SDCS1 + _SDCS_OFFSET)
+#define	SDCS3			(SDCS2 + _SDCS_OFFSET)
+
+#define	MEM_SIZE	(64 * 1024 * 1024)
+
+#ifndef __ASSEMBLY__
+extern struct input_dev *pointer_dev;	/* Input Device Pointer */
+extern unsigned int pointMoved_flag;	/* Input Device Pointer Flag */
+#endif
+
+/* SANDGATE-VP  IMR (Interrupt Mask Register) */
+#define SGVP_IMR		__SGVP_REG((SGVP_FPGA_PHYS + 0x00000008))
+#define SGVP_IMR_INT_MASK0	0x00000001
+#define SGVP_IMR_INT_MASK1	0x00000002
+#define SGVP_IMR_INT_MASK2	0x00000004
+#define SGVP_IMR_INT_MASK3	0x00000008
+#define SGVP_IMR_INT_MASK4	0x00000010
+#define SGVP_IMR_INT_MASK5	0x00000020
+#define SGVP_IMR_INT_MASK6	0x00000040
+#define SGVP_IMR_INT_MASK7	0x00000080
+
+/* SANDGATE-VP  ISR (Interrupt Status/Clear Register) */
+#define SGVP_ISR		__SGVP_REG((SGVP_FPGA_PHYS + 0x0000000c))
+#define SGVP_ISR_SD_IN_INT	0x00000001
+#define SGVP_ISR_SD_OUT_INT	0x00000002
+#define SGVP_ISR_CF_IN_INT	0x00000004
+#define SGVP_ISR_CF_OUT_INT	0x00000008
+#define SGVP_ISR_USB_IN_INT	0x00000010
+#define SGVP_ISR_USB_OUT_INT	0x00000020
+#define SGVP_ISR_LCD_IN_INT	0x00000040
+#define SGVP_ISR_LCD_OUT_INT	0x00000080
+
+/* SANDGATE-VP  DSP_IRR (DSP Interrupt Request Register) */
+#define SGVP_DSP_IRR		__SGVP_REG((SGVP_FPGA_PHYS + 0x00000010))
+#define SGVP_DSP_IRR_INT1	0x00000001
+#define SGVP_DSP_IRR_INT2	0x00000002
+
+/* SANDGATE-VP  IOCR (I/O Control Register) */
+#define SGVP_IOCR		__SGVP_REG((SGVP_FPGA_PHYS + 0x00000014))
+#define SGVP_IOCR_DBG_OUT0	0x00000001
+#define SGVP_IOCR_DBG_OUT1	0x00000002
