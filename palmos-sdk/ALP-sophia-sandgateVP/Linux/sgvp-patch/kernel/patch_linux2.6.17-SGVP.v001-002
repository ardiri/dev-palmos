 /* the following tables allow us to go from OSS <-> ac97 quickly. */
@@ -375,6 +415,9 @@
 	u16 val = 0;
 	int scale;
 	struct ac97_mixer_hw *mh = &ac97_hw[oss_channel];
+#ifdef CONFIG_MACH_SANDGATEVP
+	unsigned int reg;
+#endif
 
 #ifdef DEBUG
 	printk("ac97_codec: wrote OSS mixer %2d (%s ac97 register 0x%02x), "
@@ -443,20 +486,110 @@
 			left = mh->scale-1;
 		val = left;
 	} else if (oss_channel == SOUND_MIXER_MIC) {
+#ifdef CONFIG_MACH_SANDGATEVP
+		val = codec->codec_read(codec , mh->offset) & ~0x803f;
+		left = (left * mh->scale) / 100;
+#else
 		val = codec->codec_read(codec , mh->offset) & ~0x801f;
 		left = ((100 - left) * mh->scale) / 100;
+#endif
 		if (left >= mh->scale)
 			left = mh->scale-1;
+#if !defined(CONFIG_MACH_SANDGATE2P) && !defined(CONFIG_MACH_SANDGATEVP)
 		val |= left;
+#else
+		val |= left | MGAIN;
+#endif
 		/*  the low bit is optional in the tone sliders and masking
 		    it lets us avoid the 0xf 'bypass'.. */
 	}
+
 #ifdef DEBUG
-	printk(" 0x%04x", val);
+	printk(" 0x%04x -> \n", val);
+#endif
+
+#ifdef CONFIG_MACH_SANDGATEVP
+	/* Power on */
+	if (val != AC97_MUTE) {
+		switch(oss_channel) {
+		case SOUND_MIXER_VOLUME:
+			reg = codec->codec_read(codec, AK4650_POWER_MANAGEMENT);
+			if (!(reg & PMSPK)) {
+				reg |= PMSPK;
+				codec->codec_write(codec, AK4650_POWER_MANAGEMENT, reg);
+			}
+			break;
+		case SOUND_MIXER_ALTPCM:
+			reg = codec->codec_read(codec, AK4650_POWER_MANAGEMENT);
+			if (!(reg & (PMHPR | PMHPL))) {
+				reg |= PMHPR | PMHPL;
+				codec->codec_write(codec, AK4650_POWER_MANAGEMENT, reg);
+			}
+			break;
+		case SOUND_MIXER_MIC:
+			reg = codec->codec_read(codec, AK4650_GENERAL_PURPOSE);
+			if (!(reg & MSEL)) {
+				reg = codec->codec_read(codec, AK4650_POWER_MANAGEMENT);
+				if (reg & MPWRE) {
+					/* external mic power-off */
+					reg &= ~MPWRE;
+					codec->codec_write(codec, AK4650_POWER_MANAGEMENT, reg);
+				}
+				if ((reg & (PMMIC|MPWRI)) != (PMMIC|MPWRI)) {
+					/* internal mic power-on  */
+					reg |= PMMIC | MPWRI;
+					codec->codec_write(codec, AK4650_POWER_MANAGEMENT, reg);
+				}
+			} else {
+				reg = codec->codec_read(codec, AK4650_POWER_MANAGEMENT);
+				if (reg & MPWRI) {
+					/* internal mic power-off */
+					reg &= ~MPWRI;
+					codec->codec_write(codec, AK4650_POWER_MANAGEMENT, reg);
+				}
+				if ((reg & (PMMIC|MPWRE)) != (PMMIC|MPWRE)) {
+					/* extennal mic power-on  */
+					reg |= PMMIC | MPWRE;
+					codec->codec_write(codec, AK4650_POWER_MANAGEMENT, reg);
+				}
+
+			}
+			break;
+		}
+	}
 #endif
 
 	codec->codec_write(codec, mh->offset, val);
 
+#ifdef CONFIG_MACH_SANDGATEVP
+	/* Power Save Mode */
+	if (val == AC97_MUTE) {
+		switch(oss_channel) {
+		case SOUND_MIXER_VOLUME:
+			reg = codec->codec_read(codec, AK4650_POWER_MANAGEMENT);
+			if(!(reg & PMSPK))
+				break;
+			reg &= ~PMSPK;
+			codec->codec_write(codec, AK4650_POWER_MANAGEMENT, reg);
+			break;
+		case SOUND_MIXER_ALTPCM:
+			reg = codec->codec_read(codec, AK4650_POWER_MANAGEMENT);
+			if (!(reg & (PMHPR | PMHPL)))
+				break;
+			reg &= ~(PMHPR | PMHPL);
+			codec->codec_write(codec, AK4650_POWER_MANAGEMENT, reg);
+			break;
+		case SOUND_MIXER_MIC:
+			reg = codec->codec_read(codec, AK4650_POWER_MANAGEMENT);
+			if (!(reg & (PMMIC | MPWRI | MPWRE)))
+				break;
+			reg &= ~(PMMIC | MPWRI | MPWRE);
+			codec->codec_write(codec, AK4650_POWER_MANAGEMENT, reg);
+			break;
+		}
+	}
+#endif
+
 #ifdef DEBUG
 	val = codec->codec_read(codec, mh->offset);
 	printk(" -> 0x%04x\n", val);
@@ -1313,6 +1446,103 @@
 }
 #endif
 	
+#if defined(CONFIG_MACH_SANDGATE2P) || defined(CONFIG_MACH_SANDGATEVP)
+static int ak4650_init(struct ac97_codec *codec)
+{
+	unsigned long flags;
+	unsigned short val;
+
+	local_irq_save(flags);
+
+	// Power ON(ADC,DAC)
+	val = codec->codec_read(codec, AK4650_POWERDOWN_CTROL_STAT);
+	val &= ~(PR2 | PR1 | PR0);
+	codec->codec_write(codec, AK4650_POWERDOWN_CTROL_STAT, val);
+
+	// Enable ALC1, ALC2
+	val = codec->codec_read(codec, AK4650_ALC_MODE_CONTROL);
+	val  |= (ALC2 | ALC1);
+	codec->codec_write(codec, AK4650_ALC_MODE_CONTROL, val);
+
+	// Record select
+	val = codec->codec_read(codec, AK4650_RECORD_SELECT);
+	val  |= MICAD;
+	codec->codec_write(codec, AK4650_RECORD_SELECT, val);
+
+	// Line select
+	val = codec->codec_read(codec, AK4650_SIGNAL_SELECT);
+	val  |= (ALCS | DAHS);
+	codec->codec_write(codec, AK4650_SIGNAL_SELECT, val);
+
+	// Boost control
+	val = codec->codec_read(codec, AK4650_BOOST_CONTROL);
+	val  |= BST1;
+	codec->codec_write(codec, AK4650_BOOST_CONTROL, val);
+
+	// Clear ATSW
+	val = codec->codec_read(codec, AK4650_ALC_DAC_CONTROL);
+	val  &= ~ATSW;
+	codec->codec_write(codec, AK4650_ALC_DAC_CONTROL, val);
+
+	// Set output sampling rate
+	val = 48000 & 0xFFFF;
+	codec->codec_write(codec, AK4650_PCM_FRONT_DAC_RATE, val);
+	val = codec->codec_read(codec, AK4650_ALC_DAC_CONTROL);
+	val  &= ~(DEM0);
+	val  |= DEM1;
+	codec->codec_write(codec, AK4650_ALC_DAC_CONTROL, val);
+
+	// Power on speaker amp
+	val = codec->codec_read(codec, AK4650_POWER_MANAGEMENT);
+	val  |= PMSPK;
+	codec->codec_write(codec, AK4650_POWER_MANAGEMENT, val);
+
+	// Power on speaker
+	val = codec->codec_read(codec, AK4650_SPEAKER_OUTPUT);
+	val  &= ~SPPS;
+	codec->codec_write(codec, AK4650_SPEAKER_OUTPUT, val);
+
+	// Power on head phone amp
+	val = codec->codec_read(codec, AK4650_POWER_MANAGEMENT);
+	val  |= PMHPR|PMHPL;
+	codec->codec_write(codec, AK4650_POWER_MANAGEMENT, val);
+
+	// Power on head phone
+	val = codec->codec_read(codec, AK4650_HEADPHONE_OUTPUT);
+	val  &= ~HPMT;
+	codec->codec_write(codec, AK4650_HEADPHONE_OUTPUT, val);
+
+	// Mute off
+	val = codec->codec_read(codec, AK4650_PCM_OUT_VOLUME);
+	val  &= ~SMUTE;
+	codec->codec_write(codec, AK4650_PCM_OUT_VOLUME, val);
+
+	// select internal mic
+	val = codec->codec_read(codec, AK4650_GENERAL_PURPOSE);
+	val  &= ~MSEL;
+	codec->codec_write(codec, AK4650_GENERAL_PURPOSE, val);
+
+	// power up mic amp and internal mic
+	val = codec->codec_read(codec, AK4650_POWER_MANAGEMENT);
+	val  |= PMMIC | MPWRI;
+	codec->codec_write(codec, AK4650_POWER_MANAGEMENT, val);
+
+	// clear mic mute and set volume
+	val = codec->codec_read(codec, AK4650_MIC_VOLUME);
+	val  &= ~MICMT;
+	val  |= MGAIN;
+	val  |= 0xf;
+	codec->codec_write(codec, AK4650_MIC_VOLUME, val);
+
+	// set the input sample rate
+	val = 48000 & 0xFFFF;
+	codec->codec_write(codec, AK4650_PCM_LR_ADC_RATE, val);
+
+	local_irq_restore(flags);
+
+	return 0;
+}
+#endif
 
 EXPORT_SYMBOL(ac97_read_proc);
 EXPORT_SYMBOL(ac97_probe_codec);
diff -uNr linux-2.6.17.org/sound/oss/ak4650-regs.h linux-2.6.17/sound/oss/ak4650-regs.h
--- linux-2.6.17.org/sound/oss/ak4650-regs.h	1970-01-01 09:00:00.000000000 +0900
+++ linux-2.6.17/sound/oss/ak4650-regs.h	2006-10-28 14:42:39.000000000 +0900
@@ -0,0 +1,261 @@
+/*
+ *  linux/oss/sound/ak4650-regs.h
+ *
+ *  Register definition for ak4650 audio codec on Sophia Systems Sandgate2-p board.
+ *
+ *  This program is free software; you can redistribute it and/or modify
+ *  it under the terms of the GNU General Public License version 2 as
+ *  published by the Free Software Foundation.
+ *
+ *  Copyright (c) 2006 Sophia Systems Co.,Ltd.
+ */
+
+#ifndef __AK4650_REGS_H__
+#define __AK4650_REGS_H__
+
+/* AK4650 Register */
+#define AK4650_RESET				0x00
+#define AK4650_SPEAKER_OUTPUT			0x02
+#define AK4650_HEADPHONE_OUTPUT			0x04
+#define AK4650_MONO_OUTPUT			0x06
+#define AK4650_BOOST_CONTROL			0x08
+#define AK4650_PC_BEEP_VOLUME			0x0a
+#define AK4650_PHONE_VOLUME			0x0c
+#define AK4650_MIC_VOLUME			0x0e
+#define AK4650_LINE_IN_VOLUME			0x10
+#define AK4650_PCM_OUT_VOLUME			0x18
+#define AK4650_RECORD_SELECT			0x1a
+#define AK4650_GENERAL_PURPOSE			0x20
+#define AK4650_POWERDOWN_CTROL_STAT		0x26
+#define AK4650_EXTENDED_AUDIO_ID		0x28
+#define AK4650_EXTENDED_AUDIO_STAT_CTROL	0x2a
+#define AK4650_PCM_FRONT_DAC_RATE		0x2c
+#define AK4650_PCM_LR_ADC_RATE			0x32
+#define AK4650_POWER_MANAGEMENT			0x60
+#define AK4650_SIGNAL_SELECT			0x62
+#define AK4650_ALC_DAC_CONTROL			0x64
+#define AK4650_ALC_MODE_CONTROL			0x66
+#define AK4650_VOLUME_CONTROL			0x68
+#define AK4650_DETECT_RESULT			0x6a
+#define AK4650_12BIT_ADC_CONTROL1		0x70
+#define AK4650_12BIT_ADC_CONTROL2		0x72
+#define AK4650_ADC_DATA1			0x74
+#define AK4650_ADC_DATA2			0x76
+#define AK4650_ADC_DATA3			0x78
+#define AK4650_VENDOR_ID1			0x7c
+#define AK4650_VENDOR_ID2			0x7e
+
+
+#define D0	(1<<0)
+#define D1	(1<<1)
+#define	D2	(1<<2)
+#define	D3	(1<<3)
+#define	D4	(1<<4)	
+#define	D5	(1<<5)	
+#define	D6	(1<<6)	
+#define	D7	(1<<7)	
+#define	D8	(1<<8)	
+#define	D9	(1<<9)	
+#define	D10	(1<<10)	
+#define	D11	(1<<11)	
+#define	D12	(1<<12)	
+#define	D13	(1<<13)	
+#define	D14	(1<<14)	
+#define	D15	(1<<15)	
+
+
+/* AK4650_SPEAKER_OUTPUT */
+#define SPPS	D15
+
+/* AK4650_HEADPHONE_OUTPUT */
+#define HPMT	D15
+
+/* AK4650_MONO_OUTPUT */
+#define MOMT	D15
+#define MOGN2	D2
+#define MOGN1	D1
+#define	MOGN0	D0
+
+/* AK4650_BOOST_CONTROL */
+#define BST1	D11
+#define BST0	D10
+
+/* AK4650_PC_BEEP_VOLUME */
+#define BPMT	D15
+
+/* AK4650_PHONE_VOLUME */
+#define AUXMT	D15
+#define	GN4	D4
+#define	GN3	D3
+#define	GN2	D2
+#define	GN1	D1
+#define	GN0	D0
+
+/* AK4650_MIC_VOLUME */
+#define MICMT	D15
+#define MGAIN	D6
+#define IPGA5	D5
+#define IPGA4	D4
+#define IPGA3	D3
+#define IPGA2	D2
+#define IPGA1	D1
+#define IPGA0	D0
+
+/* AK4650_LINE_IN_VOLUME */
+#define LNMT	D15
+#define GL4	D12
+#define GL3	D11
+#define GL2	D10
+#define GL1	D9
+#define GL0	D8
+#define GR4	D4
+#define GR3	D3
+#define GR2	D2
+#define GR1	D1
+#define GR0	D0
+
+/* AK4650_PCM_OUT_VOLUME */
+#define SMUTE	D15
+#define ATTL6	D14
+#define ATTL5	D13
+#define ATTL4	D12
+#define ATTL3	D11
+#define ATTL2	D10
+#define ATTL1	D9
+#define ATTL0	D8
+#define ATTR6	D6
+#define ATTR5	D5
+#define ATTR4	D4
+#define ATTR3	D3
+#define ATTR2	D2
+#define ATTR1	D1
+#define ATTR0	D0
+
+/* AK4650_RECORD_SELECT */
+#define MICAD	D9
+#define AUXAD	D8
+
+/* AK4650_GENERAL_PURPOSE */
+#define	MDIF	D9
+#define	MSEL	D8
+#define	LOOP	D7
+
+/* AK4650_POWERDOWN_CTROL_STAT */
+#define PR6	D14
+#define PR5	D13
+#define PR4	D12
+#define PR3	D11
+#define PR2	D10
+#define PR1	D9
+#define PR0	D8
+#define REF	D3
+#define ANL	D2
+#define DAC	D1
+#define ADC	D0
+
+/* AK4650_EXTENDED_AUDIO_STAT_CTROL */
+#define VRA	D00
+
+/* AK4650_POWER_MANAGEMENT */
+#define MPWRE	D15
+#define MPWRI	D14
+#define MCKPD	D8
+#define PMSPK	D7
+#define PMHPR	D6
+#define PMHPL	D5
+#define PMBPM	D4
+#define PMLIN	D3
+#define PMMO	D2
+#define PMAUX	D1
+#define PMMIC	D0
+
+/* AK4650_SIGNAL_SELECT */
+#define HPM	D15
+#define INBP	D11
+#define RNMD	D10
+#define LNMP	D9
+#define DAHS	D8
+#define AUXL	D7
+#define MICL	D6
+#define MICM	D5
+#define DAMO	D4
+#define BPMHP	D3
+#define BPMSP	D2
+#define ALCS	D1
+#define MO2	D0
+
+/* AK4650_ALC_DAC_CONTROL */
+#define HPINT	D14
+#define REF5	D13
+#define REF4	D12
+#define REF3	D11
+#define REF2	D10
+#define REF1	D9
+#define REF0	D8
+#define DATTC	D7
+#define ATPU	D6
+#define ATSW	D5
+#define HPDT	D4
+#define TM1	D3
+#define TM0	D2
+#define DEM1	D1
+#define DEM0	D0
+
+/* AK4650_ALC_MODE_CONTROL */
+#define ALC2	D14
+#define ALC1	D13
+#define ZELMN	D12
+#define LMAT1	D11
+#define LMAT0	D10
+#define RGAIN	D9
+#define LMTH	D8
+#define ROTM	D6
+#define ZTM1	D5
+#define ZTM0	D4
+#define WTM1	D3
+#define WTM0	D2
+#define LTM1	D1
+#define LTM0	D0
+
+/* AK4650_VOLUME_CONTROL */
+#define ATS	D4
+#define ATTM	D3
+#define ATTS2	D2
+#define ATTS1	D1
+#define ATTS0	D0
+
+/* AK4650_DETECT_RESULT */
+#define DTPEN	D2
+#define DTHPJ	D1
+#define DTMIC	D0
+
+/* AK4650_12D_ADC_CONTROL1 */
+#define	PM12AD	D15
+#define	ADFLT	D14
+#define	MSR1	D13
+#define	MSR0	D12
+#define	DLY3	D11
+#define	DLY2	D10
+#define	DLY1	D9
+#define	DLY0	D8
+#define	ADEXE1	D7
+#define	ADEXE0	D6
+#define	ADMODE1	D5
+#define	ADMODE0	D4
+#define	A2	D3
+#define	A1	D2
+#define	A0	D1
+#define	SER	D0
+
+/* AK4650_12D_ADC_CONTROL2 */
+#define	SIWU	D15
+#define	GINT	D14
+#define	PENINT	D13
+#define	PINTR	D12
+#define	PMVREF	D11
+#define	PINTE	D10
+#define	SLOTNO1	D2
+#define	SLOTNO0	D1
+#define	SLOT	D0
+
+#endif //__AK4650_REGS_H__
diff -uNr linux-2.6.17.org/sound/oss/Kconfig linux-2.6.17/sound/oss/Kconfig
--- linux-2.6.17.org/sound/oss/Kconfig	2006-10-28 14:35:28.000000000 +0900
+++ linux-2.6.17/sound/oss/Kconfig	2006-10-28 14:42:39.000000000 +0900
@@ -3,6 +3,12 @@
 # 18 Apr 1998, Michael Elizabeth Chastain, <mailto:mec@shout.net>
 # More hacking for modularisation.
 #
