+
 endmenu
 
-if (ARCH_SA1100 || ARCH_INTEGRATOR || ARCH_OMAP1)
+if (ARCH_SA1100 || ARCH_INTEGRATOR || ARCH_OMAP1 || ARCH_PXA)
 
 menu "CPU Frequency scaling"
 
@@ -683,6 +713,16 @@
 
 	  If in doubt, say Y.
 
+config DVFM
+	bool "Dynamic Voltage & Frequency change Manager"
+	depends on CPU_FREQ && ARCH_PXA && !DPM
+	default y
+	
+config FAST_DVFM
+	bool "Fast Dynamic Voltage & Frequency change Manager"
+	depends on DVFM
+	default y
+
 endmenu
 
 endif
@@ -878,3 +918,5 @@
 source "crypto/Kconfig"
 
 source "lib/Kconfig"
+
+source "drivers/dpm/Kconfig"
