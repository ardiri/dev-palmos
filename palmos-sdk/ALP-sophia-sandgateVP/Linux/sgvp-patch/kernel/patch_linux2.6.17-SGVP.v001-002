diff -uNr linux-2.6.17.org/drivers/i2c/chips/i2c-adcm2650.c linux-2.6.17/drivers/i2c/chips/i2c-adcm2650.c
--- linux-2.6.17.org/drivers/i2c/chips/i2c-adcm2650.c	1970-01-01 09:00:00.000000000 +0900
+++ linux-2.6.17/drivers/i2c/chips/i2c-adcm2650.c	2006-10-28 14:42:38.000000000 +0900
@@ -0,0 +1,292 @@
+/* 
+    i2c-adcm2650 - ADCM 2650 CMOS sensor I2C client driver
+
+    Copyright (C) 2003, Intel Corporation
+
+    This program is free software; you can redistribute it and/or modify
+    it under the terms of the GNU General Public License as published by
+    the Free Software Foundation; either version 2 of the License, or
+    (at your option) any later version.
+
+    This program is distributed in the hope that it will be useful,
+    but WITHOUT ANY WARRANTY; without even the implied warranty of
+    MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+    GNU General Public License for more details.
+
+    You should have received a copy of the GNU General Public License
+    along with this program; if not, write to the Free Software
+    Foundation, Inc., 675 Mass Ave, Cambridge, MA 02139, USA.
+
+    Code Status:
+    2004/10/19: Yan Yin <yan.yin@intel.com>
+        - Ported to 2.6 kernel	
+  
+   Copyright (C) 2005-2006 WILLCOM, Inc. All rights Reserved.
+*/
+
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/slab.h>
+#include <linux/init.h>
+#include <linux/i2c.h>
+#include <asm/hardware.h>
+#include <asm/types.h>
+
+#include "i2c-adcm2650.h"
+
+void i2c_adcm2650_inc_use (struct i2c_client *client);
+void i2c_adcm2650_dec_use (struct i2c_client *client);
+int i2c_adcm2650_attach_adapter(struct i2c_adapter *adapter);
+extern int i2c_adapter_id(struct i2c_adapter *adap);
+int i2c_adcm2650_detect_client(struct i2c_adapter *adapter, int address, int flags);
+int i2c_adcm2650_cleanup(void);
+int i2c_adcm2650_detach_client(struct i2c_client *client);
+
+struct i2c_driver adcm2650_driver  = 
+{
+	.driver			= {
+		.owner		=	THIS_MODULE,
+		.name		=	"adcm2650 driver",				/* name           */
+	},
+	.id				=	I2C_DRIVERID_ADCM2650, 			/* id             */
+	.attach_adapter	=	&i2c_adcm2650_attach_adapter,   /* attach_adapter */
+	.detach_client	=	&i2c_adcm2650_detach_client,    /* detach_client  */
+	.command		=	NULL,
+};
+
+extern  struct i2c_adapter *i2cdev_adaps[];
+/* Unique ID allocation */
+static int adcm2650_id = 0;
+static struct i2c_client *g_client;
+static unsigned short normal_i2c[] = { 0x52,I2C_CLIENT_END };
+static unsigned short normal_i2c_range[] = { I2C_CLIENT_END }; 
+I2C_CLIENT_INSMOD;
+
+static int ChgBlockAddr(u8 block)
+{
+
+	struct adcm2650_data *p;
+	int	res;
+
+	p=(struct adcm2650_data *)i2c_get_clientdata(g_client);	
+
+	down(&p->update_lock);
+	/*	FIXME:	Shall we change the g_client->addr?	*/
+	g_client->addr = PIPE_SLAVE_ADDR;	
+	res = i2c_smbus_write_byte_data(g_client, BLOCK_SWITCH_CMD, block);
+	p->blockaddr = block;
+	up( &p->update_lock);
+	return res;
+}
+
+int adcm2650_read(u16 addr, u16 *pvalue)
+{
+	int	res=0;
+	struct 	adcm2650_data *p;
+	u8	blockaddr = BLOCK(addr);
+	u8	offset;
+
+	if( g_client == NULL )	/*	No global client pointer?	*/
+		return -1;
+
+	p=(struct adcm2650_data *)i2c_get_clientdata(g_client);	
+
+	res = ChgBlockAddr( blockaddr);
+	
+	if( res !=0 )  {
+		printk("Change block address failed. block = %2x \n", blockaddr);
+		return -1;
+	}
+	offset = (addr << 1) & 0xff;
+	res = i2c_smbus_read_word_data(g_client, offset);
+	*pvalue = (u16)res;
+	return res;
+}	
+
+int adcm2650_write(u16 addr, u16 value)
+{
+	int	res=0;
+	struct adcm2650_data *p;
+	u8	blockaddr = BLOCK(addr);
+	u8 	offset;
+
+	if( g_client == NULL )	/*	No global client pointer?	*/
+		return -1;
+
+	p=(struct adcm2650_data *)i2c_get_clientdata(g_client);	
+	res = ChgBlockAddr( blockaddr );
+	
+	if( res !=0 )  {
+		printk("Change block address failed. block = %2x \n", blockaddr);
+		return -1;
+	}
+	offset = (addr << 1) & 0xff;
+	return i2c_smbus_write_word_data(g_client, offset, value );
+}	
+
+
+int i2c_adcm2650_read(struct i2c_client *client, u8 reg)
+{
+	return i2c_smbus_read_word_data(client,reg);
+}
+
+int i2c_adcm2650_write(struct i2c_client *client, u8 reg, u16 value)
+{
+	return i2c_smbus_write_word_data(client,reg,value);
+}
+
+
+int i2c_adcm2650_attach_adapter(struct i2c_adapter *adap)
+{
+	printk(KERN_INFO "In function %s.\n", __FUNCTION__);
+	return i2c_probe(adap,&addr_data,i2c_adcm2650_detect_client);
+}
+
+
+int i2c_adcm2650_detect_client(struct i2c_adapter *adapter, int address, int flags)	
+{
+	struct i2c_client *new_client=NULL;
+	int err = 0;
+	struct adcm2650_data *data;
+
+	printk(KERN_INFO "In funtion %s.\n", __FUNCTION__);
+	/* Let's see whether this adapter can support what we need.
+          Please substitute the things you need here!  */
+	if ( !i2c_check_functionality(adapter,I2C_FUNC_SMBUS_WORD_DATA) ) {
+		printk(KERN_INFO "Word op is not permited.\n");
+		goto ERROR0;
+	}
+
+	/* OK. For now, we presume we have a valid client. We now create the
+          client structure, even though we cannot fill it completely yet.
+          But it allows us to access several i2c functions safely */
+    
+	/* Note that we reserve some space for adcm2650_data too. If you don't
+          need it, remove it. We do it here to help to lessen memory
+          fragmentation. */
+	new_client=kmalloc(sizeof(struct i2c_client), GFP_KERNEL );	
+
+	if (!new_client)  {
+       	err = -ENOMEM;
+	    goto ERROR0;
+       }
+	memset(new_client, 0, sizeof(struct i2c_client));
+
+	data = kmalloc(sizeof(struct adcm2650_data), GFP_KERNEL);
+	if (!data) {
+       	err = -ENOMEM;
+	        goto ERROR1;
+	}
+	memset(data, 0, sizeof(struct adcm2650_data));
+
+	i2c_set_clientdata(new_client, data);
+	
+	new_client->addr = address;	
+    new_client->adapter = adapter;
+    new_client->driver = &adcm2650_driver;
+    new_client->flags = 0;
+
+    g_client = new_client;
+
+    /* Now, we do the remaining detection. If no `force' parameter is used. */
+
+    /* First, the generic detection (if any), that is skipped if any force
+          parameter was used. */
+
+#if 0
+	if (kind <= 0) {
+		/* The below is of course bogus */
+	
+		printk("<1>I2C: Probe ADCM2650 chip..");
+		if (i2c_adcm2650_read(new_client, REV) != 0x0600 ) {
+			printk(KERN_WARNING "Failed.\n");		
+			goto ERROR1;
+		}		 
+		else {
+			if ( adcm2650_id == 0 )
+				printk("<1> detected.\n");
+		}
+	
+	}
+#endif
+
+	strcpy(new_client->name, "ADCM2650");
+    	//new_client->id = adcm2650_id++; /* Automatically unique */
+	
+	data->valid = 0; /* Only if you use this field */
+	init_MUTEX(&data->update_lock); /* Only if you use this field */
+
+    	/* Tell the i2c layer a new client has arrived */
+    	if ((err = i2c_attach_client(new_client)))
+      		goto ERROR3;
+
+    	/* This function can write default values to the client registers, if
+          needed. */
+	/*	adcm2650_init_client(new_client);	*/
+    	return 0;
+
+    	/* OK, this is not exactly good programming practice, usually. But it is
+          very code-efficient in this case. */
+
+ERROR3:
+ERROR1:
+      	kfree(new_client);
+ERROR0:
+	return err;
+}
+
+int i2c_adcm2650_detach_client(struct i2c_client *client)
+{
+	int err;
+
+   	/* Try to detach the client from i2c space */
+   	if ((err = i2c_detach_client(client))) {
+   		printk("adcm2650.o: Client deregistration failed, client not detached.\n");
+     	return err;
+   	}
+
+	kfree(i2c_get_clientdata(client)); /* Frees client data too, if allocated at the same time */
+   	g_client = NULL;
+   	return 0;
+}
+
+/* 	Keep track of how far we got in the initialization process. If several
+	things have to initialized, and we fail halfway, only those things
+	have to be cleaned up! */
+static int adcm2650_initialized = 0;
+
+int i2c_adcm2650_init(void)
+{
+	int res;
+
+	printk(KERN_INFO "I2C: driver for device adcm2650.\n");
+	if ( (res = i2c_add_driver(&adcm2650_driver)) ) {
+		printk("adcm2650: Driver registration failed, module not inserted.\n");
+		i2c_adcm2650_cleanup();
+		return res;
+	}
+	adcm2650_initialized = 1;
+	return 0;
+}
+
+int i2c_adcm2650_cleanup(void)
+{
+	int res;
+
+	if (adcm2650_initialized == 1) {
+		if ((res = i2c_del_driver(&adcm2650_driver))) {
+			printk("adcm2650: Driver registration failed, module not removed.\n");
+			return res;
+		}
+		adcm2650_initialized = 0;
+	}
+	return 0;
+}
+
+EXPORT_SYMBOL(i2c_adcm2650_init);
+EXPORT_SYMBOL(adcm2650_write);
+EXPORT_SYMBOL(adcm2650_read);
+EXPORT_SYMBOL(i2c_adcm2650_cleanup);
+
+MODULE_DESCRIPTION("I2C client of adcm2650 camera interface ");
+MODULE_LICENSE("GPL");
diff -uNr linux-2.6.17.org/drivers/i2c/chips/i2c-adcm2650.h linux-2.6.17/drivers/i2c/chips/i2c-adcm2650.h
--- linux-2.6.17.org/drivers/i2c/chips/i2c-adcm2650.h	1970-01-01 09:00:00.000000000 +0900
+++ linux-2.6.17/drivers/i2c/chips/i2c-adcm2650.h	2006-10-28 14:42:38.000000000 +0900
@@ -0,0 +1,54 @@
+/* 
+    i2c-adcm2650 - ADCM 2650 CMOS sensor I2C client driver
+
+    Copyright (C) 2003, Intel Corporation
+
+    This program is free software; you can redistribute it and/or modify
+    it under the terms of the GNU General Public License as published by
+    the Free Software Foundation; either version 2 of the License, or
+    (at your option) any later version.
+
+    This program is distributed in the hope that it will be useful,
+    but WITHOUT ANY WARRANTY; without even the implied warranty of
+    MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+    GNU General Public License for more details.
+
+    You should have received a copy of the GNU General Public License
+    along with this program; if not, write to the Free Software
+    Foundation, Inc., 675 Mass Ave, Cambridge, MA 02139, USA.
+  
+   Copyright (C) 2005-2006 WILLCOM, Inc. All rights Reserved.
+*/
+
+
+#ifndef  _I2C_ADCM2650_H_
+#define  _I2C_ADCM2650_H_
+/* Calculating the Module Block Number */
+#define BLOCK(a)    (u8)((a) >> 7)      /* register's module block address. */
+#define OFFSET(a)   (u8)((a) & 0x7F )   /* register's offset to this block. */
+
+/*  Update the block address.*/
+#define BLOCK_SWITCH_CMD    0xFE
+#define PIPE_SLAVE_ADDR     0x0052
+#define SENSOR_SLAVE_ADDR   0x0055
+
+#define DEBUG
+#define I2C_DRIVERID_ADCM2650   241
+/* Register definitions in ADCM2650's chip. */
+#define REV     0x0
+
+struct adcm2650_data {
+    /*
+     *  Because the i2c bus is slow, it is often useful to cache the read
+     *  information of a chip for some time (for example, 1 or 2 seconds).
+     *  It depends of course on the device whether this is really worthwhile
+     *  or even sensible.
+     */
+    struct semaphore update_lock; /* When we are reading lots of information,
+                                     another process should not update the
+                                     below information */
+    char valid;                   /* != 0 if the following fields are valid. */
+    int  blockaddr;                  /*  current using block address.    */
+    unsigned long last_updated;   /* In jiffies */
+};
+#endif
diff -uNr linux-2.6.17.org/drivers/i2c/chips/Kconfig linux-2.6.17/drivers/i2c/chips/Kconfig
--- linux-2.6.17.org/drivers/i2c/chips/Kconfig	2006-10-28 14:35:02.000000000 +0900
+++ linux-2.6.17/drivers/i2c/chips/Kconfig	2006-10-28 14:42:38.000000000 +0900
@@ -1,6 +1,12 @@
 #
 # Miscellaneous I2C chip drivers configuration
 #
+# Copyright (C) 2005-2006 WILLCOM, Inc. All rights Reserved.
+#
+# This program is free software; you can redistribute it and/or modify
+# it under the terms of the GNU General Public License version 2 as
+# published by the Free Software Foundation.
+#
 
 menu "Miscellaneous I2C Chip support"
 	depends on I2C
@@ -117,4 +123,9 @@
 	  This driver can also be built as a module.  If so, the module
 	  will be called max6875.
 
+config SENSORS_ADCM2650 
+	tristate "ADCM2650 chip"
+	depends on I2C && I2C_ADAP_PXA
+	select I2C_SENSOR
+
 endmenu
diff -uNr linux-2.6.17.org/drivers/i2c/chips/Makefile linux-2.6.17/drivers/i2c/chips/Makefile
--- linux-2.6.17.org/drivers/i2c/chips/Makefile	2006-10-28 14:35:02.000000000 +0900
+++ linux-2.6.17/drivers/i2c/chips/Makefile	2006-10-28 14:42:38.000000000 +0900
@@ -1,6 +1,12 @@
 #
 # Makefile for miscellaneous I2C chip drivers.
 #
+# Copyright (C) 2005-2006 WILLCOM, Inc. All rights Reserved.
+#
+# This program is free software; you can redistribute it and/or modify
+# it under the terms of the GNU General Public License version 2 as
+# published by the Free Software Foundation.
+#
 
 obj-$(CONFIG_SENSORS_DS1337)	+= ds1337.o
 obj-$(CONFIG_SENSORS_DS1374)	+= ds1374.o
@@ -12,6 +18,7 @@
 obj-$(CONFIG_SENSORS_PCF8591)	+= pcf8591.o
 obj-$(CONFIG_ISP1301_OMAP)	+= isp1301_omap.o
 obj-$(CONFIG_TPS65010)		+= tps65010.o
+obj-$(CONFIG_SENSORS_ADCM2650)	+= i2c-adcm2650.o
 
 ifeq ($(CONFIG_I2C_DEBUG_CHIP),y)
 EXTRA_CFLAGS += -DDEBUG
diff -uNr linux-2.6.17.org/drivers/input/keyboard/blackriver_kp.c linux-2.6.17/drivers/input/keyboard/blackriver_kp.c
--- linux-2.6.17.org/drivers/input/keyboard/blackriver_kp.c	1970-01-01 09:00:00.000000000 +0900
+++ linux-2.6.17/drivers/input/keyboard/blackriver_kp.c	2006-10-28 14:42:38.000000000 +0900
@@ -0,0 +1,410 @@
+/*
+ *  linux/drivers/input/keyboard/blackriver_kp.c
+ *
+ *  Keypad driver for blackriver Platform
+ *
+ *  Copyright (C) 2004, Intel Corporation (jingqing.xu@intel.com)
+ *
+ *  This program is free software; you can redistribute it and/or modify
+ *  it under the terms of the GNU General Public License version 2 as
+ *  published by the Free Software Foundation.
+ *
+ * Copyright (C) 2005-2006 WILLCOM, Inc. All rights Reserved.
+ */
+#include <linux/module.h>
+#include <linux/init.h>
+#include <linux/input.h>
+#include <linux/interrupt.h>
+#include <asm/irq.h>
+#include <asm/hardware.h>
+#include <asm/arch/pxa-regs.h>
+#include <linux/platform_device.h>
+
+MODULE_AUTHOR("Xu Jingqing <Jingqing.Xu@intel.com>");
+MODULE_DESCRIPTION("BlackRiever keypad driver");
+MODULE_LICENSE("GPL");
+
+static int software_repeat = 1;	/* original default 0 */
+module_param(software_repeat, uint, 0644);
+MODULE_PARM_DESC(software_repeat, "Use software keyboard repeat");
+
+static int repeat_delay = 1000;	/* original default 250 */
+module_param(repeat_delay, uint, 0644);
+MODULE_PARM_DESC(repeat_delay, "repeat delay time[msec]");
+
+static int repeat_period = 250;	/* original default 33 */
+module_param(repeat_period, uint, 0644);
+MODULE_PARM_DESC(repeat_period, "repeat period time[msec]");
+
+#define MATRIX_ROW	4	/* IN0 - IN3 */
+#define MATRIX_COLUMN	7	/* OUT0 - OUT6 */
+#define KEYBUF		0x78	/* the number of key buf */
+
+#define	KEYBUF_POWERSW	0x0f
+#define	KEYBUF_HOOKSW	0x0e
+
+#define	GPIO_POWERSW	GPIO_0_PWR_SW
+#define	GPIO_HOOKSW	GPIO_81_HOOK_SW
+
+#define	IRQ_POWERSW	IRQ_GPIO0
+#define	IRQ_HOOKSW	IRQ_GPIO(GPIO_HOOKSW)
+
+#define	PXA27x_KEYPAD_EXTENT	0x4c
+#define	PXA27x_KEYPAD_NAME	"pxa27x-keypad"
+
+static char press_state[KEYBUF];
+static unsigned char	*blackriver_keycode;
+
+static int		blackriver_kp_irq_keypad;
+static int		blackriver_kp_irq_powersw;
+static int		blackriver_kp_irq_hooksw;
+static int		blackriver_kp_input_device_register;
+
+static void __kp_updown_report(struct input_dev *dev, u8 c, u8 state)
+{
+	press_state[c] = state;
+	input_report_key(dev, blackriver_keycode[c], state);
+}
+
+static void __kp_matrix_scan(struct input_dev *dev, u8 c, u8 mkc, u8 mask)
+{
+	if (mkc & mask) {
+		if (!press_state[c]) {
+			__kp_updown_report(dev, c, 1);	/* Down */
+		}
+	} else {
+		if (press_state[c]) {
+			__kp_updown_report(dev, c, 0);	/* Up */
+		}
+	}
+}
+
+static int kp_matrix_scan(struct input_dev *dev, int irq)
+{
+	u32		autoscan;
+	u8		c, mkc, mask;
+	int		i, n = -1;
+	unsigned long	kpc_val;
+
+	/* check keypad interrupt */
+	/* ack interrupt */
+	kpc_val = KPC;
+
+	/* matrix interrupt */
+	if (kpc_val & KPC_MI) {
+		autoscan = KPAS;
+		n = (autoscan >> 26) & 0x1f;
+		c = autoscan & 0xff;
+	}
+
+	/* if keypad interrupt is active..*/
+	if (n > -1) {
+
+		/* Read OUT0 */
+		mkc = KPASMKP0 & 0xff;
+		mask = 1;
+		for (i = 0; i < MATRIX_ROW; i++, mask <<= 1) {
+			__kp_matrix_scan(dev, (i << 4) | 0x0, mkc, mask);
+		}
+
+		/* Read OUT1 */
+		mkc = ((KPASMKP0 & 0xff0000) >> 16);
+		mask = 1;
+		for (i = 0; i < MATRIX_ROW; i++, mask <<= 1) {
+			__kp_matrix_scan(dev, (u8)((i << 4) | 0x1), mkc, mask);
+		}
+
+		/* Read OUT2 */
+		mkc = (KPASMKP1 & 0xff);
+		mask = 1;
+		for (i = 0; i < MATRIX_ROW; i++, mask <<= 1) {
+			__kp_matrix_scan(dev, (u8)((i << 4) | 0x2), mkc, mask);
+		}
+
+		/* Read OUT3 */
+		mkc = ((KPASMKP1 & 0xff0000) >> 16);
+		mask = 1;
+		for (i = 0; i < MATRIX_ROW; i++, mask <<= 1) {
+			__kp_matrix_scan(dev, (u8)((i << 4) | 0x3), mkc, mask);
+		}
+
+		/* Read OUT4 */
+		mkc = (KPASMKP2 & 0xff);
+		mask = 1;
+		for (i = 0; i < MATRIX_ROW-1; i++, mask <<= 1) {
+			__kp_matrix_scan(dev, (u8)((i << 4) | 0x4), mkc, mask);
+		}
+
+		/* Read OUT5 */
+		mkc = ((KPASMKP2 & 0xff0000) >> 16);
+		mask = 1;
+		for (i = 0; i < MATRIX_ROW-1; i++, mask <<= 1) {
+			__kp_matrix_scan(dev, (u8)((i << 4) | 0x5), mkc, mask);
+		}
+
+		/* Read OUT6 */
+		mkc = (KPASMKP3 & 0xff);
+		mask = 1;
+		/* i=2 is OFF Key */
+		for (i = 0; i < MATRIX_ROW-1; i++, mask <<= 1) {
+			__kp_matrix_scan(dev, (u8)((i << 4) | 0x6), mkc, mask);
+		}
+	}
+
+	return 0;
+}
+
+/* Interrupt Handler for KEYPAD */
+static irqreturn_t kp_interrupt(int irq, void *ptr, struct pt_regs *regs)
+{
+	kp_matrix_scan(platform_get_drvdata((struct platform_device *)ptr),
+	    irq);
+	return IRQ_HANDLED;
+}
+
+/* Interrupt Handler for Hooksw */
+static irqreturn_t powersw_interrupt(int irq, void *ptr, struct pt_regs *regs)
+{
+	__kp_updown_report(platform_get_drvdata((struct platform_device *)ptr),
+	    (u8)KEYBUF_POWERSW,
+	     GPLR(GPIO_POWERSW) & GPIO_bit(GPIO_POWERSW) ? 0 : 1);
+
+	return IRQ_HANDLED;
+}
+
+/* Interrupt Handler for Hooksw */
+static irqreturn_t hooksw_interrupt(int irq, void *ptr, struct pt_regs *regs)
+{
+	__kp_updown_report(platform_get_drvdata((struct platform_device *)ptr),
+	    (u8)KEYBUF_HOOKSW,
+	     GPLR(GPIO_HOOKSW) & GPIO_bit(GPIO_HOOKSW) ? 0 : 1);
+
+	return IRQ_HANDLED;
+}
+
+static void kpad_configure(void)
+{
+	/* gpio */
+	pxa_gpio_mode(GPIO_81_HOOK_SW | GPIO_IN);	/* GPIO 81 HOOK_SW */
+	pxa_gpio_mode(GPIO_0_PWR_SW | GPIO_IN);		/* GPIO 0 PWR_SW */
+
+	pxa_gpio_mode(GPIO_100_KP_MKIN0  | GPIO_ALT_FN_1_IN);	/* MKIN0 */
+ 	pxa_gpio_mode(GPIO_101_KP_MKIN1  | GPIO_ALT_FN_1_IN);	/* MKIN1 */
+	pxa_gpio_mode(GPIO_102_KP_MKIN2  | GPIO_ALT_FN_1_IN);	/* MKIN2 */
+	pxa_gpio_mode(GPIO_97_KP_MKIN3   | GPIO_ALT_FN_3_IN);	/* MKIN3 */
+	pxa_gpio_mode(GPIO_103_KP_MKOUT0 | GPIO_ALT_FN_2_OUT);	/* MKOUT0 */
+	pxa_gpio_mode(GPIO_104_KP_MKOUT1 | GPIO_ALT_FN_2_OUT);	/* MKOUT1 */
+	pxa_gpio_mode(GPIO_105_KP_MKOUT2 | GPIO_ALT_FN_2_OUT);	/* MKOUT2 */
+	pxa_gpio_mode(GPIO_106_KP_MKOUT3 | GPIO_ALT_FN_2_OUT);	/* MKOUT3 */
+	pxa_gpio_mode(GPIO_107_KP_MKOUT4 | GPIO_ALT_FN_2_OUT);	/* MKOUT4 */
+	pxa_gpio_mode(GPIO_108_KP_MKOUT5 | GPIO_ALT_FN_2_OUT);	/* MKOUT5 */
+	pxa_gpio_mode(GPIO_96_KP_MKOUT6  | GPIO_ALT_FN_3_OUT);	/* MKOUT6 */
+
+	/* enable unit clock */
+	CKEN |= CKEN19_KEYPAD;
+
+//FIXME:PXA27x E11
+#ifdef CONFIG_PXA27x_E11
+	/* debouce setting: matrix debouce + direct debouce */
+	KPKDI= 10 + (2 << 8);
+#else
+	KPKDI= 2 << 8;
+#endif
+
+	/* keypad control register */
+	KPC
+	  = (KPC_ASACT			/* Automatic Scan on Activity */
+	  | (MATRIX_ROW << 26)		/* rows 4 */
+	  | (MATRIX_COLUMN << 23)	/* column 7 */
+	  | KPC_ME			/* Matrix Enable */
+	  | KPC_REE0			/* Rotary Encoder 0 Enable */
+	  | KPC_MS0			/* Manual Matrix Scan Line 0 */
+	  | KPC_MS1			/* Manual Matrix Scan Line 1 */
+	  | KPC_MS2			/* Manual Matrix Scan Line 2 */
+	  | KPC_MS3			/* Manual Matrix Scan Line 3 */
+	  | KPC_MS4			/* Manual Matrix Scan Line 4 */
+	  | KPC_MS5			/* Manual Matrix Scan Line 5 */
+	  | KPC_MS6			/* Manual Matrix Scan Line 6 */
+	  | KPC_MIE);			/* Matrix Interrupt Enable */
+}
+
+static void blackriver_kp_clean(struct platform_device *pdev)
+{
+	struct resource		*res;
+	static struct input_dev	*input_dev;
+
+	blackriver_keycode = NULL;
+
+	CKEN &= ~CKEN19_KEYPAD;
+	pxa_gpio_mode(GPIO_POWERSW & ~GPIO_IN);
+
+	if (blackriver_kp_irq_keypad) {
+		free_irq(IRQ_KEYPAD, pdev);
+		blackriver_kp_irq_keypad = 0;
+	}
+	if (blackriver_kp_irq_powersw) {
+		free_irq(IRQ_POWERSW, pdev);
+		blackriver_kp_irq_powersw = 0;
+	}
+	if (blackriver_kp_irq_hooksw) {
+		free_irq(IRQ_HOOKSW, pdev);
+		blackriver_kp_irq_hooksw = 0;
+	}
+	if ((input_dev = platform_get_drvdata(pdev)) != NULL) {
+		input_unregister_device(input_dev);
+		input_free_device(input_dev);
+		platform_set_drvdata(pdev, NULL);
+	}
+
+	res = platform_get_resource_byname(pdev,
+	    IORESOURCE_MEM,
+	    PXA27x_KEYPAD_NAME);
+	if (res) {
+		release_mem_region(res->start, PXA27x_KEYPAD_EXTENT);
+	}
+}
+
+static int __init blackriver_kp_probe(struct platform_device *pdev)
+{
+	static struct input_dev *input_dev;
+	struct resource		*res;
+	int			i, err;
+	struct keypad_data {
+		unsigned int	keycodemax;
+		unsigned int	keycodesize;
+		void		*keycode;
+	} *data;
+
+	res = platform_get_resource_byname(pdev,
+	    IORESOURCE_MEM,
+	    PXA27x_KEYPAD_NAME);
+	if (!res) {
+		return -ENODEV;
+	}
+	data = pdev->dev.platform_data;
+	if (!request_mem_region(res->start,
+	    PXA27x_KEYPAD_EXTENT,
+	    PXA27x_KEYPAD_NAME)) {
+		return -EBUSY;
+	}
+
+	if ((input_dev = input_allocate_device()) == NULL) {
+		release_mem_region(res->start, PXA27x_KEYPAD_EXTENT);
+		return -ENOMEM;
+	}
+	platform_set_drvdata(pdev, input_dev);
+
+	input_dev->evbit[0] = BIT(EV_KEY);
+	if (software_repeat)
+		input_dev->evbit[0] |= BIT(EV_REP);
+
+	input_dev->keycode = data->keycode;
+	blackriver_keycode = data->keycode;
+	input_dev->keycodesize = data->keycodesize;
+	input_dev->keycodemax = data->keycodemax;
+
+	for (i = 0; i < data->keycodemax; i++) {
+		if (blackriver_keycode[i])
+			set_bit(blackriver_keycode[i],
+			   input_dev->keybit);
+	}
+
+	/* keypad */
+	err = request_irq(IRQ_KEYPAD, kp_interrupt, 0, "Keypad", pdev);
+	if (err) {
+		printk(KERN_CRIT "Wow! Can't register IRQ[%d] for Keypad\n",
+		  IRQ_KEYPAD);
+		blackriver_kp_clean(pdev);
+		return -1;
+	}
+	blackriver_kp_irq_keypad = 1;
+
+	/* power sw */
+	pxa_gpio_mode(GPIO_POWERSW | GPIO_IN); /* GPIO_0_PWR_SW (OFF KEY) */
+	set_irq_type(IRQ_POWERSW, IRQT_BOTHEDGE);
+	err = request_irq(IRQ_POWERSW, powersw_interrupt, 0, "Power SW", pdev);
+	if (err) {
+		printk(KERN_CRIT "Wow! Can't register IRQ[%d] for Power SW\n",
+		  IRQ_POWERSW);
+		blackriver_kp_clean(pdev);
+		return -1;
+	}
+	blackriver_kp_irq_powersw = 1;
+
+	/* hook sw */
+	pxa_gpio_mode(GPIO_HOOKSW | GPIO_IN); /* GPIO_81_HOOK_SW */
+	set_irq_type(IRQ_HOOKSW, IRQT_BOTHEDGE);
+	err = request_irq(IRQ_HOOKSW, hooksw_interrupt,
+	    SA_SHIRQ, "Hook SW", pdev);
+	if (err) {
+		printk(KERN_CRIT "Wow! Can't register IRQ[%d] for Hook SW\n",
+		  IRQ_HOOKSW);
+		blackriver_kp_clean(pdev);
+		return -1;
+	}
+	blackriver_kp_irq_hooksw = 1;
+
+	kpad_configure();
+
+	input_dev->name = PXA27x_KEYPAD_NAME;
+	input_dev->phys = "pxa27x/input0";
+	input_dev->id.vendor = 0x0001;
+	input_dev->id.product = 0x0001;
+	input_dev->id.version = 0x0001;
+
+	if (input_register_device(input_dev) != 0) {
+		printk(KERN_CRIT
+		    "blackriver_kp: fail input_register_device()\n");
+		blackriver_kp_clean(pdev);
+		return -1;
+	}
+	if (software_repeat) {
+		input_dev->rep[REP_DELAY] = repeat_delay;
+		input_dev->rep[REP_PERIOD] = repeat_period;
+	}
+	blackriver_kp_input_device_register = 1;
+	printk(KERN_INFO "input: BlackRiver keypad driver!\n");
+
+	return 0;
+}
+
+static int blackriver_kp_remove(struct platform_device *pdev)
+{
+	blackriver_kp_clean(pdev);
+	return 0;
+}
+
+static int blackriver_kp_suspend(struct platform_device *pdev, pm_message_t state)
+{
+	CKEN &= ~CKEN19_KEYPAD;
+	return 0;
+}
+
+static int blackriver_kp_resume(struct platform_device *pdev)
+{
+	kpad_configure();
+	return 0;
+}
+
+static struct platform_driver blackriver_kp_driver = {
+	.probe		= blackriver_kp_probe,
+	.remove		= blackriver_kp_remove,
+	.suspend	= blackriver_kp_suspend,
+	.resume		= blackriver_kp_resume,
+	.driver		= {
+		.name	= "pxa27x-keypad",
+	},
+};
+
+static int __init blackriver_kp_init(void)
+{
+	return platform_driver_register(&blackriver_kp_driver);
+}
+
+static void __exit blackriver_kp_exit(void)
+{
+	platform_driver_unregister(&blackriver_kp_driver);
+}
+
+module_init(blackriver_kp_init);
+module_exit(blackriver_kp_exit);
diff -uNr linux-2.6.17.org/drivers/input/keyboard/difflog/sandgatevp_kp.c.difflog linux-2.6.17/drivers/input/keyboard/difflog/sandgatevp_kp.c.difflog
--- linux-2.6.17.org/drivers/input/keyboard/difflog/sandgatevp_kp.c.difflog	1970-01-01 09:00:00.000000000 +0900
+++ linux-2.6.17/drivers/input/keyboard/difflog/sandgatevp_kp.c.difflog	2006-10-28 14:42:38.000000000 +0900
@@ -0,0 +1,453 @@
+# diffLog ver 0.3 charset=SJIS
+# 2006/09/28 19:01:25 1.0
+## before saved by ViVi
