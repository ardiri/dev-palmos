+	KEY_Y,		/* 0x35:  21 */ /* reserved */
+	KEY_U,		/* 0x36:  22 */ /* reserved */
+	KEY_I,		/* 0x37:  23 */ /* reserved */
+	KEY_O,		/* 0x38:  24 */ /* reserved */
+	KEY_P,		/* 0x39:  25 */ /* reserved */
+	KEY_A,		/* 0x3a:  30 */ /* reserved */
+	KEY_S,		/* 0x3b:  31 */ /* reserved */
+	KEY_D,		/* 0x3c:  32 */ /* reserved */
+	KEY_F,		/* 0x3d:  33 */ /* reserved */
+	KEY_G,		/* 0x3e:  34 */ /* reserved */
+	KEY_H,		/* 0x3f:  35 */ /* reserved */
+	KEY_J,		/* 0x40:  36 */ /* reserved */
+	KEY_K,		/* 0x41:  37 */ /* reserved */
