 /*
  * This is the maximum size of an area which will be flushed.  If the area
@@ -168,8 +173,16 @@
 	.align	5
 
 ENTRY(cpu_xscale_do_idle)
+#ifndef CONFIG_IDLEMODE_NORMAL
+#ifdef CONFIG_IDLEMODE_DEEPIDLE
+	ldr	r0, =CCCR
+	ldr	r1, [r0]
+	orr	r1, r1, #0x80000000		@ CCCR.CPDIS
+	str	r1, [r0]
+#endif /* CONFIG_IDLEMODE_DEEPIDLE */
 	mov	r0, #1
 	mcr	p14, 0, r0, c7, c0, 0		@ Go to IDLE
+#endif /* !CONFIG_IDLEMODE_NORMAL */
 	mov	pc, lr
 
