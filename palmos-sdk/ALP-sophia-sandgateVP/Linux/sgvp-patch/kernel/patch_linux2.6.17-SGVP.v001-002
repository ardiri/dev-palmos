diff -uNr linux-2.6.17.org/arch/arm/boot/Makefile linux-2.6.17/arch/arm/boot/Makefile
--- linux-2.6.17.org/arch/arm/boot/Makefile	2006-10-28 14:34:31.000000000 +0900
+++ linux-2.6.17/arch/arm/boot/Makefile	2006-10-28 14:42:37.000000000 +0900
@@ -9,6 +9,7 @@
 # for more details.
 #
 # Copyright (C) 1995-2002 Russell King
+# Copyright (C) 2005-2006 WILLCOM, Inc. All rights Reserved.
 #
 
 MKIMAGE         := $(srctree)/scripts/mkuboot.sh
@@ -27,7 +28,7 @@
 
 export ZRELADDR INITRD_PHYS PARAMS_PHYS
 
-targets := Image zImage xipImage bootpImage uImage
+targets := Image zImage xipImage bootpImage uImage romImage
 
 ifeq ($(CONFIG_XIP_KERNEL),y)
 
@@ -76,6 +77,13 @@
 	$(call if_changed,objcopy)
 	@echo '  Kernel: $@ is ready'
 
+$(obj)/romImage:	$(obj)/rom/rom.o FORCE
+	$(call if_changed,objcopy)
+	@echo '  Kernel: $@ is ready'
+
+$(obj)/rom/rom.o:	FORCE
+	$(Q)$(MAKE) $(build)=$(obj)/rom $@
+
 PHONY += initrd FORCE
 initrd:
 	@test "$(INITRD_PHYS)" != "" || \
@@ -91,4 +99,4 @@
 	$(CONFIG_SHELL) $(srctree)/$(src)/install.sh $(KERNELRELEASE) \
 	$(obj)/zImage System.map "$(INSTALL_PATH)"
 
-subdir-	    := bootp compressed
+subdir-	    := bootp compressed rom
diff -uNr linux-2.6.17.org/arch/arm/boot/rom/boot.S linux-2.6.17/arch/arm/boot/rom/boot.S
--- linux-2.6.17.org/arch/arm/boot/rom/boot.S	1970-01-01 09:00:00.000000000 +0900
+++ linux-2.6.17/arch/arm/boot/rom/boot.S	2006-10-28 14:42:37.000000000 +0900
@@ -0,0 +1,45 @@
+/*
+ * arch/arm/boot/rom/boot.S
+ *
+ * Copyright (C) 2005-2006 WILLCOM, Inc. All rights Reserved.
+ *  $Date: 2006/09/25 06:52:35 $ Fujitsu Software Technologies Limited.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 as
+ * published by the Free Software Foundation.
+ */
+
+#include <linux/config.h>
+#include <linux/linkage.h>
+#include <asm/assembler.h>
+
+	.text
+ENTRY(_start)
+	// wait 8 cycle
+	.rept	8
+		nop
+	.endr
+
+#ifdef CONFIG_PXA27x
+	#include "pxa27x-boot.S"
+#endif /* CONFIG_PXA27x */
+
+__rom_boot_copy_kernel:
+
+	// setup r0, r1
+	// r0 = 0
+	// r1 = architecture ID
+#ifdef CONFIG_PXA27x
+	#include "pxa27x-copy.S"
+#endif /* CONFIG_PXA27x */
+
+__rom_boot_jump_kernel:
+	ldr	r4, kernel_addr
+	mov	lr, pc
+	mov	pc, r4
+
+__rom_boot_tail:
+	b	__rom_boot_tail
+
+	.type	kernel_addr, %object
+kernel_addr:	.long	(TEXT_OFFSET + PHYS_OFFSET)
diff -uNr linux-2.6.17.org/arch/arm/boot/rom/ld.script linux-2.6.17/arch/arm/boot/rom/ld.script
--- linux-2.6.17.org/arch/arm/boot/rom/ld.script	1970-01-01 09:00:00.000000000 +0900
+++ linux-2.6.17/arch/arm/boot/rom/ld.script	2006-10-28 14:42:37.000000000 +0900
@@ -0,0 +1,46 @@
+/*
+ *  linux/arch/arm/boot/rom/ld.script
+ *
+ *  Copyright (C) 2000 Russell King
+ *
+ * Copyright (C) WILLCOM. Inc. All rights Reserved.
+ *  $Date: 2006/09/25 06:52:35 $ Fujitsu Software Technologies Limited.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 as
+ * published by the Free Software Foundation.
+ */
+OUTPUT_ARCH(arm)
+ENTRY(_start)
+SECTIONS
+{
+	. = 0;
+	_text = .;
+	.text : {
+		_start = .;
+		*(.start)
+		*(.text)
+	}
+	.data : {
+		*(.data)
+	}
+	.bss : {
+		*(.bss)
+	}
+	. = ALIGN(32);
+	.image : {
+		__image_start = .;
+		*(.image)
+		. = ALIGN(32);
+		__image_end = .;
+	}
+	_gp = .;
+	.sdata : {
+		*(.sdata)
+	}
+	.sbss : {
+		*(.sbss)
+	}
+	. = ALIGN(16);
+}
+
diff -uNr linux-2.6.17.org/arch/arm/boot/rom/Makefile linux-2.6.17/arch/arm/boot/rom/Makefile
--- linux-2.6.17.org/arch/arm/boot/rom/Makefile	1970-01-01 09:00:00.000000000 +0900
+++ linux-2.6.17/arch/arm/boot/rom/Makefile	2006-10-28 14:42:37.000000000 +0900
@@ -0,0 +1,33 @@
+#
+# linux/arch/arm/boot/rom/Makefile
+#
+# create a rom boot + vmlinuz image from the original vmlinux
+#
+# Copyright (C) 2005-2006 WILLCOM, Inc. All rights Reserved.
+#  $Date: 2006/09/25 06:52:35 $ Fujitsu Software Technologies Limited.
+#
+
+EXTRA_AFLAGS	:= -DTEXT_OFFSET=$(TEXT_OFFSET)
+LDFLAGS_rom.o	:= -T $(obj)/ld.script -Bstatic
+
+OBJCOPYFLAGS_vmlinux.bin	:= $(OBJCOPYFLAGS)
+
+OBJCOPYFLAGS_image.o	:= -I binary
+OBJCOPYFLAGS_image.o	+= -O elf32-littlearm
+OBJCOPYFLAGS_image.o	+= -B arm
+OBJCOPYFLAGS_image.o	+= --add-section=.image=$(obj)/vmlinux.bin
+OBJCOPYFLAGS_image.o	+= --set-section-flags .image=contents,alloc,load,readonly
+OBJCOPYFLAGS_image.o	+= -R .data
+
+bootobjs	:= $(obj)/boot.o $(obj)/image.o
+
+$(obj)/rom.o:	$(bootobjs)
+	$(call if_changed,ld)
+
+$(obj)/image.o:	$(obj)/vmlinux.bin
+	$(call if_changed,objcopy)
+
+$(obj)/vmlinux.bin:	vmlinux
+	$(call if_changed,objcopy)
+
+clean-files	:= vmlinux.bin
diff -uNr linux-2.6.17.org/arch/arm/boot/rom/pxa27x-blackriver.h linux-2.6.17/arch/arm/boot/rom/pxa27x-blackriver.h
--- linux-2.6.17.org/arch/arm/boot/rom/pxa27x-blackriver.h	1970-01-01 09:00:00.000000000 +0900
+++ linux-2.6.17/arch/arm/boot/rom/pxa27x-blackriver.h	2006-10-28 14:42:37.000000000 +0900
@@ -0,0 +1,75 @@
+/*
+ * arch/arm/boot/rom/pxa27x-blackriver.h
+ *
+ * Copyright (C) 2005-2006 WILLCOM, Inc. All rights Reserved.
+ *  $Date: 2006/09/25 06:52:35 $ Fujitsu Software Technologies Limited.
+ */
+
+/*
+ * GPIO
+ */
+/* GPDR */
+#define	VAL_GPDR0	0x00408000	// nCS1 | Charge
+#define	VAL_GPDR1	0x00020002	// nCS5 | PWE-
+#define	VAL_GPDR2	0x00014000	// nCS2 | nCS4
+#define	VAL_GPDR3	0x00000000
+/* GPSR */
+#define	VAL_GPSR0	0x00408000	// nCS1 | Charge-500mA
+#define	VAL_GPSR1	0x00000002	// nCS5
+#define	VAL_GPSR2	0x00014000	// nCS2 | nCS4
+#define	VAL_GPSR3	0x00000000
+/* GPCR */
+#define	VAL_GPCR0	0xffffffff
+#define	VAL_GPCR1	0xffffffff
+#define	VAL_GPCR2	0xffffffff
+#define	VAL_GPCR3	0xffffffff
+/* GAFR */
+#define	VAL_GAFR0_L	0x80000000	// nCS1(2)
+#define	VAL_GAFR0_U	0x00000010	// RDY(1)
+#define	VAL_GAFR1_L	0x00000008	// nCS5(2)
+#define	VAL_GAFR1_U	0x00000008	// PWE-(2)
+#define	VAL_GAFR2_L	0x20000000	// nCS2(2)
+#define	VAL_GAFR2_U	0x00000002	// nCS4(2)
+#define	VAL_GAFR3_L	0x00000000
+#define	VAL_GAFR3_U	0x00000000
+
+/*
+ * Memory Control
+ */
+#define	VAL_MDCNFG	0x0b002bcf
+#define	VAL_MDMRS	0x00000000
+#define	VAL_MDREFR	0x200fe02e
+#define	VAL_MSC0	0x98e898e8
+#define	VAL_MSC1	0x0000bdd9
+#define	VAL_MSC2	0x0000388c
+#define	VAL_MECR	0x00000001
+#define	VAL_MCMEM0	0x00014307
+#define	VAL_MCMEM1	0x00014307
+#define	VAL_MCATT0	0x0001c787
+#define	VAL_MCATT1	0x0001c787
+#define	VAL_MCIO0	0x0001430f
+#define	VAL_MCIO1	0x0001430f
+
+/* UART */
+#define	UART_CKEN	CKEN7_BTUART
+#define	UART_BASE	__PREG(BTUART)
+#define	UART_GPDR	__PREG(GPDR1)
+#define	UART_GPSR	__PREG(GPSR1)
+#define	UART_GPCR	__PREG(GPCR1)
+#define	UART_GAFR	__PREG(GAFR1_L)
+#define	UART_GPIO_SET	(GPIO_bit(GPIO43_BTTXD) | GPIO_bit(GPIO45_BTRTS))
+#define	UART_GPIO_CLR	(GPIO_bit(GPIO42_BTRXD) | GPIO_bit(GPIO44_BTCTS))
+#define	UART_GPIO_FUNC	(1 << 20 | 2 << 22 | 1 << 24 | 2 << 26)
+
+/* architecture ID */
+#define	ARCH_ID		MACH_TYPE_BLACKRIVER
+
+/* FlashROM */
+#define	ROM_BASE	PXA_CS0_PHYS
+#define	ROM_END		PXA_CS2_PHYS
+
+/* CCCR */
+#define	VAL_CCCR	0x02000210	// A=1, T=416MHz, R=208MHz
+
+/* Power I2C */
+#define	PI2C_SLAVE_ADDR	0x76
diff -uNr linux-2.6.17.org/arch/arm/boot/rom/pxa27x-boot.S linux-2.6.17/arch/arm/boot/rom/pxa27x-boot.S
--- linux-2.6.17.org/arch/arm/boot/rom/pxa27x-boot.S	1970-01-01 09:00:00.000000000 +0900
+++ linux-2.6.17/arch/arm/boot/rom/pxa27x-boot.S	2006-10-28 14:42:37.000000000 +0900
@@ -0,0 +1,592 @@
+/*
+ * arch/arm/boot/rom/pxa27x-boot.S
+ *
+ * Copyright (C) 2005-2006 WILLCOM, Inc. All rights Reserved.
+ *  $Date: 2006/09/27 02:55:38 $ Fujitsu Software Technologies Limited.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 as
+ * published by the Free Software Foundation.
+ */
+
+#include <linux/config.h>
+#include <linux/serial_reg.h>
+#include <asm/ptrace.h>
+#include <asm/system.h>
+#include <asm/hardware.h>
+#include <asm/memory.h>
+#include <asm/arch/pxa-regs.h>
+
+#if defined(CONFIG_MACH_BLACKRIVER)
+#include "pxa27x-blackriver.h"
+#elif defined(CONFIG_MACH_SANDGATE2P)
+#include "pxa27x-sandgate2p.h"
+#elif defined(CONFIG_MACH_SANDGATEVP)
+#include "pxa27x-sandgate-vp.h"
+#else
+#error	"not support"
+#endif
+
+.macro	CPWAIT wr
+	mrc	p15, 0, \wr, c2, c0, 0	// arbitrary read of CP15
+	mov	\wr, \wr		// wait for it
+	sub	pc, pc, #4		// branch to next instruction
+	// At this point, any previous CP15 writes area
+	// guaranteed to have taken effect.
+.endm
+
+.macro	WAIT_200uSEC reg0, reg1, reg2
+		ldr	\reg2, __OSCR0	// OSCR0 address
+		// really 0x2E1 is about 200usec, so 0x300 should be plenty
+		mov	\reg0, #0x300
+		ldr	\reg1, [\reg2]	// OSCR0 value
+		add	\reg0, \reg0, \reg1
+	1:
+		ldr	\reg1, [\reg2]	// OSCR0 value
+		cmp	\reg0, \reg1
+		bgt	1b
+.endm
+
+.macro	INIT_CLOCKS reg0, reg1, reg2, reg3
+		/*
+		 * INIT CLOCKS
+		 */
+		// disables the peripheral clocks
+		adr	\reg2, __CCCR
+		ldmia	\reg2, { \reg0, \reg1, \reg3 }
+		str	\reg1, [\reg0]		// CCCR value
+		mov	\reg2, #OSCC_OON
+		str	\reg2, [\reg3]		// OSCC value
+	2:
+		ldr	\reg2, [\reg3]
+		ands	\reg2, \reg2, #OSCC_OON
+		beq	2b
+		// set CLKCFG(Turbo | Frequency Change | Fast-Bus)
+		mov	\reg2, #0x08 | 0x02 | 0x01
+		mcr	p14, 0, \reg2, c6, c0, 0
+.endm
+
+/* Clock Change */
+#if defined(CONFIG_MACH_BLACKRIVER) || defined(CONFIG_MACH_SANDGATEVP)
+/* Preprocessing */
+.macro	ClockChangePreProcessing reg0, reg1, reg2, reg3, reg4
+	/*
+	 * PowerI2C init(1st)
+	 */
+	//ldr	\reg0, __PMCR
+	// PCFR |= PCFR.FVC
+	ldr	\reg1, [\reg0, #0x1c]
+	orr	\reg1, \reg1, #PCFR_FVC
+	str	\reg1, [\reg0, #0x1c]
+
+	/*
+	 * PowerI2C init(2nd)
+	 */
+	// PVCR = slave address
+	mov	\reg1, #(PI2C_SLAVE_ADDR >> 1)
+	str	\reg1, [\reg0, #0x40]
+	ldr	\reg1, [\reg0, #0x40]
+	// set PCMD0-1 for SOFTRESET
+	mov	\reg1, #(0x40 | 14)
+	str	\reg1, [\reg0, #0x80 + 0x00]
+	mov	\reg1, #0x80
+	orr	\reg1, \reg1, #PCMD_LC
+	str	\reg1, [\reg0, #0x80 + 0x04]
+
+	INIT_CLOCKS \reg2, \reg1, \reg3, \reg4
+
+	/*
+	 * PowerI2C init(3rd)
+	 */
+	// PVCR = slave address
+	mov	\reg1, #(PI2C_SLAVE_ADDR >> 1)
+	str	\reg1, [\reg0, #0x40]
+	ldr	\reg1, [\reg0, #0x40]
+	// set PCMD0-1 for SOFTRESET
+	mov	\reg1, #(0x40 | 6)
+	str	\reg1, [\reg0, #0x80 + 0x00]
+	mov	\reg1, #0xff
+	str	\reg1, [\reg0, #0x80 + 0x1c]
+	mov	\reg1, #0x00
+	str	\reg1, [\reg0, #0x80 + 0x0c]
+	str	\reg1, [\reg0, #0x80 + 0x10]
+	mov	\reg1, #0x85
+	str	\reg1, [\reg0, #0x80 + 0x04]
+	mov	\reg1, #0x05
+	str	\reg1, [\reg0, #0x80 + 0x08]
+	mov	\reg1, #0x80
+	str	\reg1, [\reg0, #0x80 + 0x14]
+	str	\reg1, [\reg0, #0x80 + 0x18]
+	mov	\reg1, #0x7f
+	str	\reg1, [\reg0, #0x80 + 0x20]
+	str	\reg1, [\reg0, #0x80 + 0x24]
+	mov	\reg1, #0x1e
+	orr	\reg1, \reg1, #PCMD_LC
+	str	\reg1, [\reg0, #0x80 + 0x28]
+.endm
+
+/* Postprocessing */
+.macro	ClockChangePostProcessing reg0, reg1
+	/*
+	 * PowerI2C init(4th)
+	 */
+	// PCFR &= ~PCFR.FVC
+	ldr	\reg1, [\reg0, #0x1c]
+	and	\reg1, \reg1, #~PCFR_FVC
+	str	\reg1, [\reg0, #0x1c]
+.endm
+/* Sleep Mode */
+.macro JUDGE_SLEEP reg0, reg1
+
+	ldr \reg0, __MDREFR
+        ldr \reg1,[\reg0]
+        and \reg1,\reg1,#~MDREFR_SLFRSH
+        str \reg1,[\reg0]
+
+	ldr \reg0, __RCSR
+        ldr \reg1,[\reg0]
+        and \reg1,\reg1,#15
+        cmp \reg1,#4
+        bne normalboot
+
+        ldr \reg0, __PSPR
+        ldr \reg1,[\reg0]
+        cmp \reg1,#0
+        beq normalboot
+
+        mov pc,\reg1
+        nop
+
+        .p2align 5
+normalboot:
+.endm
+
+#else
+/* Preprocessing */
+.macro	ClockChangePreProcessing reg0, reg1, reg2, reg3, reg4
+.endm
+
+/* Postprocessing */
+.macro	ClockChangePostProcessing reg0, reg1
+.endm
+#endif /* CONFIG_MACH_BLACKRIVER, CONFIG_MACH_SANDGATEVP */
+
+pxa27x_boot_head:
+	// disable interrupt
+	mov	r0, #PSR_I_BIT | PSR_F_BIT | SVC_MODE
+	msr	cpsr, r0
+
+#ifdef CONFIG_BOOT_PERF
+	ldr	r2, __OSCR4		// OSCR4 address
+	mov	r3, #0x0
+	str	r3, [r2, #0x00]		// OSCR4 value
+	str	r3, [r2, #0x40]		// OSMR4 value
+	mov	r4, #0x42
+	str	r4, [r2, #0x80]		// OMCR4 value
+	str	r3, [r2, #0x00]		// OSCR40 value
+#endif /* CONFIG_BOOT_PERF */
+
+	// check current address
+	sub	r0, pc, #(__pxa27x_boot_check_rom - _start)
+	ldr	r1, __ROM_BASE
+__pxa27x_boot_check_rom:
+	ldr	r2, __ROM_END
+	cmp	r1, r0			// if (_start < ROM_BASE)
+	bhi	pxa27x_boot_tail
+	cmp	r2, r0			// if (_start >= ROM_END)
+	bls	pxa27x_boot_tail
+
+	// set CPAR(enable CP0, CP6, CP7, CP13)
+	mov	r0, #1 << 0 | 1 << 6 | 1 << 7
+	orr	r0, r0, #1 << 13
+	mcr	p15, 0, r0, c15, c1, 0
+	CPWAIT	r0
+
+	// set control register
+	mov	r0, #CR_W | CR_P | CR_D | CR_L
+	mcr	p15, 0, r0, c1, c0, 0
+	CPWAIT	r0
+
+	// Invalidate I & D TLB
+	// Invalidate I & D cache and BTB
+	// Dran Write (&Fill) Buffer
+	mov	r0, #0
+	mcr	p15, 0, r0, c8, c7, 0
+	mcr	p15, 0, r0, c7, c7, 0
+	mcr	p15, 0, r0, c7, c10, 4
+
+	// wait 4 cycle
+	.rept	4
+		nop
+	.endr
+
+	// set Domain Access Control register
+	mvn	r0, #0
+	mcr	p15, 0, r0, c3, c0, 0
+
+	/*
+	 * INIT GPIO
+	 */
+	// set GPIO
+	adr	r1, __GPIO_start
+	adr	r2, __GPIO_end
+__pxa27x_boot_reload_gpio:
+	ldmia	r1!, { r3, r4 }
+	cmp	r1, r2
+	str	r4, [r3]
+	bne	__pxa27x_boot_reload_gpio
+	b	__pxa27x_boot_pm
+
+	.type	__GPIO_start, %object
+__GPIO_start:
+		.long	__PREG(GPCR0),		VAL_GPCR0
+		.long	__PREG(GPCR1),		VAL_GPCR1
+		.long	__PREG(GPCR2),		VAL_GPCR2
+		.long	__PREG(GPCR3),		VAL_GPCR3
+		.long	__PREG(GPSR0),		VAL_GPSR0
+		.long	__PREG(GPSR1),		VAL_GPSR1
+		.long	__PREG(GPSR2),		VAL_GPSR2
+		.long	__PREG(GPSR3),		VAL_GPSR3
+		.long	__PREG(GPDR0),		VAL_GPDR0
+		.long	__PREG(GPDR1),		VAL_GPDR1
+		.long	__PREG(GPDR2),		VAL_GPDR2
+		.long	__PREG(GPDR3),		VAL_GPDR3
+		.long	__PREG(GAFR0_L),	VAL_GAFR0_L
+		.long	__PREG(GAFR0_U),	VAL_GAFR0_U
+		.long	__PREG(GAFR1_L),	VAL_GAFR1_L
+		.long	__PREG(GAFR1_U),	VAL_GAFR1_U
+		.long	__PREG(GAFR2_L),	VAL_GAFR2_L
+		.long	__PREG(GAFR2_U),	VAL_GAFR2_U
+		.long	__PREG(GAFR3_L),	VAL_GAFR3_L
+		.long	__PREG(GAFR3_U),	VAL_GAFR3_U
+__GPIO_end:
+
+__pxa27x_boot_pm:
+	// set PSSR.PH
+	ldr	r1, __PSSR		// PSSR address
+	mov	r3, #PSSR_PH
+	ldr	r2, [r1]		// PSSR value
+	orr	r3, r3, r2
+	orr	r3, r3, #PSSR_RDH
+	str	r3, [r1]		// PSSR value
+
+	/*
+	 * INIT CONTROLLER
+	 */
+	// disables all interrupts
+	ldr	r1, __ICMR
+	ldr	r2, __ICLR
+	mov	r3, #0
+	str	r3, [r1]		// ICMR value
+	str	r3, [r2]		// ICLR value
+
+	/*
+	 * ENABLE CLOCKS
+	 */
+	// Re-Enable On-Chip Peripheral Clock
+	ldr	r2, __CKEN		// CKEN address
+	mov	r3, #CKEN22_MEMC
+	orr	r3, r3, #CKEN9_OSTIMER
+	orr	r3, r3, #CKEN15_PWRI2C
+	str	r3, [r2]		// CKEN value
+
+	/*
+	 * INIT POWER
+	 */
+	// set PMCR, PCFR, PWER
+	ldr	r2, __PMCR		// PMCR address
+#ifdef CONFIG_MACH_SANDGATEVP
+	mov	r3, #14			// INTRS, VIDAE
+#else
+	mov	r3, #0
+#endif
+	str	r3, [r2]		// PMCR value
+	mov	r3, #0
+	str	r3, [r2, #0x0c]		// PWER
+	str	r3, [r2, #0x10]		// PRER
+	str	r3, [r2, #0x14]		// PFER
+	str	r3, [r2, #0x18]		// PEDR
+	str	r3, [r2, #0x20]		// PGSR0
+	str	r3, [r2, #0x24]		// PGSR1
+	str	r3, [r2, #0x28]		// PGSR2
+	str	r3, [r2, #0x2c]		// PGSR3
+	str	r3, [r2, #0x38]		// PSTR
+	str	r3, [r2, #0x40]		// PVCR
+	str	r3, [r2, #0x50]		// PKWR
+	str	r3, [r2, #0x54]		// PKSR
+
+#if defined(CONFIG_MACH_SANDGATEVP)
+	mov	r3, #PCFR_OPDE | (0x1 << 5) | PCFR_PI2CEN | PCFR_GPR_EN
+#else
+	mov	r3, #PCFR_OPDE | (0x1 << 5) | PCFR_PI2CEN
+#endif
+	str	r3, [r2, #0x1c]		// PCFR
+	mov	r3, #PWER_GPIO0
+	orr	r3, r3, #PWER_RTC
+	str	r3, [r2, #0x0c]		// PWER
+	str	r3, [r2, #0x14]		// PFER
+
+	/*
+	 * IF Sleep Exit then skip ClockSet
+	 */
+        ldr     r2, __RCSR
+        ldr     r3, [r2]
+        and     r3, r3, #15
+        cmp     r3, #4
+        bne     _normalboot1
+	ldr	r2, __PSPR
+	ldr	r3, [r2]
+	cmp	r3, #0
+	bne	clock_set_skip
+_normalboot1:
+
+	/*
+	 * INIT CLOCKS
+	 */
+	ClockChangePreProcessing r2, r3, r1, r4, r5
+	INIT_CLOCKS r1, r3, r4, r5
+	ClockChangePostProcessing r2, r3
+
+	/*
+	 * INIT OS Timer
+	 */
+	// set OS Timer
+	ldr	r2, __OSMR0		// OSMR0 address
+	mov	r3, #0
+	str	r3, [r2, #16]		// OSCR0 value
+	str	r3, [r2, #0]		// OSMR0 value
+	str	r3, [r2, #4]		// OSMR1 value
+	str	r3, [r2, #8]		// OSMR2 value
+	str	r3, [r2, #12]		// OSMR3 value
+	str	r3, [r2, #24]		// OWER value
+	mov	r3, #0xf		// M3 | M2 | M1 | M0
+	str	r3, [r2, #18]		// OSSR value
+	mov	r3, #OIER_E0
+	str	r3, [r2, #28]		// OIER value
+
+clock_set_skip:
+	/*
+	 * INIT MEMORY CONTROLLER
+	 */
+	WAIT_200uSEC r0, r1, r2
+
+	// initializes the memory controller
+	adr	r1, __MEMC_start
+	adr	r2, __MEMC_end
+__pxa27x_reload_memc:
+	ldmia	r1!, { r3, r4 }
+	cmp	r1, r2
+	str	r4, [r3]
+	bne	__pxa27x_reload_memc
+
+	WAIT_200uSEC r0, r1, r2
+
+	// set MDREFR.DRI
+	adr	r1, __MDREFR
+	ldmia	r1, { r2, r3 }
+	mov	r1, #0x00ff
+	orr	r1, r1, #0x0f00		// MDREFR.DRI mask
+	and	r3, r3, r1
+	ldr	r0, [r2]		// MDREFR value
+	bic	r0, r0, r1
+	orr	r0, r0, r3
+	str	r0, [r2]		// MDREFR value
+	// set MDREFR.K*
+	bic	r0, r0, #MDREFR_K2FREE | MDREFR_K1FREE | MDREFR_K0FREE
+	orr	r0, r0, #MDREFR_K1RUN | MDREFR_K0RUN | MDREFR_K0DB2
+	bic	r0, r0, #MDREFR_K1DB2
+	str	r0, [r2]		// MDREFR value
+	// unset MDREFR.SLFRSH
+	bic	r0, r0, #MDREFR_SLFRSH
+	str	r0, [r2]		// MDREFR value
+	// set MDREFR.E1PIN
+	orr	r0, r0, #MDREFR_E1PIN
+	str	r0, [r2]		// MDREFR value
+	nop
+	nop
+
+	// set MDCNFG
+	adr	r1, __MDCNFG
+	ldmia	r1, { r2, r3 }
+	bic	r3, r3, #1 << 17 | 1 << 16	// DE3, DE2
+	bic	r3, r3, #1 <<  1 | 1 <<  0	// DE1, DE0
+	str	r3, [r2]
+
+	WAIT_200uSEC r0, r1, r3
+
+	// set control register
+	mov	r0, #CR_W | CR_P | CR_D | CR_L
+	mcr	p15, 0, r0, c1, c0, 0
+
+	// Check Resume
+	ldr	r0, __RCSR
+	ldr	r1, [r0]
+	and	r1, r1, #15
+	cmp	r1, #4
+	bne	_normalboot2
+	ldr	r0, __PSPR
+	ldr	r1, [r0]
+	cmp	r1, #0
+	bne	sdram_w_skip
+_normalboot2:
+
+	// wait refresh cycles
+	ldr	r0, __SDRAM_BASE
+	.rept	8
+		str	r0, [r0]
+	.endr
+sdram_w_skip:
+	ldr	r0, __SDRAM_BASE
+
+	// set MDCNFG.DE0
+	ldr	r1, [r2]		// MDCNFIG value
+	orr	r1, r1, #(VAL_MDCNFG & ((1 << 0) | (1 << 1)))	// DE0, DE1
+	orr	r1, r1, #(VAL_MDCNFG & ((1 << 16) | (1 << 17)))	// DE2, DE3
+	str	r1, [r2]		// MDCNFIG value
+
+	// set MDMRS
+	adr	r1, __MDMRS
+	ldmia	r1, { r2, r3 }
+	str	r3, [r2]
+
+	/*
+	 * RESTART MEMORY CONTROLLER
+	 */
+	// set MDREFR
+	adr	r1, __MDREFR
+	ldmia	r1, { r2, r3 }
+	bic	r0, r3, #MDREFR_E0PIN | MDREFR_E1PIN
+	str	r0, [r2]
+	str	r3, [r2]
+
+	// Check Resume
+	ldr	r0, __RCSR
+	ldr	r1, [r0]
+	and	r1, r1, #15
+	cmp	r1, #4
+	bne	normalboot3
+	ldr	r0, __PSPR
+	ldr	r1, [r0]
+	cmp	r1, #0
+	bne	sdram_w_skip2
+normalboot3:
+
+	// wait refresh cycles
+	ldr	r0, __SDRAM_BASE
+	.rept	8
+		str	r0, [r0]
+	.endr
+sdram_w_skip2:
+	// judge returned from sleep-mode
+	JUDGE_SLEEP r0, r1
+
+	/*
+	 * ENABLE UART(for console)
+	 */
+	// set UART clock
+	ldr	r0, __CKEN		// CKEN address
+	ldr	r1, [r0]		// CKEN value
+	orr	r1, r1, #UART_CKEN
+	str	r1, [r0]		// CKEN value
+
+	// set UART(GPIO)
+	adr	r0, __UART_start
+	ldmia	r0, { r1, r2, r3, r4, r5, r6 }
+	str	r5, [r2]		// GPCR
+	ldr	r0, [r1]		// GPDR
+	bic	r0, r0, r5
+	orr	r0, r0, r4
+	str	r0, [r1]
+	ldr	r0, [r3]		// GAFR
+	orr	r0, r0, r6
+	str	r0, [r3]
+	// set UART
+	ldr	r1, __UART_BASE
+	ldr	r0, [r1, #UART_LCR << 2]
+	bic	r0, r0, #UART_LCR_DLAB	// LCR.DALB
+	str	r0, [r1, #UART_LCR << 2]
+	// 8-1-no parity
+	mov	r2, #UART_LCR_WLEN8 | UART_LCR_DLAB
+	str	r2, [r1, #UART_LCR << 2]
+	// baud 115200
+	mov	r0, #0x08
+	str	r0, [r1, #UART_DLL << 2]
+	mov	r0, #0x00
+	str	r0, [r1, #UART_DLM << 2]
+	// clear Divisor Latch Access
+	bic	r2, r2, #UART_LCR_DLAB
+	str	r2, [r1, #UART_LCR << 2]
+	// clear FIFO
+	mov	r0, #UART_FCR_ENABLE_FIFO | UART_FCR_CLEAR_RCVR | UART_FCR_CLEAR_XMIT
+	str	r0, [r1, #UART_FCR << 2]
+	// Enable
+	mov	r0, #UART_IER_UUE
+	str	r0, [r1, #UART_IER << 2]
+
+	// check POWER key state(0: on, 1: off)
+	ldr	r1, __GPIO_start	// GPCR0(0xXXXX0024)
+	ldr	r1, [r1, #-0x24]	// GPLR0(0xXXXX0000)
+	ands	r1, r1, #0x1		// GPIO 0
+	bne	__pxa27x_deep_sleep
+
+	// return
+__pxa27x_boot_end:
+	b	pxa27x_boot_tail
+
+	.type	__ROM_BASE, %object
+__ROM_BASE:	.long	ROM_BASE
+__ROM_END:	.long	ROM_END
+__SDRAM_BASE:	.long	PHYS_OFFSET
+__OSCR0:	.long	__PREG(OSCR)
+__PSSR:		.long	__PREG(PSSR)
+__ICMR:		.long	__PREG(ICMR)
+__ICLR:		.long	__PREG(ICLR)
+__CKEN:		.long	__PREG(CKEN)
+__CCCR:		.long	__PREG(CCCR),		VAL_CCCR
+__OSCC:		.long	__PREG(OSCC)
+__OSMR0:	.long	__PREG(OSMR0)
+#ifdef CONFIG_BOOT_PERF
+__OSCR4:	.long	__PREG(OSCR4)
+#endif
+__RCNR:		.long	__PREG(RCNR)
+__PMCR:		.long	__PREG(PMCR)
+__MEMC_start:
+		.long	__PREG(MSC0),		VAL_MSC0
+		.long	__PREG(MSC1),		VAL_MSC1
+		.long	__PREG(MSC2),		VAL_MSC2
+		.long	__PREG(MECR),		VAL_MECR
+		.long	__PREG(MCMEM0),		VAL_MCMEM0
+		.long	__PREG(MCMEM1),		VAL_MCMEM1
+		.long	__PREG(MCATT0),		VAL_MCATT0
+		.long	__PREG(MCATT1),		VAL_MCATT1
+		.long	__PREG(MCIO0),		VAL_MCIO0
+		.long	__PREG(MCIO1),		VAL_MCIO1
+__MEMC_end:
+__MDREFR:	.long	__PREG(MDREFR),		VAL_MDREFR
+__MDCNFG:	.long	__PREG(MDCNFG),		VAL_MDCNFG
+__MDMRS:	.long	__PREG(MDMRS),		VAL_MDMRS
+__UART_start:
+		.long	UART_GPDR
+		.long	UART_GPCR
+		.long	UART_GAFR
+		.long	UART_GPIO_SET
+		.long	UART_GPIO_CLR
+		.long	UART_GPIO_FUNC
+__UART_BASE:	.long	UART_BASE
+__RCSR:		.long	__PREG(RCSR)
+__PSPR:		.long	__PREG(PSPR)
+
+__pxa27x_deep_sleep:
+	ldr	r1, __RCSR
+	ldr	r2, [r1]
+	and	r2, r2, #(RCSR_GPR | RCSR_SMR | RCSR_WDR | RCSR_HWR)
+	str	r2, [r1]
+	mov	r1, #PWRMODE_DEEPSLEEP
+	mcr	p14, 0, r1, c7, c0, 0
+	.rept	10
+		nop
+	.endr
+__pxa27x_deep_sleep__:
+	b	__pxa27x_deep_sleep__
+
+pxa27x_boot_tail:
diff -uNr linux-2.6.17.org/arch/arm/boot/rom/pxa27x-copy.S linux-2.6.17/arch/arm/boot/rom/pxa27x-copy.S
--- linux-2.6.17.org/arch/arm/boot/rom/pxa27x-copy.S	1970-01-01 09:00:00.000000000 +0900
+++ linux-2.6.17/arch/arm/boot/rom/pxa27x-copy.S	2006-10-28 14:42:37.000000000 +0900
@@ -0,0 +1,143 @@
+/*
+ * arch/arm/boot/rom/pxa27x-copy.S
+ *
+ * Copyright (C) 2005-2006 WILLCOM, Inc. All rights Reserved.
+ *  $Date: 2006/09/25 06:52:35 $ Fujitsu Software Technologies Limited.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 as
+ * published by the Free Software Foundation.
+ */
+
+#include <linux/config.h>
+#include <asm/ptrace.h>
+#include <asm/system.h>
+#include <asm/hardware.h>
+#include <asm/memory.h>
+#include <asm/mach-types.h>
+#include <asm/arch/pxa-regs.h>
+
+#if defined(CONFIG_MACH_BLACKRIVER)
+#include "pxa27x-blackriver.h"
+#elif defined(CONFIG_MACH_SANDGATE2P)
+#include "pxa27x-sandgate2p.h"
+#elif defined(CONFIG_MACH_SANDGATEVP)
+#include "pxa27x-sandgate-vp.h"
+#else
+#error	"not support"
+#endif
+
+.macro	get_timer1 reg0
+.endm
+.macro	get_timer2 reg0, reg1
+.endm
+
+pxa27x_copy_head:
+	mov	r5, pc			// pc = . + 8
+	adr	r3, kernel_paddr
+__pxa27x_copy_call:
+	ldmia	r3, { r0, r1, r2, r4 }
+	subs	r2, r2, r1
+	ble	pxa27x_copy_tail
+	sub	r3, r5, r4
+	add	r1, r1, r3
+	/*
+	 * r0: dst
+	 * r1: src
+	 * r2: size
+	 */
+	get_timer1 fp
+#ifdef CONFIG_DMA_IN_BOOT
+	mov	r3, #0x1000		// 4KB
+	sub	r5, r3, #1
+	and	r2, r2, r5
+	ldr	r5, __DCSR		// DMA Controller base
+	mov	r6, #0
+	str	r6, [r5, #0xa0]		// DALGN
+	add	r7, r5, #0x200		// Channel 0
+__pxa27x_copy_loop:
+	cmp	r3, r2
+	mov	r6, #DCSR_NODESC
+	str	r6, [r5]		// DCSR
+	str	r1, [r7, #0x04]		// DSADR
+	mov	r6, #DCMD_INCTRGADDR | DCMD_INCSRCADDR
+	str	r0, [r7, #0x08]		// DSADR
+	orr	r6, r6, #DCMD_BURST32
+	movle	r4, r3
+	movgt	r4, r2
+	orr	r6, r6, r4
+	str	r6, [r7, #0x0c]		// DCMD
+	mov	r6, #DCSR_NODESC | DCSR_RUN
+	str	r6, [r5]		// DCSR
+
+__pxa27x_wait_loop:
+	ldr	r6, [r5]
+	ands	r6, r6, #DCSR_RUN
+	beq	__pxa27x_wait_loop
+
+	subs	r2, r2, r4
+	bne	__pxa27x_copy_loop
+#else
+__pxa27x_copy_loop:
+	subs	r2, r2, #32		// 32 = 4byte x 8
+	ldmia	r1!, { r3 - r9, ip }
+	stmia	r0!, { r3 - r9, ip }
+	bgt	__pxa27x_copy_loop
+#endif /* CONFIG_DMA_IN_BOOT */
+
+	get_timer2 sp, fp		// r3: time of copy
+
+	// build Setup data
+	adr	r0, __tag_start
+	adr	r2, __tag_end
+	ldr	r4, __tag_addr
+	sub	r1, r2, r0
+	sub	r1, r1, #8
+pxa27x_copy_tag_loop:
+	subs	r1, r1, #8
+	ldmia	r0!, { r2, r3 }
+	stmia	r4!, { r2, r3 }
+	bgt	pxa27x_copy_tag_loop
+
+	// check POWER key state(0: on, 1: off)
+	ldr	r1, __GPIO_start	// GPCR0(0xXXXX0024)
+	ldr	r1, [r1, #-0x24]	// GPLR0(0xXXXX0000)
+	ands	r1, r1, #0x1		// GPIO 0
+	bne	__pxa27x_deep_sleep
+
+	// return
+__pxa27x_copy_end:
+	mov	r0, #0
+	ldr	r1, __ARCH_ID
+	b	pxa27x_copy_tail
+
+	.type	kernel_paddr, %object
+kernel_paddr:	.long	(TEXT_OFFSET + PHYS_OFFSET)
+image_start:	.long	__image_start
+image_end:	.long	__image_end
+__offset:	.long	(__pxa27x_copy_call - _start)
+#ifdef CONFIG_DMA_IN_BOOT
+__DCSR:		.long	__PREG(DCSR0)
+#endif /* CONFIG_DMA_IN_BOOT */
+__tag_addr:	.long	PHYS_OFFSET + 0x100
+__tag_start:
+		// header
+		.long	2 + 3		// tag_header.size // header + core
+		.long	0x54410001	// tag_header.tag  // ATAG_CORE
+		// core
+		.long	0		// tag_core.flags
+		.long	0		// tag_core.pagesize
+		.long	0		// tag_core.rootdev
+		// header
+		.long	2 + 2		// tag_header.size // header + mem32
+		.long	0x54410002	// tag_header.tag  // ATAG_MEM
+		// mem32
+		.long	MEM_SIZE	// tag_mem32.size
+		.long	PHYS_OFFSET	// tag_mem32.start
+		// header
+		.long	0		// tag_header.size
+		.long	0x00000000	// tag_header.tag  // ATAG_NONE
+__tag_end:
+		.long	0, 0, 0, 0	// padding
+__ARCH_ID:	.long	ARCH_ID
+pxa27x_copy_tail:
diff -uNr linux-2.6.17.org/arch/arm/boot/rom/pxa27x-sandgate2p.h linux-2.6.17/arch/arm/boot/rom/pxa27x-sandgate2p.h
--- linux-2.6.17.org/arch/arm/boot/rom/pxa27x-sandgate2p.h	1970-01-01 09:00:00.000000000 +0900
+++ linux-2.6.17/arch/arm/boot/rom/pxa27x-sandgate2p.h	2006-10-28 14:42:37.000000000 +0900
@@ -0,0 +1,72 @@
+/*
+ * arch/arm/boot/rom/pxa27x-sandgate2p.h
+ *
+ * Copyright (C) 2005-2006 WILLCOM, Inc. All rights Reserved.
+ *  $Date: 2006/09/25 06:52:35 $ Fujitsu Software Technologies Limited.
+ */
+
+/*
+ * GPIO
+ */
+/* GPDR */
+#define	VAL_GPDR0	0x00208000
+#define	VAL_GPDR1	0x00cf0382
+#define	VAL_GPDR2	0x0021c000
+#define	VAL_GPDR3	0x00000000
+/* GPSR */
+#define	VAL_GPSR0	0x00008000
+#define	VAL_GPSR1	0x00cf0002
+#define	VAL_GPSR2	0x0021c000
+#define	VAL_GPSR3	0x00000000
+/* GPCR */
+#define	VAL_GPCR0	0xffffffff
+#define	VAL_GPCR1	0xffffffff
+#define	VAL_GPCR2	0xffffffff
+#define	VAL_GPCR3	0xffffffff
+/* GAFR */
+#define	VAL_GAFR0_L	0x80000000
+#define	VAL_GAFR0_U	0x00000010
+#define	VAL_GAFR1_L	0x000a9558
+#define	VAL_GAFR1_U	0x000590aa
+#define	VAL_GAFR2_L	0xa0000000
+#define	VAL_GAFR2_U	0x00000402
+#define	VAL_GAFR3_L	0x00000000
+#define	VAL_GAFR3_U	0x00001400
+
+/*
+ * Memory Control
+ */
+#define	VAL_MDCNFG	0x00000ac8
+#define	VAL_MDMRS	0x00000000
+#define	VAL_MDREFR	0x0091c031
+#define	VAL_MSC0	0x92909290
+#define	VAL_MSC1	0x00008041
+#define	VAL_MSC2	0xb884b88c
+#define	VAL_MECR	0x00000001
+#define	VAL_MCMEM0	0x00014307
+#define	VAL_MCMEM1	0x00014307
+#define	VAL_MCATT0	0x0001c787
+#define	VAL_MCATT1	0x0001c787
+#define	VAL_MCIO0	0x0001430f
+#define	VAL_MCIO1	0x0001430f
+
+/* UART */
+#define	UART_CKEN	CKEN7_BTUART
+#define	UART_BASE	__PREG(BTUART)
+#define	UART_GPDR	__PREG(GPDR1)
+#define	UART_GPSR	__PREG(GPSR1)
+#define	UART_GPCR	__PREG(GPCR1)
+#define	UART_GAFR	__PREG(GAFR1_L)
+#define	UART_GPIO_SET	(GPIO_bit(GPIO43_BTTXD) | GPIO_bit(GPIO45_BTRTS))
+#define	UART_GPIO_CLR	(GPIO_bit(GPIO42_BTRXD) | GPIO_bit(GPIO44_BTCTS))
+#define	UART_GPIO_FUNC	(1 << 20 | 2 << 22 | 1 << 24 | 2 << 26)
+
+/* architecture ID */
+#define	ARCH_ID		MACH_TYPE_SANDGATE2P
+
+/* FlashROM */
+#define	ROM_BASE	PXA_CS0_PHYS
+#define	ROM_END		PXA_CS2_PHYS
+
+/* CCCR */
+#define	VAL_CCCR	0x00000310	// T=614MHz, R=208MHz
diff -uNr linux-2.6.17.org/arch/arm/boot/rom/pxa27x-sandgate-vp.h linux-2.6.17/arch/arm/boot/rom/pxa27x-sandgate-vp.h
--- linux-2.6.17.org/arch/arm/boot/rom/pxa27x-sandgate-vp.h	1970-01-01 09:00:00.000000000 +0900
+++ linux-2.6.17/arch/arm/boot/rom/pxa27x-sandgate-vp.h	2006-10-28 14:42:37.000000000 +0900
@@ -0,0 +1,75 @@
+/*
+ * arch/arm/boot/rom/pxa27x-sandgate-vp.h
+ *
+ * Copyright (c) 2006 Sophia Systems Co.,Ltd.
+ *  $Date: 2006/09/25 07:11:45 $ Fujitsu Software Technologies Limited.
+ */
+
+/*
+ * GPIO
+ */
+/* GPDR */
+#define	VAL_GPDR0	0x00598000
+#define	VAL_GPDR1	0x00Df3BD0
+#define	VAL_GPDR2	0xC3F7C000
+#define	VAL_GPDR3	0x00021F8D
+/* GPSR */
+#define	VAL_GPSR0	0x00108000
+#define	VAL_GPSR1	0x00CF0080
+#define	VAL_GPSR2	0x40350000
+#define	VAL_GPSR3	0x00020000
+/* GPCR */
+#define	VAL_GPCR0	0x00490000
+#define	VAL_GPCR1	0x00103B50
+#define	VAL_GPCR2	0x83C2C000
+#define	VAL_GPCR3	0x00001F8D
+/* GAFR */
+#define	VAL_GAFR0_L	0x80000000
+#define	VAL_GAFR0_U	0x00000002
+#define	VAL_GAFR1_L	0x00900000
+#define	VAL_GAFR1_U	0x0005A0AA
+#define	VAL_GAFR2_L	0x40000000
+#define	VAL_GAFR2_U	0x00000400
+#define	VAL_GAFR3_L	0x00000000
+#define	VAL_GAFR3_U	0x00000000
+
+/*
+ * Memory Control
+ */
+#define	VAL_MDCNFG	0x0b002bcf
+#define	VAL_MDMRS	0x00000000
+#define	VAL_MDREFR	0x200fe02e
+#define	VAL_MSC0	0x98e898e8
+#define	VAL_MSC1	0x0000bdd9
+#define	VAL_MSC2	0x0000388c
+#define	VAL_MECR	0x00000001
+#define	VAL_MCMEM0	0x00014307
+#define	VAL_MCMEM1	0x00014307
+#define	VAL_MCATT0	0x0001c787
+#define	VAL_MCATT1	0x0001c787
+#define	VAL_MCIO0	0x0001430f
+#define	VAL_MCIO1	0x0001430f
+
+/* UART */
+#define	UART_CKEN	CKEN7_BTUART
+#define	UART_BASE	__PREG(BTUART)
+#define	UART_GPDR	__PREG(GPDR1)
+#define	UART_GPSR	__PREG(GPSR1)
+#define	UART_GPCR	__PREG(GPCR1)
+#define	UART_GAFR	__PREG(GAFR1_L)
+#define	UART_GPIO_SET	(GPIO_bit(GPIO43_BTTXD))
+#define	UART_GPIO_CLR	(GPIO_bit(GPIO42_BTRXD))
+#define	UART_GPIO_FUNC	(1 << 20 | 2 << 22 | 1 << 24 | 2 << 26)
+
+/* architecture ID */
+#define	ARCH_ID		MACH_TYPE_SANDGATEVP
+
+/* FlashROM */
+#define	ROM_BASE	PXA_CS0_PHYS
+#define	ROM_END		PXA_CS2_PHYS
+
+/* CCCR */
+#define	VAL_CCCR	0x02000210	// A=1, T=416MHz, R=208MHz
+
+/* Power I2C */
+#define	PI2C_SLAVE_ADDR	0x76
