+           Say Y to support the sandgate2p board keypad debug.
+
+config KEYPAD_BLACKRIVER
+        tristate "BlackRiver Keypad"
+        depends on MACH_BLACKRIVER
+        default y
+        help
+           Say Y to support the blackriver board keypad.
+
+config KEYPAD_BLACKRIVER_DEBUG
+        bool "BlackRiver Keypad debug"
+        depends on KEYPAD_BLACKRIVER
+        default n
+        help
+           Say Y to support the blackriver board keypad debug.
+
+config KEYPAD_SANDGATEVP
+        tristate "Sandgate-VP Keypad"
+        depends on MACH_SANDGATEVP
+        default y
+        help
+           Say Y to support the sandgate-vp board keypad.
+
 endif
diff -uNr linux-2.6.17.org/drivers/input/keyboard/mainstone_kp.c linux-2.6.17/drivers/input/keyboard/mainstone_kp.c
--- linux-2.6.17.org/drivers/input/keyboard/mainstone_kp.c	1970-01-01 09:00:00.000000000 +0900
+++ linux-2.6.17/drivers/input/keyboard/mainstone_kp.c	2006-10-28 14:42:38.000000000 +0900
@@ -0,0 +1,255 @@
+/*
+ *  linux/drivers/input/keyboard/mainstone_kp.c
+ *
+ *  Keypad driver for mainstone Platform
+ *
+ *  Copyright (C) 2004, Intel Corporation (jingqing.xu@intel.com)
+ *
+ *  This program is free software; you can redistribute it and/or modify
+ *  it under the terms of the GNU General Public License version 2 as
+ *  published by the Free Software Foundation.
+ *
+ * Copyright (C) 2005-2006 WILLCOM, Inc. All rights Reserved.
+ */
+#include <linux/module.h>
+#include <linux/init.h>
+#include <linux/input.h>
+#include <linux/interrupt.h>
+#include <asm/irq.h>
+#include <asm/hardware.h> 
+#include <asm/arch/pxa-regs.h>
+#include <linux/platform_device.h>
+MODULE_AUTHOR("Xu Jingqing <Jingqing.Xu@intel.com>");
+MODULE_DESCRIPTION("Mainstone III keypad driver");
+MODULE_LICENSE("GPL");
+ 
+static unsigned char mainstone_keycode[0x78] = {
+	[0]	 = KEY_A,
+	[1]	 = KEY_G,
+	[2]	 = KEY_M,
+	[3]	 = KEY_S,
+	[4]	 = KEY_DOT,
+	[5]	 = KEY_HOME,
+	[0xA]    = KEY_UP,
+        [0xB]    = KEY_DOWN,
+        [0XC]    = KEY_KPENTER,
+	[0x10]	 = KEY_B,
+	[0x11]	 = KEY_H,
+	[0x12]	 = KEY_N,
+	[0x13]	 = KEY_T,
+	[0x14]	 = KEY_EMAIL,
+	[0x15]	 = KEY_UP,
+	[0x20]	 = KEY_C,
+	[0x21]	 = KEY_I,
+	[0x22]	 = KEY_O,
+	[0x23]	 = KEY_U,
+	[0x24]	 = KEY_Y,
+	[0x25]	 = KEY_SPACE,
+	[0x30]	 = KEY_D,
+	[0x31]	 = KEY_J,
+	[0x32]	 = KEY_P,
+	[0x33]	 = KEY_V,
+	[0x34]	 = KEY_Z,
+	[0x35]	 = KEY_SPACE,
+	[0x40]	 = KEY_E,
+	[0x41]	 = KEY_K,
+	[0x42]	 = KEY_Q,
+	[0x43]	 = KEY_W,
+	[0x44]	 = KEY_SLASH,
+	[0x45]	 = KEY_KPENTER,
+	[0x50]	 = KEY_F,
+	[0x51]	 = KEY_L,
+	[0x52]	 = KEY_R,
+	[0x53]	 = KEY_X,
+	[0x54]	 = KEY_BACKSLASH,
+	[0x55]	 = KEY_ESC,
+};
+static struct input_dev mainstone_kp_dev;
+/* scan code */
+#define ROTARY_DEFAULT			0x7F
+#define NO_KEY				0xFF
+#define SCAN_CODE_SCROLL_UP		0xA
+#define SCAN_CODE_SCROLL_DOWN		0xB
+#define SCAN_CODE_ACTION		0xC
+
+static int kp_direct_scan(void)
+{
+	static int prev;
+	u32 curr;
+	u32 direct, rotary;
+	u8 c;
+        direct 	= KPDK;
+	rotary 	= KPREC;
+	/* Rotary */
+	curr = rotary & 0xFF;
+	if (rotary & KPREC_OF0) {
+		KPREC 	&= ~KPREC_OF0;
+		KPREC	|= ROTARY_DEFAULT;
+		prev 	= ROTARY_DEFAULT;
+		c 	= SCAN_CODE_SCROLL_UP;
+	}
+	else if (rotary & KPREC_UF0) {
+		KPREC 	&= ~KPREC_UF0;
+		KPREC	|= ROTARY_DEFAULT;
+		prev 	= ROTARY_DEFAULT;
+		c 	= SCAN_CODE_SCROLL_DOWN;
+	}
+	else if (curr > prev) {
+		c 	= SCAN_CODE_SCROLL_UP;
+		prev	= curr;
+	}
+	else if (curr < prev) {
+		c	= SCAN_CODE_SCROLL_DOWN;
+		prev	= curr;
+	}
+
+	if (direct & KPDK_DK2) {
+		c	= SCAN_CODE_ACTION;
+		prev	= curr;
+	}
+
+	return 0;
+}
+
+static int kp_matrix_scan(void)
+{
+	u32 autoscan, n;
+	u8 c;
+	autoscan = KPAS;
+	n = (autoscan >> 26) & 0x1f;
+	c = autoscan & 0xff;
+	/* encode scan-code */
+	if ( n == 1 ){
+        	input_report_key(&mainstone_kp_dev,mainstone_keycode[c], 1 );
+        	input_report_key(&mainstone_kp_dev,mainstone_keycode[c], 0 );
+ 		return 0;
+	}
+	else 
+		return 1;
+}
+
+/* Interrupt Handler for KEYPAD */
+static irqreturn_t kp_interrupt(int irq, void *ptr, struct pt_regs *regs) 
+{
+	unsigned long kpc_val;
+
+	/* ack interrupt */
+	kpc_val = KPC;
+        
+	/* direct interrupt */
+	if (kpc_val & KPC_DI) 
+                kp_direct_scan();
+
+	/* matrix interrupt */
+	if (kpc_val & KPC_MI) 
+		kp_matrix_scan();
+
+        return IRQ_HANDLED;
+
+}
+static void kpad_configure()
+{
+	pxa_gpio_mode(93 | GPIO_ALT_FN_1_IN);   /* DKIN0 */
+	pxa_gpio_mode(94 | GPIO_ALT_FN_1_IN);   /* DKIN1 */
+	pxa_gpio_mode( 98 | GPIO_ALT_FN_3_IN); 	/* MKIN4 */
+	pxa_gpio_mode( 99 | GPIO_ALT_FN_3_IN);  /* MKIN5 */
+        pxa_gpio_mode(100 | GPIO_ALT_FN_1_IN);  /* MKIN0 */
+ 	pxa_gpio_mode(101 | GPIO_ALT_FN_1_IN);  /* MKIN1 */
+	pxa_gpio_mode(102 | GPIO_ALT_FN_1_IN);  /* MKIN2 */
+	pxa_gpio_mode( 97 | GPIO_ALT_FN_3_IN);  /* MKIN3 */
+	pxa_gpio_mode(103 | GPIO_ALT_FN_2_OUT); /* MKOUT0 */
+	pxa_gpio_mode(104 | GPIO_ALT_FN_2_OUT); /* MKOUT1 */
+	pxa_gpio_mode(105 | GPIO_ALT_FN_2_OUT); /* MKOUT2 */
+	pxa_gpio_mode(106 | GPIO_ALT_FN_2_OUT); /* MKOUT3 */
+	pxa_gpio_mode(107 | GPIO_ALT_FN_2_OUT); /* MKOUT4 */
+	pxa_gpio_mode(108 | GPIO_ALT_FN_2_OUT); /* MKOUT5 */
+
+	/* enable unit clock */
+	CKEN |= CKEN19_KEYPAD;
+
+//FIXME:PXA27x E11
+#ifdef CONFIG_PXA27x_E11
+	/* debouce setting: matrix debouce + direct debouce */
+   	KPKDI= 10 + (2 << 8);  
+#else
+	KPKDI= 2 << 8;
+#endif 
+	/* set scroll wheel value to mid-point value */
+	KPREC= ROTARY_DEFAULT;
+
+	/* keypad control register */
+	KPC = (KPC_ASACT | (5<<26) | (5<<23)|
+		KPC_ME | (2<<6) | KPC_REE0 | KPC_DE | 
+		KPC_MS0 | KPC_MS1 | KPC_MS2 | KPC_MS3| 
+                KPC_MS4 | KPC_MS5 | KPC_MIE | KPC_DIE | KPC_IMKP);
+
+
+}
+static int mb_kp_resume( struct device * dev)
+{	
+	kpad_configure();
+	return 0;
+}
+
+static int mb_kp_suspend(struct device * dev, pm_message_t state)
+{
+	CKEN &= ~CKEN19_KEYPAD;
+	return 0;
+}
+
+static struct device_driver mb_kp_drv = {
+		.bus = &platform_bus_type,
+		.name = "mb_kp", 
+		.resume = mb_kp_resume,
+		.suspend = mb_kp_suspend,
+		};
+static struct platform_device * mb_kp_platform_device;
+static int __init mainstone_kp_init( void )
+{
+        int i,err;
+      
+	init_input_dev(&mainstone_kp_dev);
+
+	mainstone_kp_dev.evbit[0] = BIT(EV_KEY);
+	mainstone_kp_dev.keycode = mainstone_keycode;
+	mainstone_kp_dev.keycodesize = sizeof(unsigned char);
+	mainstone_kp_dev.keycodemax = ARRAY_SIZE(mainstone_keycode);
+
+	for (i = 0; i < 0x55; i++)
+		if (mainstone_keycode[i])
+			set_bit(mainstone_keycode[i], mainstone_kp_dev.keybit);
+
+	err = request_irq (IRQ_KEYPAD, kp_interrupt, 0, "Keypad", NULL);
+
+	if (err) {
+		printk (KERN_CRIT "Wow!  Can't register IRQ[%d] for Keypad\n", IRQ_KEYPAD);
+		return -1;
+	}
+	kpad_configure();
+	mainstone_kp_dev.name = "mainstoneIII keypad";
+	mainstone_kp_dev.phys = "mainstoneIII/input0";
+	mainstone_kp_dev.id.vendor = 0x0001;
+	mainstone_kp_dev.id.product = 0x0001;
+	mainstone_kp_dev.id.version = 0x0001;
+
+	input_register_device(&mainstone_kp_dev);
+	printk(KERN_INFO "input: mainstoneIII keypad!\n");
+	mb_kp_platform_device = platform_device_register_simple("mb_kp",0,0,0);
+	printk(KERN_INFO "platform bus: mainstoneIII keypad device!\n");
+	driver_register(&mb_kp_drv);
+	printk(KERN_INFO "input: mainstoneIII keypad driver!\n");
+	return 0;
+   
+}
+
+static void __exit mainstone_kp_exit( void )
+{
+	platform_device_unregister(mb_kp_platform_device);
+	driver_unregister(&mb_kp_drv);
+	input_unregister_device(&mainstone_kp_dev);
+	free_irq(IRQ_KEYPAD, NULL);
+}
+module_init(mainstone_kp_init);
+module_exit(mainstone_kp_exit);
+
+ 
diff -uNr linux-2.6.17.org/drivers/input/keyboard/Makefile linux-2.6.17/drivers/input/keyboard/Makefile
--- linux-2.6.17.org/drivers/input/keyboard/Makefile	2006-10-28 14:34:46.000000000 +0900
+++ linux-2.6.17/drivers/input/keyboard/Makefile	2006-10-28 14:42:38.000000000 +0900
@@ -1,6 +1,12 @@
 #
 # Makefile for the input core drivers.
 #
+# Copyright (C) 2005-2006 WILLCOM, Inc. All rights Reserved.
+#
+# This program is free software; you can redistribute it and/or modify
+# it under the terms of the GNU General Public License version 2 as
+# published by the Free Software Foundation.
+#
 
 # Each configuration option enables a list of files.
 
@@ -15,4 +21,9 @@
 obj-$(CONFIG_KEYBOARD_SPITZ)		+= spitzkbd.o
 obj-$(CONFIG_KEYBOARD_HIL)		+= hil_kbd.o
 obj-$(CONFIG_KEYBOARD_HIL_OLD)		+= hilkbd.o
+obj-$(CONFIG_KEYPAD_MAINSTONE)		+= mainstone_kp.o
+obj-$(CONFIG_SWITCHES_SANDGATE2G)	+= sandgate2g_switches.o
+obj-$(CONFIG_KEYPAD_SANDGATE2P)		+= sandgate2p_kp.o
+obj-$(CONFIG_KEYPAD_BLACKRIVER)		+= blackriver_kp.o
+obj-$(CONFIG_KEYPAD_SANDGATEVP)		+= sandgatevp_kp.o
 
diff -uNr linux-2.6.17.org/drivers/input/keyboard/sandgate2g_switches.c linux-2.6.17/drivers/input/keyboard/sandgate2g_switches.c
--- linux-2.6.17.org/drivers/input/keyboard/sandgate2g_switches.c	1970-01-01 09:00:00.000000000 +0900
+++ linux-2.6.17/drivers/input/keyboard/sandgate2g_switches.c	2006-10-28 14:42:38.000000000 +0900
@@ -0,0 +1,140 @@
+/*
+ *  linux/drivers/input/keyboard/sandgate2g_switches.c
+ *
+ *  switch->keypress driver for sandgate2g Platform
+ *
+ *  This works very nicely for switches 1,2 and 3 but the
+ *  3-way switch 4 suffers a lot from not being debounced.
+ *  I thought this might be a function of the CPLD but
+ *  it would seem not.
+ *
+ *  Anyway, I only intended this to be functional enough for demo
+ *  purposes (i.e. use 1,2 & 3 to type in a number for a 
+ *  script, push sw4 to run it) and it does that much at least.
+ *
+ *  Maybe using sw4 in a way similar to shift/ctrl/alt to modify
+ *  the action of switches 1,2 & 3 would be better.
+ *
+ *  Copyright (C) 2004, Intel Corporation (adam.ward@intel.com)
+ *
+ *  This program is free software; you can redistribute it and/or modify
+ *  it under the terms of the GNU General Public License version 2 as
+ *  published by the Free Software Foundation.
+ *
+ * Copyright (C) 2005-2006 WILLCOM, Inc. All rights Reserved.
+ */
+#include <linux/module.h>
+#include <linux/init.h>
+#include <linux/input.h>
+#include <linux/interrupt.h>
+#include <asm/irq.h>
+#include <asm/hardware.h> 
+#include <asm/arch/pxa-regs.h>
+//#include <asm/arch/sandgate2g.h>
+#include <linux/platform_device.h>
+MODULE_AUTHOR("Adam Ward <adam.ward@intel.com>");
+MODULE_DESCRIPTION("Sandgate2G switches driver");
+MODULE_LICENSE("GPL");
+ 
+static unsigned char sandgate_keycode[0x78] = {
+	[0]	 = KEY_1,
+	[1]	 = KEY_2,
+	[2]	 = KEY_3,
+	[3]	 = KEY_UP,
+	[4]	 = KEY_DOWN,
+	[5]	 = KEY_KPENTER,
+};
+
+static struct input_dev sandgate_sw_dev;
+static int press_state[6]={1,1,1,1,1,1};
+
+/* Interrupt Handler for switches */
+static irqreturn_t sw_interrupt(int irq, void *ptr, struct pt_regs *regs) 
+{
+	unsigned int sg2g_switch = (irq - SANDGATE2G_SW1_IRQ);
+	/* ack interrupt */
+	SG2G_INTERRUPTS &= ~(SG2G_INT_SW1 << sg2g_switch);
+	input_report_key(&sandgate_sw_dev,sandgate_keycode[sg2g_switch], press_state[sg2g_switch] );
+	press_state[sg2g_switch]= 1 - press_state[sg2g_switch];
+        return IRQ_HANDLED;
+}
+
+static int sg2g_sw_resume(struct device * dev)
+{
+	return 0;
+}
+
+static int sg2g_sw_suspend(struct device * dev, pm_message_t state)
+{
+	return 0;
+}
+
+static struct device_driver sg2g_sw_drv = {
+		.bus = &platform_bus_type,
+		.name = "sg2g_sw", 
+		.resume = sg2g_sw_resume,
+		.suspend = sg2g_sw_suspend,
+		};
+static struct platform_device * sg2g_sw_platform_device;
+static int __init sandgate_sw_init( void )
+{
+        int i,err;
+      
+	init_input_dev(&sandgate_sw_dev);
+
+	sandgate_sw_dev.evbit[0] = BIT(EV_KEY);
+	sandgate_sw_dev.keycode = sandgate_keycode;
+	sandgate_sw_dev.keycodesize = sizeof(unsigned char);
+	sandgate_sw_dev.keycodemax = ARRAY_SIZE(sandgate_keycode);
+
+	for (i = 0; i < 0x55; i++)
+		if (sandgate_keycode[i])
+			set_bit(sandgate_keycode[i], sandgate_sw_dev.keybit);
+
+	for (i = 0; i <= 5; i++) {
+	    err = request_irq (SANDGATE2G_SW1_IRQ+i, sw_interrupt, 0, "Switches", NULL);
+
+	    if (err) {
+		printk (KERN_CRIT "Wow!  Can't register IRQ[%d] for Switches\n", SANDGATE2G_SW1_IRQ+i);
+		while(i>0) {
+		    i--;
+		    free_irq(SANDGATE2G_SW1_IRQ+i, NULL);
+		}		
+		return -1;
+	    }
+	}
+
+	SG2G_BCR2 &= ~SG2G_BCR2_SW_INT_MASK;	    
+
+	sandgate_sw_dev.name = "Sandgate2G switches";
+	sandgate_sw_dev.phys = "Sandgate2G/input0";
+	sandgate_sw_dev.id.vendor = 0x0001;
+	sandgate_sw_dev.id.product = 0x0001;
+	sandgate_sw_dev.id.version = 0x0001;
+
+	input_register_device(&sandgate_sw_dev);
+	printk(KERN_INFO "input: Sandgate2G switches\n");
+	sg2g_sw_platform_device = platform_device_register_simple("sg2g_sw",0,0,0);
+	printk(KERN_INFO "platform bus: Sandgate2G switches device\n");
+	driver_register(&sg2g_sw_drv);
+	printk(KERN_INFO "input: Sandgate2G switches driver\n");
+	return 0;
+   
+}
+
+static void __exit sandgate_sw_exit( void )
+{
+	int i;
+	
+	platform_device_unregister(sg2g_sw_platform_device);
+	driver_unregister(&sg2g_sw_drv);
+	input_unregister_device(&sandgate_sw_dev);
+	for (i = 0; i <= 5; i++) {
+	    free_irq(SANDGATE2G_SW1_IRQ+i, NULL);
+	}	    
+	SG2G_BCR2 |= SG2G_BCR2_SW_INT_MASK;	    
+}
+module_init(sandgate_sw_init);
+module_exit(sandgate_sw_exit);
+
+ 
diff -uNr linux-2.6.17.org/drivers/input/keyboard/sandgate2p_kp.c linux-2.6.17/drivers/input/keyboard/sandgate2p_kp.c
--- linux-2.6.17.org/drivers/input/keyboard/sandgate2p_kp.c	1970-01-01 09:00:00.000000000 +0900
+++ linux-2.6.17/drivers/input/keyboard/sandgate2p_kp.c	2006-10-28 14:42:38.000000000 +0900
@@ -0,0 +1,584 @@
+/*
+ *  linux/drivers/input/keyboard/sandgate2p_kp.c
+ *
+ *  Keypad driver for sandgate2p Platform
+ *
+ *  Copyright (C) 2004, Intel Corporation (jingqing.xu@intel.com)
+ *
+ *  This program is free software; you can redistribute it and/or modify
+ *  it under the terms of the GNU General Public License version 2 as
+ *  published by the Free Software Foundation.
+ *
+ * Copyright (C) 2005-2006 WILLCOM, Inc. All rights Reserved.
+ */
+#include <linux/module.h>
+#include <linux/init.h>
+#include <linux/input.h>
+#include <linux/interrupt.h>
+#include <asm/irq.h>
+#include <asm/hardware.h>
+#include <asm/arch/pxa-regs.h>
+#include <linux/platform_device.h>
+#include <asm/atomic.h>
+
+MODULE_AUTHOR("Xu Jingqing <Jingqing.Xu@intel.com>");
+MODULE_DESCRIPTION("SandgateII-P keypad driver");
+MODULE_LICENSE("GPL");
+
+#define MATRIX_ROW	3	/* IN0 - IN2 */
+#define MATRIX_COLUMN	7	/* OUT0 - OUT6 */
+#define KEYBUF		0x78	/* the number of key buf */
+
+#define	SG2P_SIDE	0x07
+#define	SG2P_PWR	0x09
+#define	MAX_KEYCODE	0x25
+
+#define	KPASMKP_CHECK(val1, val2, shift) \
+	(((val1) & (0xff << (shift))) != ((val2) & (0xff << (shift))))
+
+static unsigned long save_KPASMKP[4];
+static char press_state[KEYBUF];
+static atomic_t press_count;
+static unsigned char sandgate2p_keycode[KEYBUF] = {
+	KEY_1,		/* 0x00:   2 */
+	KEY_2,		/* 0x01:   3 */
+	KEY_3,		/* 0x02:   4 */
+	KEY_4,		/* 0x03:   5 */
+	KEY_5,		/* 0x04:   6 */
+	KEY_6,		/* 0x05:   7 */
+	KEY_7,		/* 0x06:   8 */
+	KEY_LEFTALT,	/* 0x07:  56 */	/* side key */
+	KEY_F4,		/* 0x08:  62 */	/* side key */
+	KEY_POWER,	/* 0x09: 116 */ /* power key */
+	KEY_RESERVED,	/* 0x0a: */
+	KEY_RESERVED,	/* 0x0b: */
+	KEY_RESERVED,	/* 0x0c: */
+	KEY_RESERVED,	/* 0x0d: */
+	KEY_RESERVED,	/* 0x0e: */
+	KEY_RESERVED,	/* 0x0f: */
+	KEY_8,		/* 0x10:   9 */
+	KEY_9,		/* 0x11:  10 */
+	KEY_0,		/* 0x12:  11 */
+	KEY_F1,		/* 0x13:  59 */
+	KEY_F2,		/* 0x14:  60 */
+	KEY_PHONE,	/* 0x15: 169 */
+	KEY_LEFTCTRL,	/* 0x16:  29 */
+	KEY_RESERVED,	/* 0x17: */
+	KEY_RESERVED,	/* 0x18: */
+	KEY_RESERVED,	/* 0x19: */
+	KEY_RESERVED,	/* 0x1a: */
+	KEY_RESERVED,	/* 0x1b: */
+	KEY_RESERVED,	/* 0x1c: */
+	KEY_RESERVED,	/* 0x1d: */
+	KEY_RESERVED,	/* 0x1e: */
+	KEY_RESERVED,	/* 0x1f: */
+	KEY_ESC,	/* 0x20:   1 */
+	KEY_DOWN,	/* 0x21: 108 */
+	KEY_UP,		/* 0x22: 103 */
+	KEY_LEFT,	/* 0x23: 105 */
+	KEY_RIGHT,	/* 0x24: 106 */
+	KEY_ENTER,	/* 0x25:  28 */
+	KEY_RESERVED,	/* 0x26: */
+	KEY_RESERVED,	/* 0x27: */
+	KEY_RESERVED,	/* 0x28: */
+	KEY_RESERVED,	/* 0x29: */
+	KEY_RESERVED,	/* 0x2a: */
+	KEY_RESERVED,	/* 0x2b: */
+	KEY_RESERVED,	/* 0x2c: */
+	KEY_RESERVED,	/* 0x2d: */
+	KEY_RESERVED,	/* 0x2e: */
+	KEY_RESERVED,	/* 0x2f: */
+	KEY_Q,		/* 0x30:  16 */
+	KEY_W,		/* 0x31:  17 */
+	KEY_E,		/* 0x32:  18 */
+	KEY_R,		/* 0x33:  19 */
+	KEY_T,		/* 0x34:  20 */
+	KEY_Y,		/* 0x35:  21 */
+	KEY_U,		/* 0x36:  22 */
+	KEY_I,		/* 0x37:  23 */
+	KEY_O,		/* 0x38:  24 */
+	KEY_P,		/* 0x39:  25 */
+	KEY_A,		/* 0x3a:  30 */
+	KEY_S,		/* 0x3b:  31 */
+	KEY_D,		/* 0x3c:  32 */
+	KEY_F,		/* 0x3d:  33 */
+	KEY_G,		/* 0x3e:  34 */
+	KEY_H,		/* 0x3f:  35 */
+	KEY_J,		/* 0x40:  36 */
+	KEY_K,		/* 0x41:  37 */
+	KEY_L,		/* 0x42:  38 */
+	KEY_Z,		/* 0x43:  44 */
+	KEY_X,		/* 0x44:  45 */
+	KEY_C,		/* 0x45:  46 */
+	KEY_V,		/* 0x46:  47 */
+	KEY_B,		/* 0x47:  48 */
+	KEY_N,		/* 0x48:  49 */
+	KEY_M,		/* 0x49:  50 */
+};
+
+#ifdef CONFIG_KEYPAD_SANDGATE2P_DEBUG
+static void keycode_dbgprint(u8 c, int state)
+{
+	char	key[16];
+	u8	code = sandgate2p_keycode[c];
+
+	switch (code) {
+	case KEY_1:
+		strcpy(key, "[1]    ");
+		break;
+	case KEY_2:
+		strcpy(key, "[2]    ");
+		break;
+	case KEY_3:
+		strcpy(key, "[3]    ");
+		break;
+	case KEY_4:
+		strcpy(key, "[4]    ");
+		break;
+	case KEY_5:
+		strcpy(key, "[5]    ");
+		break;
+	case KEY_6:
+		strcpy(key, "[6]    ");
+		break;
+	case KEY_7:
+		strcpy(key, "[7]    ");
+		break;
+	case KEY_8:
+		strcpy(key, "[8]    ");
+		break;
+	case KEY_9:
+		strcpy(key, "[9]    ");
+		break;
+	case KEY_0:
+		strcpy(key, "[0]    ");
+		break;
+	case KEY_F1:
+		strcpy(key, "[A]    ");
+		break;
+	case KEY_F2:
+		strcpy(key, "[B]    ");
+		break;
+	case KEY_PHONE:
+		strcpy(key, "[ON]   ");
+		break;
+	case KEY_KPASTERISK:
+	case KEY_LEFTCTRL:
+		strcpy(key, "[*]    ");
+		break;
+	case KEY_ESC:
+		strcpy(key, "[#]    ");
+		break;
+	case KEY_DOWN:
+		strcpy(key, "[DOWN] ");
+		break;
+	case KEY_UP:
+		strcpy(key, "[UP]   ");
+		break;
+	case KEY_LEFT:
+		strcpy(key, "[LEFT] ");
+		break;
+	case KEY_RIGHT:
+		strcpy(key, "[RIGHT]");
+		break;
+	case KEY_ENTER:
+		strcpy(key, "[ENTER]");
+		break;
+	case KEY_F3:
+	case KEY_LEFTALT:
+		strcpy(key, "[SIDE1]");
+		break;
+	case KEY_F4:
+		strcpy(key, "[SIDE2]");
+		break;
+	case KEY_POWER:
+		strcpy(key, "[OFF]  ");
+		break;
+	default:
+		strcpy(key, "[ERROR]");
+		break;
+	}
+
+	switch (state) {
+	case 0:
+	case 1:
+		printk("code[%2x] key %s status %s\n",
+		   c, key, (state == 1) ? "(Key Down)" : "(Key Up)");
+		break;
+	default:
+		printk("%s ", key);
+		break;
+	}
+}
+#define	DBGPRT(x, y)	keycode_dbgprint(x, y)
+#else
+#define	DBGPRT(x, y)
+#endif /* CONFIG_KEYPAD_SANDGATE2P_DEBUG */
+
+static struct input_dev *sandgate2p_kp_dev;
+
+static void __kp_updown_report(u8 c, u8 state)
+{
+	press_state[c] = state;
+	input_report_key(sandgate2p_kp_dev, sandgate2p_keycode[c], state);
+	DBGPRT(c, state);
+}
+
+static void __kp_matrix_scan(u8 c, u8 mkc, u8 mask)
+{
+	if (mkc & mask) {
+		if (!press_state[c]) {
+			atomic_inc(&press_count);
+			__kp_updown_report(c, 1);	/* Down */
+		}
+	} else {
+		if (press_state[c]) {
+			atomic_dec(&press_count);
+			__kp_updown_report(c, 0);	/* Up */
+		}
+	}
+}
+
+static void __kp_special_scan(u8 c)
+{
+	if (!press_state[c]) {
+		__kp_updown_report(c, 1);	/* Down */
+	} else if (press_state[c]) {
+		__kp_updown_report(c, 0);	/* Up */
+	}
+}
+
+static int kp_matrix_scan(int irq)
+{
+	u32		autoscan;
+	u8		c = -1, mkc;
+	int		i, n = -1;
+	unsigned long	kpc_val;
+
+	if (irq == IRQ_GPIO0) {
+		/* Read OFF/ESC Key */
+		__kp_special_scan((u8)SG2P_PWR);
+	} else if (irq == IRQ_GPIO(GPIO_82_PTT_SW)) {
+		/* Read SIDE Key */
+		__kp_special_scan((u8)SG2P_SIDE);
+	}
+
+	/* check keypad interrupt */
+	/* ack interrupt */
+	kpc_val = KPC;
+
+	/* matrix interrupt */
+	if (kpc_val & KPC_MI) {
+		autoscan = KPAS;
+		n = (autoscan >> 26) & 0x1f;
+		c = autoscan & 0xff;
+	}
+
+	/* if keypad interrupt is active..*/
+	if (n == 1 && c <= MAX_KEYCODE && atomic_read(&press_count) == 0) {
+		/* Single key pressed. */
+		atomic_inc(&press_count);
+		__kp_updown_report(c, 1);
+	} else if (n == 0 && atomic_read(&press_count) != 0) {
+		/* No key pressed. */
+		for (i = 0; i <= MAX_KEYCODE; i++) {
+			if (i == SG2P_PWR || i == SG2P_SIDE)
+				continue;
+			if (press_state[i]) {
+				atomic_dec(&press_count);
+				__kp_updown_report(i, 0);
+			}
+		}
+	} else if (n != -1) {
+		/* Multiples keys change. */
+
+		/* Read OUT0 */
+		if (KPASMKP_CHECK(save_KPASMKP[0], KPASMKP0, 0)) {
+			mkc = KPASMKP0 & 0xff;
+			__kp_matrix_scan((u8)((0 << 4) | 0x0), mkc, 1 << 0);
+			__kp_matrix_scan((u8)((1 << 4) | 0x0), mkc, 1 << 1);
+			__kp_matrix_scan((u8)((2 << 4) | 0x0), mkc, 1 << 2);
+		}
+
+		/* Read OUT1 */
+		if (KPASMKP_CHECK(save_KPASMKP[0], KPASMKP0, 16)) {
+			mkc = ((KPASMKP0 & 0xff0000) >> 16);
+			__kp_matrix_scan((u8)((0 << 4) | 0x1), mkc, 1 << 0);
+			__kp_matrix_scan((u8)((1 << 4) | 0x1), mkc, 1 << 1);
+			__kp_matrix_scan((u8)((2 << 4) | 0x1), mkc, 1 << 2);
+		}
+
+		/* Read OUT2 */
+		if (KPASMKP_CHECK(save_KPASMKP[1], KPASMKP1, 0)) {
+			mkc = (KPASMKP1 & 0xff);
+			__kp_matrix_scan((u8)((0 << 4) | 0x2), mkc, 1 << 0);
+			__kp_matrix_scan((u8)((1 << 4) | 0x2), mkc, 1 << 1);
+			__kp_matrix_scan((u8)((2 << 4) | 0x2), mkc, 1 << 2);
+		}
+
+		/* Read OUT3 */
+		if (KPASMKP_CHECK(save_KPASMKP[1], KPASMKP1, 16)) {
+			mkc = ((KPASMKP1 & 0xff0000) >> 16);
+			__kp_matrix_scan((u8)((0 << 4) | 0x3), mkc, 1 << 0);
+			__kp_matrix_scan((u8)((1 << 4) | 0x3), mkc, 1 << 1);
+			__kp_matrix_scan((u8)((2 << 4) | 0x3), mkc, 1 << 2);
+		}
+
+		/* Read OUT4 */
+		if (KPASMKP_CHECK(save_KPASMKP[2], KPASMKP2, 0)) {
+			mkc = (KPASMKP2 & 0xff);
+			__kp_matrix_scan((u8)((0 << 4) | 0x4), mkc, 1 << 0);
+			__kp_matrix_scan((u8)((1 << 4) | 0x4), mkc, 1 << 1);
+			__kp_matrix_scan((u8)((2 << 4) | 0x4), mkc, 1 << 2);
+		}
+
+		/* Read OUT5 */
+		if (KPASMKP_CHECK(save_KPASMKP[2], KPASMKP2, 16)) {
+			mkc = ((KPASMKP2 & 0xff0000) >> 16);
+			__kp_matrix_scan((u8)((0 << 4) | 0x5), mkc, 1 << 0);
+			__kp_matrix_scan((u8)((1 << 4) | 0x5), mkc, 1 << 1);
+			__kp_matrix_scan((u8)((2 << 4) | 0x5), mkc, 1 << 2);
+		}
+
+		/* Read OUT6 */
+		if (KPASMKP_CHECK(save_KPASMKP[3], KPASMKP3, 0)) {
+			mkc = (KPASMKP3 & 0xff);
+			__kp_matrix_scan((u8)((0 << 4) | 0x6), mkc, 1 << 0);
+			__kp_matrix_scan((u8)((1 << 4) | 0x6), mkc, 1 << 1);
+			//__kp_matrix_scan((u8)((2 << 4) | 0x6), mkc, 1 << 2);
+		}
+	}
+
+#ifdef CONFIG_KEYPAD_SANDGATE2P_DEBUG
+	{
+		int	j;
+
+		printk("key state all scan : ");
+		for (j = 0; j < KEYBUF; j++) {
+			if (press_state[j])
+				DBGPRT(j, 3);
+		}
+		printk("\n");
+		printk("press_state ");
+		for (j = 0; j < KEYBUF; j++)
+			printk("%d", press_state[j]);
+		printk("\n\n");
+	}
+#endif /* CONFIG_KEYPAD_SANDGATE2P_DEBUG */
+
+	save_KPASMKP[0] = KPASMKP0;
+	save_KPASMKP[1] = KPASMKP1;
+	save_KPASMKP[2] = KPASMKP2;
+	save_KPASMKP[3] = KPASMKP3;
+
+	return 0;
+}
+
+/* Interrupt Handler for KEYPAD */
+static irqreturn_t kp_interrupt(int irq, void *ptr, struct pt_regs *regs)
+{
+	kp_matrix_scan(irq);
+	return IRQ_HANDLED;
+}
+
+static void kpad_configure(void)
+{
+	pxa_gpio_mode(GPIO_0_PWR_SW | GPIO_IN); /* GPIO_0_PWR_SW (OFF KEY) */
+	pxa_gpio_mode(GPIO_82_PTT_SW | GPIO_IN); /* GPIO_82_PTT_SW (SIDE KEY) */
+
+	pxa_gpio_mode(100 | GPIO_ALT_FN_1_IN);	/* MKIN0 */
+ 	pxa_gpio_mode(101 | GPIO_ALT_FN_1_IN);	/* MKIN1 */
+	pxa_gpio_mode(102 | GPIO_ALT_FN_1_IN);	/* MKIN2 */
+	pxa_gpio_mode(103 | GPIO_ALT_FN_2_OUT); /* MKOUT0 */
+	pxa_gpio_mode(104 | GPIO_ALT_FN_2_OUT);	/* MKOUT1 */
+	pxa_gpio_mode(105 | GPIO_ALT_FN_2_OUT); /* MKOUT2 */
+	pxa_gpio_mode(106 | GPIO_ALT_FN_2_OUT); /* MKOUT3 */
+	pxa_gpio_mode(107 | GPIO_ALT_FN_2_OUT); /* MKOUT4 */
+	pxa_gpio_mode(108 | GPIO_ALT_FN_2_OUT); /* MKOUT5 */
+	pxa_gpio_mode( 96 | GPIO_ALT_FN_3_OUT); /* MKOUT6 */
+
+	/* enable unit clock */
+	CKEN |= CKEN19_KEYPAD;
+
+//FIXME:PXA27x E11
+#ifdef CONFIG_PXA27x_E11
+	/* debouce setting: matrix debouce + direct debouce */
+	KPKDI = 10 + (2 << 8);
+#else
+	KPKDI = 2 << 8;
+#endif
+
+	/* keypad control register */
+	KPC
+	  = (KPC_ASACT			/* Automatic Scan on Activity */
+	  | (MATRIX_ROW << 26)		/* rows 3 */
+	  | (MATRIX_COLUMN << 23)	/* column 7 */
+	  | KPC_ME			/* Matrix Enable */
+	  | KPC_REE0			/* Rotary Encoder 0 Enable */
+	  | KPC_MS0			/* Manual Matrix Scan Line 0 */
+	  | KPC_MS1			/* Manual Matrix Scan Line 1 */
+	  | KPC_MS2			/* Manual Matrix Scan Line 2 */
+	  | KPC_MS3			/* Manual Matrix Scan Line 3 */
+	  | KPC_MS4			/* Manual Matrix Scan Line 4 */
+	  | KPC_MS5			/* Manual Matrix Scan Line 5 */
+	  | KPC_MS6			/* Manual Matrix Scan Line 6 */
+	  | KPC_MIE);			/* Matrix Interrupt Enable */
+}
+
+static int mb_kp_resume(struct device * dev)
+{
+	kpad_configure();
+	return 0;
+}
+
+static int mb_kp_suspend(struct device * dev, pm_message_t state)
+{
+	CKEN &= ~CKEN19_KEYPAD;
+	//pxa_gpio_mode(GPIO_0_PWR_SW & ~GPIO_IN);
+	//pxa_gpio_mode(GPIO_82_PTT_SW & ~GPIO_OUT);
+	return 0;
+}
+
+static struct device_driver mb_kp_drv = {
+	.bus = &platform_bus_type,
+	.name = "mb_kp",
+	.resume = mb_kp_resume,
+	.suspend = mb_kp_suspend,
+};
+static struct platform_device * mb_kp_platform_device;
+
+static int sandgate2p_kp_irq_powersw;
+static int sandgate2p_kp_irq_pttsw;
+static int sandgate2p_kp_irq_keypad;
+static int sandgate2p_kp_driver_register;
+static int sandgate2p_kp_input_device_register;
+
+static void sandgate2p_kp_clean(void)
+{
+	CKEN &= ~CKEN19_KEYPAD;
+	pxa_gpio_mode(GPIO_0_PWR_SW & ~GPIO_IN);
+	pxa_gpio_mode(GPIO_82_PTT_SW & ~GPIO_OUT);
+
+	if (sandgate2p_kp_irq_powersw) {
+		free_irq(IRQ_GPIO0, NULL);
+		sandgate2p_kp_irq_powersw = 0;
+	}
+	if (sandgate2p_kp_irq_pttsw) {
+		free_irq(IRQ_GPIO(GPIO_82_PTT_SW), NULL);
+		sandgate2p_kp_irq_pttsw = 0;
+	}
+	if (sandgate2p_kp_irq_keypad) {
+		free_irq(IRQ_KEYPAD, NULL);
+		sandgate2p_kp_irq_keypad = 0;
+	}
+	if (sandgate2p_kp_driver_register) {
+		driver_unregister(&mb_kp_drv);
+		sandgate2p_kp_driver_register = 0;
+	}
+	if (mb_kp_platform_device) {
+		platform_device_unregister(mb_kp_platform_device);
+		mb_kp_platform_device = NULL;
+	}
+	if (sandgate2p_kp_input_device_register) {
+		input_unregister_device(sandgate2p_kp_dev);
+		sandgate2p_kp_input_device_register = 0;
+	}
+	if (sandgate2p_kp_dev) {
+		input_free_device(sandgate2p_kp_dev);
+		sandgate2p_kp_dev = NULL;
+	}
+}
+
+static int __init sandgate2p_kp_init(void)
+{
+	int	i, err;
+
+	if ((sandgate2p_kp_dev = input_allocate_device()) == NULL)
+		return -ENOMEM;
+
+	sandgate2p_kp_dev->evbit[0] = BIT(EV_KEY) | BIT(EV_PWR);
+	sandgate2p_kp_dev->keycode = sandgate2p_keycode;
+	sandgate2p_kp_dev->keycodesize = sizeof(unsigned char);
+	sandgate2p_kp_dev->keycodemax = ARRAY_SIZE(sandgate2p_keycode);
+
+	for (i = 0; i < KEYBUF; i++) {
+		if (sandgate2p_keycode[i])
+			set_bit(sandgate2p_keycode[i],
+			   sandgate2p_kp_dev->keybit);
+	}
+
+	err = request_irq (IRQ_KEYPAD, kp_interrupt, 0, "Keypad", NULL);
+	if (err) {
+		printk(KERN_CRIT "Wow! Can't register IRQ[%d] for Keypad\n",
+		  IRQ_KEYPAD);
+		sandgate2p_kp_clean();
+		return -1;
+	}
+	sandgate2p_kp_irq_keypad = 1;
+
+	set_irq_type(IRQ_GPIO0, IRQT_BOTHEDGE);
+	err = request_irq (IRQ_GPIO0, kp_interrupt, 0, "PWR_SW", NULL);
+	if (err) {
+		printk(KERN_CRIT "Wow! Can't register IRQ[%d] for Keypad\n",
+		  IRQ_GPIO0);
+		sandgate2p_kp_clean();
+		return -1;
+	}
+	sandgate2p_kp_irq_powersw = 1;
+
+	set_irq_type(IRQ_GPIO(GPIO_82_PTT_SW), IRQT_BOTHEDGE);
+	err = request_irq(IRQ_GPIO(GPIO_82_PTT_SW), kp_interrupt, 0, "PTT_SW", NULL);
+	if (err) {
+		printk(KERN_CRIT "Wow! Can't register IRQ[%d] for Keypad\n",
+		  IRQ_GPIO(GPIO_82_PTT_SW));
+		sandgate2p_kp_clean();
+		return -1;
+	}
+	sandgate2p_kp_irq_pttsw = 1;
+
+	kpad_configure();
+
+	sandgate2p_kp_dev->name = "SandgateII-P keypad";
+	sandgate2p_kp_dev->phys = "SandgateII-P/input0";
+	sandgate2p_kp_dev->id.vendor = 0x0001;
+	sandgate2p_kp_dev->id.product = 0x0001;
+	sandgate2p_kp_dev->id.version = 0x0001;
+
+	if (input_register_device(sandgate2p_kp_dev) != 0) {
+		printk(KERN_CRIT
+		    "sandgate2p_kp: fail input_register_device()\n");
+		sandgate2p_kp_clean();
+		return -1;
+	}
+	sandgate2p_kp_input_device_register = 1;
+	printk(KERN_INFO "input: SandgateII-P keypad!\n");
+
+	mb_kp_platform_device = platform_device_register_simple("mb_kp",0,0,0);
+	if (IS_ERR(mb_kp_platform_device)) {
+		printk(KERN_CRIT
+		    "sandgate2p_kp: fail platform_device_register_simple()\n");
+		mb_kp_platform_device = NULL;
+		sandgate2p_kp_clean();
+		return -1;
+	}
+	printk(KERN_INFO "platform bus: SandgateII-P keypad device!\n");
+
+	if (driver_register(&mb_kp_drv) != 0) {
+		printk(KERN_CRIT
+		    "sandgate2p_kp: fail driver_register()\n");
+		sandgate2p_kp_clean();
+		return -1;
+	}
+	sandgate2p_kp_driver_register = 1;
+	printk(KERN_INFO "input: SandgateII-P keypad driver!\n");
+
+	return 0;
+}
+
+static void __exit sandgate2p_kp_exit(void)
+{
+	sandgate2p_kp_clean();
+}
+
+module_init(sandgate2p_kp_init);
+module_exit(sandgate2p_kp_exit);
diff -uNr linux-2.6.17.org/drivers/input/keyboard/sandgatevp_kp.c linux-2.6.17/drivers/input/keyboard/sandgatevp_kp.c
--- linux-2.6.17.org/drivers/input/keyboard/sandgatevp_kp.c	1970-01-01 09:00:00.000000000 +0900
+++ linux-2.6.17/drivers/input/keyboard/sandgatevp_kp.c	2006-10-28 14:42:38.000000000 +0900
@@ -0,0 +1,440 @@
+/*
+ *  linux/drivers/input/keyboard/sandgatevp_kp.c
+ *
+ *  Keypad driver for sandgate-VP Platform
+ *
+ *  Copyright (C) 2004, Intel Corporation (jingqing.xu@intel.com)
+ *
+ *  This program is free software; you can redistribute it and/or modify
+ *  it under the terms of the GNU General Public License version 2 as
+ *  published by the Free Software Foundation.
+ *
+ * Copyright (c) 2006 Sophia Systems Co.,Ltd.
+ */
+#include <linux/module.h>
+#include <linux/init.h>
+#include <linux/input.h>
+#include <linux/interrupt.h>
+#include <asm/irq.h>
+#include <asm/hardware.h>
+#include <asm/arch/pxa-regs.h>
+#include <linux/platform_device.h>
+
+MODULE_AUTHOR("Xu Jingqing <Jingqing.Xu@intel.com>");
+MODULE_DESCRIPTION("Sandgate-VP keypad driver");
+MODULE_LICENSE("GPL");
+
+static int software_repeat = 1;	/* original default 0 */
+module_param(software_repeat, uint, 0644);
+MODULE_PARM_DESC(software_repeat, "Use software keyboard repeat");
+
+static int repeat_delay = 250;	/* original default 250 */
+module_param(repeat_delay, uint, 0644);
+MODULE_PARM_DESC(repeat_delay, "repeat delay time[msec]");
+
+static int repeat_period = 250;	/* original default 33 */
+module_param(repeat_period, uint, 0644);
+MODULE_PARM_DESC(repeat_period, "repeat period time[msec]");
+
+#define MATRIX_ROW	4	/* IN0 - IN3 */
+#define MATRIX_COLUMN	7	/* OUT0 - OUT6 */
+#define KEYBUF		0x78	/* the number of key buf */
+
+#define	KEYBUF_POWERSW	0x0f
+#define	KEYBUF_HOOKSW	0x0e
+
+#define	GPIO_POWERSW	GPIO_0_PWR_SW
+#define	GPIO_HOOKSW		GPIO_53_HOOK_SW
+
+#define	IRQ_POWERSW	IRQ_GPIO0
+#define	IRQ_HOOKSW	IRQ_GPIO(GPIO_HOOKSW)
+
+#define	PXA27x_KEYPAD_EXTENT	0x4c
+#define	PXA27x_KEYPAD_NAME	"pxa27x-keypad"
+
+#define Key_OK	0x25
+
+static char press_state[KEYBUF];
+static unsigned char	*sandgatevp_keycode;
+
+static int		sandgatevp_kp_irq_keypad;
+static int		sandgatevp_kp_irq_powersw;
+static int		sandgatevp_kp_irq_hooksw;
+static int		sandgatevp_kp_input_device_register;
+static int		sandgatevp_pointering_flag=0;
+
+static void __kp_updown_report(struct input_dev *dev, u8 c, u8 state)
+{
+	press_state[c] = state;
+	input_report_key(dev, sandgatevp_keycode[c], state);
+}
+
+static void __kp_matrix_scan(struct input_dev *dev, u8 c, u8 mkc, u8 mask)
+{
+	if (mkc & mask) 
+	{
+		if (!press_state[c]) {
+			if((pointMoved_flag == 1) && (c == Key_OK) && (sandgatevp_pointering_flag==0))
+			{	
+				sandgatevp_pointering_flag = 1;
+				input_report_key(pointer_dev, BTN_LEFT, 1);
+				press_state[c] = 1;
+			}
+			else if(( pointMoved_flag == 1) && (!press_state[Key_OK]))
+			{
+				pointMoved_flag = 0;
+				__kp_updown_report(dev, c, 1);	/* Down */
+			}
+			else
+				__kp_updown_report(dev, c, 1);	/* Down */
+		}
+	} 
+	else 
+	{
+		if (press_state[c]) {
+			if((pointMoved_flag == 1) && (c == Key_OK) && (sandgatevp_pointering_flag == 1))
+			{	
+				sandgatevp_pointering_flag = 0;
+				input_report_key(pointer_dev, BTN_LEFT, 0);
+				press_state[c] = 0;
+			}
+			else
+				__kp_updown_report(dev, c, 0);	/* Up */
+		}
+	}
+}
+
+static int kp_matrix_scan(struct input_dev *dev, int irq)
+{
+	u32		autoscan;
+	u8		c, mkc, mask;
+	int		i, n = -1;
+	unsigned long	kpc_val;
+
+	/* check keypad interrupt */
+	/* ack interrupt */
+	kpc_val = KPC;
+
+	/* matrix interrupt */
+	if (kpc_val & KPC_MI) {
+		autoscan = KPAS;
+		n = (autoscan >> 26) & 0x1f;
+		c = autoscan & 0xff;
+	}
+
+	/* if keypad interrupt is active..*/
+	if (n > -1) {
+
+		/* Read OUT0 */
+		mkc = KPASMKP0 & 0xff;
+		mask = 1;
+		for (i = 0; i < MATRIX_ROW; i++, mask <<= 1) {
+			__kp_matrix_scan(dev, (i << 4) | 0x0, mkc, mask);
+		}
+
+		/* Read OUT1 */
+		mkc = ((KPASMKP0 & 0xff0000) >> 16);
+		mask = 1;
+		for (i = 0; i < MATRIX_ROW; i++, mask <<= 1) {
+			__kp_matrix_scan(dev, (u8)((i << 4) | 0x1), mkc, mask);
+		}
+
+		/* Read OUT2 */
+		mkc = (KPASMKP1 & 0xff);
+		mask = 1;
+		for (i = 0; i < MATRIX_ROW; i++, mask <<= 1) {
+			__kp_matrix_scan(dev, (u8)((i << 4) | 0x2), mkc, mask);
+		}
+
+		/* Read OUT3 */
+		mkc = ((KPASMKP1 & 0xff0000) >> 16);
+		mask = 1;
+		for (i = 0; i < MATRIX_ROW; i++, mask <<= 1) {
+			__kp_matrix_scan(dev, (u8)((i << 4) | 0x3), mkc, mask);
+		}
+
+		/* Read OUT4 */
+		mkc = (KPASMKP2 & 0xff);
+		mask = 1;
+		for (i = 0; i < MATRIX_ROW; i++, mask <<= 1) {
+			__kp_matrix_scan(dev, (u8)((i << 4) | 0x4), mkc, mask);
+		}
+
+		/* Read OUT5 */
+		mkc = ((KPASMKP2 & 0xff0000) >> 16);
+		mask = 1;
+		for (i = 0; i < MATRIX_ROW-1; i++, mask <<= 1) {
+			__kp_matrix_scan(dev, (u8)((i << 4) | 0x5), mkc, mask);
+		}
+
+		/* Read OUT6 */
+		mkc = (KPASMKP3 & 0xff);
+		mask = 1;
+		/* i=2 is OFF Key */
+		for (i = 0; i < MATRIX_ROW-1; i++, mask <<= 1) {
+			__kp_matrix_scan(dev, (u8)((i << 4) | 0x6), mkc, mask);
+		}
+	}
+
+	return 0;
+}
+
+/* Interrupt Handler for KEYPAD */
+static irqreturn_t kp_interrupt(int irq, void *ptr, struct pt_regs *regs)
+{
+	
+	kp_matrix_scan(platform_get_drvdata((struct platform_device *)ptr),
+	    irq);
+	return IRQ_HANDLED;
+}
+
+/* Interrupt Handler for Hooksw */
+static irqreturn_t powersw_interrupt(int irq, void *ptr, struct pt_regs *regs)
+{
+	if((pointMoved_flag == 1) && (sandgatevp_pointering_flag == 0))
+		pointMoved_flag = 0;
+	__kp_updown_report(platform_get_drvdata((struct platform_device *)ptr),
+	    (u8)KEYBUF_POWERSW,
+	     GPLR(GPIO_POWERSW) & GPIO_bit(GPIO_POWERSW) ? 0 : 1);
+
+	return IRQ_HANDLED;
+}
+
+/* Interrupt Handler for Hooksw */
+static irqreturn_t hooksw_interrupt(int irq, void *ptr, struct pt_regs *regs)
+{
+	if((pointMoved_flag == 1) && (sandgatevp_pointering_flag == 0))
+		pointMoved_flag = 0;
+	__kp_updown_report(platform_get_drvdata((struct platform_device *)ptr),
+	    (u8)KEYBUF_HOOKSW,
+	     GPLR(GPIO_HOOKSW) & GPIO_bit(GPIO_HOOKSW) ? 0 : 1);
+
+	return IRQ_HANDLED;
+}
+
+static void kpad_configure(void)
+{
+	/* gpio */
+	pxa_gpio_mode(GPIO_53_HOOK_SW | GPIO_IN);	/* GPIO 53 HOOK_SW */
+	pxa_gpio_mode(GPIO_0_PWR_SW | GPIO_IN);		/* GPIO 0 PWR_SW */
+
+	pxa_gpio_mode(GPIO_100_KP_MKIN0  | GPIO_ALT_FN_1_IN);	/* MKIN0 */
+ 	pxa_gpio_mode(GPIO_101_KP_MKIN1  | GPIO_ALT_FN_1_IN);	/* MKIN1 */
+	pxa_gpio_mode(GPIO_102_KP_MKIN2  | GPIO_ALT_FN_1_IN);	/* MKIN2 */
+	pxa_gpio_mode(GPIO_97_KP_MKIN3   | GPIO_ALT_FN_3_IN);	/* MKIN3 */
+	pxa_gpio_mode(GPIO_103_KP_MKOUT0 | GPIO_ALT_FN_2_OUT);	/* MKOUT0 */
+	pxa_gpio_mode(GPIO_104_KP_MKOUT1 | GPIO_ALT_FN_2_OUT);	/* MKOUT1 */
+	pxa_gpio_mode(GPIO_105_KP_MKOUT2 | GPIO_ALT_FN_2_OUT);	/* MKOUT2 */
+	pxa_gpio_mode(GPIO_106_KP_MKOUT3 | GPIO_ALT_FN_2_OUT);	/* MKOUT3 */
+	pxa_gpio_mode(GPIO_107_KP_MKOUT4 | GPIO_ALT_FN_2_OUT);	/* MKOUT4 */
+	pxa_gpio_mode(GPIO_108_KP_MKOUT5 | GPIO_ALT_FN_2_OUT);	/* MKOUT5 */
+	pxa_gpio_mode(GPIO_96_KP_MKOUT6  | GPIO_ALT_FN_3_OUT);	/* MKOUT6 */
+
+	/* enable unit clock */
+	CKEN |= CKEN19_KEYPAD;
+
+//FIXME:PXA27x E11
+#ifdef CONFIG_PXA27x_E11
+	/* debouce setting: matrix debouce + direct debouce */
+	KPKDI= 10 + (2 << 8);
+#else
+	KPKDI= 2 << 8;
+#endif
+
+	/* keypad control register */
+	KPC
+	  = (KPC_ASACT			/* Automatic Scan on Activity */
+	  | (MATRIX_ROW << 26)		/* rows 4 */
+	  | (MATRIX_COLUMN << 23)	/* column 7 */
+	  | KPC_ME			/* Matrix Enable */
+	  | KPC_REE0			/* Rotary Encoder 0 Enable */
+	  | KPC_MS0			/* Manual Matrix Scan Line 0 */
+	  | KPC_MS1			/* Manual Matrix Scan Line 1 */
+	  | KPC_MS2			/* Manual Matrix Scan Line 2 */
+	  | KPC_MS3			/* Manual Matrix Scan Line 3 */
+	  | KPC_MS4			/* Manual Matrix Scan Line 4 */
+	  | KPC_MS5			/* Manual Matrix Scan Line 5 */
+	  | KPC_MS6			/* Manual Matrix Scan Line 6 */
+	  | KPC_MIE);			/* Matrix Interrupt Enable */
+}
+
+static void sandgatevp_kp_clean(struct platform_device *pdev)
+{
+	struct resource		*res;
+	static struct input_dev	*input_dev;
+
+	sandgatevp_keycode = NULL;
+
+	CKEN &= ~CKEN19_KEYPAD;
+	pxa_gpio_mode(GPIO_POWERSW & ~GPIO_IN);
+
+	if (sandgatevp_kp_irq_keypad) {
+		free_irq(IRQ_KEYPAD, pdev);
+		sandgatevp_kp_irq_keypad = 0;
+	}
+	if (sandgatevp_kp_irq_powersw) {
+		free_irq(IRQ_POWERSW, pdev);
+		sandgatevp_kp_irq_powersw = 0;
+	}
+	if (sandgatevp_kp_irq_hooksw) {
+		free_irq(IRQ_HOOKSW, pdev);
+		sandgatevp_kp_irq_hooksw = 0;
+	}
+	if ((input_dev = platform_get_drvdata(pdev)) != NULL) {
+		input_unregister_device(input_dev);
+		input_free_device(input_dev);
+		platform_set_drvdata(pdev, NULL);
+	}
+
+	res = platform_get_resource_byname(pdev,
+	    IORESOURCE_MEM,
+	    PXA27x_KEYPAD_NAME);
+	if (res) {
+		release_mem_region(res->start, PXA27x_KEYPAD_EXTENT);
+	}
+}
+
+static int __init sandgatevp_kp_probe(struct platform_device *pdev)
+{
+	static struct input_dev *input_dev;
+	struct resource		*res;
+	int			i, err;
+	struct keypad_data {
+		unsigned int	keycodemax;
+		unsigned int	keycodesize;
+		void		*keycode;
+	} *data;
+
+	res = platform_get_resource_byname(pdev,
+	    IORESOURCE_MEM,
+	    PXA27x_KEYPAD_NAME);
+	if (!res) {
+		return -ENODEV;
+	}
+	data = pdev->dev.platform_data;
+	if (!request_mem_region(res->start,
+	    PXA27x_KEYPAD_EXTENT,
+	    PXA27x_KEYPAD_NAME)) {
+		return -EBUSY;
+	}
+
+	if ((input_dev = input_allocate_device()) == NULL) {
+		release_mem_region(res->start, PXA27x_KEYPAD_EXTENT);
+		return -ENOMEM;
+	}
+	platform_set_drvdata(pdev, input_dev);
+
+	input_dev->evbit[0] = BIT(EV_KEY);
+	if (software_repeat)
+		input_dev->evbit[0] |= BIT(EV_REP);
+
+	input_dev->keycode = data->keycode;
+	sandgatevp_keycode = data->keycode;
+	input_dev->keycodesize = data->keycodesize;
+	input_dev->keycodemax = data->keycodemax;
+
+	for (i = 0; i < data->keycodemax; i++) {
+		if (sandgatevp_keycode[i])
+			set_bit(sandgatevp_keycode[i],
+			   input_dev->keybit);
+	}
+
+	/* keypad */
+	err = request_irq(IRQ_KEYPAD, kp_interrupt, 0, "Keypad", pdev);
+	if (err) {
+		printk(KERN_CRIT "Wow! Can't register IRQ[%d] for Keypad\n",
+		  IRQ_KEYPAD);
+		sandgatevp_kp_clean(pdev);
+		return -1;
+	}
+	sandgatevp_kp_irq_keypad = 1;
+
+	/* power sw */
+	pxa_gpio_mode(GPIO_POWERSW | GPIO_IN); /* GPIO_0_PWR_SW (OFF KEY) */
+	set_irq_type(IRQ_POWERSW, IRQT_BOTHEDGE);
+	err = request_irq(IRQ_POWERSW, powersw_interrupt, 0, "Power SW", pdev);
+	if (err) {
+		printk(KERN_CRIT "Wow! Can't register IRQ[%d] for Power SW\n",
+		  IRQ_POWERSW);
+		sandgatevp_kp_clean(pdev);
+		return -1;
+	}
+	sandgatevp_kp_irq_powersw = 1;
+
+	/* hook sw */
+	pxa_gpio_mode(GPIO_HOOKSW | GPIO_IN); /* GPIO_81_HOOK_SW */
+	set_irq_type(IRQ_HOOKSW, IRQT_BOTHEDGE);
+	err = request_irq(IRQ_HOOKSW, hooksw_interrupt,
+	    SA_SHIRQ, "Hook SW", pdev);
+	if (err) {
+		printk(KERN_CRIT "Wow! Can't register IRQ[%d] for Hook SW\n",
+		  IRQ_HOOKSW);
+		sandgatevp_kp_clean(pdev);
+		return -1;
+	}
+	sandgatevp_kp_irq_hooksw = 1;
+
+	kpad_configure();
+
+	input_dev->name = PXA27x_KEYPAD_NAME;
+	input_dev->phys = "pxa27x/input0";
+	input_dev->id.vendor = 0x0001;
+	input_dev->id.product = 0x0001;
+	input_dev->id.version = 0x0001;
+
+	if (input_register_device(input_dev) != 0) {
+		printk(KERN_CRIT
+		    "sandgatevp_kp: fail input_register_device()\n");
+		sandgatevp_kp_clean(pdev);
+		return -1;
+	}
+	if (software_repeat) {
+		input_dev->rep[REP_DELAY] = repeat_delay;
+		input_dev->rep[REP_PERIOD] = repeat_period;
+	}
+	sandgatevp_kp_input_device_register = 1;
+	printk(KERN_INFO "input: sandgatevp keypad driver!\n");
+
+	return 0;
+}
+
+static int sandgatevp_kp_remove(struct platform_device *pdev)
+{
+	sandgatevp_kp_clean(pdev);
+	return 0;
+}
+
+static int sandgatevp_kp_suspend(struct platform_device *pdev, pm_message_t state)
+{
+	CKEN &= ~CKEN19_KEYPAD;
+	return 0;
+}
+
+static int sandgatevp_kp_resume(struct platform_device *pdev)
+{
+	kpad_configure();
+	return 0;
+}
+
+static struct platform_driver sandgatevp_kp_driver = {
+	.probe		= sandgatevp_kp_probe,
+	.remove		= sandgatevp_kp_remove,
+	.suspend	= sandgatevp_kp_suspend,
+	.resume		= sandgatevp_kp_resume,
+	.driver		= {
+		.name	= "pxa27x-keypad",
+	},
+};
+
+static int __init sandgatevp_kp_init(void)
+{
+	return platform_driver_register(&sandgatevp_kp_driver);
+}
+
+static void __exit sandgatevp_kp_exit(void)
+{
+	platform_driver_unregister(&sandgatevp_kp_driver);
+}
+
+module_init(sandgatevp_kp_init);
+module_exit(sandgatevp_kp_exit);
