+# Boot options
+#
+CONFIG_ZBOOT_ROM_TEXT=0x0
+CONFIG_ZBOOT_ROM_BSS=0x0
+CONFIG_CMDLINE="console=ttyS0,115200 mem=64M@0xa0000000 root=/dev/mtdblock1 rootfstype=jffs2"
+# CONFIG_XIP_KERNEL is not set
+CONFIG_ROMBOOT=y
+CONFIG_CONFIG_DMA_IN_BOOT=y
+
+#
+# CPU Frequency scaling
+#
+CONFIG_CPU_FREQ=y
+CONFIG_CPU_FREQ_TABLE=y
