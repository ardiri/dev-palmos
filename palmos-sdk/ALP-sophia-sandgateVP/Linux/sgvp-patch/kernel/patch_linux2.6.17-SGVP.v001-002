diff -uNr linux-2.6.17.org/arch/arm/mach-pxa/leds-sandgate2.c linux-2.6.17/arch/arm/mach-pxa/leds-sandgate2.c
--- linux-2.6.17.org/arch/arm/mach-pxa/leds-sandgate2.c	1970-01-01 09:00:00.000000000 +0900
+++ linux-2.6.17/arch/arm/mach-pxa/leds-sandgate2.c	2006-10-28 14:42:38.000000000 +0900
@@ -0,0 +1,117 @@
+/*
+ * linux/arch/arm/mach-pxa/leds-sandgate2.c
+ *
+ * modified by Adam Ward (adam.ward@intel.com) in 2005 from
+ *
+ * linux/arch/arm/mach-pxa/leds-mainstone.c
+ *
+ * Author:     Nicolas Pitre
+ * Created:    Nov 05, 2002
+ * Copyright:  MontaVista Software Inc.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 as
+ * published by the Free Software Foundation.
+ *
+ * Copyright (C) 2005-2006 WILLCOM, Inc. All rights Reserved.
+ */
+
+#include <linux/config.h>
+#include <linux/types.h>
+#include <linux/init.h>
+
+#include <asm/hardware.h>
+#include <asm/leds.h>
+#include <asm/system.h>
+
+#include <asm/arch/pxa-regs.h>
+#include <asm/arch/sandgate2.h>
+
+#include "leds.h"
+
+
+#define LED_STATE_ENABLED	1
+#define LED_STATE_CLAIMED	2
+
+static unsigned int led_state;
+static unsigned int hw_led_state;
+
+void sandgate2_leds_event(led_event_t evt)
+{
+	unsigned long flags;
+
+	local_irq_save(flags);
+
+	switch (evt) {
+	case led_start:
+		hw_led_state = 0;
+		led_state = LED_STATE_ENABLED;
+		break;
+
+	case led_stop:
+		led_state &= ~LED_STATE_ENABLED;
+		break;
+
+	case led_claim:
+		led_state |= LED_STATE_CLAIMED;
+		hw_led_state = 0;
+		break;
+
+	case led_release:
+		led_state &= ~LED_STATE_CLAIMED;
+		hw_led_state = 0;
+		break;
+
+#ifdef CONFIG_LEDS_TIMER
+	case led_timer:
+		hw_led_state ^= SG2_BCR_REDLED;
+		break;
+#endif
+
+#ifdef CONFIG_LEDS_CPU
+	case led_idle_start:
+		hw_led_state |= SG2_BCR_GRNLED;
+		break;
+
+	case led_idle_end:
+		hw_led_state &= ~SG2_BCR_GRNLED;
+		break;
+#endif
+
+	case led_halted:
+		break;
+
+	case led_green_on:
+		hw_led_state |= SG2_BCR_GRNLED;
+		break;
+
+	case led_green_off:
+		hw_led_state &= ~SG2_BCR_GRNLED;
+		break;
+
+	case led_amber_on:
+		break;
+
+	case led_amber_off:
+		break;
+
+	case led_red_on:
+		hw_led_state |= SG2_BCR_REDLED;
+		break;
+
+	case led_red_off:
+		hw_led_state &= ~SG2_BCR_REDLED;
+		break;
+
+	default:
+		break;
+	}
+
+	sandgate2_bcr &= ~(SG2_BCR_REDLED | SG2_BCR_GRNLED);
+	if  (led_state & LED_STATE_ENABLED) {
+	    sandgate2_bcr |= (hw_led_state &= (SG2_BCR_REDLED | SG2_BCR_GRNLED));
+        }
+	SG2_BCR = sandgate2_bcr;
+
+	local_irq_restore(flags);
+}
diff -uNr linux-2.6.17.org/arch/arm/mach-pxa/leds-sandgate2g.c linux-2.6.17/arch/arm/mach-pxa/leds-sandgate2g.c
--- linux-2.6.17.org/arch/arm/mach-pxa/leds-sandgate2g.c	1970-01-01 09:00:00.000000000 +0900
+++ linux-2.6.17/arch/arm/mach-pxa/leds-sandgate2g.c	2006-10-28 14:42:38.000000000 +0900
@@ -0,0 +1,116 @@
+/*
+ * linux/arch/arm/mach-pxa/leds-sandgate2g.c
+ *
+ * modified by Adam Ward (adam.ward@intel.com) in 2005 from
+ *
+ * linux/arch/arm/mach-pxa/leds-mainstone.c
+ *
+ * Author:     Nicolas Pitre
+ * Created:    Nov 05, 2002
+ * Copyright:  MontaVista Software Inc.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 as
+ * published by the Free Software Foundation.
+ *
+ * Copyright (C) 2005-2006 WILLCOM, Inc. All rights Reserved.
+ */
+
+#include <linux/config.h>
+#include <linux/types.h>
+#include <linux/init.h>
+
+#include <asm/hardware.h>
+#include <asm/leds.h>
+#include <asm/system.h>
+
+#include <asm/arch/pxa-regs.h>
+#include <asm/arch/sandgate2g.h>
+
+#include "leds.h"
+
+
+#define LED_STATE_ENABLED	1
+#define LED_STATE_CLAIMED	2
+
+static unsigned int led_state;
+static unsigned int hw_led_state;
+
+void sandgate2g_leds_event(led_event_t evt)
+{
+	unsigned long flags;
+
+	local_irq_save(flags);
+
+	switch (evt) {
+	case led_start:
+		hw_led_state = 0;
+		led_state = LED_STATE_ENABLED;
+		break;
+
+	case led_stop:
+		led_state &= ~LED_STATE_ENABLED;
+		break;
+
+	case led_claim:
+		led_state |= LED_STATE_CLAIMED;
+		hw_led_state = 0;
+		break;
+
+	case led_release:
+		led_state &= ~LED_STATE_CLAIMED;
+		hw_led_state = 0;
+		break;
+
+#ifdef CONFIG_LEDS_TIMER
+	case led_timer:
+		hw_led_state ^= SG2G_BCR1_REDLED;
+		break;
+#endif
+
+#ifdef CONFIG_LEDS_CPU
+	case led_idle_start:
+		hw_led_state |= SG2G_BCR1_GRNLED;
+		break;
+
+	case led_idle_end:
+		hw_led_state &= ~SG2G_BCR1_GRNLED;
+		break;
+#endif
+
+	case led_halted:
+		break;
+
+	case led_green_on:
+		hw_led_state |= SG2G_BCR1_GRNLED;
+		break;
+
+	case led_green_off:
+		hw_led_state &= ~SG2G_BCR1_GRNLED;
+		break;
+
+	case led_amber_on:
+		break;
+
+	case led_amber_off:
+		break;
+
+	case led_red_on:
+		hw_led_state |= SG2G_BCR1_REDLED;
+		break;
+
+	case led_red_off:
+		hw_led_state &= ~SG2G_BCR1_REDLED;
+		break;
+
+	default:
+		break;
+	}
+
+        SG2G_BCR1 &= ~(SG2G_BCR1_REDLED | SG2G_BCR1_GRNLED);
+	if  (led_state & LED_STATE_ENABLED) {
+	    SG2G_BCR1 |= (hw_led_state & (SG2G_BCR1_REDLED | SG2G_BCR1_GRNLED));
+	}
+
+	local_irq_restore(flags);
+}
diff -uNr linux-2.6.17.org/arch/arm/mach-pxa/leds-sandgate2p.c linux-2.6.17/arch/arm/mach-pxa/leds-sandgate2p.c
