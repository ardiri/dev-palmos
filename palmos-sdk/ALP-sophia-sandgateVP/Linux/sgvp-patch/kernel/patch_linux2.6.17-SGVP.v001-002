+#if defined(CONFIG_MMC_PXA) || defined(CONFIG_MMC_PXA_MODULE)
+/*
+ * MultiMediaCard/SD/SDIO Controller
+ */
+static int sandgate_vp_mci_init(struct device *dev, irqreturn_t (*sandgate_vp_detect_int)(int, void *, struct pt_regs *), void *data)
+{
+	int err;
+
+	/*
+	 * setup GPIO for PXA27x MMC controller
+	 */
+	pxa_gpio_mode(GPIO32_MMCCLK_MD);
+	pxa_gpio_mode(GPIO112_MMCCMD_MD);
+	pxa_gpio_mode(GPIO92_MMCDAT0_MD);
+	pxa_gpio_mode(GPIO109_MMCDAT1_MD);
+	pxa_gpio_mode(GPIO110_MMCDAT2_MD);
+	pxa_gpio_mode(GPIO111_MMCDAT3_MD);
+
+	/*
+	 * setup mmc detect interrupt
+	 */
+	err = request_irq(SANDGATEVP_SD_IN_IRQ,
+		sandgate_vp_detect_int,
+		SA_INTERRUPT | SA_SHIRQ,
+		"MMC card detect in",
+		data);
+	if (err) {
+		printk(KERN_ERR
+		  "%s: MMC/SD: can't request MMC card detect in IRQ(%d)\n",
+		  __FUNCTION__, SANDGATEVP_SD_IN_IRQ);
+		return -1;
+	}
+	err = request_irq(SANDGATEVP_SD_OUT_IRQ,
+		sandgate_vp_detect_int,
+		SA_INTERRUPT | SA_SHIRQ,
+		"MMC card detect out",
+		data);
+	if (err) {
+		printk(KERN_ERR
+		  "%s: MMC/SD: can't request MMC card detect out IRQ(%d)\n",
+		  __FUNCTION__, SANDGATEVP_SD_OUT_IRQ);
+		free_irq(SANDGATEVP_SD_IN_IRQ, data);
+		return -1;
+	}
+
+	return 0;
+}
+
+static void sandgate_vp_mci_setpower(struct device *dev, unsigned int vdd)
+{
+	/*
+	 * SD PWR is controlled by hardware.
+	 */
+}
+
+static void sandgate_vp_mci_exit(struct device *dev, void *data)
+{
+	/*
+	 * MMC Detect Interrupt is free.
+	 */
+	free_irq(SANDGATEVP_SD_IN_IRQ, data);
+	free_irq(SANDGATEVP_SD_OUT_IRQ, data);
+}
