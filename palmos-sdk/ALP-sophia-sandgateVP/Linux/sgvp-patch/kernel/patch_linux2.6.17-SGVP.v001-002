 #ifdef CONFIG_CPU_FREQ
+
+#ifdef CONFIG_FAST_DVFM_DPM
+void pxafb_wait_for_eof(unsigned int clkcfg)
+#else
+void pxafb_wait_for_eof(void)
+#endif /* CONFIG_FAST_DVFM_DPM */
+{
+	unsigned long flags;
+	DECLARE_WAITQUEUE(wait, current);
+#ifdef CONFIG_FAST_DVFM_DPM
+	fcs_clkcfg = clkcfg;
+#endif /* CONFIG_FAST_DVFM_DPM */
+	down(&fcs_lcd_sem);
+	add_wait_queue(&fcs_wait_eof, &wait);
+	set_current_state(TASK_UNINTERRUPTIBLE);
+	/* if LCD controller is disabled or is disabling, we do not need wait 
+	   eof. directly change frequency.
+	*/
+	local_irq_save(flags);
+	if ((LCCR0 & LCCR0_DIS) || !(LCCR0 & LCCR0_ENB)) { 
+		fcs_in_eof = 0;
+		local_irq_restore(flags);
+#ifdef CONFIG_FAST_DVFM_DPM
+		fcs_lcd_disable = 1;
+		pxa27x_setspeed(fcs_clkcfg);
+#endif /* CONFIG_FAST_DVFM_DPM */
+		current->state = TASK_RUNNING;
+		remove_wait_queue(&fcs_wait_eof, &wait);
+		up(&fcs_lcd_sem);
+		return ;
+	}
+
+#ifdef CONFIG_FAST_DVFM_DPM
+	fcs_lcd_disable = 0;
+#endif /* CONFIG_FAST_DVFM_DPM */
+	fcs_in_eof = 1;
+	/* enable end of frame interrupt */
+	LCCR0 &= ~LCCR0_EFM;
+	local_irq_restore(flags);
+	schedule_timeout(20 * HZ / 1000);
+	current->state = TASK_RUNNING;
+	remove_wait_queue(&fcs_wait_eof, &wait);	
+	up(&fcs_lcd_sem);
+}
+EXPORT_SYMBOL(pxafb_wait_for_eof);
+
