diff -uNr linux-2.6.17.org/drivers/pcmcia/pxa2xx_sandgate2.c linux-2.6.17/drivers/pcmcia/pxa2xx_sandgate2.c
--- linux-2.6.17.org/drivers/pcmcia/pxa2xx_sandgate2.c	1970-01-01 09:00:00.000000000 +0900
+++ linux-2.6.17/drivers/pcmcia/pxa2xx_sandgate2.c	2006-10-28 14:42:38.000000000 +0900
@@ -0,0 +1,174 @@
+/*
+ * linux/drivers/pcmcia/pxa2xx_sandgate2.c
+ *
+ * Mainstone PCMCIA specific routines.
+ *
+ * Created:	May 12, 2004
+ * Author:	Nicolas Pitre
+ * Copyright:	MontaVista Software Inc.
+ *
+ * modified from linux/drivers/pcmcia/pxa2xx_mainstone.c
+ * by Adam Ward (adam.ward@intel.com) in 2005
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 as
+ * published by the Free Software Foundation.
+ *
+ * Copyright (C) 2005-2006 WILLCOM, Inc. All rights Reserved.
+ */
+
+#include <linux/module.h>
+#include <linux/init.h>
+#include <linux/kernel.h>
+#include <linux/errno.h>
+#include <linux/interrupt.h>
+#include <linux/device.h>
+
+#include <pcmcia/ss.h>
+
+#include <asm/hardware.h>
+#include <asm/irq.h>
+
+#include <asm/arch/pxa-regs.h>
+#include <asm/arch/sandgate2.h>
+
+#include "soc_common.h"
+
+
+static struct pcmcia_irqs irqs[] = {
+	{ 0, SANDGATE2_CF_DETECT_IRQ, "PCMCIA0 IN/OUT" },
+};
+
+static int sg2_pcmcia_hw_init(struct soc_pcmcia_socket *skt)
+{
+	/*
+	 * Setup default state of GPIO outputs
+	 * before we enable them as outputs.
+	 */
+	GPSR(GPIO48_nPOE) =
+		GPIO_bit(GPIO48_nPOE) |
+		GPIO_bit(GPIO49_nPWE) |
+		GPIO_bit(GPIO50_nPIOR) |
+		GPIO_bit(GPIO51_nPIOW) |
+		GPIO_bit(GPIO85_nPCE_1) |
+		GPIO_bit(GPIO54_nPCE_2);
+
+	pxa_gpio_mode(GPIO48_nPOE_MD);
+	pxa_gpio_mode(GPIO49_nPWE_MD);
+	pxa_gpio_mode(GPIO50_nPIOR_MD);
+	pxa_gpio_mode(GPIO51_nPIOW_MD);
+	pxa_gpio_mode(GPIO85_nPCE_1_MD);
+	pxa_gpio_mode(GPIO54_nPCE_2_MD);
+	pxa_gpio_mode(GPIO55_nPREG_MD);
+	pxa_gpio_mode(GPIO56_nPWAIT_MD);
+	pxa_gpio_mode(GPIO57_nIOIS16_MD);
+
+	skt->irq = SANDGATE2_CF_IRQ;
+	return soc_pcmcia_request_irqs(skt, irqs, ARRAY_SIZE(irqs));
+}
+
+static void sg2_pcmcia_hw_shutdown(struct soc_pcmcia_socket *skt)
+{
+	soc_pcmcia_free_irqs(skt, irqs, ARRAY_SIZE(irqs));
+}
+
+static unsigned long sg2_pcmcia_status;
+
+static void sg2_pcmcia_socket_state(struct soc_pcmcia_socket *skt,
+				    struct pcmcia_state *state)
+{
+	unsigned long status, flip;
+
+	status = SG2_STATUS & 0x01FFF;
+
+	flip = (status ^ sg2_pcmcia_status) & SG2_STATUS_CF_DETECT;
+	if (flip) {
+	    sg2_pcmcia_status = status;
+	    if (status & SG2_STATUS_CF_DETECT) {
+	       sandgate2_bcr |= SG2_BCR_CF_PWR_ON;
+	       sandgate2_bcr &= ~SG2_BCR_nCF_BUS_ON;	
+	       SG2_BCR = sandgate2_bcr;
+	    } else {
+	       sandgate2_bcr &= ~SG2_BCR_CF_PWR_ON;	
+	       sandgate2_bcr |= SG2_BCR_nCF_BUS_ON;
+	       SG2_BCR = sandgate2_bcr;
+	    }
+	}
+
+	state->detect = (status & SG2_STATUS_CF_DETECT) ? 1 : 0;
+	state->ready  = (GPLR(22) & GPIO_bit(22)) ? 1 : 0;
+	state->bvd1   = (status & SG2_STATUS_CF_BVD1) ? 1 : 0;
+	state->bvd2   = (status & SG2_STATUS_CF_BVD2) ? 1 : 0;
+	state->vs_3v  = 0;  /* not available */
+	state->vs_Xv  = 0;  /* not available */
+	state->wrprot = 0;  /* not available */
+}
+
+static int sg2_pcmcia_configure_socket(struct soc_pcmcia_socket *skt,
+				       const socket_state_t *state)
+{
+	if (state->flags & SS_RESET) {
+	       sandgate2_bcr |= SG2_BCR_CF_RESET;
+	       SG2_BCR = sandgate2_bcr;
+	} else {
+	       sandgate2_bcr &= ~SG2_BCR_CF_RESET;
+	       SG2_BCR = sandgate2_bcr;
+	}
+
+	return 0;
+}
+
+static void sg2_pcmcia_socket_init(struct soc_pcmcia_socket *skt)
+{
+}
+
+static void sg2_pcmcia_socket_suspend(struct soc_pcmcia_socket *skt)
+{
+}
+
+static struct pcmcia_low_level sg2_pcmcia_ops = {
+	.owner			= THIS_MODULE,
+	.hw_init		= sg2_pcmcia_hw_init,
+	.hw_shutdown		= sg2_pcmcia_hw_shutdown,
+	.socket_state		= sg2_pcmcia_socket_state,
+	.configure_socket	= sg2_pcmcia_configure_socket,
+	.socket_init		= sg2_pcmcia_socket_init,
+	.socket_suspend		= sg2_pcmcia_socket_suspend,
+	.nr			= 1,
+};
+
+static struct platform_device *sg2_pcmcia_device;
+
+static int __init sg2_pcmcia_init(void)
+{
+	int ret;
+
+	sg2_pcmcia_device = kmalloc(sizeof(*sg2_pcmcia_device), GFP_KERNEL);
+	if (!sg2_pcmcia_device)
+		return -ENOMEM;
+	memset(sg2_pcmcia_device, 0, sizeof(*sg2_pcmcia_device));
+	sg2_pcmcia_device->name = "pxa2xx-pcmcia";
+	sg2_pcmcia_device->dev.platform_data = &sg2_pcmcia_ops;
+
+	ret = platform_device_register(sg2_pcmcia_device);
+	if (ret)
+		kfree(sg2_pcmcia_device);
+
+	return ret;
+}
+
+static void __exit sg2_pcmcia_exit(void)
+{
+	/*
+	 * This call is supposed to free our sg2g_pcmcia_device.
+	 * Unfortunately platform_device don't have a free method, and
+	 * we can't assume it's free of any reference at this point so we
+	 * can't free it either.
+	 */
+	platform_device_unregister(sg2_pcmcia_device);
+}
+
+module_init(sg2_pcmcia_init);
+module_exit(sg2_pcmcia_exit);
+
+MODULE_LICENSE("GPL");
diff -uNr linux-2.6.17.org/drivers/pcmcia/pxa2xx_sandgate2g.c linux-2.6.17/drivers/pcmcia/pxa2xx_sandgate2g.c
--- linux-2.6.17.org/drivers/pcmcia/pxa2xx_sandgate2g.c	1970-01-01 09:00:00.000000000 +0900
+++ linux-2.6.17/drivers/pcmcia/pxa2xx_sandgate2g.c	2006-10-28 14:42:38.000000000 +0900
@@ -0,0 +1,171 @@
+/*
+ * linux/drivers/pcmcia/pxa2xx_sandgate2g.c
+ *
+ * Mainstone PCMCIA specific routines.
+ *
+ * Created:	May 12, 2004
+ * Author:	Nicolas Pitre
+ * Copyright:	MontaVista Software Inc.
+ *
+ * modified from linux/drivers/pcmcia/pxa2xx_mainstone.c
+ * by Adam Ward (adam.ward@intel.com) in 2005
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 as
+ * published by the Free Software Foundation.
+ *
+ * Copyright (C) 2005-2006 WILLCOM, Inc. All rights Reserved.
+ */
+
+#include <linux/module.h>
+#include <linux/init.h>
+#include <linux/kernel.h>
+#include <linux/errno.h>
+#include <linux/interrupt.h>
+#include <linux/device.h>
+
+#include <pcmcia/ss.h>
+
+#include <asm/hardware.h>
+#include <asm/irq.h>
+
+#include <asm/arch/pxa-regs.h>
+#include <asm/arch/sandgate2g.h>
+
+#include "soc_common.h"
+
+
+static struct pcmcia_irqs irqs[] = {
+	{ 0, SANDGATE2G_CF_IN_IRQ, "PCMCIA0 IN" },
+	{ 0, SANDGATE2G_CF_OUT_IRQ, "PCMCIA0 OUT" },
+};
+
+static int sg2g_pcmcia_hw_init(struct soc_pcmcia_socket *skt)
+{
+	/*
+	 * Setup default state of GPIO outputs
+	 * before we enable them as outputs.
+	 */
+	GPSR(GPIO48_nPOE) =
+		GPIO_bit(GPIO48_nPOE) |
+		GPIO_bit(GPIO49_nPWE) |
+		GPIO_bit(GPIO50_nPIOR) |
+		GPIO_bit(GPIO51_nPIOW) |
+		GPIO_bit(GPIO85_nPCE_1) |
+		GPIO_bit(GPIO54_nPCE_2);
+
+	pxa_gpio_mode(GPIO48_nPOE_MD);
+	pxa_gpio_mode(GPIO49_nPWE_MD);
+	pxa_gpio_mode(GPIO50_nPIOR_MD);
+	pxa_gpio_mode(GPIO51_nPIOW_MD);
+	pxa_gpio_mode(GPIO85_nPCE_1_MD);
+	pxa_gpio_mode(GPIO54_nPCE_2_MD);
+	pxa_gpio_mode(GPIO55_nPREG_MD);
+	pxa_gpio_mode(GPIO56_nPWAIT_MD);
+	pxa_gpio_mode(GPIO57_nIOIS16_MD);
+
+	skt->irq = SANDGATE2G_CF_IRQ;
+	return soc_pcmcia_request_irqs(skt, irqs, ARRAY_SIZE(irqs));
+}
+
+static void sg2g_pcmcia_hw_shutdown(struct soc_pcmcia_socket *skt)
+{
+	soc_pcmcia_free_irqs(skt, irqs, ARRAY_SIZE(irqs));
+}
+
+static unsigned long sg2g_pcmcia_status;
+
+static void sg2g_pcmcia_socket_state(struct soc_pcmcia_socket *skt,
+				    struct pcmcia_state *state)
+{
+	unsigned long status, flip;
+
+	status = SG2G_STATUS & 0x01FFF;
+
+	flip = (status ^ sg2g_pcmcia_status) & SG2G_STATUS_CF_DETECT;
+	if (flip) {
+	    sg2g_pcmcia_status = status;
+	    if (status & SG2G_STATUS_CF_DETECT) {
+	       SG2G_BCR1 |= SG2G_BCR1_CF_PWR_ON;
+	       SG2G_BCR1 &= ~SG2G_BCR1_nCF_BUS_ON;	
+	    } else {
+	       SG2G_BCR1 &= ~SG2G_BCR1_CF_PWR_ON;	
+	       SG2G_BCR1 |= SG2G_BCR1_nCF_BUS_ON;
+	    }
+	}
+
+	state->detect = (status & SG2G_STATUS_CF_DETECT) ? 1 : 0;
+	state->ready  = (GPLR(22) & GPIO_bit(22)) ? 1 : 0;
+	state->bvd1   = (status & SG2G_STATUS_CF_BVD1) ? 1 : 0;
+	state->bvd2   = (status & SG2G_STATUS_CF_BVD2) ? 1 : 0;
+	state->vs_3v  = 0;  /* not available */
+	state->vs_Xv  = 0;  /* not available */
+	state->wrprot = 0;  /* not available */
+}
+
+static int sg2g_pcmcia_configure_socket(struct soc_pcmcia_socket *skt,
+				       const socket_state_t *state)
+{
+	if (state->flags & SS_RESET) {
+	       SG2G_BCR1 |= SG2G_BCR1_CF_RESET;
+	} else {
+	       SG2G_BCR1 &= ~SG2G_BCR1_CF_RESET;	
+	}
+
+	return 0;
+}
+
+static void sg2g_pcmcia_socket_init(struct soc_pcmcia_socket *skt)
+{
+}
+
+static void sg2g_pcmcia_socket_suspend(struct soc_pcmcia_socket *skt)
+{
+}
+
+static struct pcmcia_low_level sg2g_pcmcia_ops = {
+	.owner			= THIS_MODULE,
+	.hw_init		= sg2g_pcmcia_hw_init,
+	.hw_shutdown		= sg2g_pcmcia_hw_shutdown,
+	.socket_state		= sg2g_pcmcia_socket_state,
+	.configure_socket	= sg2g_pcmcia_configure_socket,
+	.socket_init		= sg2g_pcmcia_socket_init,
+	.socket_suspend		= sg2g_pcmcia_socket_suspend,
+	.nr			= 1,
+};
+
+static struct platform_device *sg2g_pcmcia_device;
+
+static int __init sg2g_pcmcia_init(void)
+{
+	int ret;
+
+	sg2g_pcmcia_device = kmalloc(sizeof(*sg2g_pcmcia_device), GFP_KERNEL);
+	if (!sg2g_pcmcia_device)
+		return -ENOMEM;
+	memset(sg2g_pcmcia_device, 0, sizeof(*sg2g_pcmcia_device));
+	sg2g_pcmcia_device->name = "pxa2xx-pcmcia";
+	sg2g_pcmcia_device->dev.platform_data = &sg2g_pcmcia_ops;
+
+	ret = platform_device_register(sg2g_pcmcia_device);
+	if (ret)
+		kfree(sg2g_pcmcia_device);
+
+	return ret;
+}
+
+static void __exit sg2g_pcmcia_exit(void)
+{
+	/*
+	 * This call is supposed to free our sg2g_pcmcia_device.
+	 * Unfortunately platform_device don't have a free method, and
+	 * we can't assume it's free of any reference at this point so we
+	 * can't free it either.
+	 */
+	platform_device_unregister(sg2g_pcmcia_device);
+}
+
+module_init(sg2g_pcmcia_init);
+module_exit(sg2g_pcmcia_exit);
+
+MODULE_LICENSE("GPL");
diff -uNr linux-2.6.17.org/drivers/pcmcia/pxa2xx_sandgate-vp.c linux-2.6.17/drivers/pcmcia/pxa2xx_sandgate-vp.c
--- linux-2.6.17.org/drivers/pcmcia/pxa2xx_sandgate-vp.c	1970-01-01 09:00:00.000000000 +0900
+++ linux-2.6.17/drivers/pcmcia/pxa2xx_sandgate-vp.c	2006-10-28 14:42:38.000000000 +0900
@@ -0,0 +1,185 @@
+/*
+ * linux/drivers/pcmcia/pxa2xx_sandgate-vp.c
+ *
+ * Mainstone PCMCIA specific routines.
+ *
+ * Created:	May 12, 2004
+ * Author:	Nicolas Pitre
+ * Copyright:	MontaVista Software Inc.
+ *
+ * modified from linux/drivers/pcmcia/pxa2xx_mainstone.c
+ * by Adam Ward (adam.ward@intel.com) in 2005
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 as
+ * published by the Free Software Foundation.
+ *
+ * Copyright (c) 2006 Sophia Systems Co.,Ltd.
+ */
+
+#include <linux/module.h>
+#include <linux/init.h>
+#include <linux/kernel.h>
+#include <linux/errno.h>
+#include <linux/interrupt.h>
+#include <linux/device.h>
+#include <linux/platform_device.h>
+
+#include <pcmcia/ss.h>
+
+#include <asm/hardware.h>
+#include <asm/irq.h>
+
+#include <asm/arch/pxa-regs.h>
+#include <asm/arch/sandgate-vp.h>
+
+#include "soc_common.h"
+
+
+static struct pcmcia_irqs irqs[] = {
+	{ 0, SANDGATEVP_CF_DETECT1_IRQ, "PCMCIA0 IN/OUT 1" },
+	{ 0, SANDGATEVP_CF_DETECT2_IRQ, "PCMCIA1 IN/OUT 2" },
+};
+
+static int sgvp_pcmcia_hw_init(struct soc_pcmcia_socket *skt)
+{
+	/*
+	 * Setup default state of GPIO outputs
+	 * before we enable them as outputs.
+	 */
+	GPSR(GPIO48_nPOE) =
+		GPIO_bit(GPIO48_nPOE) |
+		GPIO_bit(GPIO49_nPWE) |
+		GPIO_bit(GPIO50_nPIOR) |
+		GPIO_bit(GPIO51_nPIOW) |
+		GPIO_bit(GPIO85_nPCE_1) |
+		GPIO_bit(GPIO54_nPCE_2);
+
+	pxa_gpio_mode(GPIO48_nPOE_MD);
+	pxa_gpio_mode(GPIO49_nPWE_MD);
+	pxa_gpio_mode(GPIO50_nPIOR_MD);
+	pxa_gpio_mode(GPIO51_nPIOW_MD);
+	pxa_gpio_mode(GPIO85_nPCE_1_MD);
+	pxa_gpio_mode(GPIO54_nPCE_2_MD);
+	pxa_gpio_mode(GPIO55_nPREG_MD);
+	pxa_gpio_mode(GPIO56_nPWAIT_MD);
+	pxa_gpio_mode(GPIO57_nIOIS16_MD);
+	pxa_gpio_mode(GPIO79_pSKTSEL_MD);
+
+	skt->irq = (skt->nr == 0) ? SANDGATEVP_CF_IRQ : SANDGATEVP_WLAN_IRQ;
+	return soc_pcmcia_request_irqs(skt, irqs, ARRAY_SIZE(irqs));
+}
+
+static void sgvp_pcmcia_hw_shutdown(struct soc_pcmcia_socket *skt)
+{
+	soc_pcmcia_free_irqs(skt, irqs, ARRAY_SIZE(irqs));
+}
+
+static void sgvp_pcmcia_socket_state(struct soc_pcmcia_socket *skt,
+				    struct pcmcia_state *state)
+{
+	if (skt->nr == 0) {
+		state->detect = (GPLR(GPIO_34_CF_CD1) & GPIO_bit(GPIO_34_CF_CD1)) ? 0 : 1; // GPIO_34_CF_CD1 = low: detect
+		state->detect |= (GPLR(GPIO_35_CF_CD2) & GPIO_bit(GPIO_35_CF_CD2)) ? 0 : 1; // GPIO_35_CF_CD2 = low: detect
+		state->ready  = (GPLR(GPIO_10_CF_IRQ1) & GPIO_bit(GPIO_10_CF_IRQ1)) ? 1 : 0;
+		state->bvd1   = (GPLR(GPIO_13_CF_BVD1) & GPIO_bit(GPIO_13_CF_BVD1)) ? 1 : 0;
+		state->bvd2   = (GPLR(GPIO_37_CF_BVD2) & GPIO_bit(GPIO_37_CF_BVD2)) ? 1 : 0;
+	} else {
+		state->detect = 1;
+		state->ready  = (GPLR(GPIO_14_WLAN_IRQ) & GPIO_bit(GPIO_14_WLAN_IRQ)) ? 1 : 0;
+		state->bvd1 = 1;
+		state->bvd2 = 1;
+	}
+
+	state->vs_3v  = 1;  /* only 3.3V */
+	state->vs_Xv  = 0;  /* not available */
+	state->wrprot = 0;  /* not available */
+}
+
+static int sgvp_pcmcia_configure_socket(struct soc_pcmcia_socket *skt,
+				       const socket_state_t *state)
+{
+
+	if (skt->nr == 0) {
+		if (state->flags & SS_RESET) {
+			GPSR(GPIO_86_CF_RESET) |= GPIO_bit(GPIO_86_CF_RESET);		// ON
+		} else {
+			GPCR(GPIO_86_CF_RESET) |= GPIO_bit(GPIO_86_CF_RESET);		// OFF
+		}
+	} else {
+		switch (state->Vcc) {
+		case 0: /* power off */
+			GPCR(GPIO_38_WLAN_STBY) |= GPIO_bit(GPIO_38_WLAN_STBY);
+		        break;
+		case 50:
+		case 33:
+			GPSR(GPIO_38_WLAN_STBY) |= GPIO_bit(GPIO_38_WLAN_STBY);
+			break;
+		default:
+			return -1;
+		}
+
+		if (state->flags & SS_RESET) {
+			GPSR(GPIO_39_WLAN_RESET) |= GPIO_bit(GPIO_39_WLAN_RESET);	// ON
+		} else {
+			GPCR(GPIO_39_WLAN_RESET) |= GPIO_bit(GPIO_39_WLAN_RESET);	// OFF
+		}
+	}
+
+	return 0;
+}
+
+static void sgvp_pcmcia_socket_init(struct soc_pcmcia_socket *skt)
+{
+}
+
+static void sgvp_pcmcia_socket_suspend(struct soc_pcmcia_socket *skt)
+{
+}
+
+static struct pcmcia_low_level sgvp_pcmcia_ops = {
+	.owner			= THIS_MODULE,
+	.hw_init		= sgvp_pcmcia_hw_init,
+	.hw_shutdown		= sgvp_pcmcia_hw_shutdown,
+	.socket_state		= sgvp_pcmcia_socket_state,
+	.configure_socket	= sgvp_pcmcia_configure_socket,
+	.socket_init		= sgvp_pcmcia_socket_init,
+	.socket_suspend		= sgvp_pcmcia_socket_suspend,
+	.nr			= 2,
+};
+
+static struct platform_device *sgvp_pcmcia_device;
+
+static int __init sgvp_pcmcia_init(void)
+{
+	int ret;
+
+	sgvp_pcmcia_device = kmalloc(sizeof(*sgvp_pcmcia_device), GFP_KERNEL);
+	if (!sgvp_pcmcia_device)
+		return -ENOMEM;
+	memset(sgvp_pcmcia_device, 0, sizeof(*sgvp_pcmcia_device));
+	sgvp_pcmcia_device->name = "pxa2xx-pcmcia";
+	sgvp_pcmcia_device->dev.platform_data = &sgvp_pcmcia_ops;
+
+	ret = platform_device_register(sgvp_pcmcia_device);
+	if (ret)
+		kfree(sgvp_pcmcia_device);
+
+	return ret;
+}
+
+static void __exit sgvp_pcmcia_exit(void)
+{
+	/*
+	 * This call is supposed to free our sg2g_pcmcia_device.
+	 * Unfortunately platform_device don't have a free method, and
+	 * we can't assume it's free of any reference at this point so we
+	 * can't free it either.
+	 */
+	platform_device_unregister(sgvp_pcmcia_device);
+}
+
+module_init(sgvp_pcmcia_init);
+module_exit(sgvp_pcmcia_exit);
+
+MODULE_LICENSE("GPL");
diff -uNr linux-2.6.17.org/drivers/serial/pxa.c linux-2.6.17/drivers/serial/pxa.c
--- linux-2.6.17.org/drivers/serial/pxa.c	2006-10-28 14:35:04.000000000 +0900
+++ linux-2.6.17/drivers/serial/pxa.c	2006-10-28 14:42:38.000000000 +0900
@@ -22,6 +22,8 @@
  * to come from Intel might have more than 3 or 4 of those UARTs.  Let's
  * hope for a better port registration and dynamic device allocation scheme
  * with the serial core maintainer satisfaction to appear soon.
+ *
+ * Copyright (C) 2005-2006 WILLCOM, Inc. All rights Reserved.
  */
 
 #include <linux/config.h>
@@ -43,12 +45,27 @@
 #include <linux/tty.h>
 #include <linux/tty_flip.h>
 #include <linux/serial_core.h>
+#include <linux/dpm.h>
+#include <linux/notifier.h>
 
 #include <asm/io.h>
 #include <asm/hardware.h>
 #include <asm/irq.h>
 #include <asm/arch/pxa-regs.h>
 
+#if defined(CONFIG_MACH_SANDGATE2P) \
+ || defined(CONFIG_MACH_BLACKRIVER) \
+ || defined(CONFIG_MACH_SANDGATEVP)
+ #define	FFUART_NUM	1
+ #define	BTUART_NUM	0
+ #define	STUART_NUM	2
+ #define	HWUART_NUM	3
+#else
+ #define	FFUART_NUM	0
+ #define	BTUART_NUM	1
+ #define	STUART_NUM	2
+ #define	HWUART_NUM	3
+#endif
 
 struct uart_pxa_port {
 	struct uart_port        port;
@@ -57,6 +74,7 @@
 	unsigned char           mcr;
 	unsigned int            lsr_break_flag;
 	unsigned int		cken;
+	unsigned int		baud;
 	char			*name;
 };
 
@@ -208,12 +226,8 @@
 	}
 }
 
-static inline void check_modem_status(struct uart_pxa_port *up)
+static inline void __check_modem_status(struct uart_pxa_port *up, int status)
 {
-	int status;
-
-	status = serial_in(up, UART_MSR);
-
 	if ((status & UART_MSR_ANY_DELTA) == 0)
 		return;
 
@@ -229,6 +243,69 @@
 	wake_up_interruptible(&up->port.info->delta_msr_wait);
 }
 
+static inline void check_modem_status(struct uart_pxa_port *up)
+{
+	__check_modem_status(up, serial_in(up, UART_MSR));
+}
+
+#ifdef	CONFIG_PXA27x_E20
+static inline void disable_timeout_int(struct uart_pxa_port *up)
+{
+	up->ier &= ~UART_IER_RTOIE;
+	serial_out(up, UART_IER, up->ier);
+}
+
+static inline void enable_timeout_int(struct uart_pxa_port *up)
+{
+	up->ier |= UART_IER_RTOIE;
+	serial_out(up, UART_IER, up->ier);
+}
+#else
+static inline void disable_timeout_int(struct uart_pxa_port *up) {}
+static inline void enable_timeout_int(struct uart_pxa_port *up) {}
+#endif /* CONFIG_PXA27x_E20 */
+
+#if defined(CONFIG_MACH_BLACKRIVER)
+#define	GPIO_SIG_CTS	GPIO_35_FFCTS
+#define	GPIO_SIG_DCD	GPIO_36_FFDCD
+#define	GPIO_SIG_DSR	GPIO_37_FFDSR
+#define	GPIO_SIG_RI	GPIO_38_FFRI
+
+#define	__GPIO_CHK(x)	(!(GPLR(x) & GPIO_bit(x)))
+#define	GPIO_CHK_CTS	__GPIO_CHK(GPIO_SIG_CTS)
+#define	GPIO_CHK_DCD	__GPIO_CHK(GPIO_SIG_DCD)
+#define	GPIO_CHK_DSR	__GPIO_CHK(GPIO_SIG_DSR)
+#define	GPIO_CHK_RI	__GPIO_CHK(GPIO_SIG_RI)
+
+static inline irqreturn_t
+serial_pxa_irq_modem(int irq, void *dev_id, struct pt_regs *regs)
+{
+	struct uart_pxa_port *up = (struct uart_pxa_port *)dev_id;
+	int status;
+
+	switch (irq) {
+	case IRQ_GPIO(GPIO_SIG_CTS):
+		status = UART_MSR_DCTS | (GPIO_CHK_CTS ? UART_MSR_CTS : 0);
+		break;
+	case IRQ_GPIO(GPIO_SIG_DCD):
+		status = UART_MSR_DDCD | (GPIO_CHK_DCD ? UART_MSR_DCD : 0);
+		break;
+	case IRQ_GPIO(GPIO_SIG_DSR):
+		status = UART_MSR_DDSR | (GPIO_CHK_DSR ? UART_MSR_DSR : 0);
+		break;
+	case IRQ_GPIO(GPIO_SIG_RI):
+		status = UART_MSR_TERI | (GPIO_CHK_RI ? UART_MSR_RI : 0);
+		break;
+	default:
+		return IRQ_NONE;
+	}
+
+	__check_modem_status(up, status);
+
+	return IRQ_HANDLED;
+}
+#endif /* CONFIG_MACH_BLACKRIVER */
+
 /*
  * This handles the interrupt from one port.
  */
@@ -240,10 +317,17 @@
 
 	iir = serial_in(up, UART_IIR);
 	if (iir & UART_IIR_NO_INT)
+#if defined(CONFIG_MACH_BLACKRIVER)
+		if (up->port.line != FFUART_NUM)
