 static inline void putc(char c)
 {
diff -uNr linux-2.6.17.org/include/asm-arm/arch-pxa/vmalloc.h linux-2.6.17/include/asm-arm/arch-pxa/vmalloc.h
--- linux-2.6.17.org/include/asm-arm/arch-pxa/vmalloc.h	2006-10-28 14:34:44.000000000 +0900
