diff -uNr linux-2.6.17.org/arch/arm/mach-pxa/blackriver.c linux-2.6.17/arch/arm/mach-pxa/blackriver.c
--- linux-2.6.17.org/arch/arm/mach-pxa/blackriver.c	1970-01-01 09:00:00.000000000 +0900
+++ linux-2.6.17/arch/arm/mach-pxa/blackriver.c	2006-10-28 14:42:37.000000000 +0900
@@ -0,0 +1,1264 @@
+/*
+ *  linux/arch/arm/mach-pxa/blackriver.c
+ *
+ *  Support for Sophia Systems BlackRiver board.
+ *
+ *  Author:	Nicolas Pitre
+ *  Created:	Nov 05, 2002
+ *  Copyright:	MontaVista Software Inc.
+ *
+ *  Modified from linux/arch/arm/mach-pxa/mainstone.c
+ *  by Adam Ward (adam.ward@intel.com) in 2005
+ *
+ * Copyright (C) 2005-2006 WILLCOM, Inc. All rights Reserved.
+ *
+ *  This program is free software; you can redistribute it and/or modify
+ *  it under the terms of the GNU General Public License version 2 as
+ *  published by the Free Software Foundation.
+ */
+
+#include <linux/init.h>
+#include <linux/platform_device.h>
+#include <linux/interrupt.h>
+#include <linux/sched.h>
+#include <linux/bitops.h>
+#include <linux/fb.h>
+#include <linux/input.h>
+
+#include <asm/types.h>
+#include <asm/setup.h>
+#include <asm/memory.h>
+#include <asm/mach-types.h>
+#include <asm/hardware.h>
+#include <asm/irq.h>
+
+#include <asm/mach/arch.h>
+#include <asm/mach/map.h>
+#include <asm/mach/irq.h>
+
+#include <asm/arch/bitfield.h>
+#include <asm/arch/pxa-regs.h>
+#include <asm/arch/blackriver.h>
+#include <asm/arch/pxafb.h>
+
+#if defined(CONFIG_MMC_PXA) || defined(CONFIG_MMC_PXA_MODULE)
+#include <asm/arch/mmc.h>
+#endif /* CONFIG_MMC_PXA || CONFIG_MMC_PXA_MODULE */
+
+#include "generic.h"
+#include <asm/arch/gpio-blackriver.h>
+#include <asm/arch/i2c-pxa.h>
+#include <linux/delay.h>
+
+/*
+ * CPU depend
+ */
+static void __enter_deep_sleep(void)
+{
+	/* for deep-sleep */
+	RCSR = RCSR & (RCSR_GPR | RCSR_SMR | RCSR_WDR | RCSR_HWR);
+
+#ifdef CONFIG_BOOT_PERF
+	PSPR  = OSCR4;
+#endif
+
+	asm volatile (
+		"	mcr	p14, 0, %0, c7, c0, 0\n"
+		"	nop\n"
+		"	nop\n"
+		"	nop\n"
+		"	nop\n"
+		"	nop\n"
+		"	nop\n"
+		"	nop\n"
+		"	nop\n"
+		"	nop\n"
+		"	nop\n"
+		"	b	.\n"
+		: : "r" (PWRMODE_DEEPSLEEP));
+}
+
+static inline void blackriver_mdelay(int ndelay)
+{
+	mdelay(ndelay + 0);
+}
+
+/*
+ * LCD
+ */
+const static u16 LS022XXXXXX_idata[][3] = {
+	/*  5 */ { 0x0007, 0x0101,  1 },
+	/*  6 */ { 0x0004, 0x0100,  0 },
+	/*  7 */
+	/*  8 */ { 0x0029, 0x0100,  0 },
+	/*  9 */ { 0x0026, 0x0106, 20 },
+	/* 10 */ { 0x0005, 0x0102,  0 },
+	/* 11 */ { 0x0006, 0x0130,  0 },
+	/* 12 */
+	/* 13 */ { 0x0020, 0x0101, 20 },
+	/* 14 */ { 0x0021, 0x0120, 20 },
+	/* 15 */ { 0x0021, 0x0130, 20 },
+	/* 16 */ { 0x0021, 0x0132, 20 },
+	/* 17 */ { 0x0021, 0x0133, 20 },
+	/* 18 */ { 0x0002, 0x0100, 20 },
+	/* 19 */ { 0x0001, 0x0131, 20 },
+	/* 20 */
+	/* 21 */ { 0x0001, 0x0130,  1 }
+};
+
+const static u16 LS022XXXXXX_edata[][3] = {
+	/*  2 */ { 0x0001, 0x0131,  0 },
+	/*  3 */ { 0x0003, 0x0100, 40 },
+	/*  4 */ { 0x0001, 0x0135, 20 },
+	/*  5 */ { 0x0021, 0x0122, 20 },
+	/*  6 */ { 0x0002, 0x0101, 20 },
+	/*  7 */ { 0x0021, 0x0100, 20 },
+	/*  8 */ { 0x0020, 0x0100, 20 }
+};
+
+static void __lcd_sdi(u16 data)
+{
+	int	i;
+	u16	bits;
+
+	BR_BCR |= BR_BCR_LCD_SCS;
+	for (i = 16; i > 0; i--) {
+		bits = (data >> (i - 1)) & 1;
+		BR_BCR &= ~BR_BCR_LCD_SCLK;
+		if (bits)
+			BR_BCR |= BR_BCR_LCD_SDI;
+		else
+			BR_BCR &= ~BR_BCR_LCD_SDI;
+		BR_BCR |= BR_BCR_LCD_SCLK;
+	}
+	BR_BCR &= ~(BR_BCR_LCD_SCLK | BR_BCR_LCD_SDI);
+	BR_BCR &= ~BR_BCR_LCD_SCS;
+}
+
+static void lcd_sdi(u16 comm, u16 data, u16 mdelay)
+{
+	unsigned long	flags;
+
+	local_irq_save(flags);
+	__lcd_sdi(comm);
+	__lcd_sdi(data);
+	local_irq_restore(flags);
+	if (mdelay > 0)
+		blackriver_mdelay(mdelay);
+}
+
+static u16 __lcd_sdo(u16 data)
+{
+	int	i;
+	u16	bits;
+	u16	ret;
+
+	BR_BCR |= BR_BCR_LCD_SCS;
+	for (i = 16; i > 8; i--) {
+		bits = (data >> (i - 1)) & 1;
+		BR_BCR &= ~BR_BCR_LCD_SCLK;
+		if (bits)
+			BR_BCR |= BR_BCR_LCD_SDI;
+		else
+			BR_BCR &= ~BR_BCR_LCD_SDI;
+		BR_BCR |= BR_BCR_LCD_SCLK;
+	}
+	for (ret = 0; i > 0; i--) {
+		ret <<= 1;
+		BR_BCR &= ~BR_BCR_LCD_SCLK;
+		ret |= (BR_STATUS & BR_STATUS_LCD_SD0) ? 1 : 0;
+		BR_BCR |= BR_BCR_LCD_SCLK;
+	}
+	BR_BCR &= ~(BR_BCR_LCD_SCLK | BR_BCR_LCD_SDI);
+	BR_BCR &= ~BR_BCR_LCD_SCS;
+
+	return ret;
+}
+
+static u16 lcd_sdo(u16 comm, u16 data)
+{
+	u16	ret;
+	unsigned long	flags;
+
+	local_irq_save(flags);
+	__lcd_sdi(comm);
+	ret = __lcd_sdo(data);
+	local_irq_restore(flags);
+
+	return ret;
+}
+
+#ifdef CONFIG_PRINTK
+#define	LCD_DEBUG
+#endif /* CONFIG_PRINTK */
+
+static int	blackriver_backlight_power_on_req;
+static int	blackriver_backlight_power_on_ng;
+static int	blackriver_backlight_power_off_req;
+
+#ifdef LCD_DEBUG
+const static u16 LS022XXXXXX_regs[][2] = {
+	{ 0x0000, 0x2000 },
+	{ 0x0001, 0x2000 },
+	{ 0x0002, 0x2000 },
+	{ 0x0003, 0x2000 },
+	{ 0x0004, 0x2000 },
+	{ 0x0005, 0x2000 },
+	{ 0x0006, 0x2000 },
+	{ 0x0007, 0x2000 },
+	{ 0x0008, 0x2000 },
+	{ 0x0009, 0x2000 },
+	{ 0x000a, 0x2000 },
+	{ 0x000b, 0x2000 },
+	{ 0x000c, 0x2000 },
+	{ 0x000d, 0x2000 },
+	{ 0x000e, 0x2000 },
+	{ 0x000f, 0x2000 },
+	{ 0x001e, 0x2000 },
+	{ 0x0020, 0x2000 },
+	{ 0x0021, 0x2000 },
+	{ 0x0022, 0x2000 },
+	{ 0x0026, 0x2000 },
+	{ 0x0029, 0x2000 },
+};
+
+static void blackriver_backlight_power_dump(void)
+{
+	u16	reg;
+	int	i;
+	int	sz;
+
+	sz = sizeof(LS022XXXXXX_regs) / (2 * sizeof(u16));
+	for (i = 0; i < sz; i++) {
+		reg = lcd_sdo(LS022XXXXXX_regs[i][0],
+		   LS022XXXXXX_regs[i][1]);
+		printk("[%s:%d] %04x %04x %04x\n",
+		    __FUNCTION__,
+		    __LINE__,
+		    LS022XXXXXX_regs[i][0],
+		    LS022XXXXXX_regs[i][1],
+		    reg);
+	}
+
+	printk("[%s:%d] %d/%d/%d\n",
+	    __FUNCTION__, __LINE__,
+	    blackriver_backlight_power_on_ng,
+	    blackriver_backlight_power_on_req,
+	    blackriver_backlight_power_off_req);
+}
+#else
+static inline void blackriver_backlight_power_dump(void) {}
+#endif /* LCD_DEBUG */
+
+static unsigned long	pwm_pwduty0 = 0x3ff;
+
+static void blackriver_backlight_power_off(void)
+{
+	int	i;
+	int	sz;
+
+	/* No. 1: back light off */
+	PWM_CTRL0 = 0;
+	PWM_PWDUTY0 = 0x0;
+	PWM_PERVAL0 = 0x3FF;
+	pxa_set_cken(CKEN0_PWM0, 0);
+
+	sz = sizeof(LS022XXXXXX_edata) / (3 * sizeof(u16));
+	/* No. 2-8 */
+	for (i = 0; i < sz; i++) {
+		lcd_sdi(LS022XXXXXX_edata[i][0],
+		   LS022XXXXXX_edata[i][1],
+		   LS022XXXXXX_edata[i][2]);
+	}
+	/* No. 9: logic initial */
+	BR_BCR &= ~(BR_BCR_LCD_SCS | BR_BCR_LCD_SCLK | BR_BCR_LCD_SDI);
+	/* No. 10: Reset H -> L */
+	BR_BCR &= ~BR_BCR_LCD1_RESETn;
+	/* No. 11: VCC off */
+	BR_BCR &= ~BR_BCR_LCD1_PWR_ON;
+}
+
+static void blackriver_backlight_power_on(void)
+{
+	int	i;
+	int	sz;
+	u16	reg, val;
+
+	blackriver_backlight_power_on_req++;
+	/* No. 1: Reset H -> L */
+	BR_BCR &= ~BR_BCR_LCD1_RESETn;
+	/* No. 2: logic initial */
+	BR_BCR &= ~(BR_BCR_LCD_SCS | BR_BCR_LCD_SCLK | BR_BCR_LCD_SDI);
+	/* No. 3: VCC on */
+	BR_BCR |= BR_BCR_LCD1_PWR_ON;
+	blackriver_mdelay(10);
+	/* No. 4: Reset L -> H */
+	BR_BCR |= BR_BCR_LCD1_RESETn;
+	blackriver_mdelay(1);
+
+	/* No. 5-21 */
+	sz = sizeof(LS022XXXXXX_idata) / (3 * sizeof(u16));
+	for (i = 0; i < sz; i++) {
+		reg = LS022XXXXXX_idata[i][0];
+		lcd_sdi(reg,
+		   LS022XXXXXX_idata[i][1],
+		   LS022XXXXXX_idata[i][2]);
+		if (reg == 0x0026) {
+			val = lcd_sdo(reg, 0x2000);
+			if (val != 0) {
+				printk(KERN_ALERT "[%s:%d] %04x %04x\n",
+				     __FUNCTION__, __LINE__, reg, val);
+
+				blackriver_backlight_power_on_ng++;
+				blackriver_backlight_power_dump();
+				return;
+			}
+		}
+	}
+
+	blackriver_mdelay(1);
+
+	/* No. 22: back light on */
+	pxa_gpio_mode(GPIO16_PWM0_MD);
+	pxa_set_cken(CKEN0_PWM0, 1);
+	PWM_CTRL0 = 0;
+	PWM_PWDUTY0 = pwm_pwduty0;
+	PWM_PERVAL0 = 0x3ff;
+}
+
+static void blackriver_backlight_power(int on)
+{
+	if (on) {
+		blackriver_backlight_power_on();
+	} else {
+		blackriver_backlight_power_off();
+	}
+}
+
+static void blackriver_lcd_power(int on)
+{
+	if (on)
+		BR_BCR |= BR_BCR_LCD1_PWR_ON;
+	else
+		BR_BCR &= ~BR_BCR_LCD1_PWR_ON;
+}
+
+static int blackriver_set_dury(int val)
+{
+	if (val < 0 || val > 0x400)
+		return -EINVAL;
+
+	pwm_pwduty0 = val;
+	PWM_PWDUTY0 = pwm_pwduty0;
+
+	return 0;
+}
+
+static int blackriver_get_dury(void)
+{
+	return pwm_pwduty0;
+}
