diff -uNr linux-2.6.17.org/include/linux/soundcard-sgvp.h linux-2.6.17/include/linux/soundcard-sgvp.h
--- linux-2.6.17.org/include/linux/soundcard-sgvp.h	1970-01-01 09:00:00.000000000 +0900
+++ linux-2.6.17/include/linux/soundcard-sgvp.h	2006-10-28 14:42:39.000000000 +0900
@@ -0,0 +1,48 @@
+/*
+ * soundcard-sgvp.h - OSS driver header file for Sandgate-VP
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ *
+ * Copyright (c) 2006 Sophia Systems Co.,Ltd.
+ */
+
+#ifndef SOUNDCARD_SANDGATE_VP_H
+#define SOUNDCARD_SANDGATE_VP_H
+
+#include <linux/soundcard.h>
+
+/*
+ * ioctls for Sandgate-VP.
+ * These ioctls use SOUND_MIXER_PRIVATE1-3 in linux/saundcard.h.
+ */
+#define SANDGATE_VP_SOUND_MIXER_ODEVSEL		111
+#define SANDGATE_VP_SOUND_MIXER_MICSEL		112
+#define SANDGATE_VP_SOUND_MIXER_HDSET		113
+#define SANDGATE_VP_SOUND_MIXER_READ_ODEVSEL	MIXER_READ(SANDGATE_VP_SOUND_MIXER_ODEVSEL)
+#define SANDGATE_VP_SOUND_MIXER_READ_MICSEL	MIXER_READ(SANDGATE_VP_SOUND_MIXER_MICSEL)
+#define SANDGATE_VP_SOUND_MIXER_READ_HDSET	MIXER_READ(SANDGATE_VP_SOUND_MIXER_HDSET)
+#define SANDGATE_VP_SOUND_MIXER_WRITE_ODEVSEL	MIXER_WRITE(SANDGATE_VP_SOUND_MIXER_ODEVSEL)
+#define SANDGATE_VP_SOUND_MIXER_WRITE_MICSEL	MIXER_WRITE(SANDGATE_VP_SOUND_MIXER_MICSEL)
+
+/*
+ * These flags are used by SANDGATE_VP_SOUND_MIXER_*_ODEVSEL.
+ */
+#define SANDGATE_VP_SOUND_ODEV_SPK		0x00000001
+#define SANDGATE_VP_SOUND_ODEV_RCV		0x00000002
+
+/*
+ * These values are used by SANDGATE_VP_SOUND_MIXER_*_MICSEL.
+ */
+#define SANDGATE_VP_SOUND_MIC_INT		0	/* internal mic */
+#define SANDGATE_VP_SOUND_MIC_EXT		1	/* external mic */
+
+/*
+ * These values are used by SANDGATE_VP_SOUND_MIXER_READ_HDSET.
+ */
+#define SANDGATE_VP_SOUND_HDSET_UNCONNECT	0
+#define SANDGATE_VP_SOUND_HDSET_CONNECT		1
+
+#endif
