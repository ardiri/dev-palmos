+	.init 		= sandgate_vp_mci_init,
+	.setpower 	= sandgate_vp_mci_setpower,
+	.exit		= sandgate_vp_mci_exit,
+};
+#endif /* CONFIG_MMC_PXA || CONFIG_MMC_PXA_MODULE */
