+
+static int pxafb_ioctl(struct fb_info *info, unsigned int cmd, unsigned long arg)
+{
+	int	ret = -EINVAL;
+
+	switch (cmd) {
+	case PXAFB_SET_DUTY:
+		if (pxafb_set_duty)
+			ret = pxafb_set_duty((int)arg);
+		break;
+	case PXAFB_GET_DUTY:
+		if (pxafb_get_duty)
+			ret = pxafb_get_duty();
+		break;
+	default:
+		break;
+	}
+
+	return ret;
+}
