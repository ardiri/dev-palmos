+#define	KEYBUF_HOOKSW	0x0e
+
+static unsigned char sandgate_vp_keycode[KEYBUF] = {
+	KEY_1,		/* 0x00:   2 */ /* '1' */
+	KEY_2,		/* 0x01:   3 */ /* '2' */
+	KEY_3,		/* 0x02:   4 */ /* '3' */
+	KEY_4,		/* 0x03:   5 */ /* '4' */
+	KEY_5,		/* 0x04:   6 */ /* '5' */
+	KEY_6,		/* 0x05:   7 */ /* '6' */
+	KEY_7,		/* 0x06:   8 */ /* '7' */
+	KEY_RESERVED,	/* 0x07: */
+	KEY_RESERVED,	/* 0x08: */
+	KEY_RESERVED,	/* 0x09: */
+	KEY_RESERVED,	/* 0x0a: */
+	KEY_RESERVED,	/* 0x0b: */
+	KEY_RESERVED,	/* 0x0c: */
+	KEY_RESERVED,	/* 0x0d: */
+	KEY_KPPLUS,	/* 0x0e:  78 */ /* 'HookSw' */
+	KEY_END,	/* 0x0f: 107 */ /* 'Power' */
+	KEY_8,		/* 0x10:   9 */ /* '8' */
+	KEY_9,		/* 0x11:  10 */ /* '9' */
+	KEY_0,		/* 0x12:  11 */ /* '0' */
+	KEY_F1,		/* 0x13:  59 */
+	KEY_BACKSPACE,  /* 0x14:  14 */ /* 'Clear' */
+	KEY_HOME,	/* 0x15: 102 */ /* 'Talk' */
+	KEY_KPASTERISK,	/* 0x16:  55 */ /* '*' */
+	KEY_RESERVED,	/* 0x17: */
+	KEY_RESERVED,	/* 0x18: */
+	KEY_RESERVED,	/* 0x19: */
+	KEY_RESERVED,	/* 0x1a: */
+	KEY_RESERVED,	/* 0x1b: */
+	KEY_RESERVED,	/* 0x1c: */
+	KEY_RESERVED,	/* 0x1d: */
+	KEY_RESERVED,	/* 0x1e: */
+	KEY_RESERVED,	/* 0x1f: */
+	KEY_KPSLASH,	/* 0x20:  98 */ /* '#' */
+	KEY_DOWN,	/* 0x21: 108 */ /* 'DOWN' */
+	KEY_UP,		/* 0x22: 103 */ /* 'UP' */
+	KEY_LEFT,	/* 0x23: 105 */ /* 'LEFT' */
+	KEY_RIGHT,	/* 0x24: 106 */ /* 'RIGHT' */
+	KEY_ENTER,	/* 0x25:  28 */ /* 'OK' */
+	KEY_F2,		/* 0x26:  60 */ /* 'F2' */
+	KEY_RESERVED,	/* 0x27: */
+	KEY_RESERVED,	/* 0x28: */
+	KEY_RESERVED,	/* 0x29: */
+	KEY_RESERVED,	/* 0x2a: */
+	KEY_RESERVED,	/* 0x2b: */
+	KEY_RESERVED,	/* 0x2c: */
+	KEY_KPMINUS,	/* 0x2d:  74 */ /* reserved 'Rec' */
+	KEY_KPDOT,	/* 0x2e:  83 */ /* reserved 'Zoom' */
+	KEY_KPEQUAL,	/* 0x2f: 117 */ /* reserved 'Wide' */
+	KEY_F3,		/* 0x30:  61 */ /* 'F3' */
+	KEY_F4,		/* 0x31:  62 */ /* 'F4' */
+	KEY_F5,		/* 0x32:  63 */ /* 'MODE' */
+	KEY_F7,		/* 0x32:  65 */ /* 'R1' */
+	KEY_F8,		/* 0x33:  66 */ /* 'R2' */
