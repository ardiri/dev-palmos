+
+endchoice
diff -uNr linux-2.6.17.org/arch/arm/mach-pxa/leds-blackriver.c linux-2.6.17/arch/arm/mach-pxa/leds-blackriver.c
--- linux-2.6.17.org/arch/arm/mach-pxa/leds-blackriver.c	1970-01-01 09:00:00.000000000 +0900
+++ linux-2.6.17/arch/arm/mach-pxa/leds-blackriver.c	2006-10-28 14:42:37.000000000 +0900
@@ -0,0 +1,138 @@
+/*
+ * linux/arch/arm/mach-pxa/leds-blackriver.c
+ *
+ * modified by Adam Ward (adam.ward@intel.com) in 2005 from
+ *
+ * linux/arch/arm/mach-pxa/leds-mainstone.c
+ *
+ * Author:     Nicolas Pitre
+ * Created:    Nov 05, 2002
+ * Copyright:  MontaVista Software Inc.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 as
+ * published by the Free Software Foundation.
+ *
+ * Copyright (C) 2005-2006 WILLCOM, Inc. All rights Reserved.
+ */
+
+#include <linux/config.h>
+#include <linux/types.h>
+#include <linux/init.h>
+
+#include <asm/hardware.h>
+#include <asm/leds.h>
+#include <asm/system.h>
+
+#include <asm/arch/pxa-regs.h>
+#include <asm/arch/blackriver.h>
+
+#include "leds.h"
+
+#define T_B_D /* How to do led control on blackriver? */
+
+#define LED_STATE_ENABLED	1
+#define LED_STATE_CLAIMED	2
+
+static unsigned int led_state;
+static unsigned int hw_led_state;
+
+void blackriver_leds_event(led_event_t evt)
+{
+	unsigned long flags;
+
+	local_irq_save(flags);
+
+	switch (evt) {
+	case led_start:
+		hw_led_state = 0;
+		led_state = LED_STATE_ENABLED;
+		break;
+
+	case led_stop:
+		led_state &= ~LED_STATE_ENABLED;
+		break;
+
+	case led_claim:
+		led_state |= LED_STATE_CLAIMED;
+		hw_led_state = 0;
+		break;
+
+	case led_release:
+		led_state &= ~LED_STATE_CLAIMED;
+		hw_led_state = 0;
+		break;
+
+#ifdef CONFIG_LEDS_TIMER
+	case led_timer:
+#ifdef FIXME
+		hw_led_state ^= SG2P_BCR_REDLED;
+#endif
+		break;
+#endif
+
+#ifdef CONFIG_LEDS_CPU
+	case led_idle_start:
+#ifndef T_B_D
+		hw_led_state |= SG2P_BCR_GRNLED;
+#endif
+		break;
+
+	case led_idle_end:
+#ifndef T_B_D
+		hw_led_state &= ~SG2P_BCR_GRNLED;
+#endif
+		break;
+#endif
+
+	case led_halted:
+		break;
+
+	case led_green_on:
+#ifndef T_B_D
+		hw_led_state |= SG2P_BCR_GRNLED;
+#endif
+		break;
+
+	case led_green_off:
+#ifndef T_B_D
+		hw_led_state &= ~SG2P_BCR_GRNLED;
+#endif
+		break;
+
+	case led_amber_on:
+		break;
+
+	case led_amber_off:
+		break;
+
+	case led_red_on:
+#ifndef T_B_D
+		hw_led_state |= SG2P_BCR_REDLED;
+#endif
+		break;
+
+	case led_red_off:
+#ifndef T_B_D
+		hw_led_state &= ~SG2P_BCR_REDLED;
+#endif
+		break;
+
+	default:
+		break;
+	}
+
+#ifndef T_B_D
+	blackriver_bcr &= ~(SG2P_BCR_REDLED | SG2P_BCR_GRNLED);
+#endif
+	if  (led_state & LED_STATE_ENABLED) {
+#ifndef T_B_D
+	    blackriver_bcr |= (hw_led_state &= (SG2P_BCR_REDLED | SG2P_BCR_GRNLED));
+#endif
+        }
+#ifndef T_B_D
+	SG2P_BCR = blackriver_bcr;
+#endif
+
+	local_irq_restore(flags);
+}
