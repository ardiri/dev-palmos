 	help
@@ -654,9 +666,27 @@
 	  be linked for and stored to.  This address is dependent on your
 	  own flash usage.
 
+config ROMBOOT
+	bool "boot from ROM"
+	depends on !XIP_KERNEL && (MACH_SANDGATE2P || MACH_BLACKRIVER || MACH_SANDGATEVP)
+	default y if MACH_BLACKRIVER
+	default y if MACH_SANDGATEVP
+	default n if MACH_SANDGATE2P
+
+config CONFIG_DMA_IN_BOOT
+	bool "DMA copy in boot"
+	depends on ROMBOOT
+	default y
+
+config BOOT_PERF
+	#bool
+	bool "bootup performance"
+	depends on ROMBOOT && MACH_BLACKRIVER
