diff -uNr linux-2.6.17.org/drivers/input/mouse/sandgatevp_pt.c linux-2.6.17/drivers/input/mouse/sandgatevp_pt.c
--- linux-2.6.17.org/drivers/input/mouse/sandgatevp_pt.c	1970-01-01 09:00:00.000000000 +0900
+++ linux-2.6.17/drivers/input/mouse/sandgatevp_pt.c	2006-10-28 14:42:38.000000000 +0900
@@ -0,0 +1,221 @@
+/*
+ *  linux/drivers/input/mouse/sandgatevp_pt.c
+ *
+ *  Keypad driver for sandgate-VP Platform
+ *
+ *  Copyright (C) 2004, Intel Corporation (jingqing.xu@intel.com)
+ *
+ *  This program is free software; you can redistribute it and/or modify
+ *  it under the terms of the GNU General Public License version 2 as
+ *  published by the Free Software Foundation.
+ *
+ * Copyright (c) 2006 Sophia Systems Co.,Ltd.
+ */
+
+#include <linux/module.h>
+#include <linux/init.h>
+#include <linux/input.h>
+#include <linux/interrupt.h>
+#include <asm/irq.h>
+#include <asm/hardware.h>
+#include <asm/arch/pxa-regs.h>
+#include <linux/platform_device.h>
+#include <linux/delay.h>
+
+#include <asm/io.h>
+#include <asm/irq.h>
+
+MODULE_AUTHOR("Vojtech Pavlik <vojtech@ucw.cz>");
+MODULE_DESCRIPTION("Pointer (EQ8841) Interface Driver");
+MODULE_LICENSE("GPL");
+
+#define	IRQ_POINTER		IRQ_GPIO(GPIO_9_POINT_INT)
+#define	EQ8441_POINTER_NAME	"pxa27x-pointer"
+#define MDR_SET 0x5F97
+#define RD_SET 0x005A
+#define IDX_SET 0x5B00
+#define IDY_SET 0x5C00
+
+static int irq_pointer= IRQ_POINTER;
+module_param_named(irq, irq_pointer , uint, 0);
+MODULE_PARM_DESC(irq, "IRQ_POINTER");
+
+static int x_int, y_int;
+static int x, y;
+
+static void _serial_txComm ( unsigned int data )
+{
+	 int sendData, i; 
+	
+	GPSR(GPIO_22_POINT_CS) |= GPIO_bit(GPIO_22_POINT_CS);
+	for (i=16; i>0; i--) {
+		sendData = (data >> (i-1)) & 1;
+		GPCR(GPIO_99_SCLK) |= GPIO_bit(GPIO_99_SCLK);
+		if(sendData)
+			GPSR(GPIO_36_SDI) |= GPIO_bit(GPIO_36_SDI);
+		else
+			GPCR(GPIO_36_SDI) |= GPIO_bit(GPIO_36_SDI);
+		GPSR(GPIO_99_SCLK) |= GPIO_bit(GPIO_99_SCLK);
+	}
+	GPSR(GPIO_36_SDI) |= GPIO_bit(GPIO_36_SDI);
+	GPCR(GPIO_99_SCLK) |= GPIO_bit(GPIO_99_SCLK);
+	GPCR(GPIO_22_POINT_CS) |= GPIO_bit(GPIO_22_POINT_CS);
+}
+
+static void _serial_rxComm( unsigned int data, int *x, int *y)
+{
+	unsigned int sendData, i;
+	
+	GPSR(GPIO_22_POINT_CS) |= GPIO_bit(GPIO_22_POINT_CS);
+	
+	for (i=8; i>0; i--) {
+		sendData = (data >> (i-1)) & 1;
+		GPCR(GPIO_99_SCLK) |= GPIO_bit(GPIO_99_SCLK);
+		if(sendData)
+			GPSR(GPIO_36_SDI) |= GPIO_bit(GPIO_36_SDI);
+		else
+			GPCR(GPIO_36_SDI) |= GPIO_bit(GPIO_36_SDI);
+		GPSR(GPIO_99_SCLK) |= GPIO_bit(GPIO_99_SCLK);
+	}
+
+	for (i=8; i>0; i--) {
+		GPCR(GPIO_99_SCLK) |= GPIO_bit(GPIO_99_SCLK);
+		if(GPLR(GPIO_77_SDO) & GPIO_bit(GPIO_77_SDO)) {
+			*x |= (1 << (i-1));
+		}
+		GPSR(GPIO_99_SCLK) |= GPIO_bit(GPIO_99_SCLK);
+	}
+	for (i=8; i>0; i--) {
+		GPCR(GPIO_99_SCLK) |= GPIO_bit(GPIO_99_SCLK);
+		if (GPLR(GPIO_77_SDO) & GPIO_bit(GPIO_77_SDO)) {
+			*y |= (1 << (i-1));
+		}
+		GPSR(GPIO_99_SCLK) |= GPIO_bit(GPIO_99_SCLK);
+	}
+	GPCR(GPIO_99_SCLK) |= GPIO_bit(GPIO_99_SCLK);
+	GPCR(GPIO_22_POINT_CS) |= GPIO_bit(GPIO_22_POINT_CS);
+}
+
+static void _serial_data_filer (int *x, int *y)
+{
+	if(*x < x_int-13)
+		*x = -2;
+	else if(x_int-13 <= *x && *x < x_int-10)
+		*x = -1;
+	else if(x_int-10 <= *x && *x < x_int+10)
+		*x = 0;
+	else if(x_int+10 <= *x && *x < x_int+13)
+		*x = 1;
+	else 
+		*x = 2;
+
+	if(*y < y_int-13)
+		*y = -2;
+	else if(y_int-13 <= *y && *y < y_int-10)
+		*y = -1;
+	else if(y_int-10 <= *y && *y < y_int+10)
+		*y = 0;
+	else if(y_int+10 <= *y && *y < y_int+13)
+		*y = 1;
+	else 
+		*y = 2;
+}
+
+static irqreturn_t pointer_interrupt(int irq, void *dev_id, struct pt_regs *regs)
+{
+	unsigned int data; 
+	
+	pointMoved_flag =1;
+	x = y = 0;
+	data = RD_SET;
+	_serial_rxComm( data, &x , &y);
+	_serial_data_filer(&x, &y);
+	if (x != 0 || y != 0) {
+		input_report_rel(pointer_dev, REL_X, x);
+		input_report_rel(pointer_dev, REL_Y, y);
+		input_sync(pointer_dev);
+	}
+	
+	return IRQ_HANDLED;
+}
+
+
+static void _gpio_config (void)
+{
+	/* GPIO setting */	
+	pxa_gpio_mode(GPIO_9_POINT_INT | GPIO_IN);		/* Pointer Interrup */
+	pxa_gpio_mode(GPIO_36_SDI | GPIO_OUT);			/* Pointer Serial Data Input */
+	pxa_gpio_mode(GPIO_22_POINT_CS | GPIO_OUT);		/* Pointer Chip Select */
+	pxa_gpio_mode(GPIO_77_SDO |  GPIO_IN);			/* Pointer Serial Data Output */
+	pxa_gpio_mode(GPIO_87_POINT_RST | GPIO_OUT); 	/* Pointer Sensor Reset */
+	pxa_gpio_mode(GPIO_99_SCLK | GPIO_OUT);			/* Pointer Serial Clock Input */
+
+	GPSR(GPIO_87_POINT_RST) |= GPIO_bit(GPIO_87_POINT_RST); /* Point Sensor Normal Mode(High) */
+}
+
+
+static int __init pointer_init(void)
+{
+	unsigned int data, err; 
+
+	x = y = 0;
+	if (!(pointer_dev = input_allocate_device())) {
+		printk(KERN_ERR "pointer.c: Not enough memory for input device\n");
+		return -ENOMEM;
+	}
+	/* GPIO setting */
+	_gpio_config();
+
+	/* input_dev setting */
+	pointer_dev->name = EQ8441_POINTER_NAME;
+	pointer_dev->phys = "EQ8441/input0";
+	pointer_dev->id.vendor  = 0x0001;
+	pointer_dev->id.product = 0x0001;
+	pointer_dev->id.version = 0x0001;
+	
+	pointer_dev->evbit[0] = BIT(EV_KEY) | BIT(EV_REL);
+	pointer_dev->keybit[LONG(BTN_MOUSE)] = BIT(BTN_LEFT) | BIT(BTN_RIGHT);
+	pointer_dev->relbit[0] = BIT(REL_X) | BIT(REL_Y);
+	
+	if (input_register_device(pointer_dev) != 0) {
+		printk(KERN_CRIT
+		    "sandgatevp_pointer: fail input_register_device()\n");
+		return -1;
+	}
+
+	/* Set MDR */
+	data = MDR_SET;
+	_serial_txComm(data);
+	/* Initialize x,y */
+	udelay(80);	/* Q8441 Initialize time */
+	data = RD_SET;
+	_serial_rxComm(data, &x, &y);
+	data= (IDX_SET | x);
+	_serial_txComm(data);
+	data= (IDY_SET | y);
+	_serial_txComm(data);
+	x_int = x;
+	y_int = y;
+	
+	/* Interrup Setting */
+	set_irq_type(IRQ_POINTER, IRQT_FALLING);
+	err = request_irq(IRQ_POINTER, pointer_interrupt, 0, "Pointer", 0);
+	if (err) {
+		printk(KERN_CRIT "Wow! Can't register IRQ[%d] for Pointer\n",
+		  IRQ_POINTER);
+		return -1;
+	}
+	printk(KERN_INFO "input: sandgatevp pointer driver!\n");
+	return 0;
+}
+
+
+static void __exit pointer_exit(void)
+{
+	free_irq(IRQ_POINTER, 0);
+	GPCR(GPIO_87_POINT_RST) |= GPIO_bit(GPIO_87_POINT_RST); /* Point Sensor Reset */
+	input_unregister_device(pointer_dev);
+}
+
+module_init(pointer_init);
+module_exit(pointer_exit);
