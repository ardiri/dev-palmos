+//;------------------------------------------------------------------------
+
+//; platform-specific memory controller settings
+
+//; ROM timing values
+#define MSC0_RESET_ALL                           0x7FF07FF0
+#define MSC0_RESET                               0x7FF0
+//;MSC0_28f160S3                             0x46A0   ; slightly more conservative value for 28f160S3
+#define MSC0_28f160S3                            0x26A0
+#define MSC0_28f128J3A_NB                        0x2BF0
+#define MSC0_28f128J3A_PM                        0x24F2
+#define MSC0_28f640J5                            0x7FF0
+
+#define FLYCNFG_SETTINGS                         0x0            
+// ; fly-by-dma not implemented on this platform
+//; synchronous static memory timing values
+//; if the platform does not have synchronous static memory installed,
+//; sxcnfg value MUST be 0x0
+#define SXCNFG_SETTINGS                          0x0
+#define SXLCR_SETTINGS                           0x0
+#define SXMRS_SETTINGS                           0x0
+
+//; Common SDRAM timing values
+#define MDMRS_SETTINGS                           0x00020002    //     ; SDRAM Mode Reg Set Config Reg
+//; pcmcia timing values
+#define MECR_SETTINGS                            0x1            // ; eXpansion memory config. reg
+//; memory controller settings for expansion card
+//;MCMEM0_SETTINGS                           0x00004204      ; eXpansion card common memory timing config. reg 0
+#define MCMEM0_SETTINGS                          0x00010204     // ; eXpansion card common memory timing config. reg 0
+
+#define MCATT0_SETTINGS                          0x00010504     // ; eXpansion card Attribute space timing config. reg 0
+#define MCIO0_SETTINGS                           0x0000C108      //; eXpansion card I/O space timing config. reg 0
+
+//; SDRAM timing values for Sandgate.
+//; Note: mdrefr is programmed bit-by-bit, so a combined value is not needed here
+#define MDREFR_SETTINGS                          0x0091C01D      //; SDRAM Refresh Reg
+#define MDCNFG_SETTINGS                          0x00001AC1      //; SDRAM Config Reg
+
+#define MSC1_SETTINGS                            0x00002431      //; Static Mem. Control Reg 1
+#define MSC2_SETTINGS                            0x00000000      //; Static Mem. Control Reg 2 - NOT USED
+
+//; memory controller settings for expansion card
+#define MCMEM1_SETTINGS                          0x00000000    //  ; eXpansion card common memory timing config. reg 1 - NOT USED
+#define MCATT1_SETTINGS                          0x00000000     // ; eXpansion card attribute space timing config. reg 1 - NOT USED
+#define MCIO1_SETTINGS                           0x00000000     // ; eXpansion card I/O space timing config. reg 1 - NOT USED
+
+//; SDRAM timing values for Daughter Card.
+//; Note: mdrefr is programmed bit-by-bit, so a combined value is not needed here
+#define MDREFR_SETTINGS_DC                       0x009DC01D     // ; SDRAM Refresh Reg
+#define MDCNFG_SETTINGS_DC                       0x1AA91AC9     // ; SDRAM Config Reg
+
+//; Ethernet Workaround
+#define MSC1_SETTINGS_DC                         0x12412431     // ; Static Mem. Control Reg 1
+#define MSC2_SETTINGS_DC                         0x223436D4     // ; Static Mem. Control Reg 2
+
+//; memory controller settings for expansion card
+#define MCMEM1_SETTINGS_DC                       0x00010204  //    ; eXpansion card common memory timing config. reg 1
+#define MCATT1_SETTINGS_DC                       0x00010504    //  ; eXpansion card attribute space timing config. reg 1
+#define MCIO1_SETTINGS_DC                        0x0000C108     // ; eXpansion card I/O space timing config. reg 1
+
+
+#define MCMEM0_MEM0_SET  (0x04U << 0)
+#define MCMEM0_MEM0_ASST (0x04U << 7)
+#define MCMEM0_MEM0_HOLD (0x04U << 14)
+
+#define MCMEM1_MEM1_SET  (0x04U << 0)
+#define MCMEM1_MEM1_ASST (0x04U << 7)
+#define MCMEM1_MEM1_HOLD (0x04U << 14)
+
+/*
+*******************************************************************************
+*    MCATT0 and MCATT1 Register Bitmap settings.
+*    Refer to the Cotulla EAS for details.
+*******************************************************************************
+*/
+#define MCATT0_ATT0_SET  (0x04U << 0)
+#define MCATT0_ATT0_ASST (0x0AU << 7)
+#define MCATT0_ATT0_HOLD (0x04U << 14)
+
+#define MCATT1_ATT1_SET  (0x04U << 0)
+#define MCATT1_ATT1_ASST (0x0AU << 7)
+#define MCATT1_ATT1_HOLD (0x04U << 14)
+
+/*
+*******************************************************************************
+*    MCIO0 and MCIO1 Register Bitmap settings.
+*    Refer to the Cotulla EAS for details.
+*******************************************************************************
+*/
+#define MCIO0_IO0_SET  (0x08U << 0)
+#define MCIO0_IO0_ASST (0x02U << 7)
+#define MCIO0_IO0_HOLD (0x03U << 14)
+
+#define MCIO1_IO1_SET  (0x08U << 0)
+#define MCIO1_IO1_ASST (0x02U << 7)
+#define MCIO1_IO1_HOLD (0x03U << 14)
+
+// Expansion Memory (PCMCIA and Compact Flash) Configuration Register bits.
+#define MECR_NOS    (0x0U << 0)    // Card Interface Number of Sockets
+#define MECR_CIT    (0x1U << 1)    // Card Interface Card Is There
+
+//;-----------------------------------------------------------------------
+
+// register offsets from base address
+#if defined (CYGPKG_HAL_ARM_XSCALE_PXA271_BLRV)
+#define PXA270_BCR                               REG32_PTR(0x08000000)
+#else
+#define PXA270_BCR                               REG32_PTR(0x0A000000)     // ; write-only
+#endif // CYGPKG_HAL_ARM_XSCALE_PXA271_BLRV
+
+//Note: BCR is a write-only register
+//register bit fields - bcr
+#define BCR_CFON                                 BIT0           //; cf power enable
+#define BCR_CFGFXRST                             BIT1           //; cf/daughter card reset
+#define BCR_IRDAFSEL                             BIT2           //; irda frequency select
+//#define BCR_IRDAMD                               0x00011000     //; irda mode range/power select
+#define BCR_CFBUS                                BIT5           //; cf bus enable
+#define BCR_AUDIO                                BIT6           //; audio power enable
+#define BCR_CPLD                                 BIT7           //; backlight power enable
+#define BCR_LCD                                  BIT8           //; lcd power enable
+#define BCR_RS232                                BIT9           //; rs232 enable
+#define BCR_PSKTSEL                              BIT10          //; radio module power enable
+#define BCR_EOT                                  BIT11          //; radio module wake int
+#define BCR_REDLED                               BIT12          //; red LED 0=on, 1=off
+#define BCR_GRNLED                               BIT13          //; green LED 0=on, 1=off
+#define BCR_SPKR                                 BIT14          //; audio amplifier enable
+#define BCR_MMC                                  BIT15          //; mmc power enable
+#define BCR_MS                                   BIT16         
+#define BCR_MS_SEL                               BIT17
+#define BCR_BB_SEL                               BIT18
+#define BCR_VBUS                                 BIT19
+#define BCR_EX10UT                               BIT20 
+
+#define BCR_CF_PWR_ON         ( 0x1U << 0 )
+//#define BCR_CF_PWR_ON         ( 0x1U << 0 )
+#define BCR_CF_PWR_OFF        ( 0x0U << 0 )
+#define BCR_CF_GFX_RESET      ( 0x1U << 1 )
+#define BCR_IRDA_FSEL         ( 0x1U << 2 )
+#define BCR_IRDA_MD0          ( 0x1U << 3 )
+#define BCR_IRDA_MD1          ( 0x1U << 4 )
+#define BCR_CF_BUS_ON         ( 0x0  << 5 )
+#define BCR_CF_BUS_OFF        ( 0x1U << 5 )
+#define BCR_AUDIO_PWR_ON      ( 0x1U << 6 )
+#define BCR_CPLD_HIGH_ON      ( 0x1U << 7 )
+#define BCR_CPLD_LOW_ON       ( 0x0  << 7 )
+#define BCR_LCD_PWR_ON        ( 0x1U << 8 )
+#define BCR_RS232_PWR_ON      ( 0x1U << 9 )
+#define BCR_PCMCIA1_ON        ( 0x1U << 10 )
+#define BCR_PCMCIA0_ON        ( 0x1U << 10 )
+#define BCR_EOT_HIGH_MOD      ( 0x1U << 11 )
+#define BCR_EOT_LOW_MOD       ( 0x1U << 11 )
+#define BCR_RED_LED           ( 0x1U << 12 )
+#define BCR_GREEN_LED         ( 0x1U << 13 )
+#define BCR_SPKR_ON           ( 0x1U << 14 )
+#define BCR_MMC_POWER_ON      ( 0x1U << 15 )
+#define BCR_MS_ON             ( 0x1U << 16 )
+#define BCR_MS_OFF            ( 0x0U << 16 )
+#define BCR_MS_SEL_ON         ( 0x1U << 17 )
+#define BCR_MS_SEL_OFF        ( 0x0U << 17 )
+#define BCR_BB_SEL_ON         ( 0x1U << 18 )
+#define BCR_BB_SEL_OFF        ( 0x0U << 18 )
+#define BCR_VBUS1_ON          ( 0x1U << 19 )
+#define BCR_VBUS1_OFF         ( 0x0U << 19 )
+#define BCR_EX1OUT_H          ( 0x1U << 20 ) 
+#define BCR_EX1OUT_L          ( 0x0U << 20 )
+#define BCR_EX2OUT_H          ( 0x1U << 20 )
+#define BCR_EX2OUT_L          ( 0x0U << 20 )
+
+
+//; Neponset Control Register
+#define NCR_BASE_ADDRESS                         0x08000000      //; base address (physical/virtual)
+
+#define PXA270_NCR_WHOAMI                        REG32_PTR(0x80000000)
+#define PXA270_NCR_LEDS                          REG32_PTR(0x80000010)
+#define PXA270_NCR_SWPK                          REG32_PTR(0x80000020)
+#define PXA270_NCR_IRR                           REG32_PTR(0x80000024)
+#define PXA270_NCR_KEYPAD_Y                      REG32_PTR(0x80000080)
+#define PXA270_NCR_KEYPAD_X                      REG32_PTR(0x80000090)
+#define PXA270_NCR                               REG32_PTR(0x800000A0)
+#define PXA270_NCR_MDMCTL                        REG32_PTR(0x800000B0)
+#define PXA270_NCR_AUDCTL                        REG32_PTR(0x800000C0)
+
+//;irda range/power mode settings
+#define IRDAMD_MAX                               0x00
+#define IRDAMD_SHUT                              0x08
+#define IRDAMD_23                                0x10
+#define IRDAMD_13                                0x18
+
+//; Note: SCR is a virtual register
+//; register bit fields - scr
+#define SCR_SDRAMSz                              0x00000011 // sdram size bitfield
+#define SCR_FLASHSz                              0x00001100 // ; flash size bitfield
+#define SCR_FLASHType                            BIT4       //    ; flash type
+#define SCR_LCDType                              BIT5       //    ; lcd type
+#define SCR_GFX                                  BIT6       //    ; expansion card present
+#define SCR_SA1111                               BIT7       //    ; sa1111 card present
+
+#define HWConfig_RESET      (0x1 << 0)
+#define HWConfig_PORT       (0x1 << 1)
+#define HWConfig_FIFO       (0x1 << 2)
+#define HWConfig_SA1111     (0x1 << 3)
+#define HWConfig_TURBO      (0x1 << 4)
+#define HWConfig_EXPN       (0x1 << 5)
+#define HWConfig_DbgMODE    (0x1 << 6)
+#define HWConfig_PLL        (0x1 << 7)
+#define HWConfig_STEPPING   (0xF << 8)
+#define HWConfig_BootromPM  (0x1 << 12)
+#define HWConfig_AppflashPM (0x1 << 16)
+#define HWConfig_PAGEMODE   (HWConfig_BootromPM + HWConfig_AppflashPM)
+#define HWConfig_BOOTROM    (0xF << 12)
+#define HWConfig_APPFLASH   (0xF << 16)
+#define HWConfig_BusWIDTH01 (0x1 << 20)
+#define HWConfig_SPEED01    (0x1 << 21)
+#define HWConfig_SDRAM0     (0x1 << 22)
+#define HWConfig_SDRAM1     (0x1 << 23)
+#define HWConfig_BusWIDTH23 (0x1 << 24)
+#define HWConfig_SPEED23    (0x1 << 25)
+#define HWConfig_SDRAM2     (0x1 << 26)
+#define HWConfig_SDRAM3     (0x1 << 27)
+#define HWConfig_BusWIDTH   (HWConfig_BusWIDTH01 + HWConfig_BusWIDTH23)
+#define HWConfig_BusSPEED   (HWConfig_SPEED01 + HWConfig_SPEED23)
+#define HWConfig_HWR        (0x1 << 28)
+#define HWConfig_WDR        (0x1 << 29)
+#define HWConfig_SMR        (0x1 << 30)
+#define HWConfig_GPR        (0x1 << 31)
+
+//;------------------------------------------------------------------------
+
+//; defines for the ARM control register
+#define CONTROL_MMU                        BIT0
+#define CONTROL_FAULT                      BIT1
+#define CONTROL_DCACHE                     BIT2
+#define CONTROL_ENDIAN                     BIT7
+#define CONTROL_SYSTEM                     BIT8
+#define CONTROL_ROM                        BIT9
+#define CONTROL_BTB                        BIT11
+#define CONTROL_ICACHE                     BIT12
+#define CONTROL_VECTOR                     BIT13
+
+//;------------------------------------------------------------------------
+
+//; defines for the Auxiliary control register
+#define CONTROL_COALESCE                   BIT0
+#define CONTROL_PAGETABLE                  BIT1
+#define CONTROL_MINIDATA                   0x30
+#define CONTROL_MINIDATA_00                0x00
+#define CONTROL_MINIDATA_01                0x10
+#define CONTROL_MINIDATA_10                0x20
+
+//;------------------------------------------------------------------------
+
+//; virtual memory descriptor access attributes
+#define X_BIT                              (1 << 12)
+#define ALL_ACCESS                         (3 << 10)
+#define C_BIT                              (1 << 3)
+#define B_BIT                              (1 << 2)
+#define SECTION_BIT                        (1 << 1)
+#define CB_BITS                            (C_BIT + B_BIT)
+#define XB_BITS                            (X_BIT + B_BIT)
+#define XC_BITS                            (X_BIT + C_BIT)
+#define XCB_BITS                           (X_BIT + C_BIT + B_BIT)
+
+//; 1 Mb section access constants
+#define SECTION_x1c1b1                     ALL_ACCESS + SECTION_BIT + XCB_BITS
+#define SECTION_x1c0b1                     (ALL_ACCESS + SECTION_BIT + XB_BITS)
+#define SECTION_x1c1b0                     (ALL_ACCESS + SECTION_BIT + XC_BITS)
+#define SECTION_x0c1b1                     (ALL_ACCESS + SECTION_BIT + CB_BITS)
+#define SECTION_x0c0b1                     (ALL_ACCESS + SECTION_BIT + B_BIT)
+#define SECTION_x0c1b0                     (ALL_ACCESS + SECTION_BIT + C_BIT)
+#define SECTION_x0c0b0                     (ALL_ACCESS + SECTION_BIT)
+
+//;------------------------------------------------------------------------
+
+//; DACR constant
+#define ANGEL_DACR                         (0x1)
+
+//;------------------------------------------------------------------------
+
+//; PID constant
+#define ANGEL_PID                          (0x0)
+
+//;------------------------------------------------------------------------
+//; defines for the CCLKCFG register
+#define CCLKCFG_TURBO                      BIT0
+#define CCLKCFG_FCS                        BIT1
+#define CCLKCFG_DEFINED                    0x3   
+
+//;------------------------------------------------------------------------
+//; defines for the PWRMODE register
+#define PWRMODE_RUN                        0x0
+#define PWRMODE_IDLE                       0x1
+#define PWRMODE_SLEEP                      0x3
+#define PWRMODE_DEFINED                    0x3   
+//;------------------------------------------------------------------------
+
+//; bit codes used to identify flash devices
+#define FLASH_28f160S3                     (0x2)
+#define FLASH_28f128J3A                    (0x4)
+#define FLASH_28f640J5                     (0x6)
+#define FLASH_PM                           (0x1)
+#define FLASH_28f128J3A_PM                 (FLASH_28f128J3A + FLASH_PM)
+#define FLASH_NONE                         (0x000)
+
+ 
+ 
+//;------------------------------------------------------------------------
+//; sdram bank base addresses
+#define SDRAM0_PHYSICAL_BASE               REG32_PTR(0xA0000000)
+#define SDRAM1_PHYSICAL_BASE               REG32_PTR(0xA4000000)
+#define SDRAM2_PHYSICAL_BASE               REG32_PTR(0xA8000000)
+#define SDRAM3_PHYSICAL_BASE               REG32_PTR(0xAC000000)
+
+//; processor steppings
+#define STEPPING_A0                        (0x0)
+#define STEPPING_A1                        (0x1)
+#define STEPPING_B0                        (0x2)
+#define STEPPING_B1                        (0x3)
+#define STEPPING_B2                        (0x4)
+#define STEPPING_C0                        (0x5)
+
+//;------------------------------------------------------------------------
+//; physical address for alternate boot image
+//; the alternate image is booted when gpio 1 is a 1
+#define ALTERNATE_IMAGE_ADDR               0x01E00000
+
+//;------------------------------------------------------------------------
+
+#define p_cbAngelDRAM                      0xA0000000
+#define v_cbAngelDRAM                      0x00000000
+#if defined (CYGPKG_HAL_ARM_XSCALE_PXA271_BLRV)
+#define s_cbAngelDRAM                      0x02000000
+#else
+#define s_cbAngelDRAM                      0x04000000
+#endif
+
+#define i_cxAngelDRAM                      0xA0000000
+#if defined (CYGPKG_HAL_ARM_XSCALE_PXA271_BLRV)
+#define s_cxAngelDRAM                      0x02000000
+#else
+#define s_cxAngelDRAM                      0x04000000
+#endif
+
+// ; Expansion DRAM:  p=physical address, v=virtual address, s=size
+// ;  c=cached, b=buffered, x=Not[cached/buffered]
+#define p_cbExpDRAM                        0xA0800000
+#define v_cbExpDRAM                        0x50400000
+#define s_cbExpDRAM                        0x01A00000
+
+#define p_xxExpDRAM                        0xA2200000
+#define v_xxExpDRAM                        0x60400000
+#define s_xxExpDRAM                        0x01C00000
+
+// ; PCMCIA:  p=physical address, v=virtual address, s=size
+// ;  c=cached, b=buffered, x=Not[cached/buffered]
+#define p_xxPCMCIA                         0x20000000
+#define v_xxPCMCIA                         0xB0000000
+#define s_xxPCMCIA                         0x10000000
+
+// ; Processor Registers: s=size, i=identity-mapped 
+// ;  c=cached, b=buffered, x=Not[cached/buffered]
+#define i_xxProcessorReg                   0x40000000
+#define s_xxProcessorReg                   0x08100000
+
+// ; Platform Registers: s=size, i=identity-mapped 
+// ;  c=cached, b=buffered, x=Not[cached/buffered]
+#define i_xxPlatformReg                    0x08000000
+#define s_xxPlatformReg                    0x04000000
+
+#if defined (CYGPKG_HAL_ARM_XSCALE_PXA270_SG2P) \
+   || defined (CYGPKG_HAL_ARM_XSCALE_PXA271_BLRV) \
+   || defined (CYGPKG_HAL_ARM_XSCALE_PXA270_SGVP)
+// ; Boot Rom:  p=physical address, v=virtual address, s=size
+// ;  c=cached, b=buffered, x=Not[cached/buffered]
+#define p_xbBOOTROM                        0x00000000
+#define v_xbBOOTROM                        0x10000000
+#define s_xbBOOTROM                        0x04000000
+
+// ; Application Flash:  p=physical address, v=virtual address, s=size
+// ;  c=cached, b=buffered, x=Not[cached/buffered]
+#define p_xbAPPFLASH                       0x04000000
+#define v_xbAPPFLASH                       0x14000000
+#define s_xbAPPFLASH                       0x04000000
+#else
+// ; Boot Rom:  p=physical address, v=virtual address, s=size
+// ;  c=cached, b=buffered, x=Not[cached/buffered]
+#define p_xbBOOTROM                        0x00000000
+#define v_xbBOOTROM                        0x04000000
+#define s_xbBOOTROM                        0x04000000
+
+// ; Application Flash:  p=physical address, v=virtual address, s=size
+// ;  c=cached, b=buffered, x=Not[cached/buffered]
+#define p_xbAPPFLASH                       0x04000000
+#define v_xbAPPFLASH                       0x10000000
+#define s_xbAPPFLASH                       0x02000000
+#endif
+
+// ; Ethernet controller:  p=physical address, v=virtual address, s=size
+// ;  c=cached, b=buffered, x=Not[cached/buffered]
+#if defined (CYGPKG_HAL_ARM_XSCALE_PXA270_SG2P) || \
+    defined (CYGPKG_HAL_ARM_XSCALE_PXA271_BLRV)
+#define p_xxETHERNET                       0x10000000
+#else
+#define p_xxETHERNET                       0x0C000000
+#endif // CYGPKG_HAL_ARM_XSCALE_PXA270_SG2P || CYGPKG_HAL_ARM_XSCALE_PXA271_BLRV
+#define v_xxETHERNET                       0xA8000000
+#define s_xxETHERNET                       0x04000000
+
+// ; SA1111 memory:  p=physical address, v=virtual address, s=size
+// ;  c=cached, b=buffered, x=Not[cached/buffered]
+#define p_xxSA1111                         0x10000000
+#define v_xxSA1111                         0x20000000
+#define s_xxSA1111                         0x04000000
+
+// ; Expansion card:  p=physical address, v=virtual address, s=size
+// ;  c=cached, b=buffered, x=Not[cached/buffered]
+#define p_xxEXPANSION                      0xA4000000
+#define v_xxEXPANSION                      0xA5000000
+#define s_xxEXPANSION                      0x04000000
+
+// ; The clean cache regions are used to flush the data cache and mini-data caches,
+// ; these regions should not be used for anything else.
+
+// ; Clean Data Cache:  p=physical address, v=virtual address, s=size
+// ;  c=cached, b=buffered, x=Not[cached/buffered]
+#if defined (CYGPKG_HAL_ARM_XSCALE_PXA271_BLRV)
+#define p_cbCleanCache                     0xA1E00000
+#else
+#define p_cbCleanCache                     0xA3E00000
+#endif // CYGPKG_HAL_ARM_XSCALE_PXA271_BLRV
+#define v_cbCleanCache                     0xE0000000
+#define s_cbCleanCache                     0x00100000
+
+// ; Clean Mini Cache:  p=physical address, v=virtual address, s=size
+// ;  c=cached, b=buffered, x=Not[cached/buffered]
+#if defined (CYGPKG_HAL_ARM_XSCALE_PXA271_BLRV)
+#define p_cxCleanMini                      0xA1F00000
+#else
+#define p_cxCleanMini                      0xA3F00000
+#endif // CYGPKG_HAL_ARM_XSCALE_PXA271_BLRV
+#define v_cxCleanMini                      0xE0100000
+#define s_cxCleanMini                      0x00100000
+
+#define p_cbAllDRAM                        0xA0800000
+#define v_cbAllDRAM                        0x70400000
+#define s_cbAllDRAM                        (s_cbExpDRAM + s_xxExpDRAM + s_cbCleanCache + s_cxCleanMini)
+
+// ; the translation table base is put into the highest range of memory that angel
+// ; manages for itself, 128K allocated for the table. Note: do not get this out
+// ; of synch with devconf.h!
+
+// ; Translation Table Base::  p=physical address, s=size
+#define s_TTableBASE                       0x00020000
+#define p_TTableBASE                       ((p_cbAngelDRAM + s_cbAngelDRAM) - s_TTableBASE)
+#define vp_TTableBASE                      ((v_cbAngelDRAM + s_cbAngelDRAM) - s_TTableBASE)
+
+
+#define ROM1Base                           p_xbBOOTROM
+#define ROMBase                            ROM1Base
+
+#define ROM2Base                           p_xbAPPFLASH
+#define FlashBase                          ROM2Base 
+
+//; handy size constants
+#define SZ_256                             0x00000100
+#define SZ_1K                              0x00000400
+#define SZ_8K                              0x00002000
+#define SZ_16K                             0x00004000
+#define SZ_32K                             0x00008000
+#define SZ_64K                             0x00010000
+#define SZ_128K                            0x00020000
+#define SZ_256K                            0x00040000
+#define SZ_512K                            0x00080000
+
+#define SZ_1M                              0x00100000
+#define SZ_2M                              0x00200000
+#define SZ_4M                              0x00400000
+#define SZ_8M                              0x00800000
+#define SZ_14M                             0x00E00000
+#define SZ_16M                             0x01000000
+#define SZ_24M                             0x01800000
+#define SZ_32M                             0x02000000
+#define SZ_64M                             0x04000000
+#define SZ_96M                             0x06000000
+#define SZ_128M                            0x08000000
+#define SZ_256M                            0x10000000
+#define SZ_512M                            0x20000000
+
+#define SZ_1G                              0x40000000
+
+//; Default stack location
+//;
+ 
+#define RAM_Base                           v_cbAngelDRAM
+#define ROM_Base                           v_xbBOOTROM
+#define ROM_Size                           0x00080000
+
+#define MEM_BASE_PHYSICAL                  0xA3CB8000
+#define DRIVER_GLOBALS_OFFSET	           0x13B000
+#define DRIVER_GLOBALS_PHYSICAL	           MEM_BASE_PHYSICAL + DRIVER_GLOBALS_OFFSET
+#define UNINIT_MISC_GLOBALS_OFFSET         0x800 
+#define DRIVER_GLOBALS_CPU_ID_LOCATION     DRIVER_GLOBALS_PHYSICAL + UNINIT_MISC_GLOBALS_OFFSET
+
+#define RCR_VAL	                           0x00009708
+#define RCR_COM1                           0x00600060
+#define RCR_COM2                           0x00030003
+
+//;
+//; Default page table offsets
