 // This file is part of eCos, the Embedded Configurable Operating System.
@@ -61,8 +63,8 @@
 // it must not contain any code which might be position dependent!
 //
 
-int
-flash_program_buf(volatile flash_t *addr, flash_t *data, int len,
+static inline int
+__flash_program_buf(volatile flash_t *addr, flash_t *data, int len,
                   unsigned long block_mask, int buffer_size)
 {
     volatile flash_t *ROM;
@@ -96,15 +98,15 @@
         len -= wc;
 	// convert 'wc' in bytes to 'wc' in 'flash_t' 
         wc = wc / sizeof(flash_t);  // Word count
-        *BA = FLASH_Write_Buffer;
+        *addr = FLASH_Write_Buffer;
         timeout = 5000000;
-        while(((stat = ROM[0]) & FLASH_Status_Ready) != FLASH_Status_Ready) {
+        while(((stat = *addr) & FLASH_Status_Ready) != FLASH_Status_Ready) {
             if (--timeout == 0) {
                 goto bad;
             }
-            *BA = FLASH_Write_Buffer;
+            *addr = FLASH_Write_Buffer;
         }
-        *BA = FLASHWORD(wc-1);  // Count is 0..N-1
+        *addr = FLASHWORD(wc-1);  // Count is 0..N-1
         for (i = 0;  i < wc;  i++) {
 #ifdef CYGHWR_FLASH_WRITE_ELEM
             CYGHWR_FLASH_WRITE_ELEM(addr+i, data+i);
@@ -112,7 +114,7 @@
             *(addr+i) = *(data+i);
 #endif
         }
-        *BA = FLASH_Confirm;
+        *addr = FLASH_Confirm;
     
         ROM[0] = FLASH_Read_Status;
         timeout = 5000000;
@@ -137,14 +139,14 @@
 #endif
 
     while (len > 0) {
-        ROM[0] = FLASH_Program;
+        *addr = FLASH_Program;
 #ifdef CYGHWR_FLASH_WRITE_ELEM
         CYGHWR_FLASH_WRITE_ELEM(addr, data);
 #else
         *addr = *data;
 #endif
         timeout = 5000000;
-        while(((stat = ROM[0]) & FLASH_Status_Ready) != FLASH_Status_Ready) {
+        while(((stat = *addr) & FLASH_Status_Ready) != FLASH_Status_Ready) {
             if (--timeout == 0) {
                 goto bad;
             }
@@ -152,7 +154,7 @@
         if (stat & FLASH_ErrorMask) {
             break;
         }
-        ROM[0] = FLASH_Reset;            
+        *addr = FLASH_Reset;            
         if (*addr++ != *data++) {
             stat = FLASH_ErrorNotVerified;
             break;
@@ -162,6 +164,7 @@
 
     // Restore ROM to "normal" mode
  bad:
+    BA[0] = FLASH_Reset;            
     ROM[0] = FLASH_Reset;            
 
     if (cache_on) {
@@ -170,3 +173,29 @@
 
     return stat;
 }
+
+int
+flash_program_buf(volatile flash_t *addr, flash_t *data, int len,
+                  unsigned long block_mask, int buffer_size)
+{
+	int		ret = -1;
+	unsigned int	blksz = flash_info.block_size;
+	unsigned int	addrs = (unsigned int)addr;
+	unsigned int	datas = (unsigned int)data;
+
+	if (CHECK_LFI_ADDR(addr)) {
+		blksz = __flash_info.block_size;
+		block_mask = __flash_info.block_mask;
+	}
+
+	for ( ;
+	    addrs < (unsigned int)addr + len;
+	    addrs += blksz, datas += blksz) {
+		ret = __flash_program_buf((volatile flash_t *)addrs,
+		    (flash_t *)datas, blksz, block_mask, buffer_size);
+		if (ret & FLASH_ErrorMask)
+			return ret;
+	}
+
+	return ret;
+}
diff -uNr ecos.org/packages/devs/flash/intel/strata/current/src/flash_unlock_block.c ecos/packages/devs/flash/intel/strata/current/src/flash_unlock_block.c
--- ecos.org/packages/devs/flash/intel/strata/current/src/flash_unlock_block.c	2006-09-28 17:37:03.000000000 +0900
+++ ecos/packages/devs/flash/intel/strata/current/src/flash_unlock_block.c	2006-09-28 15:37:52.000000000 +0900
@@ -5,6 +5,8 @@
 //      Flash programming
 //
 //==========================================================================
+// Copyright (C) 2005-2006 WILLCOM, Inc. All rights Reserved.
+//==========================================================================
 //####ECOSGPLCOPYRIGHTBEGIN####
 // -------------------------------------------
 // This file is part of eCos, the Embedded Configurable Operating System.
@@ -69,8 +71,8 @@
 
 #define MAX_FLASH_BLOCKS 128
 
-int
-flash_unlock_block(volatile flash_t *block, int block_size, int blocks)
+static inline int
+__flash_unlock_block(volatile flash_t *block, int block_size, int blocks)
 {
     volatile flash_t *ROM;
     flash_t stat;
@@ -99,7 +101,7 @@
     // Clear lock bit
     block[0] = FLASH_Clear_Locks;
     block[0] = FLASH_Clear_Locks_Confirm;  // Confirmation
-    while(((stat = ROM[0]) & FLASH_Status_Ready) != FLASH_Status_Ready) {
+    while(((stat = block[0]) & FLASH_Status_Ready) != FLASH_Status_Ready) {
         if (--timeout == 0) break;
     }
 #else
@@ -146,6 +148,7 @@
 #endif  // CYGOPT_FLASH_IS_SYNCHRONOUS
 
     // Restore ROM to "normal" mode
+    block[0] = FLASH_Reset;
     ROM[0] = FLASH_Reset;
 
     if (cache_on) {
@@ -154,3 +157,26 @@
 
     return stat;
 }
+
+int
+flash_unlock_block(volatile flash_t *block, int block_size, int blocks)
+{
+	int		ret = -1;
+	unsigned int	addrs = (unsigned int)block;
+	int		blksz = block_size;
+
+	if (CHECK_LFI_ADDR(block)) {
+		blksz = __flash_info.block_size;
+	}
+
+	for (addrs = (unsigned int)block;
+	    addrs < (unsigned int)block + block_size;
+	    addrs += blksz) {
+		ret = __flash_unlock_block((volatile flash_t *)addrs,
+		    blksz, blocks);
+		if (ret & FLASH_ErrorMask)
+			return ret;
+	}
+
+	return ret;
+}
