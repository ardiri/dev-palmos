diff -uNr ecos.org/packages/devs/eth/arm/pxa270_sg2p/current/cdl/pxa270_sg2p_eth_drivers.cdl ecos/packages/devs/eth/arm/pxa270_sg2p/current/cdl/pxa270_sg2p_eth_drivers.cdl
--- ecos.org/packages/devs/eth/arm/pxa270_sg2p/current/cdl/pxa270_sg2p_eth_drivers.cdl	1970-01-01 09:00:00.000000000 +0900
+++ ecos/packages/devs/eth/arm/pxa270_sg2p/current/cdl/pxa270_sg2p_eth_drivers.cdl	2006-09-28 15:37:50.000000000 +0900
@@ -0,0 +1,118 @@
+# ====================================================================
+#
+#      pxa270_sg2p_eth_drivers.cdl
+#
+#      Ethernet drivers - support for LAN91CXX ethernet controller
+#      on the BSE SandgateII/PXA270 board.
+#
+# ====================================================================
+# Copyright (C) 2005-2006 WILLCOM, Inc. All rights Reserved.
+# ====================================================================
+#####ECOSGPLCOPYRIGHTBEGIN####
+## -------------------------------------------
+## This file is part of eCos, the Embedded Configurable Operating System.
+## Copyright (C) 1998, 1999, 2000, 2001, 2002 Red Hat, Inc.
