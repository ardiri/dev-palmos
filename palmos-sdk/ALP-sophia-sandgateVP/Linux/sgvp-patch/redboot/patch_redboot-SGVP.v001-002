+	ldr \reg, [\reg]
+	and \reg, \reg, #HWConfig_STEPPING
+	//; extract stepping bits
+	mov \reg, \reg, lsr #8
+	//; shift into position 0
+.endm
+
+//;----------------------------------------------------------------------------
