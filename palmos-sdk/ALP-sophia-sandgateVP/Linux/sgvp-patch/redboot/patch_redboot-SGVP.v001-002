+    # Calculated value:  "tests/crc_test.c" 
+    # Flavor: data
+    # Current_value: tests/crc_test.c
+};
+
+# <
+# <
+
diff -uNr ecos.org/redboot-SGVP.ecc ecos/redboot-SGVP.ecc
--- ecos.org/redboot-SGVP.ecc	1970-01-01 09:00:00.000000000 +0900
+++ ecos/redboot-SGVP.ecc	2006-09-28 15:37:50.000000000 +0900
