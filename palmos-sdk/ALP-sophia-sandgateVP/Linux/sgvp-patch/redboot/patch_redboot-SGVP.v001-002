+// The PXA271_BLRV system has two 16-bit devices.
+// Doc says: a StrataFlash 28F320J3A. The 320 means 32Mbit, so 4Mbyte.
+// Reality:  a StrataFlash 28F640J3A. The 640 means 64Mbit, so 8Mbyte.
+
+#define CYGNUM_FLASH_NDEVICES 	(1)
+#define CYGNUM_FLASH_DEVICES    (1)
+#define CYGNUM_FLASH_BASE       (0x00000000u)
+#define	__CYGNUM_FLASH_SIZE	(0x02000000u * CYGNUM_FLASH_DEVICES)
+#define CYGNUM_FLASH_SIZE 	(__CYGNUM_FLASH_SIZE * CYGNUM_FLASH_NDEVICES)
+#define CYGNUM_FLASH_BASE_MASK  (~(__CYGNUM_FLASH_SIZE - 1)) // 32Mb devices
+#define __CYGNUM_FLASH_MASK	(~(CYGNUM_FLASH_SIZE - 1)) // 32Mb devices
