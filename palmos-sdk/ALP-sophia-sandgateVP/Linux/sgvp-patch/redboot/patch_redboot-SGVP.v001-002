+
+#include <pkgconf/system.h>		// System-wide configuration info
+#include CYGBLD_HAL_VARIANT_H		// Variant specific configuration
+#include CYGBLD_HAL_PLATFORM_H		// Platform specific configuration
+#include <cyg/hal/hal_pxa270.h>		// Variant specific hardware definitions
+#include <cyg/hal/hal_mmu.h>		// MMU definitions
+#include <cyg/hal/hal_mm.h>		// more MMU definitions
+#include <cyg/hal/pxa270_sgvp.h>	// Platform specific hardware definitions
+#include <cyg/hal/hal_spd.h>
+
+#if defined(CYG_HAL_STARTUP_ROM)
+#define PLATFORM_SETUP1	_platform_setup1
+#define CYGHWR_HAL_ARM_HAS_MMU
+#else
+#define PLATFORM_SETUP1
+#endif
+
+#define CYGHWR_LED_MACRO	\
+	nop			;
+
+//;------------------------------------------------------------------------------------------
+//; This macro initializes the reset cause bits in the RCSR by saving them off then clearing the register.
+//;------------------------------------------------------------------------------------------
+.macro INITRESET reg0, reg1, reg2, reg3
+	// get base address of power mgr / reset control regs
+	ldr \reg1, =PXA270_RCSR
+	// get current value of the reset controller status register
+	ldr \reg0, [\reg1]
+	// extract the reset cause bits
+	mov \reg2, #RCSR_ALL
+	and \reg0, \reg0, \reg2
+	// clear the reset cause bits (they're sticky)
+	str \reg2, [\reg1]
+.endm
+
+//;------------------------------------------------------------------------------------------
+//;This macro initializes the OST count register to zero, clears the status bits in OSSR, and zeroes out the match registers.
+//;------------------------------------------------------------------------------------------
+.macro INITOST reg0, reg1
+	// zero-out the counter
+	mov \reg1, #0
+	ldr \reg0, =PXA270_OSCR
+	str \reg1, [\reg0]
+	//zero-out all 4 match registers
+	ldr \reg0, =PXA270_OSMR0
+	str \reg1, [\reg0]
+	ldr \reg0, =PXA270_OSMR1
+	str \reg1, [\reg0]
+	ldr \reg0, =PXA270_OSMR2
+	str \reg1, [\reg0]
+	ldr \reg0, =PXA270_OSMR3
+	str \reg1, [\reg0]
+	// clear the status bits - these are 'sticky' bits, cleared by
+	// writing 1's
+	mov \reg1, #OSSR_ALL
+	ldr \reg0, =PXA270_OSSR
+	str \reg1, [\reg0]
+	//set the interrupt-enable bit for match reg 1, as that is used by
+	//timing macros later (see below)
+	mov \reg1, #OIER_E0
+	ldr \reg0, =PXA270_OIER
+	str \reg1, [\reg0]
+	mov \reg1, #0
+	ldr \reg0, =PXA270_OWER
+	str \reg1, [\reg0]
+.endm
+
+//;------------------------------------------------------------------------
+//; delay for $mls milliseconds
+//; Note: this is a cheap-n-dirty delay macro, as it does not take
+//;	rollovers of the count register into account (which could
+//;	be BAD). Only use this if OS Timer Match Reg 1 is not
+//;	working or not available.
+//;------------------------------------------------------------------------
+.macro pauseMS mls, reg0, reg1, reg2
+	ldr \reg0, =PXA270_OSCR
+	mov \reg1, #0xE00
+	orr \reg1, \reg1, #0x66
+	//; generate ticks-per-millisec (0xE66)
+	mov \reg2, \mls
+	mul \reg1, \reg2, \reg1
+	//; number of ticks in the desired interval
+	ldr \reg2, [\reg0]
+	//; get start tick count
+	add \reg2, \reg2, \reg1
+	//; compute target tick count
+	//; load target count in the os timer match register 1 (OSMR1)
+	ldr \reg0, =PXA270_OSMR0
+	str \reg2, [\reg0]
+	//; clear status bit in OSSR
+	mov \reg1, #OSSR_M0
+	ldr \reg0, =PXA270_OSSR
+	str \reg1, [\reg0]
+2:
+	ldr \reg1, [\reg0]
+	//; get current tick count
+	tst \reg1, #OSSR_M0
+	//; test target against current
+	beq 2b
+.endm
+
+//;------------------------------------------------------------------------------------------
+//;This macro pauses til the ost counter has advanced the specified
+//;number of seconds. Note: the maximum number of seconds this macro
+//;can handle is 1165.
+//;------------------------------------------------------------------------------------------
+.macro pauseSeconds sec, reg0, reg1, reg2
+	ldr \reg0, =PXA270_OSCR
+	//; generate ticks-per-second (3686400)=0x384000
+	mov \reg1, #0x384000
+	//1-cycle instruction
+	//; calculate number of ticks in the desired interval
+	mov \reg2, \sec
+	// 1-cycle instruction
+	mul \reg1, \reg2, \reg1
+	//; 4-cycle instruction
+	//; get start tick count
+	ldr \reg2, [\reg0]
+	//; get start tick count - 3-cycle instruction
+	//; calculate the target tick count (start + interval) [see note in pauseMilliSecs]
+	add \reg2, \reg2, \reg1
+	//; load target count in the os timer match register 1 (OSMR1)
+	ldr \reg0, =PXA270_OSMR0
+	str \reg2, [\reg0]
+	//; clear status bit in OSSR
+	mov \reg1, #OSSR_M0
+	ldr \reg0, =PXA270_OSSR
+	str \reg1, [\reg0]
+	//; spin til match reg 1 status bit is set
+1:
+	ldr \reg1, [\reg0]
+	//; get current status bit(s)
+	tst \reg1, #OSSR_M0
+	beq 1b
+.endm
+
+//;------------------------------------------------------------------------------------------
+//;This macro initializes the HWConfig register. Initialization consists
+//;of two parts: (1) clear the register, and (2) load the reset cause bits
+//;from RCSR in it.
+//;------------------------------------------------------------------------
+.macro INITHWCONFIG reg0, reg1
+	//; shift bits 3:0 (reset cause bits) to 31:28
+	//; this will effectively clear the rest of the register
+	mov \reg0, \reg0, lsl #28
+	//; load the new data into HWConfig
+	ldr \reg1, =PXA270_PSPR
+	str \reg0, [\reg1]
+.endm
+
+//;------------------------------------------------------------------------------------------
+//; This macro sets the direction (input/output) of all 81 gpio pins
+//; coming out of reset.
+//;------------------------------------------------------------------------------------------
+.macro INITGPIO reg0, reg1, reg2
+	//; get the pin values for GPCRx
+	ldr \reg2, =PLATFORM_GPCRx
+	//; get the gpio register block base address
+	ldr \reg0, =PXA270_GPCRx
+	//; write the x values
+	str \reg2, [\reg0]
+	//; get the pin values for GPCRy
+	ldr \reg1, =PLATFORM_GPCRy
+	//; get the gpio register block base address
+	ldr \reg0, =PXA270_GPCRy
+	//; write the y values
+	str \reg1, [\reg0]
+	//; get the pin values for GPCRz
+	ldr \reg2, =PLATFORM_GPCRz
+	//; get the gpio register block base address
+	ldr \reg0, =PXA270_GPCRz
+	//; write the z values
+	str \reg2, [\reg0]
+	//; get the pin values for GPCRn
+	ldr \reg2, =PLATFORM_GPCRn
+	//; get the gpio register block base address
+	ldr \reg0, =PXA270_GPCRn
+	//; write the n values
+	str \reg2, [\reg0]
+	//; get the pin values for GPSRx
+	ldr \reg1, =PLATFORM_GPSRx
+	//; get the gpio register block base address
+	ldr \reg0, =PXA270_GPSRx
+	//; write the x values
+	str \reg1, [\reg0]
+	//; get the pin values for GPSRy
+	ldr \reg2, =PLATFORM_GPSRy
+	//; get the gpio register block base address
+	ldr \reg0, =PXA270_GPSRy
+	// write the y values
+	str \reg2, [\reg0]
+	//; get the pin values for GPSRz
+	ldr \reg1, =PLATFORM_GPSRz
+	//; get the gpio register block base address
+	ldr \reg0, =PXA270_GPSRz
+	//; write the z values
+	str \reg1, [\reg0]
+	//; get the pin values for GPSRn
+	ldr \reg1, =PLATFORM_GPSRn
+	//; get the gpio register block base address
+	ldr \reg0, =PXA270_GPSRn
+	//; write the n values
+	str \reg1, [\reg0]
+	//; get the pin values for GPDRx
+	ldr \reg1, =PLATFORM_GPDRx
+	//; get the gpio register block base address
+	ldr \reg0, =PXA270_GPDRx
+	//; write the x values
+	str \reg1, [\reg0]
+	//; get the pin values for GPDRy
+	ldr \reg2, =PLATFORM_GPDRy
+	//; get the gpio register block base address
+	ldr \reg0, =PXA270_GPDRy
+	//; write the y values
+	str \reg2, [\reg0]
+	//; get the pin values for GPDRz
+	ldr \reg1, =PLATFORM_GPDRz
+	//; get the gpio register block base address
+	ldr \reg0, =PXA270_GPDRz
+	//; write the z values
+	str \reg1, [\reg0]
+	//; get the pin values for GPDRn
+	ldr \reg1, =PLATFORM_GPDRn
+	//; get the gpio register block base address
+	ldr \reg0, =PXA270_GPDRn
+	//; write the n values
+	str \reg1, [\reg0]
+	//; get the pin values for GAFR0x
+	ldr \reg2, =PLATFORM_GAFR0x
+	//; get the gpio register block base address
+	ldr \reg0, =PXA270_GAFR0x
+	//; write the 0x values
+	str \reg2, [\reg0]
+	//; get the pin values for GAFR1x
+	ldr \reg1, =PLATFORM_GAFR1x
+	//; get the gpio register block base address
+	ldr \reg0, =PXA270_GAFR1x
+	//; write the 1x values
+	str \reg1, [\reg0]
+	//; get the pin values for GAFR0y
+	ldr \reg2, =PLATFORM_GAFR0y
+	//; get the gpio register block base address
+	ldr \reg0, =PXA270_GAFR0y
+	//; write the 0y values
+	str \reg2, [\reg0]
+	//; get the pin values for GAFR1y
+	ldr \reg1, =PLATFORM_GAFR1y
+	//; get the gpio register block base address
+	ldr \reg0, =PXA270_GAFR1y
+	//; write the 1y values
+	str \reg1, [\reg0]
+	//; get the pin values for GAFR0z
+	ldr \reg2, =PLATFORM_GAFR0z
+	//; get the gpio register block base address
+	ldr \reg0, =PXA270_GAFR0z
+	//; write the 0z values
+	str \reg2, [\reg0]
+	//; get the pin values for GAFR1z
+	ldr \reg1, =PLATFORM_GAFR1z
+	//; get the gpio register block base address
+	ldr \reg0, =PXA270_GAFR1z
+	//; write the 1z values
+	str \reg1, [\reg0]
+	//; get the pin values for GAFR0n
+	ldr \reg2, =PLATFORM_GAFR0n
+	//; get the gpio register block base address
+	ldr \reg0, =PXA270_GAFR0n
+	//; write the 0n values
+	str \reg2, [\reg0]
+	//; get the pin values for GAFR1n
+	ldr \reg1, =PLATFORM_GAFR1n
+	//; get the gpio register block base address
+	ldr \reg0, =PXA270_GAFR1n
+	//; write the 1n values
+	str \reg1, [\reg0]
+	//; make sure the peripheral-hold and read-disable-hold bits
+	//; in the PSSR are cleared
+	ldr \reg0, =PXA270_PSSR
+	mov \reg1, #PSSR_PH
+	orr \reg1, \reg1, #PSSR_RDH
+	str \reg1, [\reg0]
+.endm
+
+//;------------------------------------------------------------------------------------------
+//; This macro performs initialization on the platform registers
+//;------------------------------------------------------------------------------------------
+.macro INITPLATFORM reg0, reg1
+	mov \reg0, #0
+	ldr \reg1, =PXA270_BCR
+	str \reg0, [\reg1]
+.endm
+
+//;------------------------------------------------------------------------
+//; This macro checks for the Neponset and updates the HW Config word.
+//; It is assumed that the initGpio macro has already been run.
+//;------------------------------------------------------------------------
+.macro DETECTNEPONSET reg0, reg1, reg2
+	//; mask all other bits
+	//; get the current value of HWConfig
+	ldr \reg0, =PXA270_PSPR
+	ldr \reg1, [\reg0]
+	cmp \reg2, #1
+	//; Neponset present if zero
+	orrne \reg1, \reg1, #HWConfig_SA1111
+	//; Neponset Present
+	biceq \reg1, \reg1, #HWConfig_SA1111
+	//; Neponset not present
+	orr \reg1, \reg1, #HWConfig_BusWIDTH01
+	orr \reg1, \reg1, #HWConfig_SDRAM0
+	orr \reg1, \reg1, #HWConfig_SDRAM1
+	//; store the new HWConfig data
+	str \reg1, [\reg0]
+.endm
+
+//;------------------------------------------------------------------------
+//; This macro gets the (saved) current value of write-only BCR, so that it can
+//; be available for read-modify-write operations.
+//; The lower 8-bits of the BCR value are stored in the ffuart scratchpad
+//; register, and the upper 8-bits are stored in the btuart scratchpad register.
+//;------------------------------------------------------------------------
+.macro getBCR reg0, reg1
+	//; get the platform register(s) base address
+	ldr \reg1, =PXA270_BCR
+	ldr \reg0, [\reg1]
+.endm
+
+//;------------------------------------------------------------------------
+//; This macro saves the current value of write-only BCR, so that it can
+//; be available for read-modify-write operations.
+//; The lower 8-bits of the BCR value are saved to the ffuart scratchpad
+//; register, and the upper 8-bits are saved to the btuart scratchpad register.
+//;------------------------------------------------------------------------
+.macro putBCR reg0, reg1
+	//; get the platform register(s) base address
+	ldr \reg1, =PXA270_BCR
+	//; write back the new value for BCR
+	str \reg0, [\reg1]
+.endm
+
+//;------------------------------------------------------------------------
+//; This macro turns on the platform green led
+//;------------------------------------------------------------------------
+.macro greenLedOn reg0, reg1
+.endm
+
+//;------------------------------------------------------------------------
+//; This macro turns off the platform red led
+//;------------------------------------------------------------------------
+.macro greenLedOff reg0, reg1
+.endm
+
+//;------------------------------------------------------------------------
+//; This macro turns on the platform red led
+//;------------------------------------------------------------------------
+.macro redLedOn reg0, reg1
+.endm
+
+//;------------------------------------------------------------------------
+//; This macro turns off the platform red led
+//;------------------------------------------------------------------------
+.macro redLedOff reg0, reg1
+.endm
+
+//;------------------------------------------------------------------------
+//; This macro fetches data from the SA1111 daughtercard hex LED display.
+//;------------------------------------------------------------------------
+.macro getHexLED \reg0, \reg1
+	ldr \reg1, =PXA270_PSPR
+	ldr \reg1, [\reg1]
+	//; Get Sandgate-VP HWConfig word
+	tst \reg1, #HWConfig_SA1111
+	//; Is Daughter Card present?
+	beq 10f
+	//; If not, just exit
+	ldr \reg1, =PXA270_NCR_LEDS
+	//; address of LED register
+	ldr \reg0, [\reg1]
+	//; Move data from register
+10:
+.endm
+
+//;------------------------------------------------------------------------
+//; This macro sends data to the SA1111 daughtercard hex LED display.
+//;------------------------------------------------------------------------
+.macro setHexLED reg0, reg1
+	ldr \reg1, =PXA270_PSPR
+	ldr \reg1, [\reg1]
+	//; Get Sandgate-VP HWConfig word
+	tst \reg1, #HWConfig_SA1111
+	//; Is Daughter Card present?
+	beq 10f
+	//; If not, just exit
+	ldr \reg1, =PXA270_NCR_LEDS
+	//; address of LED register
+	str \reg0, [\reg1]
+	//; Move data into register
+10:
+.endm
+
+//;------------------------------------------------------------------------
+//; This macro disables (masks) all interrupts at the interrupt controller
+//;------------------------------------------------------------------------
+.macro INITINTCNTRLR reg0, reg1
+	ldr \reg1, =PXA270_ICMR
+	mov \reg0, #0
+	//; mask all interrupts at the controller
+	str \reg0, [\reg1]
+	//; clear the interrupt level register
+	ldr \reg1, =PXA270_ICLR
+	str \reg0, [\reg1]
+.endm
+
+//;----------------------------------------------------------------------------
+//; This macro invalidates the I cache, and, as a side effect,
+//; invalidates the Branch Target Buffer.
+//;----------------------------------------------------------------------------
+.macro INVALIDATEICACHE reg
+	mcr p15, 0, \reg, c7, c5, 0
+.endm
+
+//;----------------------------------------------------------------------------
+//; This macro guarantees that previous writes to coprocessor 15 have
+//; completed. Depending on what is being modified in cp15 (turning on
+//; the mmu, for example), these instructions may need to be executed
+//; from the icache.
+//;----------------------------------------------------------------------------
+.macro CPWAIT reg
+	mrc p15, 0, \reg, c2, c0, 0
+	mov \reg, \reg
+	sub pc, pc, #4
+.endm
+
+//;----------------------------------------------------------------------------
+//; This macro writes the contents of \reg0 into the ARM control register.
+//; Note: you must either format the contents of w1 so that reserved bits
+//; are written with the proper value, or use getARMControl and
+//; modify the control bits you need.
+//;----------------------------------------------------------------------------
+.macro setARMControl reg
+	// ; make sure this is first instruction in a cache line
+	b 72f
+	.p2align 5
+72:
+	mcr p15, 0, \reg, c1, c0, 0
+	//; insure that the write completes before continuing
+	CPWAIT \reg
+.endm
+
+//;----------------------------------------------------------------------------
+//; This macro returns the setting(s) of switch S6 - S6 is a three-position
+//; switch that is read via gpios 19, 20, & 21.
+//;----------------------------------------------------------------------------
+.macro getS6 reg0, reg1
+	mov \reg0, #0
+.endm
+
+//;---------------------------------------------------------------------
+//; HwConfig is a virtual register in which information about the
+//; hardware configuration, some of it user-supplied, is stored.
+//; Some bits are loaded elsewhere, see the macros getResetCause and getSCR.
+//; If \reg0 is loaded with anything but 0, then we branch around the
+//; detection code contained here and just load the value found in
+//; \reg0 into the HwConfig register.
+//;---------------------------------------------------------------------
+.macro SETHWCONFIG reg0, reg1, reg2, reg3, reg4, reg5, reg6, reg7
+	//; see if we do a simple load, or a config detection
+	cmp \reg0, #0
+	movne \reg7, \reg0
+	bne 4f
+	//; clear a reg to accumulate bits in
+	mov \reg7, #0
+	//; get the processor step bits
+	mrc p15, 0, \reg0, c0, c0, 0
+	and \reg0, \reg0, #0xF
+	orr \reg7, \reg7, \reg0, lsl #8
+	//; insert stepping info
+	//; determine the rom/flash type
+	//;getFLASHType \reg3, \reg0, \reg1, \s4, \reg4, \reg5, \reg6
+	//; Determine the type of ROM and application flash on the board.
+	//; This will determine the appropriate value for MSC0.
+	//; Four bits define each set of ROM devices:
+	//; bit0 specifies if the device supports page mode
+	//; 0 = page mode not supported
+	//; 1 = page mode supported
+	//; bits 1-3 encode the device type
+	//; load msc0 with default values so that we can query the application flash
+	ldr \reg1, =PXA270_MSC0
+	//; get base address of mem cntrlr regs
+	ldr \reg4, =MSC0_RESET_ALL
+	str \reg4, [\reg1]
+	ldr \reg4, [\reg1]
+	// ; We need the ICACHE on for this
+	INVALIDATEICACHE \reg3
+	CPWAIT \reg3
+	// getARMControl \reg2
+	mrc p15, 0, \reg2, c1, c0, 0
+	//; upper 18-bits must be written as zero, clear them now
+	mov \reg2, \reg2, lsl #18
+	mov \reg2, \reg2, lsr #18
+	// ; set the i-cache bit
+	orr \reg2, \reg2, #CONTROL_ICACHE
+	//; set the btb bit
+	orr \reg2, \reg2, #CONTROL_BTB
+	// ; write back the new value
+	setARMControl \reg2
+	CPWAIT \reg2
+	mov \reg5, #ROMBase
+	//; base address of ROM
+	mvn \reg0, #0
+	//; \reg0 contains READ_ARRAY command
+	mov \reg4, #0x900000
+	add \reg4, \reg4, #0x90
+	//; \reg4 contains READ_ID_CODES command
+	b 100f
+	//.p2align 8
+	// ALIGN 32
+100:
+	//; get the manufacturer code
+	str \reg4, [\reg5]
+	//; READ_ID_CODES command
+	ldr \reg1, [\reg5], #4
+	//; manufacturer code
+	str \reg0, [\reg5]
+	//; READ_ARRAY command
+	nop
+	nop
+	nop
+	nop
+	nop
+	//; get the device id
+	str \reg4, [\reg5]
+	//; READ_ID_CODES command
+	ldr \reg2, [\reg5]
+	//; device id
+	str \reg0, [\reg5]
+	//; READ_ARRAY command
+	nop
+	nop
+	nop
+	nop
+	nop
+	//; test for 28f128J3A devices
+	mov \reg4, #0x00890000
+	add \reg4, \reg4, #0x0089
+	//; \reg4 contains strataflash mfg code
+	cmp \reg1, \reg4
+	//; strata?
+	bne 200f
+	//; no
+	mov \reg0, #0x00180000
+	add \reg0, \reg0, #0x0018
+	//; \reg0 contains 28f128J3A device code
+	cmp \reg2, \reg0
+	//; 28f128J3A?
+	bne 200f
+	//; no, check next type
+	//; 28f128J3A found in boot rom
+	mov \reg3, #FLASH_28f128J3A_PM
+	b 400f
+200:
+	//; test for 28f160S3 devices
+	mov \reg4, #0x00B00000
+	add \reg4, \reg4, #0x00B0
+	//; \reg4 contains 28f160S3/28f320 mfg code
+	cmp \reg1, \reg4
+	//; 28f160S3/28f320?
+	bne 300f
+	//; no, check next type
+	mov \reg0, #0x00D00000
+	add \reg0, \reg0, #0x00D0
+	//; \reg0 contains 28f160S3 device code
+	cmp \reg2, \reg0
+	//; 28f160S3?
+	bne 300f
+	//; no, check next type
+	//; 28f160S3 found in boot rom
+	mov \reg3, #FLASH_28f160S3
+	b 400f
+	//; goto application flash
+300:
+	//; test for 28f640J5 devices
+	mov \reg4, #0x00890000
+	add \reg4, \reg4, #0x0089
+	//; \reg4 contains 28f640J5 mfg code
+	cmp \reg1, \reg4
+	//; 28f640J5/28f320?
+	bne 350f
+	//; no, use reset value
+	mov \reg0, #0x00150000
+	add \reg0, \reg0, #0x0015
+	//; \reg0 contains 28f640J5 device code
+	cmp \reg2, \reg0
+	//; 28f640J5?
+	bne 350f
+	//; no, use reset value
+	//; 28f640J5 found in boot rom
+	mov \reg3, #FLASH_28f640J5
+	b 400f
+	//; goto application flash
+350:
+	//; boot rom type unknown or not found
+	mov \reg3, #FLASH_NONE
+400:
+	//; now query the application flash
+	mov \reg5, #FlashBase
+	//; base address of application flash
+	mvn \reg0, #0
+	//; \reg0 contains READ_ARRAY command
+	mov \reg4, #0x900000
+	add \reg4, \reg4, #0x90
+	//; \reg4 contains READ_ID_CODES command
+	b 500f
+	//.p2align 8
+	//ALIGN 32
+500:
+	//; get the manufacturer code
+	str \reg4, [\reg5]
+	//; READ_ID_CODES command
+	ldr \reg1, [\reg5], #4
+	//; manufacturer code
+	str \reg0, [\reg5]
+	//; READ_ARRAY command
+	nop
+	nop
+	nop
+	nop
+	nop
+	//; get the device id
+	str \reg4, [\reg5]
+	//; READ_ID_CODES command
+	ldr \reg2, [\reg5]
+	//; device id
+	str \reg0, [\reg5]
+	//; READ_ARRAY command
+	nop
+	nop
+	nop
+	nop
+	nop
+	//; test for 28f128J3A devices
+	mov \reg4, #0x00890000
+	add \reg4, \reg4, #0x0089
+	//; \reg4 contains strataflash mfg code
+	cmp \reg1, \reg4
+	//; strata?
+	bne 600f
+	//; no
+	mov \reg0, #0x00180000
+	add \reg0, \reg0, #0x0018
+	//; \reg0 contains 28f128J3A device code
+	cmp \reg2, \reg0
+	//; 28f128J3A?
+	bne 700f
+	//; no, use reset value
+	//; 28f128J3A found in application flash
+	mov \reg6, #FLASH_28f128J3A_PM
+	b 800f
+600:
+	//; test for 28f160S3 devices
+	mov \reg4, #0x00B00000
+	add \reg4, \reg4, #0x00B0
+	//; \reg4 contains 28f160S3/28f320 mfg code
+	cmp \reg1, \reg4
+	//; 28f160S3/28f320?
+	bne 700f
+	//; no, check next type
+	mov \reg0, #0x00D00000
+	add \reg0, \reg0, #0x00D0
+	//; \reg0 contains 28f160S3 device code
+	cmp \reg2, \reg0
+	//; 28f160S3?
+	bne 700f
+	//; no, check next type
+	//; 28f160S3 found in application flash
+	mov \reg6, #FLASH_28f160S3
+	b 800f
+700:
+	//; test for 28f640J5 devices
+	mov \reg4, #0x00890000
+	add \reg4, \reg4, #0x0089
+	//; \reg4 contains 28f640J5 mfg code
+	cmp \reg1, \reg4
+	//; 28f640J5?
+	bne 750f
+	//; no, use reset value
+	mov \reg0, #0x00150000
+	add \reg0, \reg0, #0x0015
+	//; \reg0 contains 28f640J5 device code
+	cmp \reg2, \reg0
+	//; 28f640J5?
+	bne 750f
+	//; no, use reset value
+	//; 28f640J5 found in application flash
+	mov \reg6, #FLASH_28f640J5
+	b 800f
+750:
+	//; app flash type unknown or not found
+	mov \reg6, #FLASH_NONE
+800:
+	//; insert app flash values
+	add \reg3, \reg3, \reg6, lsl #4
+	// end of get flash type
+	//;----------------------------------------------------------------------------
+	//; insert the flash type into the config reg
+	orr \reg7, \reg7, \reg3, lsl #12
+	//; set bus speed
+	//; get the pin-level setting of gpios 19, 20, or 21 (S6 on Sandgate-VP)
+	getS6 \reg0, \reg1
+	mov \reg1, #GPXXx_GPIO21
+	//; Get GPIO 21
+	mov \reg1, \reg1, lsr #19
+	//; Shift it into position
+	cmp \reg0, \reg1
+	//; Check S6C contact was made
+	biceq \reg7, \reg7, #HWConfig_BusSPEED
+	//; 0=full-speed (DEFAULT)
+	orrne \reg7, \reg7, #HWConfig_BusSPEED
+	//; 1=half-speed (DEBUG)
+	//; disable page (burst) mode in the ROMs off
+	//;bic \reg7, \reg7, #HWConfig_PAGEMODE ; clear page mode bits
+	//; set bus width - for all banks
+	bic \reg7, \reg7, #HWConfig_BusWIDTH
+	//; 0=32 bit
+	//;orr \reg7, \reg7, #HWConfig_BusWIDTH ; 1=16 bit
+	//; set pll speed
+	//; get the pin-level setting of gpios 19, 20, or 21 (S6 on Sandgate-VP)
+	getS6 \reg0, \reg1
+	mov \reg1, #GPXXx_GPIO21
+	//; Get GPIO 21
+	mov \reg1, \reg1, lsr #19
+	//; Shift it into position
+	cmp \reg0, \reg1
+	//; Check S6C contact was made
+	bicne \reg7, \reg7, #HWConfig_PLL
+	//; 0=default frequency
+	orreq \reg7, \reg7, #HWConfig_PLL
+	//; 1=alternate frequency (DEBUG)
+	//; set debug port
+	//; get the pin-level setting of gpios 19, 20, or 21 (S6 on Sandgate-VP)
+	getS6 \reg0, \reg1
+	cmp \reg0, #1
+	//; = 1 if any S6 contact was made
+	bicne \reg7, \reg7, #HWConfig_PORT
+	//; 0=ffuart - S6 NOT pushed
+	orreq \reg7, \reg7, #HWConfig_PORT
+	//; 1=btuart - S6 pushed
+	//; determine run or turbo mode
+	getS6 \reg0, \reg1
+	mov \reg1, #GPXXx_GPIO21
+	//; Get GPIO 21
+	mov \reg1, \reg1, lsr #19
+	//; Shift it into position
+	cmp \reg0, \reg1
+	//; Check S6C contact was made
+	bicne \reg7, \reg7, #HWConfig_TURBO
+	//; 0=run mode
+	orreq \reg7, \reg7, #HWConfig_TURBO
+	//; 1=turbo mode
+	//; set Angel's debug mode
+	bic \reg7, \reg7, #HWConfig_DbgMODE
+	//; 0=off (default)
+	//;orr \reg7, \reg7, #HWConfig_DbgMODE ; 1=on
+	//; set the installed sdram banks
+	//; Sandgate-VP only has bank 0 installed
+	orr \reg7, \reg7, #HWConfig_SDRAM0
+4:
+	// ; get current value (initHWConfig should already have executed)
+	ldr \reg2, =PXA270_PSPR
+	ldr \reg2, [\reg2]
+	// ; orr in the new bits
+	orr \reg7, \reg7, \reg2
+	// ; ensure that the sleep reset valid bit is clear - this should only
+	// ; be set by an app that is prepared to handle a sleep reset.
+	bic \reg7, \reg7, #HWConfig_RESET
+	// ; write back the new value
+	ldr \reg1, =PXA270_PSPR
+	str \reg7, [\reg1]
+.endm
+
+//;----------------------------------------------------------------------------
+//; This macro sets the condition code if last reset was sleep reset. The
+//; cc is set based on a cmp of the sleep reset bit in the HwConfig virtual
+//; register with 0x1. Don't confuse the sleep reset cause bit (the one of
+//; interest here) with the sleep reset valid bit, both in HwConfig.
+//;----------------------------------------------------------------------------
+.macro isSleepReset reg
+	//; get sleep mode reset bit
+	ldr \reg, =PXA270_PSPR
+	ldr \reg, [\reg]
+	and \reg, \reg, #HWConfig_SMR
+	//; extract sleep mode reset cause bit
+	mov \reg, \reg, lsr #30
+	//; set the condition code
+	cmp \reg, #1
+.endm
+
+//;----------------------------------------------------------------------------
+//; This macro disables the peripheral clocks, and sets the core clock
+//; frequency based on the pll bit in the hwConfig virtual register.
+//; This macro is for use when coming out of HW reset.
+//;----------------------------------------------------------------------------
+.macro initClocks_1st reg0, reg1
+	//CCCR
+	ldr \reg1, =0x00000210		// A=0, T=416MHz, R=208MHz
+	ldr \reg0, =PXA270_CCCR
+	str \reg1, [\reg0]
+	//; write CCCR
+	mov \reg1, #OSCC_OON
+	ldr \reg0, =PXA270_OSCC
+	str \reg1, [\reg0]
+25:
+	ldr \reg1, [\reg0]
+	ands \reg1, \reg1, #1
+	beq 25b
+	//CCLKCFG
+	mov \reg0, #0x08 | 0x02 | 0x01	// Fast-Bus, Frequency Change, Turbo
+	mcr p14, 0, \reg0, c6, c0, 0
+	//; write CCLKCFG
+.endm
+
+.macro initClocks_2nd reg0, reg1
+	//CCCR
+	ldr \reg1, =0x02000210		// A=1, T=416MHz, R=208MHz
+	ldr \reg0, =PXA270_CCCR
+	str \reg1, [\reg0]
+	//; write CCCR
+	mov \reg1, #OSCC_OON
+	ldr \reg0, =PXA270_OSCC
+	str \reg1, [\reg0]
+25:
+	ldr \reg1, [\reg0]
+	ands \reg1, \reg1, #1
+	beq 25b
+	//CCLKCFG
+	mov \reg0, #0x08 | 0x02 | 0x01	// Fast-Bus, Frequency Change, Turbo
+	mcr p14, 0, \reg0, c6, c0, 0
+	//; write CCLKCFG
+.endm
+
+//;------------------------------------------------------------------------
+//; This macro initializes the RTC count register to zero.
+//;------------------------------------------------------------------------
+.macro initRTC reg0, reg1
+	ldr \reg0, =PXA270_RCNR
+	mov \reg1, #0
+	str \reg1, [\reg0]
+.endm
+
+//;------------------------------------------------------------------------
+//; This macro initializes the power mgr registers.
+//;------------------------------------------------------------------------
+.macro initPower reg0, reg1, reg2
+	//; get base address of power mgr / reset control regs
+	ldr \reg1, =PXA270_PMCR
+	mov \reg0, #0x14 // INTRS, VIDAE 
+	str \reg0, [\reg1, #0x00]	// PMCR
+	//; initializes
+	mov \reg0, #0
+	str \reg0, [\reg1, #0x0c]	// PWER
+	str \reg0, [\reg1, #0x10]	// PRER
+	str \reg0, [\reg1, #0x14]	// PFER
+	str \reg0, [\reg1, #0x18]	// PEDR
+	str \reg0, [\reg1, #0x20]	// PGSR0
+	str \reg0, [\reg1, #0x24]	// PGSR1
+	str \reg0, [\reg1, #0x28]	// PGSR2
+	str \reg0, [\reg1, #0x2c]	// PGSR3
+	str \reg0, [\reg1, #0x38]	// PSTR
+	str \reg0, [\reg1, #0x40]	// PVCR
+	str \reg0, [\reg1, #0x50]	// PKWR
+	str \reg0, [\reg1, #0x54]	// PKSR
+	//:
+	mov \reg0, #(PCFR_OPDE | 0x20 | 0x40 | 0x10)	// SYSEN_EN, PI2C_EN, GPR_EN
+//	mov \reg0, #(PCFR_OPDE | 0x20 | 0x10)	// SYSEN_EN, GPR_EN
+	str \reg0, [\reg1, #0x1c]	// PCFR
+	//; enable gpio0 wakeup
+	mov \reg0, #PWER_WE0
+	//; enable rtc alarm wakeup
+	orr \reg0, \reg0, #PWER_WERTC
+	str \reg0, [\reg1, #0x0c]	// PWER
+	str \reg0, [\reg1, #0x14]	// PFER
+.endm
+
+//;------------------------------------------------------------------------
+//; This macro sets the condition code if the mmu is already enabled. The
+//; cc is set based on a cmp of the mmu_enable bit in the ARM control
+//; register with 0x1.
+//;-----------------------------------------------------------------------
+.macro isMmuEnabled reg
+	//getARMControl \reg
+	mrc p15, 0, \reg, c1, c0, 0
+	//; upper 18-bits must be written as zero, clear them now
+	mov \reg, \reg, lsl #18
+	mov \reg, \reg, lsr #18
+	cmp \reg, #CONTROL_MMU
+.endm
+
+//;------------------------------------------------------------------------
+//; This macro pauses til the ost counter has advanced the specified
+//; number of microseconds.
+//;------------------------------------------------------------------------
+.macro pauseMicroSecs usec, reg0, reg1, reg2
+	ldr \reg0, =PXA270_OSCR
+	/* ;-----------------------------------
+	; generate ticks-per-microsecond
+	; Note: with a 3.6864mhz counter, it's 3.6864 ticks/microsecond.
+	; This makes integer arithmetic difficult, so, we're going
+	; to multiply that by 1024 (2**10), and use 3774 as our
+	; factor. Then we'll divide the result by 1024 (just a quick
+	; shift), and our accuracy will be pretty good.*/
+	//; generate ticks-per-microsecond (3.6864)x(1024)=0xEBE
+	mov \reg1, #0xE00
+	//; 1-cycle instruction
+	orr \reg1, \reg1, #0xBE
+	//; 1-cycle instruction (no penalty)
+	//; calculate number of ticks in the desired interval
+	mov \reg2, \usec
+	//; 1-cycle instruction
+	mul \reg1, \reg2, \reg1
+	//; 4-cycle instruction
+	//; take out our factor of 1024 - now we have the interval
+	mov \reg1, \reg1, lsr #10
+	//; 1-cycle instruction
+	//; get start tick count
+	ldr \reg2, [\reg0]
+	//; get start tick count - 3-cycle instruction
+	//;-----------------------------------
+	//; calculate the target tick count (start + interval) [see note in pauseMilliSecs]
+	add \reg2, \reg2, \reg1
+	//;-----------------------------------
+	//; load target count in the os timer match register 1 (OSMR1)
+	ldr \reg0, =PXA270_OSMR0
+	str \reg2, [\reg0]
+	//; clear status bit in OSSR
+	mov \reg1, #OSSR_M0
+	ldr \reg0, =PXA270_OSSR
+	str \reg1, [\reg0]
+	//;-----------------------------------
+	//; spin til match reg 1 status bit is set
+101:
+	ldr \reg1, [\reg0]
+	//; get current status bit(s)
+	tst \reg1, #OSSR_M0
+	//; test for match reg 1 status
+	beq 101b
+	//; continue if not set
+.endm
+
+.macro PAUSE reg
+	ldr \reg, =0x100000
+555:	sub \reg, \reg, #1
+	cmp \reg, #0
+	bne 555b
+.endm
+
+//;----------------------------------------------------------------------------
+//; This macro make the red led blink
+//;----------------------------------------------------------------------------
+.macro redblink reg0, reg1, reg2, reg3
+102:
+	redLedOff \reg0, \reg1
+	pauseMS #50, \reg0, \reg1, \reg2
+	redLedOn \reg0, \reg1
+	pauseMS #50, \reg0, \reg1, \reg2
+	sub \reg3, \reg3, #1
+	cmp \reg3, #0
+	bne 102b
+.endm
+
+//;----------------------------------------------------------------------------
+//; This macro make the green led blink
+//;----------------------------------------------------------------------------
+.macro greenblink reg0, reg1, reg2, reg3
+103:
+	greenLedOn \reg0, \reg1
+	pauseMS #50, \reg0, \reg1, \reg2
+	greenLedOff \reg0, \reg1
+	pauseMS #50, \reg0, \reg1, \reg2
+	sub \reg3, \reg3, #1
+	cmp \reg3, #0
+	bne 103b
+.endm
+
+//;----------------------------------------------------------------------------
+//; This macro determines appropriate msc0 settings based on the flash type
+//; bits in HWConfig. The msc0 settings are returned in \reg0.
+//;----------------------------------------------------------------------------
+.macro getMSC0 reg0//, reg1, reg2
+/*
+	ldr \reg1, =PXA270_PSPR
+	ldr \reg1, [\reg1]
+	//; determine bootrom msc0 value
+	and \reg2, \reg1, #HWConfig_BOOTROM
+	//; extract bootrom bits
+	mov \reg2, \reg2, lsr #12
+	cmp \reg2, #FLASH_28f128J3A_PM
+	//; 28f128J3A in pagemode?
+	ldreq \reg0, =MSC0_28f128J3A_PM
+*/
+	ldr \reg0, =MSC0_28f128J3A_PM
+/*
+	beq 52f
+	cmp \reg2, #FLASH_28f128J3A
+	//; 28f128J3A non-burst?
+	ldreq \reg0, =MSC0_28f128J3A_NB
+	beq 52f
+	cmp \reg2, #FLASH_28f640J5
+	//; 28f640J5?
+	ldreq \reg0, =MSC0_28f640J5
+	beq 52f
+	cmp \reg2, #FLASH_28f160S3
+	//; 28f160S3?
+	ldreq \reg0, =MSC0_28f160S3
+	beq 52f
+	ldr \reg0, =MSC0_RESET
+	//; unknown flash type
+52:
+	//; determine app flash msc0 value
+	and \reg2, \reg1, #HWConfig_APPFLASH
+	//; extract app flash bits
+	mov \reg2, \reg2, lsr #16
+	cmp \reg2, #FLASH_28f128J3A_PM
+	//; 28f128J3A in pagemode (burst)?
+	ldreq \reg1, =MSC0_28f128J3A_PM
+	beq 54f
+	cmp \reg2, #FLASH_28f128J3A
+	//; 28f128J3A non-burst mode?
+	ldreq \reg1, =MSC0_28f128J3A_NB
+	beq 54f
+	cmp \reg2, #FLASH_28f640J5
+	//; 28f640J5?
+	ldreq \reg1, =MSC0_28f640J5
+	beq 54f
+	cmp \reg2, #FLASH_28f160S3
+	//; 28f160S3?
+	ldreq \reg1, =MSC0_28f160S3
+	beq 54f
+	ldr \reg1, =MSC0_RESET
+	//; unknown flash type
+54:
+	orr \reg0, \reg0, \reg1, lsl #16
+*/
+	//; insert app flash msc0 value
+.endm
+
+//;----------------------------------------------------------------------------
+//; The sleep reset valid bit is returned in position 0 of \reg
+//;----------------------------------------------------------------------------
+.macro getHWConfig_SleepReset reg
+	ldr \reg, =PXA270_PSPR
+	ldr \reg, [\reg]
+	and \reg, \reg, #HWConfig_RESET
+.endm
+
+//;----------------------------------------------------------------------------
+//; The debug port bit is returned in position 0 of \reg
+//;----------------------------------------------------------------------------
+.macro getHWConfig_DebugPORT reg
+	ldr \reg, =PXA270_PSPR
+	ldr \reg, [\reg]
+	and \reg, \reg, #HWConfig_PORT
+	mov \reg, \reg, lsr #1
+	//; shift into position 0
+.endm
+
+//;----------------------------------------------------------------------------
+//; The fifo trigger-level bit is returned in position 0 of \reg
+//; 1=8, 0=32
+//;----------------------------------------------------------------------------
+.macro getHWConfig_Fifo reg
+	ldr \reg, =PXA270_PSPR
+	ldr \reg, [\reg]
+	and \reg, \reg, #HWConfig_FIFO
+	//; extract expansion bit
+	mov \reg, \reg, lsr #2
+	//; shift into position 0
+.endm
+
+//;----------------------------------------------------------------------------
+//; The sa1111 bit is returned in position 0 of \reg
+//; 1=present, 0=not present
+//;----------------------------------------------------------------------------
+.macro getHWConfig_SA1111CARD reg
+	ldr \reg, =PXA270_PSPR
+	ldr \reg, [\reg]
+	and \reg, \reg, #HWConfig_SA1111
+	//; extract sa1111 bit
+	mov \reg, \reg, lsr #3
+	//; shift into position 0
+.endm
+
+//;----------------------------------------------------------------------------
+//; The TURBO bit is returned in position 0 of \reg
+//; 1=present, 0=not present
