+    #                             CYGHWR_HAL_ARM_XSCALE_PROCESSOR_CCLK_DEFAULT : 400000
+    #     CYGHWR_HAL_ARM_XSCALE_PROCESSOR_CCLK_DEFAULT (unknown) == 0
