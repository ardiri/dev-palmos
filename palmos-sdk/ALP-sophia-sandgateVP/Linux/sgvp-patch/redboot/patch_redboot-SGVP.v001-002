-#define CKEN_CKEN1                                BIT1
-#define CKEN_CKEN2                                BIT2
-#define CKEN_CKEN3                                BIT3
-//; bit 4 is reserved
-#define CKEN_CKEN5                                BIT5
-#define CKEN_CKEN6                                BIT6
-#define CKEN_CKEN7                                BIT7
-#define CKEN_CKEN8                                BIT8
-//; bit 9 is reserved
