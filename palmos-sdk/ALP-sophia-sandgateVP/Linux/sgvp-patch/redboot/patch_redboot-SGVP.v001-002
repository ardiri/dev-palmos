+
+#include <cyg/infra/cyg_type.inc>
+
+MEMORY
+{
+    ram : ORIGIN = 0xa0000000, LENGTH = 0x02000000
+    rom : ORIGIN = 0x10000000, LENGTH = 0x02000000
+}
+
+SECTIONS
+{
+    SECTIONS_BEGIN
+    SECTION_rom_vectors (rom, 0x10000000, LMA_EQ_VMA)
+    SECTION_text (rom, ALIGN (0x4), LMA_EQ_VMA)
+    SECTION_fini (rom, ALIGN (0x4), LMA_EQ_VMA)
+    SECTION_rodata (rom, ALIGN (0x4), LMA_EQ_VMA)
+    SECTION_rodata1 (rom, ALIGN (0x4), LMA_EQ_VMA)
+    SECTION_fixup (rom, ALIGN (0x4), LMA_EQ_VMA)
+    SECTION_gcc_except_table (rom, ALIGN (0x4), LMA_EQ_VMA)
+    SECTION_fixed_vectors (ram, 0xa0000020, LMA_EQ_VMA)
+    SECTION_data (ram, 0xa0008000, FOLLOWING (.gcc_except_table))
+    SECTION_bss (ram, ALIGN (0x4), LMA_EQ_VMA)
+    CYG_LABEL_DEFN(__heap1) = ALIGN (0x8);
+    SECTIONS_END
+}
diff -uNr ecos.org/packages/hal/arm/xscale/pxa271_blrv/current/include/pkgconf/mlt_arm_xscale_pxa271_blrv_rom.mlt ecos/packages/hal/arm/xscale/pxa271_blrv/current/include/pkgconf/mlt_arm_xscale_pxa271_blrv_rom.mlt
--- ecos.org/packages/hal/arm/xscale/pxa271_blrv/current/include/pkgconf/mlt_arm_xscale_pxa271_blrv_rom.mlt	1970-01-01 09:00:00.000000000 +0900
+++ ecos/packages/hal/arm/xscale/pxa271_blrv/current/include/pkgconf/mlt_arm_xscale_pxa271_blrv_rom.mlt	2006-09-13 13:48:59.000000000 +0900
@@ -0,0 +1,14 @@
+version 0
+region ram a0000000 2000000 0 !
+region rom 10000000 2000000 1 !
+section fixed_vectors 0 1 0 1 1 0 1 0 a0000020 a0000020 !
+section data 0 1 1 1 1 1 0 0 a0008000 bss !
+section bss 0 4 0 1 0 1 0 1 heap1 heap1 !
+section heap1 0 8 0 0 0 0 0 0 !
+section rom_vectors 0 1 0 1 1 1 1 1 10000000 02000000 text text !
+section text 0 4 0 1 0 1 0 1 fini fini !
+section fini 0 4 0 1 0 1 0 1 rodata rodata !
+section rodata 0 4 0 1 0 1 0 1 rodata1 rodata1 !
+section rodata1 0 4 0 1 0 1 0 1 fixup fixup !
+section fixup 0 4 0 1 0 1 0 1 gcc_except_table gcc_except_table !
+section gcc_except_table 0 4 0 1 0 0 0 1 data !
diff -uNr ecos.org/packages/hal/arm/xscale/pxa271_blrv/current/include/plf_io.h ecos/packages/hal/arm/xscale/pxa271_blrv/current/include/plf_io.h
