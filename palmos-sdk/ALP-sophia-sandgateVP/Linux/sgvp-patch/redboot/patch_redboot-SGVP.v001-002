+#define CKEN_FFUART                               CKEN_CKEN6
+#define CKEN_BTUART                               CKEN_CKEN7
+#define CKEN_I2S                                  CKEN_CKEN8
+#define CKEN_ADC                                  CKEN_CKEN10
+#define CKEN_USB                                  CKEN_CKEN11
