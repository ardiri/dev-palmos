-
-//; defines for the ARM control register
-#define CONTROL_MMU                        BIT0
-#define CONTROL_FAULT                      BIT1
-#define CONTROL_DCACHE                     BIT2
-#define CONTROL_ENDIAN                     BIT7
-#define CONTROL_SYSTEM                     BIT8
-#define CONTROL_ROM                        BIT9
-#define CONTROL_BTB                        BIT11
-#define CONTROL_ICACHE                     BIT12
-#define CONTROL_VECTOR                     BIT13
