--- ecos.org/packages/devs/flash/arm/pxa270_sg2p/current/cdl/flash_pxa270_sg2p.cdl	1970-01-01 09:00:00.000000000 +0900
+++ ecos/packages/devs/flash/arm/pxa270_sg2p/current/cdl/flash_pxa270_sg2p.cdl	2006-09-28 15:37:51.000000000 +0900
@@ -0,0 +1,82 @@
+#====================================================================
+#
+#      flash_pxa270_sg2p.cdl
+#
+#      FLASH memory - Hardware support on Intel PXA270 SandgateII 
+#
+#====================================================================
+# Copyright (C) 2005-2006 WILLCOM, Inc. All rights Reserved.
+#====================================================================
+#####ECOSGPLCOPYRIGHTBEGIN####
+## -------------------------------------------
+## This file is part of eCos, the Embedded Configurable Operating System.
+## Copyright (C) 1998, 1999, 2000, 2001, 2002 Red Hat, Inc.
+##
+## eCos is free software; you can redistribute it and/or modify it under
+## the terms of the GNU General Public License as published by the Free
+## Software Foundation; either version 2 or (at your option) any later version.
+##
+## eCos is distributed in the hope that it will be useful, but WITHOUT ANY
+## WARRANTY; without even the implied warranty of MERCHANTABILITY or
+## FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public License
+## for more details.
+##
+## You should have received a copy of the GNU General Public License along
+## with eCos; if not, write to the Free Software Foundation, Inc.,
+## 59 Temple Place, Suite 330, Boston, MA 02111-1307 USA.
+##
+## As a special exception, if other files instantiate templates or use macros
+## or inline functions from this file, or you compile this file and link it
+## with other works to produce a work based on this file, this file does not
+## by itself cause the resulting work to be covered by the GNU General Public
+## License. However the source code for this file must still be made available
+## in accordance with section (3) of the GNU General Public License.
+##
+## This exception does not invalidate any other reasons why a work based on
+## this file might be covered by the GNU General Public License.
+##
+## Alternative licenses for eCos may be arranged by contacting Red Hat, Inc.
+## at http://sources.redhat.com/ecos/ecos-license/
+## -------------------------------------------
+#####ECOSGPLCOPYRIGHTEND####
+# ====================================================================
+######DESCRIPTIONBEGIN####
+#
+# Author(s):      gthomas, hmt
+# Original data:  gthomas
+# Contributors:   gthomas
+# Date:           2001-02-14
+#
+#####DESCRIPTIONEND####
+#
+#====================================================================
+
+cdl_package CYGPKG_DEVS_FLASH_PXA270_SG2P {
+    display       "Intel XSCALE (PXA270_SG2P) FLASH memory support"
+    description   "FLASH memory device support for Intel XSCALE PXA270"
+
+    parent        CYGPKG_IO_FLASH
+    active_if	  CYGPKG_IO_FLASH
+    requires	  CYGPKG_HAL_ARM_XSCALE_PXA270_SG2P
+
+    requires      CYGPKG_DEVS_FLASH_STRATA
+
+    implements    CYGHWR_IO_FLASH_BLOCK_LOCKING
+
+    include_dir   cyg/io
+
+    # Arguably this should do in the generic package
+    # but then there is a logic loop so you can never enable it.
+    cdl_interface CYGINT_DEVS_FLASH_STRATA_REQUIRED {
+        display   "Generic StrataFLASH driver required"
+    }
+
+    implements    CYGINT_DEVS_FLASH_STRATA_REQUIRED
+
+    define_proc {
+        puts $::cdl_system_header "/***** strataflash driver proc output start *****/"
+        puts $::cdl_system_header "#define CYGDAT_DEVS_FLASH_STRATA_INL <cyg/io/pxa270_sg2p_strataflash.inl>"
+        puts $::cdl_system_header "#define CYGDAT_DEVS_FLASH_STRATA_CFG <pkgconf/devs_flash_pxa270_sg2p.h>"
+        puts $::cdl_system_header "/*****  strataflash driver proc output end  *****/"
+    }
+}
diff -uNr ecos.org/packages/devs/flash/arm/pxa270_sg2p/current/include/pxa270_sg2p_strataflash.inl ecos/packages/devs/flash/arm/pxa270_sg2p/current/include/pxa270_sg2p_strataflash.inl
--- ecos.org/packages/devs/flash/arm/pxa270_sg2p/current/include/pxa270_sg2p_strataflash.inl	1970-01-01 09:00:00.000000000 +0900
+++ ecos/packages/devs/flash/arm/pxa270_sg2p/current/include/pxa270_sg2p_strataflash.inl	2006-09-28 15:37:51.000000000 +0900
@@ -0,0 +1,77 @@
+#ifndef CYGONCE_DEVS_FLASH_PXA270_SG2P_STRATAFLASH_INL
+#define CYGONCE_DEVS_FLASH_PXA270_SG2P_STRATAFLASH_INL
+//==========================================================================
+//
+//      pxa270_sg2p_strataflash.inl
+//
+//      Flash programming - device constants, etc.
+//
+//==========================================================================
+// Copyright (C) 2005-2006 WILLCOM, Inc. All rights Reserved.
+//==========================================================================
+//####ECOSGPLCOPYRIGHTBEGIN####
+// -------------------------------------------
+// This file is part of eCos, the Embedded Configurable Operating System.
+// Copyright (C) 1998, 1999, 2000, 2001, 2002 Red Hat, Inc.
+//
+// eCos is free software; you can redistribute it and/or modify it under
+// the terms of the GNU General Public License as published by the Free
+// Software Foundation; either version 2 or (at your option) any later version.
+//
+// eCos is distributed in the hope that it will be useful, but WITHOUT ANY
+// WARRANTY; without even the implied warranty of MERCHANTABILITY or
+// FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public License
+// for more details.
+//
+// You should have received a copy of the GNU General Public License along
+// with eCos; if not, write to the Free Software Foundation, Inc.,
+// 59 Temple Place, Suite 330, Boston, MA 02111-1307 USA.
+//
+// As a special exception, if other files instantiate templates or use macros
+// or inline functions from this file, or you compile this file and link it
+// with other works to produce a work based on this file, this file does not
+// by itself cause the resulting work to be covered by the GNU General Public
+// License. However the source code for this file must still be made available
+// in accordance with section (3) of the GNU General Public License.
+//
+// This exception does not invalidate any other reasons why a work based on
+// this file might be covered by the GNU General Public License.
+//
+// Alternative licenses for eCos may be arranged by contacting Red Hat, Inc.
+// at http://sources.redhat.com/ecos/ecos-license/
+// -------------------------------------------
+//####ECOSGPLCOPYRIGHTEND####
+//==========================================================================
+//#####DESCRIPTIONBEGIN####
+//
+// Author(s):    gthomas, hmt
+// Contributors: gthomas
+// Date:         2001-02-24
+// Purpose:      
+// Description:  
+//              
+//####DESCRIPTIONEND####
+//
+//==========================================================================
+
+
+// The PXA270_SG2P system has two 16-bit devices.
+// Doc says: a StrataFlash 28F320J3A. The 320 means 32Mbit, so 4Mbyte.
+// Reality:  a StrataFlash 28F640J3A. The 640 means 64Mbit, so 8Mbyte.
+
+#define CYGNUM_FLASH_NDEVICES 	(2)
+#define CYGNUM_FLASH_DEVICES 	(2)
+#define CYGNUM_FLASH_BASE 	(0x00000000u)
+#define	__CYGNUM_FLASH_SIZE	(0x02000000u * CYGNUM_FLASH_DEVICES)
+#define CYGNUM_FLASH_SIZE 	(__CYGNUM_FLASH_SIZE * CYGNUM_FLASH_NDEVICES)
+#define CYGNUM_FLASH_BASE_MASK  (~(__CYGNUM_FLASH_SIZE - 1)) // 64Mb devices
+#define __CYGNUM_FLASH_MASK	(~(CYGNUM_FLASH_SIZE - 1)) // 128Mb devices
+#define CYGNUM_FLASH_WIDTH 	(16)
+#define CYGNUM_FLASH_BLANK      (1)
+ 
+#define CYGOPT_FLASH_IS_SYNCHRONOUS     1 
+#define FLASH_P2V( _a_ ) ((volatile flash_t *)((unsigned int)(_a_) | 0x10000000))
+
+#endif  // CYGONCE_DEVS_FLASH_PXA270_SG2P_STRATAFLASH_INL
+// ------------------------------------------------------------------------
+// EOF pxa250_sg2p_strataflash.inl
diff -uNr ecos.org/packages/devs/flash/arm/pxa270_sgvp/current/cdl/flash_pxa270_sgvp.cdl ecos/packages/devs/flash/arm/pxa270_sgvp/current/cdl/flash_pxa270_sgvp.cdl
--- ecos.org/packages/devs/flash/arm/pxa270_sgvp/current/cdl/flash_pxa270_sgvp.cdl	1970-01-01 09:00:00.000000000 +0900
+++ ecos/packages/devs/flash/arm/pxa270_sgvp/current/cdl/flash_pxa270_sgvp.cdl	2006-09-28 15:37:52.000000000 +0900
@@ -0,0 +1,82 @@
+#====================================================================
+#
+#      flash_pxa270_sgwp.cdl
+#
+#      FLASH memory - Hardware support on Intel PXA270 Sandgate-VP 
+#
+#====================================================================
+# Copyright (c) 2006 Sophia Systems Co.,Ltd.
+#====================================================================
+#####ECOSGPLCOPYRIGHTBEGIN####
+## -------------------------------------------
+## This file is part of eCos, the Embedded Configurable Operating System.
+## Copyright (C) 1998, 1999, 2000, 2001, 2002 Red Hat, Inc.
+##
+## eCos is free software; you can redistribute it and/or modify it under
+## the terms of the GNU General Public License as published by the Free
+## Software Foundation; either version 2 or (at your option) any later version.
+##
+## eCos is distributed in the hope that it will be useful, but WITHOUT ANY
+## WARRANTY; without even the implied warranty of MERCHANTABILITY or
+## FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public License
+## for more details.
+##
+## You should have received a copy of the GNU General Public License along
+## with eCos; if not, write to the Free Software Foundation, Inc.,
+## 59 Temple Place, Suite 330, Boston, MA 02111-1307 USA.
+##
+## As a special exception, if other files instantiate templates or use macros
+## or inline functions from this file, or you compile this file and link it
+## with other works to produce a work based on this file, this file does not
+## by itself cause the resulting work to be covered by the GNU General Public
+## License. However the source code for this file must still be made available
+## in accordance with section (3) of the GNU General Public License.
+##
+## This exception does not invalidate any other reasons why a work based on
+## this file might be covered by the GNU General Public License.
+##
+## Alternative licenses for eCos may be arranged by contacting Red Hat, Inc.
+## at http://sources.redhat.com/ecos/ecos-license/
+## -------------------------------------------
+#####ECOSGPLCOPYRIGHTEND####
+# ====================================================================
+######DESCRIPTIONBEGIN####
+#
+# Author(s):      gthomas, hmt
+# Original data:  gthomas
+# Contributors:   gthomas
+# Date:           2001-02-14
+#
+#####DESCRIPTIONEND####
+#
+#====================================================================
+
+cdl_package CYGPKG_DEVS_FLASH_PXA270_SGVP {
+    display       "Intel XSCALE (PXA270_SGVP) FLASH memory support"
+    description   "FLASH memory device support for Intel XSCALE PXA270"
+
+    parent        CYGPKG_IO_FLASH
+    active_if	  CYGPKG_IO_FLASH
+    requires	  CYGPKG_HAL_ARM_XSCALE_PXA270_SGVP
+
+    requires      CYGPKG_DEVS_FLASH_STRATA
+
+    implements    CYGHWR_IO_FLASH_BLOCK_LOCKING
+
+    include_dir   cyg/io
+
+    # Arguably this should do in the generic package
+    # but then there is a logic loop so you can never enable it.
+    cdl_interface CYGINT_DEVS_FLASH_STRATA_REQUIRED {
+        display   "Generic StrataFLASH driver required"
+    }
+
+    implements    CYGINT_DEVS_FLASH_STRATA_REQUIRED
+
+    define_proc {
+        puts $::cdl_system_header "/***** strataflash driver proc output start *****/"
+        puts $::cdl_system_header "#define CYGDAT_DEVS_FLASH_STRATA_INL <cyg/io/pxa270_sgvp_strataflash.inl>"
+        puts $::cdl_system_header "#define CYGDAT_DEVS_FLASH_STRATA_CFG <pkgconf/devs_flash_pxa270_sgvp.h>"
+        puts $::cdl_system_header "/*****  strataflash driver proc output end  *****/"
+    }
+}
