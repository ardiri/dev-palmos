@@ -57,14 +59,18 @@
 // Doc says: a StrataFlash 28F320J3A. The 320 means 32Mbit, so 4Mbyte.
 // Reality:  a StrataFlash 28F640J3A. The 640 means 64Mbit, so 8Mbyte.
 
+#define CYGNUM_FLASH_NDEVICES 	(1)
 #define CYGNUM_FLASH_DEVICES 	(2)
 #define CYGNUM_FLASH_BASE 	(0x00000000u)
-#define CYGNUM_FLASH_BASE_MASK  (0xFC000000u) // 64Mb devices
+#define	__CYGNUM_FLASH_SIZE	(0x02000000u * CYGNUM_FLASH_DEVICES)
+#define CYGNUM_FLASH_SIZE 	(__CYGNUM_FLASH_SIZE * CYGNUM_FLASH_NDEVICES)
+#define CYGNUM_FLASH_BASE_MASK  (~(__CYGNUM_FLASH_SIZE - 1)) // 64Mb devices
+#define __CYGNUM_FLASH_MASK	(~(CYGNUM_FLASH_SIZE - 1)) // 64Mb devices
 #define CYGNUM_FLASH_WIDTH 	(16)
-#define CYGNUM_FLASH_BLANK      (1)
- 
-#define CYGOPT_FLASH_IS_SYNCHRONOUS     1 
-#define FLASH_P2V( _a_ ) ((volatile flash_t *)((unsigned int)(_a_) | 0x04000000))
+#define CYGNUM_FLASH_BLANK      (1)
+ 
+#define CYGOPT_FLASH_IS_SYNCHRONOUS     1 
+#define FLASH_P2V( _a_ ) ((volatile flash_t *)((unsigned int)(_a_) | 0x10000000))
 
 #endif  // CYGONCE_DEVS_FLASH_PXA270_SG2_STRATAFLASH_INL
 // ------------------------------------------------------------------------
