+
+//;----------------------------------------------------------------------------
+//; The sdram bank 1 bit is returned in position 0 of \reg
+//; 0=not present, 1=present
+//;----------------------------------------------------------------------------
+.macro getHWConfig_SDRAM1 reg
+	ldr \reg, =PXA270_PSPR
+	ldr \reg, [\reg]
+	and \reg, \reg, #HWConfig_SDRAM1
+	//; extract sdram bank 1 bit
+	mov \reg, \reg, lsr #23
+	//; shift into position 0
+.endm
+
+//;----------------------------------------------------------------------------
+//; The bank 2/3 bus width bit is returned in position 0 of \reg
+//;----------------------------------------------------------------------------
+.macro getHWConfig_BusWIDTH23 reg
+	ldr \reg, =PXA270_PSPR
+	ldr \reg, [\reg]
+	and \reg, \reg, #HWConfig_BusWIDTH23
+	//; extract bank 2/3 bus width bit
+	mov \reg, \reg, lsr #24
+.endm
+
+//;----------------------------------------------------------------------------
+//; The bank 2/3 sdram clock speed bit is returned in position 0 of \reg
+//;----------------------------------------------------------------------------
+.macro getHWConfig_SPEED23 reg
+	ldr \reg, =PXA270_PSPR
+	ldr \reg, [\reg]
+	and \reg, \reg, #HWConfig_SPEED23
+	//; extract bank 2/3 sdram speed bit
+	mov \reg, \reg, lsr #25
+.endm
+
+//;----------------------------------------------------------------------------
+//; The sdram bank 2 bit is returned in position 0 of \reg
+//; 0=not present, 1=present
+//;----------------------------------------------------------------------------
+.macro getHWConfig_SDRAM2 reg
+	ldr \reg, =PXA270_PSPR
+	ldr \reg, [\reg]
+	and \reg, \reg, #HWConfig_SDRAM2
+	//; extract sdram bank 2 bit
+	mov \reg, \reg, lsr #26
+.endm
+
+//;----------------------------------------------------------------------------
+//; The sdram bank 3 bit is returned in position 0 of \reg
+//; 0=not present, 1=present
+//;----------------------------------------------------------------------------
+.macro getHWConfig_SDRAM3 reg
+	ldr \reg, =PXA270_PSPR
+	ldr \reg, [\reg]
+	and \reg, \reg, #HWConfig_SDRAM3
+	//; extract sdram bank 3 bit
+	mov \reg, \reg, lsr #27
+.endm
+
+//;--------------------------------------------------------------------------//;-----------------------------------------------------------------------
+//; This macro initializes the memory controller from a hardware or sleep
+//; reset.
+//; \reg4 = 0 for non Sandgate-VP boards (Lubbock)
+//; \reg4 = 1 for Sandgate-VP (to test for SA1111 daughter card)
+//;-----------------------------------------------------------------------
+.macro initMemCntrlr reg0, reg1, reg2, reg3, reg4
+	//; pause for 200 uSecs
+	// pauseMicroSecs #200, \reg0, \reg1, \reg2
+	ldr \reg2, =PXA270_OSCR
+	//; reset the OS Timer Count to zero
+	mov \reg1, #0
+	str \reg1, [\reg2]
+	ldr \reg3, =0x300
+	//; really 0x2E1 is about 200usec, so 0x300 should be plenty
+112:
+	ldr \reg1, [\reg2]
+	cmp \reg3, \reg1
+	bgt 112b
+	//; determine the value for MSC0
+	// getMSC0 \reg1, \reg0, \reg2
+	ldr \reg1, =MSC0_VAL
+	//; get memory controller base address
+	ldr \reg0, =PXA270_MSC0
+	//; write msc0, read back to ensure data latches
+	str \reg1, [\reg0]
+	ldr \reg1, [\reg0]
+	//; If \reg4 = 1, then a Sandgate-VP development board is assumed and the
+	//; HW Configuration word is examined to see if the Daughter Card is
+	//; present.
+	ldr \reg2, =MSC1_VAL
+	//; All others
+	ldr \reg0, =PXA270_MSC1
+	str \reg2, [\reg0]
+	//; Write out
+	ldr \reg2, [\reg0]
+	//; Read back to ensure data latches
+	ldr \reg2, =MSC2_VAL
+	//; All others
+	ldr \reg0, =PXA270_MSC2
+	str \reg2, [\reg0]
+	//; Write out
+	ldr \reg2, [\reg0]
+	//; Read back to ensure data latches
+	//; write mecr
+	ldr \reg2, =MECR_VAL
+	ldr \reg0, =PXA270_MECR
+	str \reg2, [\reg0]
+	//; write mcmem0
+	ldr \reg1, =MCMEM0_VAL
+	ldr \reg0, =PXA270_MCMEM0
+	str \reg1, [\reg0]
+	//; write mcmem1
+	ldr \reg2, =MCMEM1_VAL
+	ldr \reg0, =PXA270_MCMEM1
+	str \reg2, [\reg0]
+	//; write mcatt0
+	ldr \reg1, =MCATT0_VAL
+	ldr \reg0, =PXA270_MCATT0
+	str \reg1, [\reg0]
+	//; write mcatt1
+	ldrne \reg2, =MCATT1_VAL
+	ldr \reg0, =PXA270_MCATT1
+	str \reg2, [\reg0]
+	//; write mcio0
+	ldr \reg1, =MCIO0_VAL
+	ldr \reg0, =PXA270_MCIO0
+	str \reg1, [\reg0]
+	//; write mcio1
+	ldr \reg1, =MCIO1_VAL
+	ldr \reg0, =PXA270_MCIO1
+	str \reg2, [\reg0]
+	//; get the mdrefr settings
+	ldr \reg2, =MDREFR_VAL
+	//; extract DRI field (we need a valid DRI field)
+	ldr \reg1, =MDREFR_DRI
+	//; valid DRI field in \reg2
+	and \reg2, \reg2, \reg1
+	//; get the reset state of MDREFR
+	ldr \reg0, =PXA270_MDREFR
+	ldr \reg3, [\reg0]
+	//; clear the DRI field
+	bic \reg3, \reg3, \reg1
+	//; insert the valid DRI field
+	orr \reg3, \reg3, \reg2
+	//; write back mdrefr
+	str \reg3, [\reg0]
+	//; Note: preserve the mdrefr value in \reg3
+	//; Assumes previous mdrefr value in \reg3, if not then read current mdrefr
+	//; clear the free-running clock bits
+	bic \reg3, \reg3, #(MDREFR_K0FREE | MDREFR_K1FREE | MDREFR_K2FREE)
+	//; set K1RUN, K0RUN if bank 0 installed
+	orr \reg3, \reg3, #(MDREFR_K1RUN | MDREFR_K0RUN)
+	//; if programming banks 0-1 for 1/2 speed mem clock, set K1DB2,
+	//; else clear it
+	bic \reg3, \reg3, #MDREFR_K1DB2
+	orr \reg3, \reg3, #MDREFR_K0DB2
+	//; write back mdrefr
+	str \reg3, [\reg0]
+	ldr \reg3, [\reg0]
+	//; deassert SLFRSH
+	bic \reg3, \reg3, #MDREFR_SLFRSH
+	//; write back mdrefr
+	str \reg3, [\reg0]
+	//; assert E1PIN
+	orr \reg3, \reg3, #MDREFR_E1PIN
+	//; write back mdrefr
+	str \reg3, [\reg0]
+	nop
+	nop
+	//;-------------------------------------------------------
+	//; fetch platform value of mdcnfg
+	ldr \reg1, =MDCNFG_VAL
+	//; all others
+	//; disable all sdram banks
+	bic \reg1, \reg1, #(MDCNFG_DE0 | MDCNFG_DE1)
+	bic \reg1, \reg1, #(MDCNFG_DE2 | MDCNFG_DE3)
+	//; write initial value of mdcnfg, w/o enabling sdram banks
+	ldr \reg0, =PXA270_MDCNFG
+	str \reg1, [\reg0]
+	//; pause for 200 uSecs
+	// pauseMicroSecs #200, \reg0, \reg1, \reg2
+	ldr \reg2, =PXA270_OSCR
+	//; reset the OS Timer Count to zero
+	mov \reg1, #0
+	str \reg1, [\reg2]
+	ldr \reg3, =0x300
+	//; really 0x2E1 is about 200usec, so 0x300 should be plenty
+113:
+	ldr \reg1, [\reg2]
+	cmp \reg3, \reg1
+	bgt 113b
+	//turn everything off
+	mov \reg0, #0x78
+	mcr p15, 0, \reg0, c1, c0, 0
+	//; Access memory not yet enabled for CBR refresh cycles (8)
+	//; - CBR is generated for all banks
+	ldr \reg1, =SDRAM0_PHYSICAL_BASE
+	str \reg1, [\reg1]
+	str \reg1, [\reg1]
+	str \reg1, [\reg1]
+	str \reg1, [\reg1]
+	str \reg1, [\reg1]
+	str \reg1, [\reg1]
+	str \reg1, [\reg1]
+	str \reg1, [\reg1]
+	//; fetch current mdcnfg value
+	ldr \reg0, =PXA270_MDCNFG
+	ldr \reg2, [\reg0]
+	//; enable sdram bank 0 if installed
+	orr \reg2, \reg2, #MDCNFG_DE0
+	//; write back mdcnfg, enabling the sdram bank(s)
+	str \reg2, [\reg0]
+	//; write mdmrs
+	ldr \reg1, =MDMRS_VAL
+	ldr \reg0, =PXA270_MDMRS
+	str \reg1, [\reg0]
+	b 15f
+	.ltorg
+15:
+.endm
+
+//;------------------------------------------------------------------------
+//; This macro initiates (enters) the Frequency Change Sequence (FCS).
+//; Read and Be Aware of the necessary preconditions to entering FCS!
+//;------------------------------------------------------------------------
+.macro enterFCS reg
+	mov \reg, #CCLKCFG_FCS
+	mcr p14, 0, \reg, c6, c0, 0
+.endm
+
+//;------------------------------------------------------------------------
+//;This macro causes the processor to enter Turbo mode
+//;------------------------------------------------------------------------
+.macro enterTurbo reg
+	mov \reg, #CCLKCFG_TURBO
+	mcr p14, 0, \reg, c6, c0, 0
+.endm
+
+//;------------------------------------------------------------------------
+//; This macro restarts the memory controller after a frequency change
+//; sequence (fcs)
+//;------------------------------------------------------------------------
+.macro restartMemCntrlr reg0, reg1, reg2
+	//; get memory controller base address
+	ldr \reg0, =PXA270_MDREFR
+	//; get the current state of MDREFR
+	ldr \reg1, =MDREFR_VAL
+	//; clear E0PIN, E1PIN
+	bic \reg2, \reg1, #(MDREFR_E0PIN | MDREFR_E1PIN)
+	//; write MDREFR with E0PIN, E1PIN cleared
+	str \reg2, [\reg0]
+	//; then write MDREFR with E0PIN, E1PIN set
+	str \reg1, [\reg0]
+	ldr \reg1, [\reg0]
+	//; Access memory not yet enabled for CBR refresh cycles (8)
+	//; - CBR is generated for all banks
+	ldr \reg1, =SDRAM0_PHYSICAL_BASE
+	str \reg1, [\reg1]
+	str \reg1, [\reg1]
+	str \reg1, [\reg1]
+	str \reg1, [\reg1]
+	str \reg1, [\reg1]
+	str \reg1, [\reg1]
+	str \reg1, [\reg1]
+	str \reg1, [\reg1]
+	//; fetch current mdcnfg value
+	ldr \reg0, =PXA270_MDCNFG
+	ldr \reg2, [\reg0]
+	//; enable sdram bank 0 if installed
+	orr \reg2, \reg2, #MDCNFG_DE0
+	//; write back mdcnfg, enabling the sdram bank(s)
+	str \reg2, [\reg0]
+	//; write mdmrs
+	ldr \reg1, =MDMRS_VAL
+	ldr \reg0, =PXA270_MDMRS
+	str \reg1, [\reg0]
+/* IF :DEF: APD_ENABLE
+	// ; A0/A1/B0 errata: don't enable auto power-down
+	getHWConfig_STEPPING \reg1
+	cmp \reg1, #STEPPING_B0
+	ble 33f
+	// ; get current value of mdrefr
+	ldr \reg0, =PXA270_MDREFR
+	ldr \reg2, [\reg0]
+	//; enable auto-power down
+	orr \reg2, \reg2, #MDREFR_APD
+	// ; write back mdrefr
+	str \reg2, [\reg0]
+33:
+// ENDIF */
+.endm
+
+//;------------------------------------------------------------------------
+//; This macro returns the pin-level setting of gpio 1
+//;------------------------------------------------------------------------
+.macro getGpio1 reg0, reg1
+	//; get the gpio register block base address
+	ldr \reg1, =PXA270_GPLRx
+	//; read current pin levels - GPLRx
+	ldr \reg0, [\reg1]
+	//; extract gpio 1
+	and \reg0, \reg0, #GPXXx_GPIO1
+	//; shift bit into position 0
+	mov \reg0, \reg0, LSR #1
+.endm
+
+//;------------------------------------------------------------------------
+//;This macro causes the processor to exit Turbo mode
+//;------------------------------------------------------------------------
+.macro exitTurbo reg
+	mrc p14, 0, \reg, c6, c0, 0
+	tst \reg, #CCLKCFG_TURBO
+	beq 66
+	bic \reg, \reg, #CCLKCFG_TURBO
+	mcr p14, 0, \reg, c6, c0, 0
+66:
+.endm
+
+//;------------------------------------------------------------------------
+//; This macro boots the alternate image if gpio 1 is not in default
+//; position.
+//;----------------------------------------------------------------------------
+.macro bootAlternate reg0, reg1
+	//; get the pin-level setting of gpio 1 (S3 on Sandgate-VP)
+	getGpio1 \reg0, \reg1
+	//; see if the bit is 0 or 1
+	cmp \reg0, #1
+	//; if bit=0, branch to end
+	bne 55f
+	//; Exit Turbo mode before jumping to alternate image.
+	exitTurbo \reg1
+	//; if bit=1, xfer control to alternate image
+	ldr \reg1, =ALTERNATE_IMAGE_ADDR
+	mov pc, \reg1
+55:
+.endm
+
+//;----------------------------------------------------------------------------
+//; This macro returns the contents of the Translation Table base register in \reg0.
+//;----------------------------------------------------------------------------
+.macro getTTBase reg0
+	mrc p15, 0, \reg0, c2, c0, 0
+	//; clear the lo-order 14 bits
+	mov \reg0, \reg0, LSR #14
+	mov \reg0, \reg0, LSL #14
+.endm
+
+//;----------------------------------------------------------------------------
+//; This macro writes the contents of \reg0 into the Translation Table base
+//; register.
+//;----------------------------------------------------------------------------
+.macro setTTBase reg
+	mcr p15, 0, \reg, c2, c0, 0
+.endm
+
+//;----------------------------------------------------------------------------
+//; This macro loads the TTBase register, and clears the page table region.
+//;----------------------------------------------------------------------------
+.macro initPageTable reg0, reg1, reg2
+	//; write the page table physical base address to the TTBase register
+	ldr \reg0, =p_TTableBASE
+	setTTBase \reg0
+	//; zero-out the page table memory region
+	mov \reg1, #s_TTableBASE
+	//; get table size
+	mov \reg2, #0
+7:
+	subs \reg1, \reg1, #4
+	str \reg2, [\reg0, \reg1]
+	bne 7b
+.endm
+
+//;------------------------------------------------------------------------
+//; This macro will map a region using 1MB sections
+//; Note: must run initPageTable before this macro is valid
+//;------------------------------------------------------------------------
+.macro mapSECTIONS reg0, reg1, reg2, reg3, size, virtualaddr, physicaladdr, access
+//; \size = size of region to be mapped
+//; \virtual = starting virtual address of region
+//; \physical = starting physical address of region
+//; \access = access bits for this region
+//; \tabl = physical (base) address of page tables
+//; \Level1tab = offset from page table base to level 1 entries
+	//; get the page table base address
+	getTTBase \reg3
+	ldr \reg2, =\size
+	//; get size of bank
+	cmp \reg2, #0
+	beq 32f
+	//; if size=0, skip
+	ldr \reg1, =(Level1tab + (\virtualaddr >> (20-2)))
+	//; generate table index
+	add \reg1, \reg1, \reg3
+	//; offset into page table
+	mov \reg2, \reg2, LSR #20
+	//; no. of 1MB segments
+	ldr \reg0, =(\physicaladdr + \access)
+	//; create table entry
+13:
+	str \reg0, [\reg1], #4
+	//; store table entry and increment
+	add \reg0, \reg0, #SZ_1M
+	//; add section number field
+	subs \reg2, \reg2, #1
+	//; decrement loop count
+	bne 13b
+32:
+.endm
+
+//;----------------------------------------------------------------------------
+//; This macro sets the DACR, sets the PID, and sets the Aux control
+//; register.
+//;----------------------------------------------------------------------------
+.macro initMMU reg0, reg1, reg2
+	//; set DACR
+	ldr \reg0, =ANGEL_DACR
+	mcr p15, 0, \reg0, c3, c0, 0
+	//; set PID
+	ldr \reg1, =ANGEL_PID
+	mov \reg1, \reg1, LSR #25
+	mov \reg1, \reg1, LSL #25
+	mcr p15, 0, \reg1, c13, c0, 0
+	//; get current aux control settings
+	mrc p15, 0, \reg0, c1, c0, 1
+	and \reg0, \reg0, #0x33
+	//; orr in the mini-data cache attributes
+	orr \reg0, \reg0, #CONTROL_MINIDATA_01
+	//; write back the new settings
+	mcr p15, 0, \reg0, c1, c0, 1
+	//; invalidate and enable the BTB
+	mcr p15, 0, \reg0, c7, c5, 6
+	mrc p15, 0, \reg0, c1, c0, 0
+	//; upper 18-bits must be written as zero, clear them now
+	mov \reg0, \reg0, lsl #18
+	mov \reg0, \reg0, lsr #18
+	//; set the btb bit
+	orr \reg0, \reg0, #CONTROL_BTB
+	//; write back the new value
+	setARMControl \reg0
+	CPWAIT \reg0
+	//; zero out the memory region used for cleaning the dcache
+	//; get the CleanCache physical base address
+	ldr \reg0, =p_cbCleanCache
+	//; zero-out the region
+	mov \reg1, #s_cbCleanCache
+	//; get region size
+	mov \reg2, #0
+71:
+	subs \reg1, \reg1, #4
+	str \reg2, [\reg0, \reg1]
+	bne 71b
+.endm
+
+/*/;----------------------------------------------------------------------------
+//;This macro makes the transition into virtual address translation mode.
+//; Note: it is assumed that execution is from the boot ROM, and that the
+//; MMU is disabled.
+//;----------------------------------------------------------------------------*/
+.macro goVirtual reg0, reg1, reg2, reg3, tabl//, Level1tab
+/*/; -------------------------------------------------
+//; (1) temporarily overwrite page table entry that maps where we are now*/
+	/*/; get address to Level1 table*/
+	mov \reg0, #Level1tab
+	add \reg0, \reg0, \tabl
+	mov \reg3, pc, LSR #(18)
+	/*/; current execution location*/
+	add \reg3, \reg3, \reg0
+	/*/; ram page table entry*/
+	ldr \reg2, [\reg3]
+	/*/; must preserve \reg2, \reg3 as we need them later...*/
+	ldr \reg1, =(v_xbBOOTROM >> (18))
+	add \reg1, \reg1, \reg0
+	/*/; rom page table entry*/
+	ldr \reg0, [\reg1]
+	/*/; overwrite ram entry*/
+	str \reg0, [\reg3]
+/*/; end-of-part (1)
+//; -------------------------------------------------
+//; (2) setup to enable the MMU*/
+	adr \reg0, 36f
+	/*/; generate a pc-relative address*/
+	add \reg0, \reg0, #v_xbBOOTROM
+	/*/; add offset to virtual rom address
+	//; invalidate both TLBs*/
+	mcr p15, 0, \reg1, c8, c7, 0
+	/*/; enable mmu
+	//; read current settings in control reg*/
+	mrc p15, 0, \reg1, c1, c0, 0
+	/*/; upper 18-bits must be written as zero, clear them now */
+	mov \reg1, \reg1, LSL #18
+	mov \reg1, \reg1, LSR #18
+	/*/; set the mmu bit*/
+	orr \reg1, \reg1, #CONTROL_MMU
+	/*/; write back the new value*/
+	setARMControl \reg1
+	/*/; invalidate both caches, btb*/
+	mcr p15, 0, \reg1, c7, c7, 0
+	mov pc, \reg0
+	nop
+	nop
+	nop
+	nop
+	nop
+36:
+	add lr, lr, #v_xbBOOTROM
+/*/; end-of-part (2)
+//; -------------------------------------------------
+//; (3) restore the overwritten page table entry, flush all*/
+	str \reg2, [\reg3]
+	/*/; invalidate both TLBs*/
+	mcr p15, 0, \reg1, c8, c7, 0
+	/*/; invalidate both caches, btb*/
+	mcr p15, 0, \reg1, c7, c7, 0
+	/*/; insure that the pipe is empty*/
+	nop
+	nop
+	nop
+	nop
+	nop
+	nop
+.endm
+
+/*/;----------------------------------------------------------------------------
+//;This macro enable the clocks
+//;----------------------------------------------------------------------------*/
+.macro ENABLECLKS reg0, reg1
+	/* ; Re-Enable On-Chip Peripheral Clocking
+	// ; *Note: Currently enabling: ALL 17 clocks.*/
+	ldr \reg0, =PXA270_CKEN
+	ldr \reg1, =CKEN_DEFINED
+	str \reg1, [\reg0]
+.endm
+
+/*/;----------------------------------------------------------------------------
+//;This macro enable the PowerI2C(LED)
+//;----------------------------------------------------------------------------*/
+.macro PowerI2C_1st reg0, reg1
+	ldr	\reg0, =PXA270_PMCR
+	// PCFR |= PCFR.FVC
+	ldr	\reg1, [\reg0, #0x1c]
+	orr	\reg1, \reg1, #0x400
+	str	\reg1, [\reg0, #0x1c]
+.endm
+
+.macro PowerI2C_2nd reg0, reg1
+	// PVCR = slave address
+	mov	\reg1, #(0x76 >> 1)
+	str	\reg1, [\reg0, #0x40]	// PVCR
+	ldr	\reg1, [\reg0, #0x40]	// PVCR write back
+	// set PCMD0-1 for SOFTRESET
+	mov	\reg1, #(0x00 | 14)
+	str	\reg1, [\reg0, #0x80 + 0x00]	// PCMD0
+	mov	\reg1, #0x80
+	orr	\reg1, \reg1, #0x400		// PCMD.LC
+	str	\reg1, [\reg0, #0x80 + 0x04]	// PCMD1
+.endm
+
+.macro PowerI2C_3rd reg0, reg1
+	// PVCR = slave address
+	mov	\reg1, #(0x76 >> 1)
+	str	\reg1, [\reg0, #0x40]	// PVCR
+	ldr	\reg1, [\reg0, #0x40]	// PVCR write back
+	// set PCMD0-10 for hardware controll
+	mov	\reg1, #(0x00 | 6)
+	str	\reg1, [\reg0, #0x80 + 0x00]	// PCMD0
+	mov	\reg1, #0xff
+	str	\reg1, [\reg0, #0x80 + 0x1c]	// PCMD7
+	mov	\reg1, #0x00
+	str	\reg1, [\reg0, #0x80 + 0x0c]	// PCMD3
+	str	\reg1, [\reg0, #0x80 + 0x10]	// PCMD4
+	mov	\reg1, #0x85
+	str	\reg1, [\reg0, #0x80 + 0x04]	// PCMD1
+	mov	\reg1, #0x05
+	str	\reg1, [\reg0, #0x80 + 0x08]	// PCMD2
+	mov	\reg1, #0x80
+	str	\reg1, [\reg0, #0x80 + 0x14]	// PCMD5
+	str	\reg1, [\reg0, #0x80 + 0x18]	// PCMD6
+	mov	\reg1, #0x7f
+	str	\reg1, [\reg0, #0x80 + 0x20]	// PCMD8
+	str	\reg1, [\reg0, #0x80 + 0x24]	// PCMD9
+	mov	\reg1, #0x1e
+	orr	\reg1, \reg1, #0x400		// PCMD.LC
+	str	\reg1, [\reg0, #0x80 + 0x28]	// PCMD10
+.endm
+
+.macro PowerI2C_4th reg0, reg1
+	// PCFR &= ~PCFR.FVC
+	ldr \reg1, [\reg0, #0x1c]
+	and \reg1, \reg1, #~0x400
+	str \reg1, [\reg0, #0x1c]
+.endm
+
+/*/;------------------------------------------------------------------------
+// start of platform setup*/
+.macro _platform_setup1
+	.rept 0x20/4
+		nop
+	.endr
+	ldr r0,=(CPSR_IRQ_DISABLE|CPSR_FIQ_DISABLE|CPSR_SUPERVISOR_MODE)
+	msr cpsr, r0
+/********************************************************************
+// Grab the CPU ID off of CP15, stuff it into Driver Globals
+// ********************************************************************/
+	mrc p15, 0, r9, c0, c0, 0
+	ldr r1, =DRIVER_GLOBALS_CPU_ID_LOCATION
+	str r9,[r1]
+	and r9, r9, #0xF
+	ldr r0, =0x20C1
+	mcr p15, 0, r0, c15, c1, 0
+	CPWAIT r0
+	mov r0, #0x78
+	mcr p15, 0, r0, c1, c0, 0
+	CPWAIT r0
+	ldr r0, =0x00000000
+	mcr p15, 0, r0, c8, c7, 0
+	mcr p15, 0, r0, c7, c7, 0
+	mcr p15, 0, r0, c7, c10, 4
+	nop
+	nop
+	nop
+	nop
+	mvn r0, #0
+	mcr p15, 0, r0, c3, c0, 0
+	/* INITRESET r0, r1, r2, r3 */
+	INITGPIO r3, r6, r7
+	INITINTCNTRLR r2, r3
+	b 22f
+	.ltorg
+22:
+	ENABLECLKS r0, r1
+	initPower r0, r1, r2
+	PowerI2C_1st r0, r1
+	PowerI2C_2nd r0, r1	/* LED SOFTRESET */
+	initClocks_1st r1, r2
+	PowerI2C_3rd r0, r1	/* LED Hardware control */
+	initClocks_2nd r1, r2
+	PowerI2C_4th r0, r1
+	INITOST r6, r7
+	/* initRTC r0, r1 */
+60:
+	initMemCntrlr r2, r3, r6, r7, r8
+	restartMemCntrlr r0, r2, r3
+	b 40f
+	.ltorg
+40:
+	isMmuEnabled r0
+	beq 100f
+	initPageTable r3, r6, r7
+	mapSECTIONS r0, r1, r2, r3, s_cbAngelDRAM, v_cbAngelDRAM, p_cbAngelDRAM, SECTION_x1c1b1
+	mapSECTIONS r0, r1, r2, r3, s_cxAngelDRAM, i_cxAngelDRAM, i_cxAngelDRAM, SECTION_x1c1b1,
+	/*mapSECTIONS r0, r1, r2, r3, s_cbExpDRAM, v_cbExpDRAM, p_cbExpDRAM, SECTION_x1c1b1
+	// mapSECTIONS r0, r1, r2, r3, s_xxExpDRAM, v_xxExpDRAM, p_xxExpDRAM, SECTION_x0c0b0*/
+	// mapSECTIONS r0, r1, r2, r3, s_xxPlatformReg, i_xxPlatformReg, i_xxPlatformReg, SECTION_x0c0b0
+	mapSECTIONS r0, r1, r2, r3, s_xxProcessorReg, i_xxProcessorReg, i_xxProcessorReg, SECTION_x0c0b0
+	mapSECTIONS r0, r1, r2, r3, s_xbBOOTROM, v_xbBOOTROM, p_xbBOOTROM, SECTION_x1c0b1
+	mapSECTIONS r0, r1, r2, r3, s_xbAPPFLASH, v_xbAPPFLASH, p_xbAPPFLASH, SECTION_x1c0b1
+	// mapSECTIONS r0, r1, r2, r3, s_xxSA1111, v_xxSA1111, p_xxSA1111, SECTION_x0c0b0*/
+	// mapSECTIONS r0, r1, r2, r3, s_xxPCMCIA, v_xxPCMCIA, p_xxPCMCIA, SECTION_x0c0b0
+	// mapSECTIONS r0, r1, r2, r3, s_xxETHERNET, v_xxETHERNET, p_xxETHERNET, SECTION_x0c0b0
+	/*	mapSECTIONS r0, r1, r2, r3, s_xxEXPANSION, v_xxEXPANSION, p_xxEXPANSION, SECTION_x0c0b0*/
+	mapSECTIONS r0, r1, r2, r3, s_cbCleanCache, v_cbCleanCache, p_cbCleanCache, SECTION_x1c1b1
+	mapSECTIONS r0, r1, r2, r3, s_cxCleanMini, v_cxCleanMini, p_cxCleanMini, SECTION_x1c1b0
+	/* mapSECTIONS r0, r1, r2, r3, s_cbAllDRAM, v_cbAllDRAM, p_cbAllDRAM, SECTION_x1c1b1*/
+	initMMU r1, r2, r3
+	ldr r8, =p_TTableBASE
+	goVirtual r0, r3, r6, r7, r8
+	ldr r0, =s_cbAngelDRAM
+	ldr r1, =hal_dram_size
+	str r0, [r1]
+100:
+	b 56f
+	.ltorg
+56:
+	nop
+	nop
+	nop
+.endm
+
+/*---------------------------------------------------------------------------*/
+/* end of hal_platform_setup.h */
+#endif /* CYGONCE_HAL_PLATFORM_SETUP_H */
