-//; pcmcia timing values
-#define MECR_SETTINGS                            0x1            // ; eXpansion memory config. reg
-//; memory controller settings for expansion card
-//;MCMEM0_SETTINGS                           0x00004204      ; eXpansion card common memory timing config. reg 0
-#define MCMEM0_SETTINGS                          0x00010204     // ; eXpansion card common memory timing config. reg 0
-
-#define MCATT0_SETTINGS                          0x00010504     // ; eXpansion card Attribute space timing config. reg 0
-#define MCIO0_SETTINGS                           0x0000C108      //; eXpansion card I/O space timing config. reg 0
-
