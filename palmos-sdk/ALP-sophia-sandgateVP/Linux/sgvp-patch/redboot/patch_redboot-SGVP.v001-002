+#define CKEN_CKEN11                               BIT11
+#define CKEN_CKEN12                               BIT12
+#define CKEN_CKEN13                               BIT13
+#define CKEN_CKEN14                               BIT14
+//; bit 15 is reserved
+#define CKEN_CKEN16                               BIT16
+
+#define CKEN_PWM0                                 CKEN_CKEN0
+#define CKEN_PWM1                                 CKEN_CKEN1
+#define CKEN_AC97                                 CKEN_CKEN2
