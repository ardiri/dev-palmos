diff -uNr ecos.org/packages/devs/flash/intel/strata/current/src/flash_erase_block.c ecos/packages/devs/flash/intel/strata/current/src/flash_erase_block.c
--- ecos.org/packages/devs/flash/intel/strata/current/src/flash_erase_block.c	2006-09-28 17:37:03.000000000 +0900
+++ ecos/packages/devs/flash/intel/strata/current/src/flash_erase_block.c	2006-09-28 15:37:52.000000000 +0900
@@ -5,6 +5,8 @@
 //      Flash programming
 //
 //==========================================================================
+// Copyright (C) 2005-2006 WILLCOM, Inc. All rights Reserved.
+//==========================================================================
 //####ECOSGPLCOPYRIGHTBEGIN####
 // -------------------------------------------
 // This file is part of eCos, the Embedded Configurable Operating System.
@@ -61,9 +63,11 @@
 // it must not contain any code which might be position dependent!
 //
 
-int flash_erase_block(volatile flash_t *block, unsigned int block_size)
+static inline int
+__flash_erase_block(volatile flash_t *block, unsigned int block_size)
 {
     volatile flash_t *ROM;
+    volatile flash_t *BA;
     flash_t stat = 0;
     int timeout = 50000;
     int cache_on;
@@ -78,7 +82,7 @@
 
     // Get base address and map addresses to virtual addresses
     ROM = FLASH_P2V(CYGNUM_FLASH_BASE_MASK & (unsigned int)block);
-    eb = block = FLASH_P2V(block);
+    BA = eb = block = FLASH_P2V(block);
     block_len = block_size;
 
 #ifdef CYGOPT_FLASH_IS_BOOTBLOCK
@@ -110,6 +114,7 @@
     }
 
     // Restore ROM to "normal" mode
+    BA[0] = FLASH_Reset;
     ROM[0] = FLASH_Reset;
 
     // If an error was reported, see if the block erased anyway
@@ -128,3 +133,25 @@
 
     return stat;
 }
+
+int
+flash_erase_block(volatile flash_t *block, unsigned int block_size)
+{
+	int		ret = -1;
+	unsigned int	addrs = (unsigned int)block;
+	unsigned int	blksz = block_size;
+
+	if (CHECK_LFI_ADDR(block)) {
+		blksz = __flash_info.block_size;
+	}
+
+	for ( ;
+	    addrs < (unsigned int)block + block_size;
+	    addrs += blksz) {
+		ret = __flash_erase_block((volatile flash_t *)addrs, blksz);
+		if (ret & FLASH_ErrorMask)
+			return ret;
+	}
+
+	return ret;
+}
diff -uNr ecos.org/packages/devs/flash/intel/strata/current/src/flash_lock_block.c ecos/packages/devs/flash/intel/strata/current/src/flash_lock_block.c
--- ecos.org/packages/devs/flash/intel/strata/current/src/flash_lock_block.c	2006-09-28 17:37:03.000000000 +0900
+++ ecos/packages/devs/flash/intel/strata/current/src/flash_lock_block.c	2006-09-28 15:37:52.000000000 +0900
@@ -5,6 +5,8 @@
 //      Flash programming
 //
 //==========================================================================
+// Copyright (C) 2005-2006 WILLCOM, Inc. All rights Reserved.
+//==========================================================================
 //####ECOSGPLCOPYRIGHTBEGIN####
 // -------------------------------------------
 // This file is part of eCos, the Embedded Configurable Operating System.
@@ -59,8 +61,8 @@
 // it must not contain any code which might be position dependent!
 //
 
-int
-flash_lock_block(volatile flash_t *block)
+static inline int
+__flash_lock_block(volatile flash_t *block)
 {
     volatile flash_t *ROM;
     flash_t stat;
@@ -83,11 +85,18 @@
     // Set lock bit
     block[0] = FLASH_Set_Lock;
     block[0] = FLASH_Set_Lock_Confirm;  // Confirmation
+#ifdef CYGOPT_FLASH_IS_SYNCHRONOUS
+    while(((stat = block[0]) & FLASH_Status_Ready) != FLASH_Status_Ready) {
+        if (--timeout == 0) break;
+    }
+#else
     while(((stat = ROM[0]) & FLASH_Status_Ready) != FLASH_Status_Ready) {
         if (--timeout == 0) break;
     }
+#endif // CYGOPT_FLASH_IS_SYNCHRONOUS
 
     // Restore ROM to "normal" mode
+    block[0] = FLASH_Reset;
     ROM[0] = FLASH_Reset;
 
     if (cache_on) {
@@ -96,3 +105,25 @@
 
     return stat;
 }
+
+int
+flash_lock_block(volatile flash_t *block)
+{
+	int		ret = -1;
+	unsigned int	addrs = (unsigned int)block;
+	unsigned int	blksz = flash_info.block_size;
+
+	if (CHECK_LFI_ADDR(block)) {
+		blksz = __flash_info.block_size;
+	}
+
+	for ( ;
+	    addrs < (unsigned int)block + flash_info.block_size;
+	    addrs += blksz) {
+		ret = __flash_lock_block((volatile flash_t *)addrs);
+		if (ret & FLASH_ErrorMask)
+			return ret;
+	}
+
+	return ret;
+}
diff -uNr ecos.org/packages/devs/flash/intel/strata/current/src/flash_program_buf.c ecos/packages/devs/flash/intel/strata/current/src/flash_program_buf.c
--- ecos.org/packages/devs/flash/intel/strata/current/src/flash_program_buf.c	2006-09-28 17:37:03.000000000 +0900
+++ ecos/packages/devs/flash/intel/strata/current/src/flash_program_buf.c	2006-09-28 15:37:52.000000000 +0900
@@ -5,6 +5,8 @@
