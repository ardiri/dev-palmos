+# <
+# PXA270 Sandgate II-P SMC91C96 ethernet driver
+# Ethernet driver for PXA270 SandgateII-P boards.
+#
+cdl_package CYGPKG_DEVS_ETH_ARM_PXA270_SG2P {
+    # Packages cannot be added or removed, nor can their version be changed,
+    # simply by editing their value. Instead the appropriate configuration
+    # should be used to perform these actions.
+
+    # ActiveIf constraint: CYGPKG_IO_ETH_DRIVERS
+    #     CYGPKG_IO_ETH_DRIVERS == current
+    #   --> 1
+    # ActiveIf constraint: CYGPKG_HAL_ARM_XSCALE_PXA270_SG2P
+    #     CYGPKG_HAL_ARM_XSCALE_PXA270_SG2P == current
+    #   --> 1
+
+    # This value cannot be modified here.
+    # Flavor: booldata
+    # Current value: 1 current
+    # Requires: CYGPKG_DEVS_ETH_SMSC_LAN91CXX
+    #     CYGPKG_DEVS_ETH_SMSC_LAN91CXX == current
+    #   --> 1
+};
+
+# >
+# SMSC LAN91CXX driver required
+#
+cdl_interface CYGINT_DEVS_ETH_SMSC_LAN91CXX_REQUIRED {
+    # Implemented by CYGPKG_DEVS_ETH_ARM_PXA270_SG2P, active, enabled
+    # This value cannot be modified here.
+    # Flavor: data
+    # Current_value: 1
+
+    # The following properties are affected by this value
+    # package CYGPKG_DEVS_ETH_SMSC_LAN91CXX
+    #     ActiveIf: CYGINT_DEVS_ETH_SMSC_LAN91CXX_REQUIRED
+};
+
+# Device name for the ethernet driver
+# This option sets the name of the ethernet device for the
+# ethernet port.
+#
+cdl_option CYGDAT_DEVS_ETH_ARM_PXA270_SG2P_NAME {
+    # Flavor: data
+    # No user value, uncomment the following line to provide one.
+    # user_value "\"eth0\""
+    # value_source default
+    # Default value: "\"eth0\""
+};
+
+# The ethernet station address (MAC)
+# A static ethernet station address. 
+# Caution: Booting two systems with the same MAC on the same
+# network, will cause severe conflicts.
+#
+cdl_option CYGDAT_DEVS_ETH_ARM_PXA270_SG2P_ESA {
+    # ActiveIf constraint: !CYGSEM_DEVS_ETH_ARM_PXA270_SG2P_REDBOOT_ESA
+    #     CYGSEM_DEVS_ETH_ARM_PXA270_SG2P_REDBOOT_ESA == 0
+    #   --> 1
+
+    # Flavor: data
+    # No user value, uncomment the following line to provide one.
+    # user_value "{0x12, 0x13, 0x14, 0x15, 0x16, 0x17}"
+    # value_source default
+    # Default value: "{0x12, 0x13, 0x14, 0x15, 0x16, 0x17}"
+};
+
+# Use the RedBoot ESA (MAC address)
+# Use the ESA that is stored as a RedBoot variable instead of
+# a static ESA.
+#
+cdl_option CYGSEM_DEVS_ETH_ARM_PXA270_SG2P_REDBOOT_ESA {
+    # Flavor: bool
+    # No user value, uncomment the following line to provide one.
+    # user_value 0
+    user_value 1
+    # value_source default
+    # Default value: 0
+
+    # The following properties are affected by this value
+    # option CYGDAT_DEVS_ETH_ARM_PXA270_SG2P_ESA
+    #     ActiveIf: !CYGSEM_DEVS_ETH_ARM_PXA270_SG2P_REDBOOT_ESA
+};
+
+# <
+# SMSC LAN91CXX compatible ethernet driver
+# Ethernet driver for SMSC LAN91CXX compatible controllers.
