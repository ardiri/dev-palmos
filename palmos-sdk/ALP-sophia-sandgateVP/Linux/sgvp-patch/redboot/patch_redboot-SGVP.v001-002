+// Purpose:      PXA271 BlackRiver ethernet definitions
+//####DESCRIPTIONEND####
+//==========================================================================
+
+#include <pkgconf/system.h>
+#include <pkgconf/devs_eth_arm_pxa271_blrv.h>
+#include <cyg/hal/hal_intr.h>          
+#include <cyg/hal/pxa271_blrv.h>
+
+//#define CYGNUM_DEVS_ETH_SMSC_LAN91CXX_SHIFT_ADDR    2
+#ifndef CYGSEM_DEVS_ETH_ARM_PXA271_BLRV_REDBOOT_ESA
+static unsigned char static_esa[] = CYGDAT_DEVS_ETH_ARM_PXA271_BLRV_ESA;
+#endif
+
+#define LAN91CXX_IS_LAN91C111  1
+#define LAN91CXX_32BIT_RX      1
+
+// MAC address is stored as a Redboot config option
+#ifdef CYGPKG_REDBOOT
+#include <pkgconf/redboot.h>
+#ifdef CYGSEM_REDBOOT_FLASH_CONFIG
+#include <redboot.h>
+#include <flash_config.h>
+
+RedBoot_config_option("Network hardware address [MAC]",
+                      pxa271_blrv_esa,
+                      ALWAYS_ENABLED, true,
+                      CONFIG_ESA, 0
+    );
+#endif
+#endif
+
+// ESA address fetch function
+static void pxa271_blrv_get_ESA(struct lan91cxx_priv_data *cpd)
+{
+	// diag_printf("pxa271_blrv_get_ESA\n");
+    // Fetch hardware address from RedBoot config
+#if defined(CYGSEM_DEVS_ETH_ARM_PXA271_BLRV_REDBOOT_ESA)
+#if defined(CYGPKG_REDBOOT) && \
+    defined(CYGSEM_REDBOOT_FLASH_CONFIG)
+    flash_get_config("pxa271_blrv_esa", cpd->enaddr, CONFIG_ESA);
+#else
+#error "No RedBoot flash configuration to store ESA"
+#endif
+#else
+    memcpy(cpd->enaddr, static_esa, 6);
+#endif
+//	diag_printf("pxa271_blrv_get_ESA1\n");
+}
+
+static lan91cxx_priv_data lan91cxx_eth0_priv_data = { 
+
+    config_enaddr : pxa271_blrv_get_ESA,
+#ifndef CYGSEM_DEVS_ETH_ARM_PXA271_BLRV_REDBOOT_ESA    
+    enaddr: CYGDAT_DEVS_ETH_ARM_PXA271_BLRV_ESA,
+#endif
+    base : (unsigned short *) PXA271_BLRV_ETH_IOBASE,
+//    attbase : (unsigned char *) PXA271_BLRV_ETH_MMBASE,
+    interrupt : PXA271_IRQ_GPIO_ETH
+};
+
+#define	CYGHWR_SMSC_91CXX_INSTALL(x)	\
+	(*PXA271_BSR & CPLD_BSR_nEXB_PRES ? false : true)
+
+ETH_DRV_SC(lan91cxx_sc,
+           &lan91cxx_eth0_priv_data,          // Driver specific data
+           CYGDAT_DEVS_ETH_ARM_PXA271_BLRV_NAME, // Name for device
+           lan91cxx_start,
+           lan91cxx_stop,
+           lan91cxx_control,
+           lan91cxx_can_send,
+           lan91cxx_send,
+           lan91cxx_recv,
+           lan91cxx_deliver,
+           lan91cxx_poll,
+           lan91cxx_int_vector
+);
+
+NETDEVTAB_ENTRY(lan91cxx_netdev, 
+                "lan91cxx_" CYGDAT_DEVS_ETH_ARM_PXA271_BLRV_NAME,
+                smsc_lan91cxx_init,
+                &lan91cxx_sc);
+
+//EOF devs_eth_pxa271_blrv.inl
