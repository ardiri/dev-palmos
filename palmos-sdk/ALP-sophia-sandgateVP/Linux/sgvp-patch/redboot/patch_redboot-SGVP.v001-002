+.macro getHWConfig_PLL reg
+	ldr \reg, =PXA270_PSPR
+	ldr \reg, [\reg]
+	and \reg, \reg, #HWConfig_PLL
+	//; extract PLL clock speed bit
+	mov \reg, \reg, lsr #7
+	//; shift into position 0
+.endm
+
+//;----------------------------------------------------------------------------
+//; The processor stepping bits are returned in position 3:0 of \reg
