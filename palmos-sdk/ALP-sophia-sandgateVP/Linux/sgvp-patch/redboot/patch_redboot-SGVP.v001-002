+#include <pkgconf/hal.h>
+#include <pkgconf/system.h>
+#include CYGBLD_HAL_PLATFORM_H
+#include <cyg/infra/cyg_type.h>
+#include <cyg/infra/cyg_trac.h>
+#include <cyg/infra/cyg_ass.h>
+#include <cyg/hal/hal_io.h>
+#include <cyg/hal/hal_arch.h>
+#include <cyg/hal/hal_diag.h>
+#include <cyg/hal/hal_intr.h>
+#include <cyg/hal/hal_cache.h>
+#include <cyg/hal/hal_pxa270.h>
+#include <cyg/hal/hal_misc.h>
+#include <cyg/hal/pxa270_sg2p.h>
+#include <cyg/infra/diag.h>
+#include <cyg/hal/hal_mm.h>
+
+void plf_hardware_init(void)
+{
+	unsigned long int gpioValue ;
+	unsigned long bttmp;
+
+	// enable FFUART clock
+	gpioValue = *PXA270_CKEN ;
+
+	bttmp = (0x1u << 7);
+	gpioValue = gpioValue | (unsigned long)bttmp;
+
+	*PXA270_CKEN = gpioValue ;
+
+	return ;
+}
+
+/*------------------------------------------------------------------------*/
+// EOF mpc50_misc.c
diff -uNr ecos.org/packages/hal/arm/xscale/pxa270_sgvp/current/cdl/hal_arm_xscale_pxa270_sgvp.cdl ecos/packages/hal/arm/xscale/pxa270_sgvp/current/cdl/hal_arm_xscale_pxa270_sgvp.cdl
--- ecos.org/packages/hal/arm/xscale/pxa270_sgvp/current/cdl/hal_arm_xscale_pxa270_sgvp.cdl	1970-01-01 09:00:00.000000000 +0900
+++ ecos/packages/hal/arm/xscale/pxa270_sgvp/current/cdl/hal_arm_xscale_pxa270_sgvp.cdl	2006-09-28 15:37:54.000000000 +0900
@@ -0,0 +1,351 @@
+# ====================================================================
+#
+#      hal_arm_xscale_pxa270_sgvp.cdl
+#
+#      Accelent PXA270 Sandgate-VP platform HAL package configuration data
+#
+# ====================================================================
+# Copyright (c) 2006 Sophia Systems Co.,Ltd.
+# ====================================================================
+#####ECOSGPLCOPYRIGHTBEGIN####
+## -------------------------------------------
+## This file is part of eCos, the Embedded Configurable Operating System.
+## Copyright (C) 1998, 1999, 2000, 2001, 2002 Red Hat, Inc.
+##
+## eCos is free software; you can redistribute it and/or modify it under
