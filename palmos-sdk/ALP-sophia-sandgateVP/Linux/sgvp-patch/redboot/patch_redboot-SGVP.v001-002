-#define MDCNFG_SETTINGS                          0x00001AC1      //; SDRAM Config Reg
-
-#define MSC1_SETTINGS                            0x00002431      //; Static Mem. Control Reg 1
-#define MSC2_SETTINGS                            0x00000000      //; Static Mem. Control Reg 2 - NOT USED
-
-//; memory controller settings for expansion card
