diff -uNr ecos.org/packages/hal/arm/xscale/pxa271_blrv/current/cdl/hal_arm_xscale_pxa271_blrv.cdl ecos/packages/hal/arm/xscale/pxa271_blrv/current/cdl/hal_arm_xscale_pxa271_blrv.cdl
--- ecos.org/packages/hal/arm/xscale/pxa271_blrv/current/cdl/hal_arm_xscale_pxa271_blrv.cdl	1970-01-01 09:00:00.000000000 +0900
+++ ecos/packages/hal/arm/xscale/pxa271_blrv/current/cdl/hal_arm_xscale_pxa271_blrv.cdl	2006-09-28 15:37:55.000000000 +0900
