+// with eCos; if not, write to the Free Software Foundation, Inc.,
+// 59 Temple Place, Suite 330, Boston, MA 02111-1307 USA.
+//
+// As a special exception, if other files instantiate templates or use macros
+// or inline functions from this file, or you compile this file and link it
+// with other works to produce a work based on this file, this file does not
+// by itself cause the resulting work to be covered by the GNU General Public
+// License. However the source code for this file must still be made available
+// in accordance with section (3) of the GNU General Public License.
+//
+// This exception does not invalidate any other reasons why a work based on
+// this file might be covered by the GNU General Public License.
+//
+// Alternative licenses for eCos may be arranged by contacting Red Hat, Inc.
+// at http://sources.redhat.com/ecos/ecos-license/
+// -------------------------------------------
+//####ECOSGPLCOPYRIGHTEND####
+//=============================================================================
+//#####DESCRIPTIONBEGIN####
+//
+// Author(s):    Xiao Ye
+// Contributors: Xiao Ye
+// Purpose:      PXA271 BlackRiver platform specific support routines
+// Description:
+// Usage:        #include <cyg/hal/pxa271_blrv.h>
+//
+//####DESCRIPTIONEND####
+//
+//===========================================================================*/
+
+#include <pkgconf/system.h>
+#include CYGHWR_MEMORY_LAYOUT_H
+#include <pkgconf/hal_arm_xscale_pxa271_blrv.h>
+//#include <cyg/hal/hal_verde.h>	// IO Processor defines
+
+#define SDRAM_PHYS_BASE		0xa0000000
+#define SDRAM_BASE		0x00000000
+#define SDRAM_SIZE		0x02000000	// 32MB
+#define SDRAM_MAX		0x04000000	// 64MB
+
+// These must match setup in the page table in hal_platform_extras.h
+#define SDRAM_UNCACHED_BASE	0xc0000000
+#define DCACHE_FLUSH_AREA	0xe0000000
+
+//
+// Signal assertion levels
+//
+#define _LOGIC_ONE(m)		(m & 0xFFFF)
+#define _LOGIC_ZERO(m)		(m & 0x0000)
+
+//
+// Special purpose GPIO interrupt mappings
+//
+
+// GPIO layout
+//
+#define PXA271_GPIO_CF_DETECT	0x00000001	// 0 = Compact Flash detect
+#define PXA271_GPIO_CF_ABSENT	_LOGIC_ZERO(PXA271_GPIO_CF_DETECT)
+#define PXA271_GPIO_CF_PRESENT	_LOGIC_ONE(PXA271_GPIO_CF_DETECT)
+
+#define PXA271_CF_IRQ		CYGNUM_HAL_INTERRUPT_GPIO22
+#define PXA271_CF_DETECT	CYGNUM_HAL_INTERRUPT_GPIO12
+#define PXA271_IRQ_GPIO_ETH	CYGNUM_HAL_INTERRUPT_GPIO10
+
+//; reserved bits in CKEN must be written as 0,
+//; use this mask to insure that happens
+#define CKEN_DEFINED		0x00408200
+
+//;------------------------------------------------------------------------
+//; platform-specific memory controller settings
+#define MDCNFG_VAL		0x0b002bcf
+#define MDREFR_VAL		0x200fe02e
+#define MSC0_VAL		0x98e898e8
+#define MSC1_VAL		0x0000bdd9	//; Static Mem. Control Reg 1
+#define MSC2_VAL		0x0000388c	//; Static Mem. Control Reg 2
+#define MDMRS_VAL		0x00000000	//; SDRAM Mode Reg Set Config Reg
+#define SXCNFG_VAL		0x00006011	//; Synch. Static Mem. Config. Reg.
+#define SXMRS_VAL		0x00000000	//; Synch. Static Mem. Mode Register Set Config - NOT USED
+#define SXLCR_VAL		0x00000000	//; Synch. Static Mem. Config. Reg. - NOT USED
+#define MCMEM0_VAL		0x00014307	//; eXpansion card common memory timing config. reg 0
+#define MCMEM1_VAL		0x00014307	//; eXpansion card common memory timing config. reg 1 - NOT USED
+#define MCATT0_VAL		0x0001C787	//; eXpansion card Attribute space timing config. reg 0
+#define MCATT1_VAL		0x0001C787	//; eXpansion card attribute space timing config. reg 1 - NOT USED
+#define MCIO0_VAL		0x0001430F	//; eXpansion card I/O space timing config. reg 0
+#define MCIO1_VAL		0x0001430F	//; eXpansion card I/O space timing config. reg 1 - NOT USED
+#define MECR_VAL		0x00000001	//; eXpansion memory config. reg
+#define PXA271_BLRV_ETH_IOBASE	0xA8000300
+#define PXA271_BLRV_ETH_MMBASE	0xA8800000
+
+//;------------------------------------------------------------------------
+#define PXA271_BCR		REG16_PTR(0x08000000)
+#define PXA271_BSR		REG16_PTR(0x08000004)
+#define PXA271_INTMASK		REG16_PTR(0x08000008)
+#define PXA271_INTCLR		REG16_PTR(0x0800000C)
+#define PXA271_DSPINT		REG16_PTR(0x08000010)
+#define PXA271_REGDBG		REG16_PTR(0x08000014)
+#define PXA271_RECPLAY		REG16_PTR(0x08000020)
+#define PXA271_AMLCTRL		REG16_PTR(0x08000024)
+
+//register bit fields - bcr
+#define CPLD_BCR_SOUND_RESET_B	BIT0		//; uPD9992 reset
+#define CPLD_BCR_CAM_PWR_ON	BIT1		//; camera power
+#define CPLD_BCR_BT_PWR_ON	BIT2		//; Bluetooth power
+#define CPLD_BCR_BT_RESET	BIT3		//; Bluetooth reset
+#define CPLD_BCR_LCD_PWR_ON	BIT5		//; Main LCD power
+#define CPLD_BCR_LCD_RESETn	BIT6		//; Main LCD reset
+#define CPLD_BCR_LCD_SCLK	BIT7		//; Main LCD SCLK
+#define CPLD_BCR_LCD_SCS	BIT8		//; Main LCD SCS
+#define CPLD_BCR_LCD_SDI	BIT9		//; Main LCD SDI
+#define CPLD_BCR_AUDIO_PWR_ON	BIT10		//; Audio power
+#define CPLD_BCR_CAMERA_RESn	BIT11		//; camera reset
+#define CPLD_BCR_COMM_PWR_ON	BIT12		//; comm power
+
+//register bit fields - bsr
+#define	CPLD_BSR_COMM_INS	BIT0
+#define	CPLD_BSR_SD_INS		BIT3
+#define	CPLD_BSR_LCD_SDO	BIT5
+#define	CPLD_BSR_nEXB_PRES	BIT6
+#define	CPLD_BSR_DBG_INFO	BIT8
+#define	CPLD_BSR_USB_DETECT	BIT9
+#define	CPLD_BSR_DBG_IN1	BIT10
+
+#endif //
+// EOF pxa271_blrv.h
diff -uNr ecos.org/packages/hal/arm/xscale/pxa271_blrv/current/misc/redboot_RAM.ecm ecos/packages/hal/arm/xscale/pxa271_blrv/current/misc/redboot_RAM.ecm
