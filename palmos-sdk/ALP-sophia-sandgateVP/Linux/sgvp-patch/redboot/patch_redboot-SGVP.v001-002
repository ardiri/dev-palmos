+cdl_option CYGHWR_MEMORY_LAYOUT_LDI {
+    # Calculated value:  CYG_HAL_STARTUP == "RAM" ?                                                   "<pkgconf/mlt_arm_xscale_pxa270_sg2p_ram.ldi>" :  "<pkgconf/mlt_arm_xscale_pxa270_sg2p_rom.ldi>" 
+    #     CYG_HAL_STARTUP == ROM
+    # Flavor: data
+    # Current_value: <pkgconf/mlt_arm_xscale_pxa270_sg2p_rom.ldi>
+};
+
+# Memory layout header file
+#
+cdl_option CYGHWR_MEMORY_LAYOUT_H {
+    # Calculated value:  CYG_HAL_STARTUP == "RAM" ?                                                 "<pkgconf/mlt_arm_xscale_pxa270_sg2p_ram.h>" :  "<pkgconf/mlt_arm_xscale_pxa270_sg2p_rom.h>" 
+    #     CYG_HAL_STARTUP == ROM
