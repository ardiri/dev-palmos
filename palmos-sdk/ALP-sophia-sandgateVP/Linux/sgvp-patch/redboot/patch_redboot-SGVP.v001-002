--- ecos.org/redboot-SG2.ecc	1970-01-01 09:00:00.000000000 +0900
+++ ecos/redboot-SG2.ecc	2006-09-28 15:37:49.000000000 +0900
@@ -0,0 +1,7398 @@
+# eCos saved configuration
