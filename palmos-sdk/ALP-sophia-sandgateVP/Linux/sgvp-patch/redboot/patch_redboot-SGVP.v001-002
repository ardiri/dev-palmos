+	ldr \reg, [\reg]
+	and \reg, \reg, #HWConfig_AppflashPM
+	//; extract app flash pagemode bit
+	mov \reg, \reg, lsr #16
+	//; shift into position 0
+.endm
+
+//;----------------------------------------------------------------------------
+//; The app flash type bits are returned in position 3:0 of \reg
+//;----------------------------------------------------------------------------
+.macro getHWConfig_AppFLASHTYPE reg
