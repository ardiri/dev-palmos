+.macro getHWConfig_TURBO reg
+	ldr \reg, =PXA270_PSPR
+	ldr \reg, [\reg]
+	and \reg, \reg, #HWConfig_TURBO
+	//; extract turbo bit
+	mov \reg, \reg, lsr #4
+	//; shift into position 0
+.endm
+
+//;----------------------------------------------------------------------------
+//; The expansion card bit is returned in position 0 of \reg
+//; 1=present, 0=not present
+//;----------------------------------------------------------------------------
+.macro getHWConfig_Expn reg
+	ldr \reg, =PXA270_PSPR
+	ldr \reg, [\reg]
+	and \reg, \reg, #HWConfig_EXPN
+	//; extract expansion bit
+	mov \reg, \reg, lsr #5
+	//; shift into position 0
+.endm
+
+//;----------------------------------------------------------------------------
+//; The debug mode bit is returned in position 0 of \reg
+//; 1=off, 0=on
+//;----------------------------------------------------------------------------
+.macro getHWConfig_DbgMODE reg
+	ldr \reg, =PXA270_PSPR
+	ldr \reg, [\reg]
+	and \reg, \reg, #HWConfig_DbgMODE
+	//; extract debug mode bit
+	mov \reg, \reg, lsr #6
+	//; shift into position 0
+.endm
+
+//;----------------------------------------------------------------------------
+//; The PLL clock speed bit is returned in position 0 of \reg
+//; 1=default, 0=non-default
+//;----------------------------------------------------------------------------
+.macro getHWConfig_PLL reg
+	ldr \reg, =PXA270_PSPR
+	ldr \reg, [\reg]
+	and \reg, \reg, #HWConfig_PLL
+	//; extract PLL clock speed bit
+	mov \reg, \reg, lsr #7
+	//; shift into position 0
+.endm
+
+//;----------------------------------------------------------------------------
+//; The processor stepping bits are returned in position 3:0 of \reg
