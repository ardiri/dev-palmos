+//=============================================================================
+//#####DESCRIPTIONBEGIN####
+//
+// Author(s):    Xiao Ye
+// Contributors: Xiao Ye
+// Purpose:      PXA270 Sandgate-VP platform specific support routines
+// Description:
+// Usage:        #include <cyg/hal/pxa270_sgvp.h>
+//
+//####DESCRIPTIONEND####
+//
+//===========================================================================*/
+
+#include <pkgconf/system.h>
+#include CYGHWR_MEMORY_LAYOUT_H
+#include <pkgconf/hal_arm_xscale_pxa270_sgvp.h>
+//#include <cyg/hal/hal_verde.h>	// IO Processor defines
+
+#define SDRAM_PHYS_BASE		0xa0000000
+#define SDRAM_BASE		0x00000000
+#define SDRAM_SIZE		0x02000000	// 32MB
+#define SDRAM_MAX		0x04000000	// 64MB
+
+// These must match setup in the page table in hal_platform_extras.h
+#define SDRAM_UNCACHED_BASE	0xc0000000
+#define DCACHE_FLUSH_AREA	0xe0000000
+
+//
+// Signal assertion levels
+//
+#define _LOGIC_ONE(m)		(m & 0xFFFF)
+#define _LOGIC_ZERO(m)		(m & 0x0000)
+
+//
+// Special purpose GPIO interrupt mappings
+//
+
+// GPIO layout
+//
+//#define PXA270_GPIO_CF_DETECT	0x00000001	// 0 = Compact Flash detect
+//#define PXA270_GPIO_CF_ABSENT	_LOGIC_ZERO(PXA270_GPIO_CF_DETECT)
+//#define PXA270_GPIO_CF_PRESENT	_LOGIC_ONE(PXA270_GPIO_CF_DETECT)
+
+//#define PXA270_CF_IRQ		CYGNUM_HAL_INTERRUPT_GPIO22
+//#define PXA270_CF_DETECT	CYGNUM_HAL_INTERRUPT_GPIO12
+//#define PXA270_IRQ_GPIO_ETH	CYGNUM_HAL_INTERRUPT_GPIO10
+
+//; reserved bits in CKEN must be written as 0,
+//; use this mask to insure that happens
+#define CKEN_DEFINED		0x00408200
+
+//;------------------------------------------------------------------------
+//; platform-specific memory controller settings
+#define MDCNFG_VAL		0x0a000ac9
+#define MDREFR_VAL		0x200fe031
+#define MSC0_VAL		0x7ff07ff0
+#define MSC1_VAL		0x0000bdd9	//; Static Mem. Control Reg 1
+#define MSC2_VAL		0x0000b88c	//; Static Mem. Control Reg 2
+#define MDMRS_VAL		0x00000000	//; SDRAM Mode Reg Set Config Reg
+#define SXCNFG_VAL		0x00006011	//; Synch. Static Mem. Config. Reg.
+#define SXMRS_VAL		0x00000000	//; Synch. Static Mem. Mode Register Set Config - NOT USED
+#define SXLCR_VAL		0x00000000	//; Synch. Static Mem. Config. Reg. - NOT USED
+#define MCMEM0_VAL		0x00014307	//; eXpansion card common memory timing config. reg 0
+#define MCMEM1_VAL		0x00014307	//; eXpansion card common memory timing config. reg 1 - NOT USED
+#define MCATT0_VAL		0x0001C787	//; eXpansion card Attribute space timing config. reg 0
+#define MCATT1_VAL		0x0001C787	//; eXpansion card attribute space timing config. reg 1 - NOT USED
+#define MCIO0_VAL		0x0001430F	//; eXpansion card I/O space timing config. reg 0
+#define MCIO1_VAL		0x0001430F	//; eXpansion card I/O space timing config. reg 1 - NOT USED
+#define MECR_VAL		0x00000001	//; eXpansion memory config. reg
+
+//#define PXA270_SGVP_ETH_IOBASE	0xA8000300
+//#define PXA270_SGVP_ETH_MMBASE	0xA8800000
+
+#endif //
+// EOF pxa270_sgvp.h
