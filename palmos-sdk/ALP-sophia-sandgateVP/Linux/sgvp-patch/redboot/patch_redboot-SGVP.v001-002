-//;------------------------------------------------------------------------
-//; defines for the CCLKCFG register
-#define CCLKCFG_TURBO                      BIT0
-#define CCLKCFG_FCS                        BIT1
-#define CCLKCFG_DEFINED                    0x3   
-
-//;------------------------------------------------------------------------
-//; defines for the PWRMODE register
-#define PWRMODE_RUN                        0x0
-#define PWRMODE_IDLE                       0x1
-#define PWRMODE_SLEEP                      0x3
-#define PWRMODE_DEFINED                    0x3   
-//;------------------------------------------------------------------------
-
-//; bit codes used to identify flash devices
-#define FLASH_28f160S3                     (0x2)
-#define FLASH_28f128J3A                    (0x4)
-#define FLASH_28f640J5                     (0x6)
-#define FLASH_PM                           (0x1)
-#define FLASH_28f128J3A_PM                 (FLASH_28f128J3A + FLASH_PM)
-#define FLASH_NONE                         (0x000)
-
- 
- 
-//;------------------------------------------------------------------------
-//; sdram bank base addresses
-#define SDRAM0_PHYSICAL_BASE               REG32_PTR(0xA0000000)
-#define SDRAM1_PHYSICAL_BASE               REG32_PTR(0xA4000000)
-#define SDRAM2_PHYSICAL_BASE               REG32_PTR(0xA8000000)
-#define SDRAM3_PHYSICAL_BASE               REG32_PTR(0xAC000000)
-
-//; processor steppings
-#define STEPPING_A0                        (0x0)
-#define STEPPING_A1                        (0x1)
-#define STEPPING_B0                        (0x2)
-#define STEPPING_B1                        (0x3)
-#define STEPPING_B2                        (0x4)
-#define STEPPING_C0                        (0x5)
-
-//;------------------------------------------------------------------------
-//; physical address for alternate boot image
-//; the alternate image is booted when gpio 1 is a 1
-#define ALTERNATE_IMAGE_ADDR               0x01E00000
-
-//;------------------------------------------------------------------------
-
-#define p_cbAngelDRAM                      0xA0000000
-#define v_cbAngelDRAM                      0x00000000
-#define s_cbAngelDRAM                      0x04000000
-
-#define i_cxAngelDRAM                      0xA0000000
-#define s_cxAngelDRAM                      0x04000000
-
-// ; Expansion DRAM:  p=physical address, v=virtual address, s=size
-// ;  c=cached, b=buffered, x=Not[cached/buffered]
-#define p_cbExpDRAM                        0xA0800000
-#define v_cbExpDRAM                        0x50400000
-#define s_cbExpDRAM                        0x01A00000
-
-#define p_xxExpDRAM                        0xA2200000
-#define v_xxExpDRAM                        0x60400000
-#define s_xxExpDRAM                        0x01C00000
-
-// ; PCMCIA:  p=physical address, v=virtual address, s=size
-// ;  c=cached, b=buffered, x=Not[cached/buffered]
-#define p_xxPCMCIA                         0x20000000
-#define v_xxPCMCIA                         0xB0000000
-#define s_xxPCMCIA                         0x10000000
-
-// ; Processor Registers: s=size, i=identity-mapped 
-// ;  c=cached, b=buffered, x=Not[cached/buffered]
-#define i_xxProcessorReg                   0x40000000
-#define s_xxProcessorReg                   0x08100000
-
-// ; Platform Registers: s=size, i=identity-mapped 
-// ;  c=cached, b=buffered, x=Not[cached/buffered]
-#define i_xxPlatformReg                    0x08000000
-#define s_xxPlatformReg                    0x04000000
-
-// ; Boot Rom:  p=physical address, v=virtual address, s=size
-// ;  c=cached, b=buffered, x=Not[cached/buffered]
-#define p_xbBOOTROM                        0x00000000
-#define v_xbBOOTROM                        0x04000000
-#define s_xbBOOTROM                        0x04000000
-
-// ; Application Flash:  p=physical address, v=virtual address, s=size
-// ;  c=cached, b=buffered, x=Not[cached/buffered]
-#define p_xbAPPFLASH                       0x04000000
-#define v_xbAPPFLASH                       0x10000000
-#define s_xbAPPFLASH                       0x02000000
-
-// ; Ethernet controller:  p=physical address, v=virtual address, s=size
-// ;  c=cached, b=buffered, x=Not[cached/buffered]
-#define p_xxETHERNET                       0x0C000000
-#define v_xxETHERNET                       0xA8000000
-#define s_xxETHERNET                       0x04000000
-
-// ; SA1111 memory:  p=physical address, v=virtual address, s=size
-// ;  c=cached, b=buffered, x=Not[cached/buffered]
-#define p_xxSA1111                         0x10000000
-#define v_xxSA1111                         0x20000000
-#define s_xxSA1111                         0x04000000
-
-// ; Expansion card:  p=physical address, v=virtual address, s=size
-// ;  c=cached, b=buffered, x=Not[cached/buffered]
-#define p_xxEXPANSION                      0xA4000000
-#define v_xxEXPANSION                      0xA5000000
-#define s_xxEXPANSION                      0x04000000
-
-// ; The clean cache regions are used to flush the data cache and mini-data caches,
-// ; these regions should not be used for anything else.
-
-// ; Clean Data Cache:  p=physical address, v=virtual address, s=size
-// ;  c=cached, b=buffered, x=Not[cached/buffered]
-#define p_cbCleanCache                     0xA3E00000
-#define v_cbCleanCache                     0xE0000000
-#define s_cbCleanCache                     0x00100000
-
-// ; Clean Mini Cache:  p=physical address, v=virtual address, s=size
-// ;  c=cached, b=buffered, x=Not[cached/buffered]
-#define p_cxCleanMini                      0xA3F00000
-#define v_cxCleanMini                      0xE0100000
-#define s_cxCleanMini                      0x00100000
-
-#define p_cbAllDRAM                        0xA0800000
-#define v_cbAllDRAM                        0x70400000
-#define s_cbAllDRAM                        (s_cbExpDRAM + s_xxExpDRAM + s_cbCleanCache + s_cxCleanMini)
-
-// ; the translation table base is put into the highest range of memory that angel
-// ; manages for itself, 128K allocated for the table. Note: do not get this out
-// ; of synch with devconf.h!
-
-// ; Translation Table Base::  p=physical address, s=size
-#define s_TTableBASE                       0x00020000
-#define p_TTableBASE                       ((p_cbAngelDRAM + s_cbAngelDRAM) - s_TTableBASE)
-#define vp_TTableBASE                      ((v_cbAngelDRAM + s_cbAngelDRAM) - s_TTableBASE)
-
-
-#define ROM1Base                           p_xbBOOTROM
-#define ROMBase                            ROM1Base
-
-#define ROM2Base                           p_xbAPPFLASH
-#define FlashBase                          ROM2Base 
-
-//; handy size constants
