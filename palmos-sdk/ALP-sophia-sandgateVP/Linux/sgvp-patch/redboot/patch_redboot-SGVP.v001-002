-
-//; defines for the Auxiliary control register
-#define CONTROL_COALESCE                   BIT0
-#define CONTROL_PAGETABLE                  BIT1
-#define CONTROL_MINIDATA                   0x30
-#define CONTROL_MINIDATA_00                0x00
-#define CONTROL_MINIDATA_01                0x10
-#define CONTROL_MINIDATA_10                0x20
-
-//;------------------------------------------------------------------------
-
-//; virtual memory descriptor access attributes
-#define X_BIT                              (1 << 12)
-#define ALL_ACCESS                         (3 << 10)
-#define C_BIT                              (1 << 3)
-#define B_BIT                              (1 << 2)
-#define SECTION_BIT                        (1 << 1)
-#define CB_BITS                            (C_BIT + B_BIT)
-#define XB_BITS                            (X_BIT + B_BIT)
-#define XC_BITS                            (X_BIT + C_BIT)
-#define XCB_BITS                           (X_BIT + C_BIT + B_BIT)
-
-//; 1 Mb section access constants
-#define SECTION_x1c1b1                     ALL_ACCESS + SECTION_BIT + XCB_BITS
-#define SECTION_x1c0b1                     (ALL_ACCESS + SECTION_BIT + XB_BITS)
-#define SECTION_x1c1b0                     (ALL_ACCESS + SECTION_BIT + XC_BITS)
-#define SECTION_x0c1b1                     (ALL_ACCESS + SECTION_BIT + CB_BITS)
-#define SECTION_x0c0b1                     (ALL_ACCESS + SECTION_BIT + B_BIT)
-#define SECTION_x0c1b0                     (ALL_ACCESS + SECTION_BIT + C_BIT)
-#define SECTION_x0c0b0                     (ALL_ACCESS + SECTION_BIT)
-
-//;------------------------------------------------------------------------
-
-//; DACR constant
-#define ANGEL_DACR                         (0x1)
-
-//;------------------------------------------------------------------------
-
-//; PID constant
-#define ANGEL_PID                          (0x0)
