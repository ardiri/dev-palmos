-#define MCATT1_SETTINGS                          0x00000000     // ; eXpansion card attribute space timing config. reg 1 - NOT USED
-#define MCIO1_SETTINGS                           0x00000000     // ; eXpansion card I/O space timing config. reg 1 - NOT USED
-
