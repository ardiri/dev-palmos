+#
+cdl_option CYGPKG_HAL_ARM_XSCALE_PXA270_SG2P_CFLAGS_REMOVE {
+    # Flavor: data
+    # No user value, uncomment the following line to provide one.
+    # user_value ""
+    # value_source default
+    # Default value: ""
+};
+
+# <
+# Memory layout
+#
+cdl_component CYGHWR_MEMORY_LAYOUT {
+    # Calculated value:  CYG_HAL_STARTUP == "RAM" ? "arm_xscale_pxa270_sg2p_ram" :  "arm_xscale_pxa270_sg2p_rom" 
+    #     CYG_HAL_STARTUP == ROM
+    # Flavor: data
+    # Current_value: arm_xscale_pxa270_sg2p_rom
+};
+
+# >
+# Memory layout linker script fragment
