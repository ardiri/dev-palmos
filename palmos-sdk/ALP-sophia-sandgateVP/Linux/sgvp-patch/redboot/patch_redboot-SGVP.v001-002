+		}
+		__flash_info.init = 1;
+	} else {
+        	num_regions = (_si(qp->num_regions)+1)*CYGNUM_FLASH_NDEVICES;
+        	region_size = _si(qp->region_size)*256*CYGNUM_FLASH_DEVICES;
+
+		__flash_info.init = 0;
