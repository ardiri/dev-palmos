+
+//; register bit masks - cccr
+#define CCCR_L                                    (0x01F)
+#define CCCR_M                                    (0x060)
+#define CCCR_N                                    (0x380)
+
+//; field values for L, clock-to-memory multiplier
+#define CCCR_L27                                  (0x01)
+#define CCCR_L32                                  (0x02)
+#define CCCR_L36                                  (0x03)
+#define CCCR_L40                                  (0x04)
+#define CCCR_L45                                  (0x05)
+#define CCCR_L16                                  (0x10)
+
+//; field values for M, memory-to-run-mode  multiplier
+#define CCCR_M1                                   (0x1 << 5)
+#define CCCR_M2                                   (0x2 << 5)
+#define CCCR_M4                                   (0x3 << 5)
+
+//; field values for N, run-mode-to-turbo-mode  multiplier
+#define CCCR_N10                                  (0x2 << 7)
+#define CCCR_N15                                  (0x3 << 7)
+#define CCCR_N20                                  (0x4 << 7)
+#define CCCR_N25                                  (0x5 << 7)
+#define CCCR_N30                                  (0x6 << 7)
+
